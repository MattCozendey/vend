# a comparison, by its three cases
def Cmp.elim(
  c: Cmp,
  -P: Cmp -> Type,
  lt: {c == LT{}: Cmp} -> P(LT{}),
  eq: {c == EQ{}: Cmp} -> P(EQ{}),
  gt: {c == GT{}: Cmp} -> P(GT{})
) -> P(c):
  match c:
    case LT{}:
      lt({==})
    case EQ{}:
      eq({==})
    case GT{}:
      gt({==})

# the edge of a whole tree, with fuel for its levels, sits in its rooms
def Mst.edge_some(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  fw: Nat,
  m: Maybe<&2, Hashes.Hash>,
