# a cut of sorted runs keeps their differences: the keys it cuts at that
# differ, then the differences of the runs between
def Mst.cut_differ(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
