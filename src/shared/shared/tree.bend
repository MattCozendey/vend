import Base
import ./shared/shared/code.bend as Codes
import ./shared/depot.bend as Depots
import ./shared/shared/hash.bend as Hashes
import ./shared/shared/shared.bend as Shared

# Trees
# =====
# A tree maps keys to values (both lists of words). It is held as nodes in a
# depot of data by hash, and named by the hash of its root (none: the empty
# tree), so two versions share every node that neither changed. This file
# states what a tree must do (Tree.Laws): any structure that obeys the laws is
# a tree. Its root is a function of its bindings alone, so nodes that hold the
# same bindings hold the same root, whatever the order of their writes.
#
# The tree of this file is a Merkle search tree (Mst): each key has a level,
# from the hash of the key, so about one key in 32 is a level up. A node holds
# the keys of one level in its range, in order, and between them the subtrees
# of the keys of lower levels. So the shape is a function of the keys, a read
# or a write visits about log n nodes, a write adds only the nodes on its
# path, and two trees share each subtree whose keys and values they share, so
# a difference costs the nodes that differ.

# what a read of a key finds: its value; that the tree does not hold the key;
# or that the depot lacks the node of a hash, so the read cannot tell yet.
# Found and Absent are final: only Missing changes when the depot gets more
# nodes
type Look is Data:
  Look.Found{value: List<&2, U32>}
  Look.Absent{}
  Look.Missing{hash: Hashes.Hash}

# the value that a read found, if it found one
def Look.value(l: Look) -> Maybe<&2, List<&2, U32>>:
  match l:
    case Look.Found{v}:
      Some{v}
    case _:
      None{}

# what a read found, when it could tell: a value, or that there is none
def Look.known(l: Look) -> Maybe<&2, Maybe<&2, List<&2, U32>>>:
  match l:
    case Look.Found{v}:
      Some{Some{v}}
    case Look.Absent{}:
      Some{None{}}
    case Look.Missing{h}:
      None{}

# the read l is final: it found a value or that there is none
def Look.is_final(l: Look) -> Bool:
  Maybe.is_some(&2, Maybe<&2, List<&2, U32>>, Look.known(l))

# the read l found that the tree does not hold the key
def Look.is_absent(l: Look) -> Bool:
  match l:
    case Look.Absent{}:
      True{}
    case _:
      False{}

# what a read of a key gives after a write of the value m there (none: a
# delete)
def Look.of(m: Maybe<&2, List<&2, U32>>) -> Look:
  match m:
    case None{}:
      Look.Absent{}
    case Some{v}:
      Look.Found{v}

# a key and its value, as a tree lists them
type Binding is Data:
  Binding{key: List<&2, U32>, value: List<&2, U32>}

# a and b are the same binding
def Binding.is_eq(a: Binding, b: Binding) -> Bool:
  match a b:
    case Binding{k1, v1} Binding{k2, v2}:
      List.all.if(
        u => Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2),
        Shared.List.is_eq(~U32, ~U32.is_eq, k1, k2)
      )

# the key of a binding
def Binding.key(b: Binding) -> List<&2, U32>:
  match b:
    case Binding{k, v}:
      k

# what a write gives: the root of the new tree (none: the empty tree), and the
# nodes that it adds, each as words
type Edit is Data:
  Edit{root: Maybe<&2, Hashes.Hash>, nodes: List<&2, List<&2, U32>>}

# the root of the new tree of e
def Edit.root(e: Edit) -> Maybe<&2, Hashes.Hash>:
  match e:
    case Edit{r, ns}:
      r

# the nodes that e adds
def Edit.nodes(e: Edit) -> List<&2, List<&2, U32>>:
  match e:
    case Edit{r, ns}:
      ns

# the key k starts with the words p
def Key.leads(p: List<&2, U32>, k: List<&2, U32>) -> Bool:
  match p k:
    case Nil{} y:
      True{}
    case Con{x, rp} Nil{}:
      False{}
    case Con{+x, rp} Con{+y, rk}:
      List.all.if(u => Key.leads(rp, rk), U32.is_eq(x, y))

# the key a comes before the key b: word by word, and a key before each key
# that it starts
def Key.is_lt(a: List<&2, U32>, b: List<&2, U32>) -> Bool:
  match a b:
    case x Nil{}:
      False{}
    case Nil{} Con{y, rb}:
      True{}
    case Con{+x, ra} Con{+y, rb}:
      Bool.or(U32.is_lt(x, y), Bool.and(U32.is_eq(x, y), Key.is_lt(ra, rb)))

# the bindings bs are in the order of their keys, each key once
def Bindings.sorted(bs: List<&2, Binding>) -> Bool:
  match bs:
    case Nil{}:
      True{}
    case Con{a, Nil{}}:
      True{}
    case Con{+a, Con{+b, rest}}:
      List.all.if(u => Bindings.sorted(b <> rest), Key.is_lt(Binding.key(a), Binding.key(b)))

# The operations of a tree
# ------------------------

# the operations of a tree in a depot kept as S: what a read of a key finds;
# a write of a key (some value: set it; none: delete it), none when the depot
# lacks a node on the key's path; the bindings whose keys start with a
# prefix, in the order of their keys (none: the depot lacks a node); and the
# keys that two trees read differently (none: the depot lacks a node)
def Tree.Ops(-S: Data) -> Type:
  (S -> Maybe<&2, Hashes.Hash> -> List<&2, U32> -> Look)
    & (
      (S -> Maybe<&2, Hashes.Hash> -> List<&2, U32> -> Maybe<&2, List<&2, U32>> -> Maybe<&2, Edit>)
        & (
          (S -> Maybe<&2, Hashes.Hash> -> List<&2, U32> -> Maybe<&2, List<&2, Binding>>)
            & (S -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, List<&2, List<&2, U32>>>)
        )
    )

# what a read finds, by the operations o
def Ops.look(-S: Data, o: Tree.Ops(S)) -> S -> Maybe<&2, Hashes.Hash> -> List<&2, U32> -> Look:
  match o:
    case Tuple{lk, rest}:
      lk

# a write, by the operations o
def Ops.put(
  -S: Data,
  o: Tree.Ops(S)
) -> S -> Maybe<&2, Hashes.Hash> -> List<&2, U32> -> Maybe<&2, List<&2, U32>> -> Maybe<&2, Edit>:
  match o:
    case Tuple{lk, Tuple{pt, rest}}:
      pt

# the bindings under a prefix, by the operations o
def Ops.range(
  -S: Data,
  o: Tree.Ops(S)
) -> S -> Maybe<&2, Hashes.Hash> -> List<&2, U32> -> Maybe<&2, List<&2, Binding>>:
  match o:
    case Tuple{lk, Tuple{pt, Tuple{rg, df}}}:
      rg

# the keys that two trees read differently, by the operations o
def Ops.diff(
  -S: Data,
  o: Tree.Ops(S)
) -> S -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, List<&2, List<&2, U32>>>:
  match o:
    case Tuple{lk, Tuple{pt, Tuple{rg, df}}}:
      df

# The laws of a tree
# ------------------
# Each is a proposition about the operations o in a depot kept as S, whose
# data is fetch, and where grows says that a depot keeps all that another
# holds (a test, so that a proof may use it many times).

# the depot s holds each node of the edit e, under its hash
def Edit.Held(-S: Data, -fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, -s: S, -e: Edit) -> Type:
  @w: List<&2, U32> -> {
    List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Edit.nodes(e), w) == True{}: Bool
  } -> {fetch(s)(Hashes.Sha.hash(w)) == Some{w}: Maybe<&2, List<&2, U32>>}

# what a read could tell, it tells in any depot that grows: only Missing
# changes
def Laws.Final(-S: Data, -grows: S -> S -> Bool, -o: Tree.Ops(S)) -> Type:
  @h: Maybe<&2, Hashes.Hash> -> @k: List<&2, U32> -> Shared.Read.Stable(
    S,
    a => b => {grows(a, b) == True{}: Bool},
    Maybe<&2, List<&2, U32>>,
    s => Look.known(Ops.look(S, o)(s)(h)(k))
  )

# a write stays as the depot grows: it reads only nodes on its key's path,
# and what a read could tell stays
def Laws.PutFinal(-S: Data, -grows: S -> S -> Bool, -o: Tree.Ops(S)) -> Type:
  @s: S -> @s2: S -> @h: Maybe<&2, Hashes.Hash> -> @k: List<&2, U32> -> @m: Maybe<
    &2,
    List<&2, U32>> -> @e: Edit -> {
    Ops.put(S, o)(s)(h)(k)(m) == Some{e}: Maybe<&2, Edit>
  } -> {grows(s, s2) == True{}: Bool} -> {Ops.put(S, o)(s2)(h)(k)(m) == Some{e}: Maybe<&2, Edit>}

# a write changes its key and no other: in a depot that grows and holds the
# new nodes, the new root reads the key as written, and tells of every other
# key what the old root tells (a read that could not tell may tell after)
def Laws.Write(
  -S: Data,
  -fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -grows: S -> S -> Bool,
  -o: Tree.Ops(S)
) -> Type:
  @s: S -> @s2: S -> @h: Maybe<&2, Hashes.Hash> -> @k: List<&2, U32> -> @m: Maybe<
    &2,
    List<&2, U32>> -> @e: Edit -> {
    Ops.put(S, o)(s)(h)(k)(m) == Some{e}: Maybe<&2, Edit>
  } -> {grows(s, s2) == True{}: Bool} -> Edit.Held(S, fetch, s2, e) -> {
    Ops.look(S, o)(s2)(Edit.root(e))(k) == Look.of(m): Look
  }
    & (
      @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> {
        Shared.List.is_eq(~U32, ~U32.is_eq, k, k2) == False{}: Bool
      } -> {
        Look.known(Ops.look(S, o)(s2)(h)(k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
      } -> {Look.known(Ops.look(S, o)(s2)(Edit.root(e))(k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
    )

# a root is a function of the bindings alone: two trees that list the same
# bindings have the same root, whatever the order of their writes
def Laws.Canon(-S: Data, -o: Tree.Ops(S)) -> Type:
  @s: S -> @h1: Maybe<&2, Hashes.Hash> -> @h2: Maybe<&2, Hashes.Hash> -> @bs: List<&2, Binding> -> {
    Ops.range(S, o)(s)(h1)([]) == Some{bs}: Maybe<&2, List<&2, Binding>>
  } -> {
    Ops.range(S, o)(s)(h2)([]) == Some{bs}: Maybe<&2, List<&2, Binding>>
  } -> {h1 == h2: Maybe<&2, Hashes.Hash>}

# a listing under a prefix is in the order of its keys, and holds a binding
# exactly when its key starts with the prefix and the tree reads it so
def Laws.Range(-S: Data, -o: Tree.Ops(S)) -> Type:
  @s: S -> @h: Maybe<&2, Hashes.Hash> -> @p: List<&2, U32> -> @bs: List<&2, Binding> -> {
    Ops.range(S, o)(s)(h)(p) == Some{bs}: Maybe<&2, List<&2, Binding>>
  } -> {
    Bindings.sorted(bs) == True{}: Bool
  }
    & (
      @k: List<&2, U32> -> @v: List<&2, U32> -> {
        List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v})
          == Bool.and(
            Key.leads(p, k),
            Shared.Maybe.is_eq(
              ~List<&2, U32>,
              ~Shared.List.is_eq(~U32, ~U32.is_eq),
              Look.value(Ops.look(S, o)(s)(h)(k)),
              Some{v}
            )
          ): Bool
      }
    )

# a difference lists exactly the keys that the two trees read differently
def Laws.Diff(-S: Data, -o: Tree.Ops(S)) -> Type:
  @s: S -> @a: Maybe<&2, Hashes.Hash> -> @b: Maybe<&2, Hashes.Hash> -> @ks: List<
    &2,
    List<&2, U32>> -> {
    Ops.diff(S, o)(s)(a)(b) == Some{ks}: Maybe<&2, List<&2, List<&2, U32>>>
  } -> @k: List<&2, U32> -> {
    List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k)
      == Bool.not(
        Shared.Maybe.is_eq(
          ~List<&2, U32>,
          ~Shared.List.is_eq(~U32, ~U32.is_eq),
          Look.value(Ops.look(S, o)(s)(a)(k)),
          Look.value(Ops.look(S, o)(s)(b)(k))
        )
      ): Bool
  }

# a tree that the depot holds whole answers: the empty tree lists nothing; a
# whole tree reads each key finally, writes each key, lists each prefix, and
# differs from each whole tree
def Laws.Whole(-S: Data, -o: Tree.Ops(S)) -> Type:
  (
    @s: S -> @p: List<&2, U32> -> {
      Ops.range(S, o)(s)(None{})(p) == Some{[]}: Maybe<&2, List<&2, Binding>>
    }
  )
    & (
      @s: S -> @h: Maybe<&2, Hashes.Hash> -> @bs: List<&2, Binding> -> {
        Ops.range(S, o)(s)(h)([]) == Some{bs}: Maybe<&2, List<&2, Binding>>
      } -> (
        @k: List<&2, U32> -> @m: Maybe<&2, List<&2, U32>> -> @p: List<&2, U32> -> {
          Look.is_final(Ops.look(S, o)(s)(h)(k)) == True{}: Bool
        }
          & (
            {
              Maybe.is_some(&2, Edit, Ops.put(S, o)(s)(h)(k)(m)) == True{}: Bool
            }
              & {Maybe.is_some(&2, List<&2, Binding>, Ops.range(S, o)(s)(h)(p)) == True{}: Bool}
          )
      )
        & (
          @h2: Maybe<&2, Hashes.Hash> -> @bs2: List<&2, Binding> -> {
            Ops.range(S, o)(s)(h2)([]) == Some{bs2}: Maybe<&2, List<&2, Binding>>
          } -> {
            Maybe.is_some(&2, List<&2, List<&2, U32>>, Ops.diff(S, o)(s)(h)(h2)) == True{}: Bool
          }
        )
    )

# a write keeps a tree whole: in a depot that grows and holds the new nodes,
# a write to a tree that lists whole gives a tree that lists whole
def Laws.Kept(
  -S: Data,
  -fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -grows: S -> S -> Bool,
  -o: Tree.Ops(S)
) -> Type:
  @s: S -> @s2: S -> @h: Maybe<&2, Hashes.Hash> -> @bs: List<&2, Binding> -> @k: List<&2, U32> -> @m: Maybe<
    &2,
    List<&2, U32>> -> @e: Edit -> {
    Ops.range(S, o)(s)(h)([]) == Some{bs}: Maybe<&2, List<&2, Binding>>
  } -> {
    Ops.put(S, o)(s)(h)(k)(m) == Some{e}: Maybe<&2, Edit>
  } -> {grows(s, s2) == True{}: Bool} -> Edit.Held(S, fetch, s2, e) -> {
    Maybe.is_some(&2, List<&2, Binding>, Ops.range(S, o)(s2)(Edit.root(e))([])) == True{}: Bool
  }

# a listing stays as the depot grows: it reads only nodes by hash
def Laws.RangeFinal(-S: Data, -grows: S -> S -> Bool, -o: Tree.Ops(S)) -> Type:
  @s: S -> @s2: S -> @h: Maybe<&2, Hashes.Hash> -> @p: List<&2, U32> -> @bs: List<&2, Binding> -> {
    Ops.range(S, o)(s)(h)(p) == Some{bs}: Maybe<&2, List<&2, Binding>>
  } -> {grows(s, s2) == True{}: Bool} -> {Ops.range(S, o)(s2)(h)(p) == Some{bs}: Maybe<&2, List<&2, Binding>>}

# a difference stays as the depot grows: it reads only nodes by hash
def Laws.DiffFinal(-S: Data, -grows: S -> S -> Bool, -o: Tree.Ops(S)) -> Type:
  @s: S -> @s2: S -> @a: Maybe<&2, Hashes.Hash> -> @b: Maybe<&2, Hashes.Hash> -> @ks: List<
    &2,
    List<&2, U32>> -> {
    Ops.diff(S, o)(s)(a)(b) == Some{ks}: Maybe<&2, List<&2, List<&2, U32>>>
  } -> {grows(s, s2) == True{}: Bool} -> {Ops.diff(S, o)(s2)(a)(b) == Some{ks}: Maybe<&2, List<&2, List<&2, U32>>>}

# the laws of a tree with the operations o
def Tree.Laws(
  -S: Data,
  -fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -grows: S -> S -> Bool,
  -o: Tree.Ops(S)
) -> Type:
  Laws.Final(S, grows, o)
    & (
      Laws.PutFinal(S, grows, o)
    )
    & (
      Laws.Write(S, fetch, grows, o)
        & (Laws.Canon(S, o) & (Laws.Range(S, o) & (Laws.Diff(S, o) & (Laws.Whole(S, o) & (Laws.Kept(S, fetch, grows, o) & (Laws.RangeFinal(S, grows, o) & Laws.DiffFinal(S, grows, o)))))))
    )

# a tree in a depot kept as S, whose data is fetch and which grows as grows
# says: its operations, and the proof that they obey the laws
def Tree(
  -S: Data,
  -fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -grows: S -> S -> Bool
) -> Type:
  &o: Tree.Ops(S) -> Tree.Laws(S, fetch, grows, o)

# the operations of the tree t
def Tree.ops(
  -S: Data,
  -fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -grows: S -> S -> Bool,
  t: Tree(S, fetch, grows)
) -> Tree.Ops(S):
  match t:
    case Tuple{o, laws}:
      o

# Merkle search trees
# -------------------

# how the key a compares to the key b: word by word, a key before each key
# that it starts
def Key.cmp(a: List<&2, U32>, b: List<&2, U32>) -> Cmp:
  match a b:
    case Nil{} Nil{}:
      EQ{}
    case Nil{} Con{y, rb}:
      LT{}
    case Con{x, ra} Nil{}:
      GT{}
    case Con{x, ra} Con{y, rb}:
      +c = U32.cmp(x, y)
      Shared.Bool.when(Cmp, Cmp.is_eq(c), u => Key.cmp(ra, rb), u => c)

# the number of zero groups of 5 bits at the top of x, f groups at most
def Level.zeros(f: Nat, +x: U32) -> Nat:
  match f:
    case 0n:
      0n
    case 1n+p:
      Shared.Bool.when(
        Nat,
        U32.is_eq(U32.and(x, 4160749568), 0),
        u => 1n+Level.zeros(p, U32.mul(x, 32)),
        u => 0n
      )

# the level of a key of the hash h: its zero groups of 5 bits at the top, so
# about one key in 32 is a level up
def Level.of(h: Hashes.Hash) -> Nat:
  match h:
    case Hashes.Hash{a, b, c, d, e, f, g, i}:
      +za = Level.zeros(6n, a)
      Shared.Bool.when(Nat, Nat.is_eq(za, 6n), u => Nat.add(6n, Level.zeros(6n, b)), u => za)

# the level of the key k: by its hash, so no writer can choose it
def Key.level(k: List<&2, U32>) -> Nat:
  Level.of(Hashes.Sha.hash(k))

# a binding of a node, and the subtree of the keys between it and the next
type Item is Data:
  Item{key: List<&2, U32>, value: List<&2, U32>, right: Maybe<&2, Hashes.Hash>}

# a node of a tree: its level, the subtree of the keys before its first item,
# and its items, in the order of their keys
type Node is Data:
  Node{level: Nat, left: Maybe<&2, Hashes.Hash>, items: List<&2, Item>}

# the item x, then r
def Item.code(x: Item, r: List<&2, U32>) -> List<&2, U32>:
  match x:
    case Item{k, v, h}:
      Codes.Code.words(k, Codes.Code.words(v, Codes.Code.maybe(~Hashes.Hash, ~Hashes.Hash.code, h, r)))

# an item
def Item.code.read(ts: List<&2, U32>) -> Maybe<&2, Codes.Read<Item>>:
  Codes.Code.three.read(
    ~List<&2, U32>,
    ~List<&2, U32>,
    ~Maybe<&2, Hashes.Hash>,
    ~Item,
    ~Codes.Code.words.read,
    ~Codes.Code.words.read,
    ~(m => Codes.Code.maybe.read(~Hashes.Hash, ~Hashes.Hash.code.read, m)),
    k => v => h => Item{k, v, h},
    ts
  )

# an item reads back
def Item.code_read(x: Item, r: List<&2, U32>) -> {
  Item.code.read(Item.code(x, r)) == Some{Codes.Read{x, r}}: Maybe<&2, Codes.Read<Item>>
}:
  match x:
    case Item{k, v, h}:
      Codes.Code.three_read(
        ~List<&2, U32>,
        ~List<&2, U32>,
        ~Maybe<&2, Hashes.Hash>,
        ~Item,
        ~Codes.Code.words.codec(),
        ~Codes.Code.words.codec(),
        ~Codes.Code.maybe.codec(~Hashes.Hash, ~Hashes.Hash.codec()),
        a => b => c => Item{a, b, c},
        k,
        v,
        h,
        r
      )

# the code of items
def Item.codec() -> Codes.Codec(Item):
  (Item.code, (Item.code.read, x => r => Item.code_read(x, r)))

# the code of counts
def Count.codec() -> Codes.Codec(Nat):
  (Codes.Code.count, (Codes.Code.count.read, x => r => Codes.Code.count_read(x, r)))

# the node n, then r
def Node.code(n: Node, r: List<&2, U32>) -> List<&2, U32>:
  match n:
    case Node{l, h, xs}:
      Codes.Code.count(
        l,
        Codes.Code.maybe(~Hashes.Hash, ~Hashes.Hash.code, h, Codes.Code.list(~Item, ~Item.code, xs, r))
      )

# a node
def Node.code.read(ts: List<&2, U32>) -> Maybe<&2, Codes.Read<Node>>:
  Codes.Code.three.read(
    ~Nat,
    ~Maybe<&2, Hashes.Hash>,
    ~List<&2, Item>,
    ~Node,
    ~Codes.Code.count.read,
    ~(m => Codes.Code.maybe.read(~Hashes.Hash, ~Hashes.Hash.code.read, m)),
    ~(m => Codes.Code.list.read(~Item, ~Item.code.read, m)),
    l => h => xs => Node{l, h, xs},
    ts
  )

# a node reads back
def Node.code_read(n: Node, r: List<&2, U32>) -> {
  Node.code.read(Node.code(n, r)) == Some{Codes.Read{n, r}}: Maybe<&2, Codes.Read<Node>>
}:
  match n:
    case Node{l, h, xs}:
      Codes.Code.three_read(
        ~Nat,
        ~Maybe<&2, Hashes.Hash>,
        ~List<&2, Item>,
        ~Node,
        ~Count.codec(),
        ~Codes.Code.maybe.codec(~Hashes.Hash, ~Hashes.Hash.codec()),
        ~Codes.Code.list.codec(~Item, ~Item.codec()),
        a => b => c => Node{a, b, c},
        l,
        h,
        xs,
        r
      )

# Rooms
# -----
# A read or a write opens a node only where it may sit: below the level of its
# parent, with an item, and with its keys in order between the keys beside it
# in its parent. So in any tree that a read or a write walks, the levels fall
# along each path, no path outruns Mst.depth, and a key is where the order of
# keys puts it.

# where a subtree sits: its node has a level below up, and keys after lo and
# before hi (none: no bound)
type Room is Data:
  Room{up: Nat, lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>}

# no tree is deeper than this many levels, and no level of a node reaches
# it: levels fall along each path
def Mst.depth() -> Nat:
  64n

# the room of a root
def Room.top() -> Room:
  Room{Mst.depth(), None{}, None{}}

# the key k comes after the bound lo (none: no bound)
def Bound.after(lo: Maybe<&2, List<&2, U32>>, k: List<&2, U32>) -> Bool:
  match lo:
    case None{}:
      True{}
    case Some{a}:
      Key.is_lt(a, k)

# the key k comes before the bound hi (none: no bound)
def Bound.before(k: List<&2, U32>, hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match hi:
    case None{}:
      True{}
    case Some{b}:
      Key.is_lt(k, b)

# the keys of the items xs come in order, after lo and before hi
def Items.fit(xs: List<&2, Item>, lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{Item{+k, v, r}, rest}:
      Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Items.fit(rest, Some{k}, hi))

# the key of the first of the items xs, else m
def Items.head_key(xs: List<&2, Item>, m: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  match xs:
    case Nil{}:
      m
    case Con{Item{k, v, r}, rest}:
      Some{k}

# the key of the last of the items xs, else m
def Items.last_key(xs: List<&2, Item>, m: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  match xs:
    case Nil{}:
      m
    case Con{Item{k, v, r}, rest}:
      Items.last_key(rest, Some{k})

# the node n, when it may sit in the room r
def Node.in(n: Node, r: Room) -> Maybe<&2, Node>:
  match n r:
    case Node{+l, left, +xs} Room{up, lo, hi}:
      Shared.Maybe.when(
        Node,
        Bool.and(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi)),
        u => Some{Node{l, left, xs}}
      )

# the node that the depot s holds under the hash h (none: s lacks it, or it
# is not the code of one node)
def Mst.node(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  s: S,
  h: Hashes.Hash
) -> Maybe<&2, Node>:
  Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, fetch(s)(h))

# the node of the hash h, when it may sit in the room r (none: the depot s
# lacks it, or it may not sit there)
def Mst.node.in(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  s: S,
  h: Hashes.Hash,
  r: Room
) -> Maybe<&2, Node>:
  Maybe.bind(&2, Node, Node, Mst.node(~S, ~fetch, s, h), n => Node.in(n, r))

# the room of a subtree of a node of the level l, after the key lo and
# before hi
def Room.of(+l: Nat, lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> Room:
  Room{l, lo, hi}

# Reads
# -----

# what a read of a node finds: the value of the key, or the subtree to go on
# in and its room
type Pick is Data:
  Pick.Hit{value: List<&2, U32>}
  Pick.Down{sub: Maybe<&2, Hashes.Hash>, room: Room}

# the pick of the key k among the items xs of a node of the level l, whose
# subtree before them is prev, after the key lo, and before hi
def Mst.pick(xs: List<&2, Item>, prev: Maybe<&2, Hashes.Hash>, +l: Nat, lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>) -> Pick:
  match xs:
    case Nil{}:
      Pick.Down{prev, Room.of(l, lo, hi)}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +c = Key.cmp(k, ik)
      Shared.Bool.when(
        Pick,
        Cmp.is_lt(c),
        u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
        u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k))
      )

# the read that a pick in the node of the hash h, of the level l, gives for
# the key k: its value, when the node is of the level of k (else the tree is
# not in its one shape, and the read cannot tell); or the read of its subtree
# (go)
def Mst.look.pick(p: Pick, h: Hashes.Hash, l: Nat, k: List<&2, U32>, go: Maybe<&2, Hashes.Hash> -> Room -> Look) -> Look:
  match p:
    case Pick.Hit{v}:
      Shared.Bool.when(Look, Nat.is_eq(Key.level(k), l), u => Look.Found{v}, u => Look.Missing{h})
    case Pick.Down{m, r}:
      go(m)(r)

# the read of the key k in the node m of the hash h, in the room r, with go
# reading a subtree
def Mst.look.at(h: Hashes.Hash, m: Maybe<&2, Node>, r: Room, +k: List<&2, U32>, go: Maybe<&2, Hashes.Hash> -> Room -> Look) -> Look:
  match m r:
    case None{} x:
      Look.Missing{h}
    case Some{Node{+l, left, xs}} Room{up, lo, hi}:
      Mst.look.pick(Mst.pick(xs, left, l, lo, hi, k), h, l, k, go)

# the read of the key k in the tree of the root m, in the room r, at most f
# levels down
def Mst.look.go(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +r: Room,
  m: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>
) -> Look:
  match f m:
    case x None{}:
      Look.Absent{}
    case 0n Some{h}:
      Look.Missing{h}
    case 1n+p Some{+h}:
      Mst.look.at(h, Mst.node.in(~S, ~fetch, s, h, r), r, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k))

# the read of the key k in the tree of the root m
def Mst.look(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  s: S,
  m: Maybe<&2, Hashes.Hash>,
  k: List<&2, U32>
) -> Look:
  Mst.look.go(~S, ~fetch, Mst.depth(), s, Room.top(), m, k)

# Writes
# ------
# A write changes only the nodes on the path to its key: an insert splits the
# subtree where the key goes, a delete merges the two subtrees beside it, and
# every node it rebuilds is new; all others stay shared. It opens each node
# in its room, so what it builds from them is in order; a subtree that a
# merge lifts into a wider room has its inner edge read in its old room.

# the node n stored: its hash, and its words in front of the new nodes acc
def Mst.store(n: Node, acc: List<&2, List<&2, U32>>) -> Edit:
  +ws = Node.code(n, [])
  Edit{Some{Hashes.Sha.hash(ws)}, ws <> acc}

# a node of the level l in its one shape: with no item it is its left subtree
def Mst.make(+l: Nat, left: Maybe<&2, Hashes.Hash>, xs: List<&2, Item>, acc: List<&2, List<&2, U32>>) -> Edit:
  match xs:
    case Nil{}:
      Edit{left, acc}
    case Con{x, r}:
      Mst.store(Node{l, left, x <> r}, acc)

# the items of a node split at the key k: those before it, last first; the
# subtree where k goes; and those from k on
type Part is Data:
  Part{before: List<&2, Item>, gap: Maybe<&2, Hashes.Hash>, after: List<&2, Item>}

# the items xs split at the key k, the subtree before them prev, after the
# items acc, last first
def Mst.part(xs: List<&2, Item>, prev: Maybe<&2, Hashes.Hash>, +k: List<&2, U32>, +acc: List<&2, Item>) -> Part:
  match xs:
    case Nil{}:
      Part{acc, prev, []}
    case Con{Item{+ik, +iv, +r}, +rest}:
      Shared.Bool.when(
        Part,
        Cmp.is_lt(Key.cmp(ik, k)),
        u => Mst.part(rest, r, k, Item{ik, iv, r} <> acc),
        u => Part{acc, prev, Item{ik, iv, r} <> rest}
      )

# the subtree of a part
def Part.gap(p: Part) -> Maybe<&2, Hashes.Hash>:
  match p:
    case Part{b, g, a}:
      g

# the room of the gap of the part p of a node of the level l, after the key
# lo and before hi
def Part.room(p: Part, +l: Nat, lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> Room:
  match p:
    case Part{b, g, a}:
      Room.of(l, Items.head_key(b, lo), Items.head_key(a, hi))

# the part p cuts its node at a key k that the node holds
def Part.hits(p: Part, k: List<&2, U32>) -> Bool:
  match p:
    case Part{b, g, Con{Item{ik, iv, r}, rest}}:
      Cmp.is_eq(Key.cmp(ik, k))
    case Part{b, g, Nil{}}:
      False{}

# a node's items before a place, last first, with the subtree there set to
# m, in order, then the items after
def Mst.rejoin(before: List<&2, Item>, m: Maybe<&2, Hashes.Hash>, after: List<&2, Item>) -> List<&2, Item>:
  match before:
    case Nil{}:
      after
    case Con{Item{k, v, r}, rest}:
      List.append(&2, Item, List.reverse(&2, Item, rest), Item{k, v, m} <> after)

# the left subtree of a node whose items before a place are before (last
# first), when the subtree there becomes m
def Mst.left(before: List<&2, Item>, left: Maybe<&2, Hashes.Hash>, m: Maybe<&2, Hashes.Hash>) -> Maybe<&2, Hashes.Hash>:
  match before:
    case Nil{}:
      m
    case Con{x, r}:
      left

# a tree split at a key: the subtree of the keys before it, of those after
# it, and the new nodes
type Halves is Data:
  Halves{lo: Maybe<&2, Hashes.Hash>, hi: Maybe<&2, Hashes.Hash>, nodes: List<&2, List<&2, U32>>}

# the node of the level l and the left subtree left, split at k by its part
# p, once its gap is split (m)
def Mst.split.done(+l: Nat, +left: Maybe<&2, Hashes.Hash>, p: Part, m: Maybe<&2, Halves>) -> Maybe<&2, Halves>:
  match p m:
    case x None{}:
      None{}
    case Part{+b, g, a} Some{Halves{+clo, chi, ns}}:
      +lo = Mst.make(l, Mst.left(b, left, clo), Mst.rejoin(b, clo, []), ns)
      +hi = Mst.make(l, chi, a, Edit.nodes(lo))
      Some{Halves{Edit.root(lo), Edit.root(hi), Edit.nodes(hi)}}

# the node m, in the room r, split at the key k, with go splitting a subtree
def Mst.split.at(
  m: Maybe<&2, Node>,
  r: Room,
  +k: List<&2, U32>,
  go: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>
) -> Maybe<&2, Halves>:
  match m r:
    case None{} x:
      None{}
    case Some{Node{+l, +left, xs}} Room{up, lo, hi}:
      +p = Mst.part(xs, left, k, [])
      Shared.Bool.when(
        Maybe<&2, Halves>,
        Part.hits(p, k),
        u => None{},
        u => Mst.split.done(l, left, p, go(Part.room(p, l, lo, hi))(Part.gap(p)))
      )

# the tree of the root m, in the room r, split at the key k, which it lacks,
# at most f levels down (none: a node holds k, so the tree is not in its one
# shape)
def Mst.split(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +r: Room,
  m: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>
) -> Maybe<&2, Halves>:
  match f m:
    case x None{}:
      Some{Halves{None{}, None{}, []}}
    case 0n Some{h}:
      None{}
    case 1n+p Some{h}:
      Mst.split.at(Mst.node.in(~S, ~fetch, s, h, r), r, k, r2 => c => Mst.split(~S, ~fetch, p, s, r2, c, k))

# the subtree at the end of a node: the right of its last item, else its left
def Mst.last(xs: List<&2, Item>, left: Maybe<&2, Hashes.Hash>) -> Maybe<&2, Hashes.Hash>:
  match xs:
    case Nil{}:
      left
    case Con{Item{k, v, r}, rest}:
      Mst.last(rest, r)

# the items xs with the subtree after the last one set to m
def Mst.set_last(xs: List<&2, Item>, m: Maybe<&2, Hashes.Hash>) -> List<&2, Item>:
  match xs:
    case Nil{}:
      []
    case Con{Item{k, v, r}, Nil{}}:
      [Item{k, v, m}]
    case Con{x, rest}:
      x <> Mst.set_last(rest, m)

# a node with no item has m as its left subtree, else it keeps left
def Mst.end_left(xs: List<&2, Item>, left: Maybe<&2, Hashes.Hash>, m: Maybe<&2, Hashes.Hash>) -> Maybe<&2, Hashes.Hash>:
  match xs:
    case Nil{}:
      m
    case Con{x, r}:
      left

# the node of the level l, left subtree left and items xs, with its last
# subtree replaced by the merge e
def Mst.with_last(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  e: Maybe<&2, Edit>
) -> Maybe<&2, Edit>:
  match e:
    case None{}:
      None{}
    case Some{Edit{+mc, ns}}:
      Some{Mst.make(l, Mst.end_left(xs, left, mc), Mst.set_last(xs, mc), ns)}

# the node of the level l and items xs, with its left subtree replaced by the
# merge e
def Mst.with_first(+l: Nat, xs: List<&2, Item>, e: Maybe<&2, Edit>) -> Maybe<&2, Edit>:
  match e:
    case None{}:
      None{}
    case Some{Edit{mc, ns}}:
      Some{Mst.make(l, mc, xs, ns)}

# two nodes of one level as one: the items of a, then of b, the subtrees
# between them merged (e)
def Mst.with_both(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  xb: List<&2, Item>,
  e: Maybe<&2, Edit>
) -> Maybe<&2, Edit>:
  match e:
    case None{}:
      None{}
    case Some{Edit{+mc, ns}}:
      Some{Mst.make(l, Mst.end_left(xa, left, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), ns)}

# the subtree m, in the room r, with each node of its left edge in its room
# (go reads the next one): no key of it comes before the lower bound of r,
# even once that bound widens
def Mst.edge.left.at(m: Maybe<&2, Node>, r: Room, go: Room -> Maybe<&2, Hashes.Hash> -> Bool) -> Bool:
  match m r:
    case None{} x:
      False{}
    case Some{Node{+l, left, xs}} Room{up, lo, hi}:
      go(Room.of(l, lo, Items.head_key(xs, hi)))(left)

# the subtree m, in the room r, with each node of its right edge in its room
# (go reads the next one): no key of it comes after the upper bound of r,
# even once that bound widens
def Mst.edge.right.at(m: Maybe<&2, Node>, r: Room, go: Room -> Maybe<&2, Hashes.Hash> -> Bool) -> Bool:
  match m r:
    case None{} x:
      False{}
    case Some{Node{+l, left, +xs}} Room{up, lo, hi}:
      go(Room.of(l, Items.last_key(xs, lo), hi))(Mst.last(xs, left))

# the nodes of the left (left: True) or right edge of the tree of the root
# m, in the room r, each sit in their rooms, at most f levels down
def Mst.edge(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +left: Bool,
  +r: Room,
  m: Maybe<&2, Hashes.Hash>
) -> Bool:
  match f m:
    case x None{}:
      True{}
    case 0n Some{h}:
      False{}
    case 1n+(+p) Some{h}:
      +n = Mst.node.in(~S, ~fetch, s, h, r)
      Shared.Bool.when(
        Bool,
        left,
        u => Mst.edge.left.at(n, r, r2 => c => Mst.edge(~S, ~fetch, p, s, left, r2, c)),
        u => Mst.edge.right.at(n, r, r2 => c => Mst.edge(~S, ~fetch, p, s, left, r2, c))
      )

# the merge of the node a of the level la, in the room ra, and the node b of
# the level lb, in the room rb, by how la compares to lb (c), with go merging
# two subtrees, each in its room
def Mst.merge.nodes(
  c: Cmp,
  +ha: Hashes.Hash,
  +ra: Room,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +hb: Hashes.Hash,
  +rb: Room,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  go: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>
) -> Maybe<&2, Edit>:
  match c ra rb:
    case GT{} Room{ua, loa, hia} y:
      Mst.with_last(la, lefta, xa, go(Room.of(la, Items.last_key(xa, loa), hia))(rb)(Mst.last(xa, lefta))(Some{hb}))
    case LT{} x Room{ub, lob, hib}:
      Mst.with_first(lb, xb, go(ra)(Room.of(lb, lob, Items.head_key(xb, hib)))(Some{ha})(leftb))
    case EQ{} Room{ua, loa, hia} Room{ub, lob, hib}:
      Mst.with_both(
        la,
        lefta,
        xa,
        xb,
        go(Room.of(la, Items.last_key(xa, loa), hia))(Room.of(lb, lob, Items.head_key(xb, hib)))(Mst.last(xa, lefta))(leftb)
      )

# the merge of the nodes na, in the room ra, and nb, in the room rb, of the
# hashes ha and hb
def Mst.merge.at(
  na: Maybe<&2, Node>,
  nb: Maybe<&2, Node>,
  +ha: Hashes.Hash,
  +ra: Room,
  +hb: Hashes.Hash,
  +rb: Room,
  go: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>
) -> Maybe<&2, Edit>:
  match na nb:
    case Some{Node{+la, lefta, xa}} Some{Node{+lb, leftb, xb}}:
      Mst.merge.nodes(Nat.cmp(la, lb), ha, ra, la, lefta, xa, hb, rb, lb, leftb, xb, go)
    case x y:
      None{}

# the tree of the keys of a, in the room ra, then of b, in the room rb, when
# each key of a is before each of b, at most f levels down. A side that stands
# alone rises into the room of both, so the edge that faces the other side
# is read in its old room
def Mst.merge(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +ra: Room,
  +rb: Room,
  a: Maybe<&2, Hashes.Hash>,
  b: Maybe<&2, Hashes.Hash>
) -> Maybe<&2, Edit>:
  match f a b:
    case x None{} None{}:
      Some{Edit{None{}, []}}
    case x None{} Some{+hb}:
      Shared.Maybe.when(Edit, Mst.edge(~S, ~fetch, Mst.depth(), s, True{}, rb, Some{hb}), u => Some{Edit{Some{hb}, []}})
    case x Some{+ha} None{}:
      Shared.Maybe.when(Edit, Mst.edge(~S, ~fetch, Mst.depth(), s, False{}, ra, Some{ha}), u => Some{Edit{Some{ha}, []}})
    case 0n y z:
      None{}
    case 1n+p Some{+ha} Some{+hb}:
      Mst.merge.at(
        Mst.node.in(~S, ~fetch, s, ha, ra),
        Mst.node.in(~S, ~fetch, s, hb, rb),
        ha,
        ra,
        hb,
        rb,
        r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y)
      )

# the tree of the level L with only the key k, over the halves of a tree split
# at k
def Mst.insert.top(+L: Nat, +k: List<&2, U32>, +v: List<&2, U32>, m: Maybe<&2, Halves>) -> Maybe<&2, Edit>:
  match m:
    case None{}:
      None{}
    case Some{Halves{lo, hi, ns}}:
      Some{Mst.store(Node{L, lo, [Item{k, v, hi}]}, ns)}

# a node of the level l that gets the key k, which it lacks, in the gap of its
# part p, once that gap is split (m)
def Mst.insert.gap(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  p: Part,
  m: Maybe<&2, Halves>
) -> Maybe<&2, Edit>:
  match p m:
    case x None{}:
      None{}
    case Part{+b, g, a} Some{Halves{+clo, chi, ns}}:
      Some{Mst.store(Node{l, Mst.left(b, left, clo), Mst.rejoin(b, clo, Item{k, v, chi} <> a)}, ns)}

# a node of the level l, split at k by its part p, that gets the key k: a new
# value when it holds k, else k in its gap (sp splits the gap)
def Mst.insert.here(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  p: Part,
  sp: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>
) -> Maybe<&2, Edit>:
  match p:
    case Part{+b, +g, Con{Item{+ik, iv, +r}, +rest}}:
      Shared.Bool.when(
        Maybe<&2, Edit>,
        Cmp.is_eq(Key.cmp(ik, k)),
        u => Some{Mst.store(Node{l, left, Mst.rejoin(b, g, Item{k, v, r} <> rest)}, [])},
        u => Mst.insert.gap(l, left, k, v, Part{b, g, Item{ik, iv, r} <> rest}, sp(g))
      )
    case Part{+b, +g, Nil{}}:
      Mst.insert.gap(l, left, k, v, Part{b, g, []}, sp(g))

# a node of the level l whose gap of its part p got the edit e
def Mst.with_gap(+l: Nat, +left: Maybe<&2, Hashes.Hash>, p: Part, e: Maybe<&2, Edit>) -> Maybe<&2, Edit>:
  match p e:
    case x None{}:
      None{}
    case Part{+b, g, a} Some{Edit{+nc, ns}}:
      Some{Mst.make(l, Mst.left(b, left, nc), Mst.rejoin(b, nc, a), ns)}

# the node of the hash h, of the level l, after the key lo and before hi,
# that gets the key k of the level L, by how l compares to L (c): above it a
# new node splits the tree (sp); at it, it takes the key (spg splits its gap);
# below it, the key goes into the gap of its part (ins). A node of another
# level that holds k is not in its one shape: none
def Mst.insert.node(
  c: Cmp,
  +h: Hashes.Hash,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  xs: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +L: Nat,
  sp: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  spg: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  ins: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>
) -> Maybe<&2, Edit>:
  match c:
    case LT{}:
      Mst.insert.top(L, k, v, sp(Some{h}))
    case EQ{}:
      +p = Mst.part(xs, left, k, [])
      Mst.insert.here(l, left, k, v, p, spg(Part.room(p, l, lo, hi)))
    case GT{}:
      +p = Mst.part(xs, left, k, [])
      Shared.Bool.when(
        Maybe<&2, Edit>,
        Part.hits(p, k),
        u => None{},
        u => Mst.with_gap(l, left, p, ins(Part.room(p, l, lo, hi))(Part.gap(p)))
      )

# the node m of the hash h, in the room r, with the key k of the level L
# bound to v
def Mst.insert.at(
  m: Maybe<&2, Node>,
  +h: Hashes.Hash,
  r: Room,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +L: Nat,
  sp: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  spg: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  ins: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>
) -> Maybe<&2, Edit>:
  match m r:
    case None{} x:
      None{}
    case Some{Node{+l, left, xs}} Room{up, lo, hi}:
      Mst.insert.node(Nat.cmp(l, L), h, l, left, xs, lo, hi, k, v, L, sp, spg, ins)

# the tree of the root m, in the room r, with the key k, of the level L,
# bound to v, at most f levels down
def Mst.insert(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +r: Room,
  m: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +L: Nat
) -> Maybe<&2, Edit>:
  match f m:
    case x None{}:
      Some{Mst.store(Node{L, None{}, [Item{k, v, None{}}]}, [])}
    case 0n Some{h}:
      None{}
    case 1n+(+p) Some{+h}:
      Mst.insert.at(
        Mst.node.in(~S, ~fetch, s, h, r),
        h,
        r,
        k,
        v,
        L,
        c => Mst.split(~S, ~fetch, p, s, r, c, k),
        r2 => c => Mst.split(~S, ~fetch, p, s, r2, c, k),
        r2 => c => Mst.insert(~S, ~fetch, p, s, r2, c, k, v, L)
      )

# the tree of the hash h, unchanged, once a read (lk) finds k absent from its
# subtree m in the room r; else none: the tree holds k where it does not
# belong, or the read cannot tell
def Mst.delete.none(+h: Hashes.Hash, r: Room, m: Maybe<&2, Hashes.Hash>, lk: Room -> Maybe<&2, Hashes.Hash> -> Look) -> Maybe<&2, Edit>:
  Shared.Maybe.when(Edit, Look.is_absent(lk(r)(m)), u => Some{Edit{Some{h}, []}})

# a node of the level l, after the key lo and before hi, split at k by its
# part p, without the key k: the two subtrees beside k merge (mg); a node
# that lacks k stays (h), once its gap lacks k too (lk)
def Mst.delete.here(
  +h: Hashes.Hash,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  p: Part,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  mg: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  lk: Room -> Maybe<&2, Hashes.Hash> -> Look
) -> Maybe<&2, Edit>:
  match p:
    case Part{+b, +g, Con{Item{+ik, iv, +r}, +rest}}:
      Shared.Bool.when(
        Maybe<&2, Edit>,
        Cmp.is_eq(Key.cmp(ik, k)),
        u => Mst.with_gap(
          l,
          left,
          Part{b, g, rest},
          mg(Room.of(l, Items.head_key(b, lo), Some{ik}))(Room.of(l, Some{ik}, Items.head_key(rest, hi)))(g)(r)
        ),
        u => Mst.delete.none(h, Room.of(l, Items.head_key(b, lo), Some{ik}), g, lk)
      )
    case Part{b, g, Nil{}}:
      Mst.delete.none(h, Room.of(l, Items.head_key(b, lo), hi), g, lk)

# the pick p of k in a node lacks k, and so does the subtree it goes on in
# (lk reads)
def Mst.delete.lacks(p: Pick, lk: Room -> Maybe<&2, Hashes.Hash> -> Look) -> Bool:
  match p:
    case Pick.Hit{v}:
      False{}
    case Pick.Down{m, r}:
      Look.is_absent(lk(r)(m))

# the node of the hash h, of the level l, after the key lo and before hi,
# without the key k of the level L, by how l compares to L (c). Below it, k is
# not there, once a read (lk) finds it absent; a node of another level that
# holds k is not in its one shape: none
def Mst.delete.node(
  c: Cmp,
  +h: Hashes.Hash,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  xs: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  mg: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  del: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  lk: Room -> Maybe<&2, Hashes.Hash> -> Look
) -> Maybe<&2, Edit>:
  match c:
    case LT{}:
      Shared.Maybe.when(Edit, Mst.delete.lacks(Mst.pick(xs, left, l, lo, hi, k), lk), u => Some{Edit{Some{h}, []}})
    case EQ{}:
      Mst.delete.here(h, l, left, k, Mst.part(xs, left, k, []), lo, hi, mg, lk)
    case GT{}:
      +p = Mst.part(xs, left, k, [])
      Shared.Bool.when(
        Maybe<&2, Edit>,
        Part.hits(p, k),
        u => None{},
        u => Mst.with_gap(l, left, p, del(Part.room(p, l, lo, hi))(Part.gap(p)))
      )

# the node m of the hash h, in the room r, without the key k of the level L
def Mst.delete.at(
  m: Maybe<&2, Node>,
  +h: Hashes.Hash,
  r: Room,
  +k: List<&2, U32>,
  +L: Nat,
  mg: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  del: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  lk: Room -> Maybe<&2, Hashes.Hash> -> Look
) -> Maybe<&2, Edit>:
  match m r:
    case None{} x:
      None{}
    case Some{Node{+l, left, xs}} Room{up, lo, hi}:
      Mst.delete.node(Nat.cmp(l, L), h, l, left, xs, lo, hi, k, mg, del, lk)

# the tree of the root m, in the room r, without the key k, of the level L,
# at most f levels down
def Mst.delete(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +r: Room,
  m: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +L: Nat
) -> Maybe<&2, Edit>:
  match f m:
    case x None{}:
      Some{Edit{None{}, []}}
    case 0n Some{h}:
      None{}
    case 1n+(+p) Some{+h}:
      Mst.delete.at(
        Mst.node.in(~S, ~fetch, s, h, r),
        h,
        r,
        k,
        L,
        r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y),
        r2 => c => Mst.delete(~S, ~fetch, p, s, r2, c, k, L),
        r2 => c => Mst.look.go(~S, ~fetch, p, s, r2, c, k)
      )

# the tree of the root m with the key k set to the value of m2 (none: deleted)
def Mst.put(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  m2: Maybe<&2, List<&2, U32>>
) -> Maybe<&2, Edit>:
  match m2:
    case Some{v}:
      Mst.insert(~S, ~fetch, Mst.depth(), s, Room.top(), m, k, v, Key.level(k))
    case None{}:
      Mst.delete(~S, ~fetch, Mst.depth(), s, Room.top(), m, k, Key.level(k))

# Reads of many keys
# ------------------
# A listing and a difference read a tree as pieces, and check each node that
# they open (Mst.open): its hash, its code, its level, and its keys in their
# bounds. So they answer only of a tree in its one shape, whoever made its
# root, and two roots that list the same bindings are the same root.

# a piece of a tree, as a walk reads it: a binding, or the subtree of the hash
# h, whose node must have a level below up and keys after lo and before hi
type Piece is Data:
  Piece.Bind{key: List<&2, U32>, value: List<&2, U32>}
  Piece.Sub{hash: Hashes.Hash, up: Nat, lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>}

# the piece of the subtree m of a node of the level l, between lo and hi,
# before the pieces rest (none: no piece)
def Piece.sub(
  m: Maybe<&2, Hashes.Hash>,
  l: Nat,
  lo: Maybe<&2, List<&2, U32>>,
  hi: Maybe<&2, List<&2, U32>>,
  rest: List<&2, Piece>
) -> List<&2, Piece>:
  match m:
    case None{}:
      rest
    case Some{h}:
      Piece.Sub{h, l, lo, hi} <> rest

# the pieces of the items xs of a node of the level l, after the subtree
# prev, between lo and hi (none: a key is not of the level l, or not in order
# between the bounds, or a subtree sits before the empty key, where no key
# can be)
def Mst.pieces(
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> Maybe<&2, List<&2, Piece>>:
  match xs:
    case Nil{}:
      Some{Piece.sub(prev, l, lo, hi, [])}
    case Con{Item{+k, v, r}, rest}:
      Shared.Maybe.when(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(k), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, k)))),
          Bool.and(Bound.after(lo, k), Bound.before(k, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps => Piece.sub(prev, l, lo, Some{k}, Piece.Bind{k, v} <> ps),
          Mst.pieces(rest, l, r, Some{k}, hi)
        )
      )

# the pieces of the node n, below the level up and between lo and hi (none:
# it has no item, its level is not below up, or its items are not so)
def Mst.open.node(
  n: Node,
  up: Nat,
  lo: Maybe<&2, List<&2, U32>>,
  hi: Maybe<&2, List<&2, U32>>
) -> Maybe<&2, List<&2, Piece>>:
  match n:
    case Node{+l, left, +xs}:
      Shared.Maybe.when(
        List<&2, Piece>,
        Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))),
        u => Mst.pieces(xs, l, left, lo, hi)
      )

# the pieces of the node of the hash h, checked (none: the depot s lacks it,
# its words do not have the hash h or are not the code of one node, or the
# node is not in its one shape below up and between lo and hi)
def Mst.open(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  s: S,
  +h: Hashes.Hash,
  up: Nat,
  lo: Maybe<&2, List<&2, U32>>,
  hi: Maybe<&2, List<&2, U32>>
) -> Maybe<&2, List<&2, Piece>>:
  Maybe.bind(
    &2,
    List<&2, U32>,
    List<&2, Piece>,
    fetch(s)(h),
    +ws => Shared.Maybe.when(
      List<&2, Piece>,
      Hashes.Hash.is_eq(Hashes.Sha.hash(ws), h),
      u => Maybe.bind(
        &2,
        Node,
        List<&2, Piece>,
        Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
        n => Mst.open.node(n, up, lo, hi)
      )
    )
  )

# the pieces of the tree of the root m
def Mst.root(m: Maybe<&2, Hashes.Hash>) -> List<&2, Piece>:
  Piece.sub(m, Mst.depth(), None{}, None{}, [])

# Listings

# a key that starts with p may come after the bound lo
def Bound.meets_lo(+p: List<&2, U32>, lo: Maybe<&2, List<&2, U32>>) -> Bool:
  match lo:
    case None{}:
      True{}
    case Some{+a}:
      Bool.or(Key.is_lt(a, p), Key.leads(p, a))

# a key that starts with p may come before the bound hi
def Bound.meets_hi(p: List<&2, U32>, hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match hi:
    case None{}:
      True{}
    case Some{b}:
      Key.is_lt(p, b)

# the bindings under the prefix p among the pieces ps, at most f levels down:
# a subtree whose bounds hold no key that starts with p is not read
def Mst.range.go(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +p: List<&2, U32>,
  ps: List<&2, Piece>
) -> Maybe<&2, List<&2, Binding>>:
  match f ps:
    case x Nil{}:
      Some{[]}
    case 0n Con{x, rest}:
      None{}
    case 1n+(+q) Con{Piece.Bind{+k, +v}, rest}:
      Maybe.map(
        &2,
        List<&2, Binding>,
        List<&2, Binding>,
        +bs => Shared.Bool.when(List<&2, Binding>, Key.leads(p, k), u => Binding{k, v} <> bs, u => bs),
        Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
      )
    case 1n+(+q) Con{Piece.Sub{h, up, +lo, +hi}, +rest}:
      Shared.Bool.when(
        Maybe<&2, List<&2, Binding>>,
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, s, h, up, lo, hi),
          ks => Maybe.bind(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, q, s, p, ks),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
            )
          )
        ),
        u => Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
      )

# the bindings whose keys start with p, in the tree of the root m, in the
# order of their keys (none: the depot lacks a node, or a node is not in its
# one shape)
def Mst.range(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  s: S,
  m: Maybe<&2, Hashes.Hash>,
  p: List<&2, U32>
) -> Maybe<&2, List<&2, Binding>>:
  Mst.range.go(~S, ~fetch, Mst.depth(), s, p, Mst.root(m))

# Differences
# -----------
# A difference walks both trees in rounds, one level of nodes a round. A round
# cuts the pieces of both at each key that both hold as a binding; of each run
# between two cuts, it drops the pieces at its ends that both trees share (a
# subtree of one hash, in the same bounds, reads the same in both), and opens
# each subtree that is left. So a difference opens only the nodes on the paths
# to the keys that differ.

# the pieces a and b are the same: one binding, or one subtree in the same
# room
def Piece.same(a: Piece, b: Piece) -> Bool:
  match a b:
    case Piece.Bind{k1, v1} Piece.Bind{k2, v2}:
      Bool.and(Shared.List.is_eq(~U32, ~U32.is_eq, k1, k2), Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2))
    case Piece.Sub{h1, u1, lo1, hi1} Piece.Sub{h2, u2, lo2, hi2}:
      Bool.and(
        Bool.and(Hashes.Hash.is_eq(h1, h2), Nat.is_eq(u1, u2)),
        Bool.and(
          Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), lo1, lo2),
          Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), hi1, hi2)
        )
      )
    case x y:
      False{}

# two runs of pieces over the same keys, one of each tree
type Runs is Data:
  Runs{a: List<&2, Piece>, b: List<&2, Piece>}

# what a round gives: keys that differ, and the runs to read on
type Round is Data:
  Round{keys: List<&2, List<&2, U32>>, pairs: List<&2, Runs>}

# the keys of a round
def Round.keys(r: Round) -> List<&2, List<&2, U32>>:
  match r:
    case Round{ks, ps}:
      ks

# the runs of a round
def Round.pairs(r: Round) -> List<&2, Runs>:
  match r:
    case Round{ks, ps}:
      ps

# the round r with the run p first
def Round.cons(p: Runs, r: Round) -> Round:
  match r:
    case Round{ks, ps}:
      Round{ks, p <> ps}

# the round r with the key k, when the values v1 and v2 of it differ
def Round.differs(+k: List<&2, U32>, v1: List<&2, U32>, v2: List<&2, U32>, r: Round) -> Round:
  match r:
    case Round{+ks, ps}:
      Round{Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => ks, u => k <> ks), ps}

# the rounds a and b, one after the other
def Round.append(a: Round, b: Round) -> Round:
  match a b:
    case Round{k1, p1} Round{k2, p2}:
      Round{List.append(&2, List<&2, U32>, k1, k2), List.append(&2, Runs, p1, p2)}

# the pieces as and bs cut at each key that both hold as a binding, after the
# pieces sa and sb of the run so far, last first
def Mst.cut(as: List<&2, Piece>, bs: List<&2, Piece>, +sa: List<&2, Piece>, +sb: List<&2, Piece>) -> Round:
  match as bs:
    case Nil{} Nil{}:
      Round{[], [Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)}]}
    case Nil{} Con{y, rb}:
      Mst.cut([], rb, sa, y <> sb)
    case Con{x, ra} Nil{}:
      Mst.cut(ra, [], x <> sa, sb)
    case Con{Piece.Sub{h, u, lo, hi}, ra} ys:
      Mst.cut(ra, ys, Piece.Sub{h, u, lo, hi} <> sa, sb)
    case Con{Piece.Bind{k1, v1}, ra} Con{Piece.Sub{h, u, lo, hi}, rb}:
      Mst.cut(Con{Piece.Bind{k1, v1}, ra}, rb, sa, Piece.Sub{h, u, lo, hi} <> sb)
    case Con{Piece.Bind{+k1, +v1}, +ra} Con{Piece.Bind{+k2, +v2}, +rb}:
      +c = Key.cmp(k1, k2)
      Shared.Bool.when(
        Round,
        Cmp.is_lt(c),
        w => Mst.cut(ra, Con{Piece.Bind{k2, v2}, rb}, Piece.Bind{k1, v1} <> sa, sb),
        w => Shared.Bool.when(
          Round,
          Cmp.is_eq(c),
          w2 => Round.cons(
            Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)},
            Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], []))
          ),
          w2 => Mst.cut(Con{Piece.Bind{k1, v1}, ra}, rb, sa, Piece.Bind{k2, v2} <> sb)
        )
      )

# the runs as and bs without the pieces at their fronts that both share
def Mst.trim(as: List<&2, Piece>, bs: List<&2, Piece>) -> Runs:
  match as bs:
    case Con{+x, +ra} Con{+y, +rb}:
      Shared.Bool.when(Runs, Piece.same(x, y), u => Mst.trim(ra, rb), u => Runs{x <> ra, y <> rb})
    case xs ys:
      Runs{xs, ys}

# the runs r, read back to front
def Runs.reverse(r: Runs) -> Runs:
  match r:
    case Runs{a, b}:
      Runs{List.reverse(&2, Piece, a), List.reverse(&2, Piece, b)}

# the runs r without their front pieces that both share
def Runs.trim_front(r: Runs) -> Runs:
  match r:
    case Runs{a, b}:
      Mst.trim(a, b)

# the run p without the pieces at either end that both runs share
def Runs.trim(p: Runs) -> Runs:
  Runs.reverse(Runs.trim_front(Runs.reverse(Runs.trim_front(p))))

# the run ps holds a subtree
def Pieces.has_sub(ps: List<&2, Piece>) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{Piece.Sub{h, u, lo, hi}, rest}:
      True{}
    case Con{Piece.Bind{k, v}, rest}:
      Pieces.has_sub(rest)

# the keys of the bindings of the run ps, before ks
def Pieces.keys(ps: List<&2, Piece>, ks: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  match ps:
    case Nil{}:
      ks
    case Con{Piece.Bind{k, v}, rest}:
      k <> Pieces.keys(rest, ks)
    case Con{Piece.Sub{h, u, lo, hi}, rest}:
      Pieces.keys(rest, ks)

# the run ps with each subtree opened one level (none: a node does not read)
def Mst.open.all(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  ps: List<&2, Piece>
) -> Maybe<&2, List<&2, Piece>>:
  match ps:
    case Nil{}:
      Some{[]}
    case Con{Piece.Bind{k, v}, rest}:
      Maybe.map(
        &2,
        List<&2, Piece>,
        List<&2, Piece>,
        r => Piece.Bind{k, v} <> r,
        Mst.open.all(~S, ~fetch, s, rest)
      )
    case Con{Piece.Sub{h, u, lo, hi}, rest}:
      Maybe.bind(
        &2,
        List<&2, Piece>,
        List<&2, Piece>,
        Mst.open(~S, ~fetch, s, h, u, lo, hi),
        a => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          b => List.append(&2, Piece, a, b),
          Mst.open.all(~S, ~fetch, s, rest)
        )
      )

# a run between two cuts, trimmed (Runs.trim): the keys of its bindings, when
# neither side holds a subtree (no key there is in both trees); else the run
# with each subtree opened, to read on
def Mst.step.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  p: Runs
) -> Maybe<&2, Round>:
  match p:
    case Runs{+a, +b}:
      Shared.Bool.when(
        Maybe<&2, Round>,
        Bool.or(Pieces.has_sub(a), Pieces.has_sub(b)),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          Round,
          Mst.open.all(~S, ~fetch, s, a),
          a2 => Maybe.map(
            &2,
            List<&2, Piece>,
            Round,
            b2 => Round{[], [Runs{a2, b2}]},
            Mst.open.all(~S, ~fetch, s, b)
          )
        ),
        u => Some{Round{Pieces.keys(a, Pieces.keys(b, [])), []}}
      )

# the round of each of the runs ps between two cuts
def Mst.step(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  ps: List<&2, Runs>
) -> Maybe<&2, Round>:
  match ps:
    case Nil{}:
      Some{Round{[], []}}
    case Con{p, rest}:
      Maybe.bind(
        &2,
        Round,
        Round,
        Mst.step.at(~S, ~fetch, s, Runs.trim(p)),
        a => Maybe.map(&2, Round, Round, b => Round.append(a, b), Mst.step(~S, ~fetch, s, rest))
      )

# the keys that differ in each of the runs ps, at most f rounds on
def Mst.diff.go(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  ps: List<&2, Runs>
) -> Maybe<&2, List<&2, List<&2, U32>>>:
  match f ps:
    case x Nil{}:
      Some{[]}
    case 0n Con{p, rest}:
      None{}
    case 1n+(+q) Con{Runs{a, b}, rest}:
      +c = Mst.cut(a, b, [], [])
      Maybe.bind(
        &2,
        Round,
        List<&2, List<&2, U32>>,
        Mst.step(~S, ~fetch, s, Round.pairs(c)),
        +r => Maybe.bind(
          &2,
          List<&2, List<&2, U32>>,
          List<&2, List<&2, U32>>,
          Mst.diff.go(~S, ~fetch, q, s, Round.pairs(r)),
          k3 => Maybe.map(
            &2,
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            k4 => List.append(
              &2,
              List<&2, U32>,
              Round.keys(c),
              List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, s, rest)
          )
        )
      )

# the keys that the trees of the roots a and b read differently (none: the
# depot lacks a node on a path where they differ, or a node there is not in
# its one shape)
def Mst.diff(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  s: S,
  a: Maybe<&2, Hashes.Hash>,
  b: Maybe<&2, Hashes.Hash>
) -> Maybe<&2, List<&2, List<&2, U32>>>:
  Mst.diff.go(~S, ~fetch, Mst.depth(), s, [Runs{Mst.root(a), Mst.root(b)}])

# The tree
# --------

# the operations of a Merkle search tree in a depot kept as S, whose data is
# fetch
def Mst.ops(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>) -> Tree.Ops(S):
  (
    s => m => k => Mst.look(~S, ~fetch, s, m, k),
    (
      s => m => k => v => Mst.put(~S, ~fetch, s, m, k, v),
      (s => m => p => Mst.range(~S, ~fetch, s, m, p), s => a => b => Mst.diff(~S, ~fetch, s, a, b))
    )
  )

# Proofs of reads and writes
# --------------------------

# the value whose code m1 holds, m2 holds too, when m2 holds the words of m1
def Mst.whole_kept(
  m1: Maybe<&2, List<&2, U32>>,
  -m2: Maybe<&2, List<&2, U32>>,
  -n: Node,
  hm: @w: List<&2, U32> -> {m1 == Some{w}: Maybe<&2, List<&2, U32>>} -> {m2 == Some{w}: Maybe<&2, List<&2, U32>>}
) -> {
  Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, m1) == Some{n}: Maybe<&2, Node>
} -> {Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, m2) == Some{n}: Maybe<&2, Node>}:
  match m1:
    case None{}:
      e => Empty.absurd(
        {Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, m2) == Some{n}: Maybe<&2, Node>},
        Shared.Maybe.none_ne_some(Node, n, e)
      )
    case Some{w}:
      %Equal.sym(Maybe<&2, List<&2, U32>>, m2, Some{w}, hm(w)({==})): (
        {Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, Some{w}) == Some{n}: Maybe<&2, Node>}
          -> {Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, _) == Some{n}: Maybe<&2, Node>}
      )
      e => e

# a node that a depot gives, a depot that grows from it gives too
def Mst.node_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  +a: S,
  b: S,
  +h: Hashes.Hash,
  -n: Node,
  gr: {grows(a, b) == True{}: Bool}
) -> {Mst.node(~S, ~fetch, a, h) == Some{n}: Maybe<&2, Node>} -> {Mst.node(~S, ~fetch, b, h) == Some{n}: Maybe<&2, Node>}:
  Mst.whole_kept(fetch(a)(h), fetch(b)(h), n, w => e => kept(a)(b)(h)(w)(gr)(e))

# a node that a depot gives in a room, a depot that grows from it gives too
def Mst.node_in_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  +a: S,
  +b: S,
  +h: Hashes.Hash,
  +r: Room,
  -n: Node,
  gr: {grows(a, b) == True{}: Bool}
) -> {
  Mst.node.in(~S, ~fetch, a, h, r) == Some{n}: Maybe<&2, Node>
} -> {Mst.node.in(~S, ~fetch, b, h, r) == Some{n}: Maybe<&2, Node>}:
  Shared.Maybe.bind_kept(
    Node,
    Node,
    Mst.node(~S, ~fetch, a, h),
    Mst.node(~S, ~fetch, b, h),
    m => Node.in(m, r),
    m => Node.in(m, r),
    n,
    m => Mst.node_kept(~S, ~fetch, ~grows, ~kept, a, b, h, m, gr),
    m => e => e
  )

# what a pick tells, it tells with any reader of subtrees that tells the same
def Mst.look.pick_kept(
  p: Pick,
  -h: Hashes.Hash,
  -l: Nat,
  -k: List<&2, U32>,
  -goa: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -gob: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -x: Maybe<&2, List<&2, U32>>,
  hg: @m: Maybe<&2, Hashes.Hash> -> @r: Room -> {
    Look.known(goa(m)(r)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {Look.known(gob(m)(r)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
) -> {
  Look.known(Mst.look.pick(p, h, l, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.pick(p, h, l, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match p:
    case Pick.Hit{v}:
      e => e
    case Pick.Down{m, r}:
      hg(m)(r)

# what a read of a node tells, it tells of the same node, with a reader of
# subtrees that tells the same
def Mst.look.at_kept(
  -h: Hashes.Hash,
  na: Maybe<&2, Node>,
  r: Room,
  -nb: Maybe<&2, Node>,
  k: List<&2, U32>,
  -goa: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -gob: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -x: Maybe<&2, List<&2, U32>>,
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hg: @m: Maybe<&2, Hashes.Hash> -> @r2: Room -> {
    Look.known(goa(m)(r2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {Look.known(gob(m)(r2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
) -> {
  Look.known(Mst.look.at(h, na, r, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.at(h, nb, r, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match na r:
    case None{} r0:
      e => Empty.absurd(
        {Look.known(Mst.look.at(h, nb, r0, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case Some{Node{+l, +left, +xs}} Room{+up, +lo, +hi}:
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, hn(Node{l, left, xs})({==})): (
        {Look.known(Mst.look.at(h, Some{Node{l, left, xs}}, Room{up, lo, hi}, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.at(h, _, Room{up, lo, hi}, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      Mst.look.pick_kept(Mst.pick(xs, left, l, lo, hi, k), h, l, k, goa, gob, x, hg)

# what a read tells, a depot that grows from it tells too
def Mst.look.go_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +a: S,
  +b: S,
  +r: Room,
  +k: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +gr: {grows(a, b) == True{}: Bool}
) -> {
  Look.known(Mst.look.go(~S, ~fetch, f, a, r, m, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.go(~S, ~fetch, f, b, r, m, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match f m:
    case f0 None{}:
      e => e
    case 0n Some{h}:
      e => e
    case 1n+p Some{+h}:
      Mst.look.at_kept(
        h,
        Mst.node.in(~S, ~fetch, a, h, r),
        r,
        Mst.node.in(~S, ~fetch, b, h, r),
        k,
        m2 => r2 => Mst.look.go(~S, ~fetch, p, a, r2, m2, k),
        m2 => r2 => Mst.look.go(~S, ~fetch, p, b, r2, m2, k),
        x,
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, h, r, n, gr),
        m2 => r2 => Mst.look.go_kept(~S, ~fetch, ~grows, ~kept, p, m2, a, b, r2, k, x, gr)
      )

# a read ma that gives a value, mb gives too
def Mst.Kept(-A: Data, -ma: Maybe<&2, A>, -mb: Maybe<&2, A>) -> Type:
  @x: A -> {ma == Some{x}: Maybe<&2, A>} -> {mb == Some{x}: Maybe<&2, A>}

# a step F that gives nothing of nothing keeps what it reads kept
def Mst.kept.app(
  -A: Data,
  -B: Data,
  -F: Maybe<&2, A> -> Maybe<&2, B>,
  ma: Maybe<&2, A>,
  -mb: Maybe<&2, A>,
  hn: {F(None{}) == None{}: Maybe<&2, B>},
  hm: Mst.Kept(A, ma, mb)
) -> Mst.Kept(B, F(ma), F(mb)):
  match ma:
    case None{}:
      x => e => Empty.absurd(
        {F(mb) == Some{x}: Maybe<&2, B>},
        Shared.Maybe.none_ne_some(
          B,
          x,
          Equal.trans(Maybe<&2, B>, None{}, F(None{}), Some{x}, Equal.sym(Maybe<&2, B>, F(None{}), None{}, hn), e)
        )
      )
    case Some{+y}:
      %Equal.sym(Maybe<&2, A>, mb, Some{y}, hm(y)({==})): Mst.Kept(B, F(Some{y}), F(_))
      x => e => e

# a choice keeps what each of its branches keeps
def Mst.kept.when(
  -A: Data,
  b: Bool,
  -ka: Unit -> Maybe<&2, A>,
  -kb: Unit -> Maybe<&2, A>,
  -ea: Unit -> Maybe<&2, A>,
  -eb: Unit -> Maybe<&2, A>,
  hk: Mst.Kept(A, ka(Unit{}), kb(Unit{})),
  he: Mst.Kept(A, ea(Unit{}), eb(Unit{}))
) -> Mst.Kept(A, Shared.Bool.when(Maybe<&2, A>, b, ka, ea), Shared.Bool.when(Maybe<&2, A>, b, kb, eb)):
  match b:
    case True{}:
      hk
    case False{}:
      he

# a test that stays true keeps what its branch keeps
def Mst.kept.mwhen(
  -A: Data,
  ba: Bool,
  -bb: Bool,
  -ka: Unit -> Maybe<&2, A>,
  -kb: Unit -> Maybe<&2, A>,
  hb: {ba == True{}: Bool} -> {bb == True{}: Bool},
  hk: Mst.Kept(A, ka(Unit{}), kb(Unit{}))
) -> Mst.Kept(A, Shared.Maybe.when(A, ba, ka), Shared.Maybe.when(A, bb, kb)):
  match ba:
    case True{}:
      %Equal.sym(Bool, bb, True{}, hb({==})): Mst.Kept(A, ka(Unit{}), Shared.Maybe.when(A, _, kb))
      hk
    case False{}:
      x => e => Empty.absurd(
        {Shared.Maybe.when(A, bb, kb) == Some{x}: Maybe<&2, A>},
        Shared.Maybe.none_ne_some(A, x, e)
      )

# a read that finds a key absent tells that it is absent
def Look.absent_known(l: Look) -> {Look.is_absent(l) == True{}: Bool} -> {
  Look.known(l) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match l:
    case Look.Found{v}:
      e => Empty.absurd(
        {Look.known(Look.Found{v}) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Bool.false_ne_true(e)
      )
    case Look.Absent{}:
      e => {==}
    case Look.Missing{h}:
      e => Empty.absurd(
        {Look.known(Look.Missing{h}) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Bool.false_ne_true(e)
      )

# a read that tells that a key is absent finds it absent
def Look.known_absent(l: Look) -> {
  Look.known(l) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.is_absent(l) == True{}: Bool}:
  match l:
    case Look.Found{v}:
      e => Empty.absurd(
        {Look.is_absent(Look.Found{v}) == True{}: Bool},
        Shared.Maybe.none_ne_some(
          List<&2, U32>,
          v,
          Equal.sym(
            Maybe<&2, List<&2, U32>>,
            Some{v},
            None{},
            Shared.Maybe.some_inj(Maybe<&2, List<&2, U32>>, Some{v}, None{}, e)
          )
        )
      )
    case Look.Absent{}:
      e => {==}
    case Look.Missing{h}:
      e => Empty.absurd(
        {Look.is_absent(Look.Missing{h}) == True{}: Bool},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, None{}, e)
      )

# a read that finds a key absent, a depot that grows from it finds so too
def Mst.look.absent_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  +f: Nat,
  +m: Maybe<&2, Hashes.Hash>,
  +a: S,
  +b: S,
  +r: Room,
  +k: List<&2, U32>,
  +gr: {grows(a, b) == True{}: Bool}
) -> {
  Look.is_absent(Mst.look.go(~S, ~fetch, f, a, r, m, k)) == True{}: Bool
} -> {Look.is_absent(Mst.look.go(~S, ~fetch, f, b, r, m, k)) == True{}: Bool}:
  e => Look.known_absent(Mst.look.go(~S, ~fetch, f, b, r, m, k))(
    Mst.look.go_kept(~S, ~fetch, ~grows, ~kept, f, m, a, b, r, k, None{}, gr)(
      Look.absent_known(Mst.look.go(~S, ~fetch, f, a, r, m, k))(e)
    )
  )

# Mst.split.done keeps what the split of its gap keeps
def Mst.split.done_kept(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  p: Part,
  ma: Maybe<&2, Halves>,
  -mb: Maybe<&2, Halves>,
  hm: Mst.Kept(Halves, ma, mb)
) -> Mst.Kept(Halves, Mst.split.done(l, left, p, ma), Mst.split.done(l, left, p, mb)):
  match p:
    case Part{+b, +g, +a}:
      Mst.kept.app(Halves, Halves, m => Mst.split.done(l, left, Part{b, g, a}, m), ma, mb, {==}, hm)

# Mst.split.at keeps what its node and the splits below it keep
def Mst.split.at_kept(
  na: Maybe<&2, Node>,
  r: Room,
  -nb: Maybe<&2, Node>,
  +k: List<&2, U32>,
  goa: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  -gob: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hg: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Halves, goa(r2)(c), gob(r2)(c))
) -> Mst.Kept(Halves, Mst.split.at(na, r, k, goa), Mst.split.at(nb, r, k, gob)):
  match na r:
    case None{} r0:
      x => e => Empty.absurd(
        {Mst.split.at(nb, r0, k, gob) == Some{x}: Maybe<&2, Halves>},
        Shared.Maybe.none_ne_some(Halves, x, e)
      )
    case Some{Node{+l, +left, +xs}} Room{+up, +lo, +hi}:
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, hn(Node{l, left, xs})({==})): Mst.Kept(
        Halves,
        Mst.split.at(Some{Node{l, left, xs}}, Room{up, lo, hi}, k, goa),
        Mst.split.at(_, Room{up, lo, hi}, k, gob)
      )
      Mst.kept.when(
        Halves,
        Part.hits(Mst.part(xs, left, k, []), k),
        u => None{},
        u => None{},
        u => Mst.split.done(
          l,
          left,
          Mst.part(xs, left, k, []),
          goa(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        ),
        u => Mst.split.done(
          l,
          left,
          Mst.part(xs, left, k, []),
          gob(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        ),
        x => e => e,
        Mst.split.done_kept(
          l,
          left,
          Mst.part(xs, left, k, []),
          goa(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, []))),
          gob(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, []))),
          hg(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        )
      )

# a split that a depot gives, a depot that grows from it gives too
def Mst.split_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +a: S,
  +b: S,
  +r: Room,
  +k: List<&2, U32>,
  +gr: {grows(a, b) == True{}: Bool}
) -> Mst.Kept(Halves, Mst.split(~S, ~fetch, f, a, r, m, k), Mst.split(~S, ~fetch, f, b, r, m, k)):
  match f m:
    case f0 None{}:
      x => e => e
    case 0n Some{h}:
      x => e => e
    case 1n+(+p) Some{+h}:
      Mst.split.at_kept(
        Mst.node.in(~S, ~fetch, a, h, r),
        r,
        Mst.node.in(~S, ~fetch, b, h, r),
        k,
        r2 => c => Mst.split(~S, ~fetch, p, a, r2, c, k),
        r2 => c => Mst.split(~S, ~fetch, p, b, r2, c, k),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, h, r, n, gr),
        r2 => c => Mst.split_kept(~S, ~fetch, ~grows, ~kept, p, c, a, b, r2, k, gr)
      )

# an edge walk of a node that a depot gives keeps what the walk below keeps
def Mst.edge.left.at_kept(
  na: Maybe<&2, Node>,
  r: Room,
  -nb: Maybe<&2, Node>,
  -goa: Room -> Maybe<&2, Hashes.Hash> -> Bool,
  -gob: Room -> Maybe<&2, Hashes.Hash> -> Bool,
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hg: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> {goa(r2)(c) == True{}: Bool} -> {gob(r2)(c) == True{}: Bool}
) -> {Mst.edge.left.at(na, r, goa) == True{}: Bool} -> {Mst.edge.left.at(nb, r, gob) == True{}: Bool}:
  match na r:
    case None{} r0:
      e => Empty.absurd({Mst.edge.left.at(nb, r0, gob) == True{}: Bool}, Shared.Bool.false_ne_true(e))
    case Some{Node{+l, +left, +xs}} Room{+up, +lo, +hi}:
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, hn(Node{l, left, xs})({==})): (
        {Mst.edge.left.at(Some{Node{l, left, xs}}, Room{up, lo, hi}, goa) == True{}: Bool}
          -> {Mst.edge.left.at(_, Room{up, lo, hi}, gob) == True{}: Bool}
      )
      hg(Room.of(l, lo, Items.head_key(xs, hi)))(left)

# Mst.edge.left.at_kept, on the right edge
def Mst.edge.right.at_kept(
  na: Maybe<&2, Node>,
  r: Room,
  -nb: Maybe<&2, Node>,
  -goa: Room -> Maybe<&2, Hashes.Hash> -> Bool,
  -gob: Room -> Maybe<&2, Hashes.Hash> -> Bool,
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hg: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> {goa(r2)(c) == True{}: Bool} -> {gob(r2)(c) == True{}: Bool}
) -> {Mst.edge.right.at(na, r, goa) == True{}: Bool} -> {Mst.edge.right.at(nb, r, gob) == True{}: Bool}:
  match na r:
    case None{} r0:
      e => Empty.absurd({Mst.edge.right.at(nb, r0, gob) == True{}: Bool}, Shared.Bool.false_ne_true(e))
    case Some{Node{+l, +left, +xs}} Room{+up, +lo, +hi}:
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, hn(Node{l, left, xs})({==})): (
        {Mst.edge.right.at(Some{Node{l, left, xs}}, Room{up, lo, hi}, goa) == True{}: Bool}
          -> {Mst.edge.right.at(_, Room{up, lo, hi}, gob) == True{}: Bool}
      )
      hg(Room.of(l, Items.last_key(xs, lo), hi))(Mst.last(xs, left))

# an edge that a depot gives in its rooms, a depot that grows from it gives too
def Mst.edge_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  left: Bool,
  +a: S,
  +b: S,
  +r: Room,
  +gr: {grows(a, b) == True{}: Bool}
) -> {Mst.edge(~S, ~fetch, f, a, left, r, m) == True{}: Bool} -> {Mst.edge(~S, ~fetch, f, b, left, r, m) == True{}: Bool}:
  match f m left:
    case f0 None{} l0:
      e => e
    case 0n Some{h} l0:
      e => e
    case 1n+(+p) Some{+h} True{}:
      Mst.edge.left.at_kept(
        Mst.node.in(~S, ~fetch, a, h, r),
        r,
        Mst.node.in(~S, ~fetch, b, h, r),
        r2 => c => Mst.edge(~S, ~fetch, p, a, True{}, r2, c),
        r2 => c => Mst.edge(~S, ~fetch, p, b, True{}, r2, c),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, h, r, n, gr),
        r2 => c => Mst.edge_kept(~S, ~fetch, ~grows, ~kept, p, c, True{}, a, b, r2, gr)
      )
    case 1n+(+p) Some{+h} False{}:
      Mst.edge.right.at_kept(
        Mst.node.in(~S, ~fetch, a, h, r),
        r,
        Mst.node.in(~S, ~fetch, b, h, r),
        r2 => c => Mst.edge(~S, ~fetch, p, a, False{}, r2, c),
        r2 => c => Mst.edge(~S, ~fetch, p, b, False{}, r2, c),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, h, r, n, gr),
        r2 => c => Mst.edge_kept(~S, ~fetch, ~grows, ~kept, p, c, False{}, a, b, r2, gr)
      )

# Mst.merge.nodes keeps what the merge below it keeps
def Mst.merge.nodes_kept(
  c: Cmp,
  +ha: Hashes.Hash,
  ra: Room,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +hb: Hashes.Hash,
  rb: Room,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  goa: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -gob: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  hg: @r1: Room -> @r2: Room -> @x: Maybe<&2, Hashes.Hash> -> @y: Maybe<&2, Hashes.Hash> -> Mst.Kept(
    Edit,
    goa(r1)(r2)(x)(y),
    gob(r1)(r2)(x)(y)
  )
) -> Mst.Kept(
  Edit,
  Mst.merge.nodes(c, ha, ra, la, lefta, xa, hb, rb, lb, leftb, xb, goa),
  Mst.merge.nodes(c, ha, ra, la, lefta, xa, hb, rb, lb, leftb, xb, gob)
):
  match c ra rb:
    case GT{} Room{+ua, +loa, +hia} Room{+ub, +lob, +hib}:
      Mst.kept.app(
        Edit,
        Edit,
        e => Mst.with_last(la, lefta, xa, e),
        goa(Room.of(la, Items.last_key(xa, loa), hia))(Room{ub, lob, hib})(Mst.last(xa, lefta))(Some{hb}),
        gob(Room.of(la, Items.last_key(xa, loa), hia))(Room{ub, lob, hib})(Mst.last(xa, lefta))(Some{hb}),
        {==},
        hg(Room.of(la, Items.last_key(xa, loa), hia))(Room{ub, lob, hib})(Mst.last(xa, lefta))(Some{hb})
      )
    case LT{} Room{+ua, +loa, +hia} Room{+ub, +lob, +hib}:
      Mst.kept.app(
        Edit,
        Edit,
        e => Mst.with_first(lb, xb, e),
        goa(Room{ua, loa, hia})(Room.of(lb, lob, Items.head_key(xb, hib)))(Some{ha})(leftb),
        gob(Room{ua, loa, hia})(Room.of(lb, lob, Items.head_key(xb, hib)))(Some{ha})(leftb),
        {==},
        hg(Room{ua, loa, hia})(Room.of(lb, lob, Items.head_key(xb, hib)))(Some{ha})(leftb)
      )
    case EQ{} Room{+ua, +loa, +hia} Room{+ub, +lob, +hib}:
      Mst.kept.app(
        Edit,
        Edit,
        e => Mst.with_both(la, lefta, xa, xb, e),
        goa(Room.of(la, Items.last_key(xa, loa), hia))(Room.of(lb, lob, Items.head_key(xb, hib)))(Mst.last(xa, lefta))(leftb),
        gob(Room.of(la, Items.last_key(xa, loa), hia))(Room.of(lb, lob, Items.head_key(xb, hib)))(Mst.last(xa, lefta))(leftb),
        {==},
        hg(Room.of(la, Items.last_key(xa, loa), hia))(Room.of(lb, lob, Items.head_key(xb, hib)))(Mst.last(xa, lefta))(leftb)
      )

# Mst.merge.at keeps what its nodes and the merge below them keep
def Mst.merge.at_kept(
  na: Maybe<&2, Node>,
  nb: Maybe<&2, Node>,
  -na2: Maybe<&2, Node>,
  -nb2: Maybe<&2, Node>,
  +ha: Hashes.Hash,
  +ra: Room,
  +hb: Hashes.Hash,
  +rb: Room,
  goa: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -gob: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  hna: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {na2 == Some{n}: Maybe<&2, Node>},
  hnb: @n: Node -> {nb == Some{n}: Maybe<&2, Node>} -> {nb2 == Some{n}: Maybe<&2, Node>},
  hg: @r1: Room -> @r2: Room -> @x: Maybe<&2, Hashes.Hash> -> @y: Maybe<&2, Hashes.Hash> -> Mst.Kept(
    Edit,
    goa(r1)(r2)(x)(y),
    gob(r1)(r2)(x)(y)
  )
) -> Mst.Kept(Edit, Mst.merge.at(na, nb, ha, ra, hb, rb, goa), Mst.merge.at(na2, nb2, ha, ra, hb, rb, gob)):
  match na nb:
    case Some{Node{+la, +lefta, +xa}} Some{Node{+lb, +leftb, +xb}}:
      %Equal.sym(Maybe<&2, Node>, na2, Some{Node{la, lefta, xa}}, hna(Node{la, lefta, xa})({==})): Mst.Kept(
        Edit,
        Mst.merge.at(Some{Node{la, lefta, xa}}, Some{Node{lb, leftb, xb}}, ha, ra, hb, rb, goa),
        Mst.merge.at(_, nb2, ha, ra, hb, rb, gob)
      )
      %Equal.sym(Maybe<&2, Node>, nb2, Some{Node{lb, leftb, xb}}, hnb(Node{lb, leftb, xb})({==})): Mst.Kept(
        Edit,
        Mst.merge.at(Some{Node{la, lefta, xa}}, Some{Node{lb, leftb, xb}}, ha, ra, hb, rb, goa),
        Mst.merge.at(Some{Node{la, lefta, xa}}, _, ha, ra, hb, rb, gob)
      )
      Mst.merge.nodes_kept(Nat.cmp(la, lb), ha, ra, la, lefta, xa, hb, rb, lb, leftb, xb, goa, gob, hg)
    case Some{Node{la, lefta, xa}} None{}:
      x => e => Empty.absurd(
        {Mst.merge.at(na2, nb2, ha, ra, hb, rb, gob) == Some{x}: Maybe<&2, Edit>},
        Shared.Maybe.none_ne_some(Edit, x, e)
      )
    case None{} y0:
      x => e => Empty.absurd(
        {Mst.merge.at(na2, nb2, ha, ra, hb, rb, gob) == Some{x}: Maybe<&2, Edit>},
        Shared.Maybe.none_ne_some(Edit, x, e)
      )

# a merge that a depot gives, a depot that grows from it gives too
def Mst.merge_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  ma: Maybe<&2, Hashes.Hash>,
  mb: Maybe<&2, Hashes.Hash>,
  +a: S,
  +b: S,
  +ra: Room,
  +rb: Room,
  +gr: {grows(a, b) == True{}: Bool}
) -> Mst.Kept(Edit, Mst.merge(~S, ~fetch, f, a, ra, rb, ma, mb), Mst.merge(~S, ~fetch, f, b, ra, rb, ma, mb)):
  match f ma mb:
    case f0 None{} None{}:
      x => e => e
    case f0 None{} Some{+hb}:
      Mst.kept.mwhen(
        Edit,
        Mst.edge(~S, ~fetch, Mst.depth(), a, True{}, rb, Some{hb}),
        Mst.edge(~S, ~fetch, Mst.depth(), b, True{}, rb, Some{hb}),
        u => Some{Edit{Some{hb}, []}},
        u => Some{Edit{Some{hb}, []}},
        Mst.edge_kept(~S, ~fetch, ~grows, ~kept, Mst.depth(), Some{hb}, True{}, a, b, rb, gr),
        x => e => e
      )
    case f0 Some{+ha} None{}:
      Mst.kept.mwhen(
        Edit,
        Mst.edge(~S, ~fetch, Mst.depth(), a, False{}, ra, Some{ha}),
        Mst.edge(~S, ~fetch, Mst.depth(), b, False{}, ra, Some{ha}),
        u => Some{Edit{Some{ha}, []}},
        u => Some{Edit{Some{ha}, []}},
        Mst.edge_kept(~S, ~fetch, ~grows, ~kept, Mst.depth(), Some{ha}, False{}, a, b, ra, gr),
        x => e => e
      )
    case 0n Some{ha} Some{hb}:
      x => e => e
    case 1n+(+p) Some{+ha} Some{+hb}:
      Mst.merge.at_kept(
        Mst.node.in(~S, ~fetch, a, ha, ra),
        Mst.node.in(~S, ~fetch, a, hb, rb),
        Mst.node.in(~S, ~fetch, b, ha, ra),
        Mst.node.in(~S, ~fetch, b, hb, rb),
        ha,
        ra,
        hb,
        rb,
        r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, a, r1, r2, x, y),
        r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, b, r1, r2, x, y),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, ha, ra, n, gr),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, hb, rb, n, gr),
        r1 => r2 => x => y => Mst.merge_kept(~S, ~fetch, ~grows, ~kept, p, x, y, a, b, r1, r2, gr)
      )

# Mst.with_gap keeps what the edit of its gap keeps
def Mst.with_gap_kept(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  p: Part,
  ea: Maybe<&2, Edit>,
  -eb: Maybe<&2, Edit>,
  he: Mst.Kept(Edit, ea, eb)
) -> Mst.Kept(Edit, Mst.with_gap(l, left, p, ea), Mst.with_gap(l, left, p, eb)):
  match p:
    case Part{+b, +g, +a}:
      Mst.kept.app(Edit, Edit, e => Mst.with_gap(l, left, Part{b, g, a}, e), ea, eb, {==}, he)

# Mst.insert.gap keeps what the split of its gap keeps
def Mst.insert.gap_kept(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  p: Part,
  ma: Maybe<&2, Halves>,
  -mb: Maybe<&2, Halves>,
  hm: Mst.Kept(Halves, ma, mb)
) -> Mst.Kept(Edit, Mst.insert.gap(l, left, k, v, p, ma), Mst.insert.gap(l, left, k, v, p, mb)):
  match p:
    case Part{+b, +g, +a}:
      Mst.kept.app(Halves, Edit, m => Mst.insert.gap(l, left, k, v, Part{b, g, a}, m), ma, mb, {==}, hm)

# Mst.insert.here keeps what the split of its gap keeps
def Mst.insert.here_kept(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  p: Part,
  spa: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  -spb: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  hs: @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Halves, spa(c), spb(c))
) -> Mst.Kept(Edit, Mst.insert.here(l, left, k, v, p, spa), Mst.insert.here(l, left, k, v, p, spb)):
  match p:
    case Part{+b, +g, Con{Item{+ik, +iv, +r}, +rest}}:
      Mst.kept.when(
        Edit,
        Cmp.is_eq(Key.cmp(ik, k)),
        u => Some{Mst.store(Node{l, left, Mst.rejoin(b, g, Item{k, v, r} <> rest)}, [])},
        u => Some{Mst.store(Node{l, left, Mst.rejoin(b, g, Item{k, v, r} <> rest)}, [])},
        u => Mst.insert.gap(l, left, k, v, Part{b, g, Item{ik, iv, r} <> rest}, spa(g)),
        u => Mst.insert.gap(l, left, k, v, Part{b, g, Item{ik, iv, r} <> rest}, spb(g)),
        x => e => e,
        Mst.insert.gap_kept(l, left, k, v, Part{b, g, Item{ik, iv, r} <> rest}, spa(g), spb(g), hs(g))
      )
    case Part{+b, +g, Nil{}}:
      Mst.insert.gap_kept(l, left, k, v, Part{b, g, []}, spa(g), spb(g), hs(g))

# Mst.insert.node keeps what the splits and inserts below it keep
def Mst.insert.node_kept(
  c: Cmp,
  +h: Hashes.Hash,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +L: Nat,
  spa: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  -spb: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  spga: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  -spgb: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  insa: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -insb: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  hs: @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Halves, spa(c), spb(c)),
  hsg: @r: Room -> @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Halves, spga(r)(c), spgb(r)(c)),
  hins: @r: Room -> @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Edit, insa(r)(c), insb(r)(c))
) -> Mst.Kept(
  Edit,
  Mst.insert.node(c, h, l, left, xs, lo, hi, k, v, L, spa, spga, insa),
  Mst.insert.node(c, h, l, left, xs, lo, hi, k, v, L, spb, spgb, insb)
):
  match c:
    case LT{}:
      Mst.kept.app(Halves, Edit, m => Mst.insert.top(L, k, v, m), spa(Some{h}), spb(Some{h}), {==}, hs(Some{h}))
    case EQ{}:
      Mst.insert.here_kept(
        l,
        left,
        k,
        v,
        Mst.part(xs, left, k, []),
        spga(Part.room(Mst.part(xs, left, k, []), l, lo, hi)),
        spgb(Part.room(Mst.part(xs, left, k, []), l, lo, hi)),
        hsg(Part.room(Mst.part(xs, left, k, []), l, lo, hi))
      )
    case GT{}:
      Mst.kept.when(
        Edit,
        Part.hits(Mst.part(xs, left, k, []), k),
        u => None{},
        u => None{},
        u => Mst.with_gap(
          l,
          left,
          Mst.part(xs, left, k, []),
          insa(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        ),
        u => Mst.with_gap(
          l,
          left,
          Mst.part(xs, left, k, []),
          insb(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        ),
        x => e => e,
        Mst.with_gap_kept(
          l,
          left,
          Mst.part(xs, left, k, []),
          insa(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, []))),
          insb(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, []))),
          hins(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        )
      )

# Mst.insert.at keeps what its node and the writes below it keep
def Mst.insert.at_kept(
  na: Maybe<&2, Node>,
  r: Room,
  -nb: Maybe<&2, Node>,
  +h: Hashes.Hash,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +L: Nat,
  spa: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  -spb: Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  spga: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  -spgb: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Halves>,
  insa: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -insb: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hs: @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Halves, spa(c), spb(c)),
  hsg: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Halves, spga(r2)(c), spgb(r2)(c)),
  hins: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> Mst.Kept(Edit, insa(r2)(c), insb(r2)(c))
) -> Mst.Kept(
  Edit,
  Mst.insert.at(na, h, r, k, v, L, spa, spga, insa),
  Mst.insert.at(nb, h, r, k, v, L, spb, spgb, insb)
):
  match na r:
    case None{} r0:
      x => e => Empty.absurd(
        {Mst.insert.at(nb, h, r0, k, v, L, spb, spgb, insb) == Some{x}: Maybe<&2, Edit>},
        Shared.Maybe.none_ne_some(Edit, x, e)
      )
    case Some{Node{+l, +left, +xs}} Room{+up, +lo, +hi}:
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, hn(Node{l, left, xs})({==})): Mst.Kept(
        Edit,
        Mst.insert.at(Some{Node{l, left, xs}}, h, Room{up, lo, hi}, k, v, L, spa, spga, insa),
        Mst.insert.at(_, h, Room{up, lo, hi}, k, v, L, spb, spgb, insb)
      )
      Mst.insert.node_kept(Nat.cmp(l, L), h, l, left, xs, lo, hi, k, v, L, spa, spb, spga, spgb, insa, insb, hs, hsg, hins)

# an insert that a depot gives, a depot that grows from it gives too
def Mst.insert_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +a: S,
  +b: S,
  +r: Room,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +L: Nat,
  +gr: {grows(a, b) == True{}: Bool}
) -> Mst.Kept(Edit, Mst.insert(~S, ~fetch, f, a, r, m, k, v, L), Mst.insert(~S, ~fetch, f, b, r, m, k, v, L)):
  match f m:
    case f0 None{}:
      x => e => e
    case 0n Some{h}:
      x => e => e
    case 1n+(+p) Some{+h}:
      Mst.insert.at_kept(
        Mst.node.in(~S, ~fetch, a, h, r),
        r,
        Mst.node.in(~S, ~fetch, b, h, r),
        h,
        k,
        v,
        L,
        c => Mst.split(~S, ~fetch, p, a, r, c, k),
        c => Mst.split(~S, ~fetch, p, b, r, c, k),
        r2 => c => Mst.split(~S, ~fetch, p, a, r2, c, k),
        r2 => c => Mst.split(~S, ~fetch, p, b, r2, c, k),
        r2 => c => Mst.insert(~S, ~fetch, p, a, r2, c, k, v, L),
        r2 => c => Mst.insert(~S, ~fetch, p, b, r2, c, k, v, L),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, h, r, n, gr),
        c => Mst.split_kept(~S, ~fetch, ~grows, ~kept, p, c, a, b, r, k, gr),
        r2 => c => Mst.split_kept(~S, ~fetch, ~grows, ~kept, p, c, a, b, r2, k, gr),
        r2 => c => Mst.insert_kept(~S, ~fetch, ~grows, ~kept, p, c, a, b, r2, k, v, L, gr)
      )

# Mst.delete.none keeps what the read of its subtree keeps
def Mst.delete.none_kept(
  +h: Hashes.Hash,
  +r: Room,
  +m: Maybe<&2, Hashes.Hash>,
  lka: Room -> Maybe<&2, Hashes.Hash> -> Look,
  -lkb: Room -> Maybe<&2, Hashes.Hash> -> Look,
  hl: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> {Look.is_absent(lka(r2)(c)) == True{}: Bool} -> {
    Look.is_absent(lkb(r2)(c)) == True{}: Bool
  }
) -> Mst.Kept(Edit, Mst.delete.none(h, r, m, lka), Mst.delete.none(h, r, m, lkb)):
  Mst.kept.mwhen(
    Edit,
    Look.is_absent(lka(r)(m)),
    Look.is_absent(lkb(r)(m)),
    u => Some{Edit{Some{h}, []}},
    u => Some{Edit{Some{h}, []}},
    hl(r)(m),
    x => e => e
  )

# Mst.delete.lacks stays true with a read that keeps what it finds absent
def Mst.delete.lacks_kept(
  p: Pick,
  -lka: Room -> Maybe<&2, Hashes.Hash> -> Look,
  -lkb: Room -> Maybe<&2, Hashes.Hash> -> Look,
  hl: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> {Look.is_absent(lka(r2)(c)) == True{}: Bool} -> {
    Look.is_absent(lkb(r2)(c)) == True{}: Bool
  }
) -> {Mst.delete.lacks(p, lka) == True{}: Bool} -> {Mst.delete.lacks(p, lkb) == True{}: Bool}:
  match p:
    case Pick.Hit{v}:
      e => e
    case Pick.Down{m, r}:
      hl(r)(m)

# Mst.delete.here keeps what the merge and the read below it keep
def Mst.delete.here_kept(
  +h: Hashes.Hash,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  p: Part,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  mga: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -mgb: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  lka: Room -> Maybe<&2, Hashes.Hash> -> Look,
  -lkb: Room -> Maybe<&2, Hashes.Hash> -> Look,
  hm: @r1: Room -> @r2: Room -> @x: Maybe<&2, Hashes.Hash> -> @y: Maybe<&2, Hashes.Hash> -> Mst.Kept(
    Edit,
    mga(r1)(r2)(x)(y),
    mgb(r1)(r2)(x)(y)
  ),
  hl: @r2: Room -> @c: Maybe<&2, Hashes.Hash> -> {Look.is_absent(lka(r2)(c)) == True{}: Bool} -> {
    Look.is_absent(lkb(r2)(c)) == True{}: Bool
  }
) -> Mst.Kept(
  Edit,
  Mst.delete.here(h, l, left, k, p, lo, hi, mga, lka),
  Mst.delete.here(h, l, left, k, p, lo, hi, mgb, lkb)
):
  match p:
    case Part{+b, +g, Con{Item{+ik, +iv, +r}, +rest}}:
      Mst.kept.when(
        Edit,
        Cmp.is_eq(Key.cmp(ik, k)),
        u => Mst.with_gap(
          l,
          left,
          Part{b, g, rest},
          mga(Room.of(l, Items.head_key(b, lo), Some{ik}))(Room.of(l, Some{ik}, Items.head_key(rest, hi)))(g)(r)
        ),
        u => Mst.with_gap(
          l,
          left,
          Part{b, g, rest},
          mgb(Room.of(l, Items.head_key(b, lo), Some{ik}))(Room.of(l, Some{ik}, Items.head_key(rest, hi)))(g)(r)
        ),
        u => Mst.delete.none(h, Room.of(l, Items.head_key(b, lo), Some{ik}), g, lka),
        u => Mst.delete.none(h, Room.of(l, Items.head_key(b, lo), Some{ik}), g, lkb),
        Mst.with_gap_kept(
          l,
          left,
          Part{b, g, rest},
          mga(Room.of(l, Items.head_key(b, lo), Some{ik}))(Room.of(l, Some{ik}, Items.head_key(rest, hi)))(g)(r),
          mgb(Room.of(l, Items.head_key(b, lo), Some{ik}))(Room.of(l, Some{ik}, Items.head_key(rest, hi)))(g)(r),
          hm(Room.of(l, Items.head_key(b, lo), Some{ik}))(Room.of(l, Some{ik}, Items.head_key(rest, hi)))(g)(r)
        ),
        Mst.delete.none_kept(h, Room.of(l, Items.head_key(b, lo), Some{ik}), g, lka, lkb, hl)
      )
    case Part{+b, +g, Nil{}}:
      Mst.delete.none_kept(h, Room.of(l, Items.head_key(b, lo), hi), g, lka, lkb, hl)

# Mst.delete.node keeps what the merges, deletes and reads below it keep
def Mst.delete.node_kept(
  c: Cmp,
  +h: Hashes.Hash,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  mga: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -mgb: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  dela: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -delb: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  lka: Room -> Maybe<&2, Hashes.Hash> -> Look,
  -lkb: Room -> Maybe<&2, Hashes.Hash> -> Look,
  hm: @r1: Room -> @r2: Room -> @x: Maybe<&2, Hashes.Hash> -> @y: Maybe<&2, Hashes.Hash> -> Mst.Kept(
    Edit,
    mga(r1)(r2)(x)(y),
    mgb(r1)(r2)(x)(y)
  ),
  hd: @r2: Room -> @c2: Maybe<&2, Hashes.Hash> -> Mst.Kept(Edit, dela(r2)(c2), delb(r2)(c2)),
  hl: @r2: Room -> @c2: Maybe<&2, Hashes.Hash> -> {Look.is_absent(lka(r2)(c2)) == True{}: Bool} -> {
    Look.is_absent(lkb(r2)(c2)) == True{}: Bool
  }
) -> Mst.Kept(
  Edit,
  Mst.delete.node(c, h, l, left, xs, lo, hi, k, mga, dela, lka),
  Mst.delete.node(c, h, l, left, xs, lo, hi, k, mgb, delb, lkb)
):
  match c:
    case LT{}:
      Mst.kept.mwhen(
        Edit,
        Mst.delete.lacks(Mst.pick(xs, left, l, lo, hi, k), lka),
        Mst.delete.lacks(Mst.pick(xs, left, l, lo, hi, k), lkb),
        u => Some{Edit{Some{h}, []}},
        u => Some{Edit{Some{h}, []}},
        Mst.delete.lacks_kept(Mst.pick(xs, left, l, lo, hi, k), lka, lkb, hl),
        x => e => e
      )
    case EQ{}:
      Mst.delete.here_kept(h, l, left, k, Mst.part(xs, left, k, []), lo, hi, mga, mgb, lka, lkb, hm, hl)
    case GT{}:
      Mst.kept.when(
        Edit,
        Part.hits(Mst.part(xs, left, k, []), k),
        u => None{},
        u => None{},
        u => Mst.with_gap(
          l,
          left,
          Mst.part(xs, left, k, []),
          dela(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        ),
        u => Mst.with_gap(
          l,
          left,
          Mst.part(xs, left, k, []),
          delb(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        ),
        x => e => e,
        Mst.with_gap_kept(
          l,
          left,
          Mst.part(xs, left, k, []),
          dela(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, []))),
          delb(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, []))),
          hd(Part.room(Mst.part(xs, left, k, []), l, lo, hi))(Part.gap(Mst.part(xs, left, k, [])))
        )
      )

# Mst.delete.at keeps what its node and the steps below it keep
def Mst.delete.at_kept(
  na: Maybe<&2, Node>,
  r: Room,
  -nb: Maybe<&2, Node>,
  +h: Hashes.Hash,
  +k: List<&2, U32>,
  +L: Nat,
  mga: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -mgb: Room -> Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  dela: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  -delb: Room -> Maybe<&2, Hashes.Hash> -> Maybe<&2, Edit>,
  lka: Room -> Maybe<&2, Hashes.Hash> -> Look,
  -lkb: Room -> Maybe<&2, Hashes.Hash> -> Look,
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hm: @r1: Room -> @r2: Room -> @x: Maybe<&2, Hashes.Hash> -> @y: Maybe<&2, Hashes.Hash> -> Mst.Kept(
    Edit,
    mga(r1)(r2)(x)(y),
    mgb(r1)(r2)(x)(y)
  ),
  hd: @r2: Room -> @c2: Maybe<&2, Hashes.Hash> -> Mst.Kept(Edit, dela(r2)(c2), delb(r2)(c2)),
  hl: @r2: Room -> @c2: Maybe<&2, Hashes.Hash> -> {Look.is_absent(lka(r2)(c2)) == True{}: Bool} -> {
    Look.is_absent(lkb(r2)(c2)) == True{}: Bool
  }
) -> Mst.Kept(
  Edit,
  Mst.delete.at(na, h, r, k, L, mga, dela, lka),
  Mst.delete.at(nb, h, r, k, L, mgb, delb, lkb)
):
  match na r:
    case None{} r0:
      x => e => Empty.absurd(
        {Mst.delete.at(nb, h, r0, k, L, mgb, delb, lkb) == Some{x}: Maybe<&2, Edit>},
        Shared.Maybe.none_ne_some(Edit, x, e)
      )
    case Some{Node{+l, +left, +xs}} Room{+up, +lo, +hi}:
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, hn(Node{l, left, xs})({==})): Mst.Kept(
        Edit,
        Mst.delete.at(Some{Node{l, left, xs}}, h, Room{up, lo, hi}, k, L, mga, dela, lka),
        Mst.delete.at(_, h, Room{up, lo, hi}, k, L, mgb, delb, lkb)
      )
      Mst.delete.node_kept(Nat.cmp(l, L), h, l, left, xs, lo, hi, k, mga, mgb, dela, delb, lka, lkb, hm, hd, hl)

# a delete that a depot gives, a depot that grows from it gives too
def Mst.delete_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +a: S,
  +b: S,
  +r: Room,
  +k: List<&2, U32>,
  +L: Nat,
  +gr: {grows(a, b) == True{}: Bool}
) -> Mst.Kept(Edit, Mst.delete(~S, ~fetch, f, a, r, m, k, L), Mst.delete(~S, ~fetch, f, b, r, m, k, L)):
  match f m:
    case f0 None{}:
      x => e => e
    case 0n Some{h}:
      x => e => e
    case 1n+(+p) Some{+h}:
      Mst.delete.at_kept(
        Mst.node.in(~S, ~fetch, a, h, r),
        r,
        Mst.node.in(~S, ~fetch, b, h, r),
        h,
        k,
        L,
        r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, a, r1, r2, x, y),
        r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, b, r1, r2, x, y),
        r2 => c => Mst.delete(~S, ~fetch, p, a, r2, c, k, L),
        r2 => c => Mst.delete(~S, ~fetch, p, b, r2, c, k, L),
        r2 => c => Mst.look.go(~S, ~fetch, p, a, r2, c, k),
        r2 => c => Mst.look.go(~S, ~fetch, p, b, r2, c, k),
        n => Mst.node_in_kept(~S, ~fetch, ~grows, ~kept, a, b, h, r, n, gr),
        r1 => r2 => x => y => Mst.merge_kept(~S, ~fetch, ~grows, ~kept, p, x, y, a, b, r1, r2, gr),
        r2 => c => Mst.delete_kept(~S, ~fetch, ~grows, ~kept, p, c, a, b, r2, k, L, gr),
        r2 => c => Mst.look.absent_kept(~S, ~fetch, ~grows, ~kept, p, c, a, b, r2, k, gr)
      )

# a write that a depot gives, a depot that grows from it gives too
def Mst.put_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  m2: Maybe<&2, List<&2, U32>>,
  +a: S,
  +b: S,
  +h: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +gr: {grows(a, b) == True{}: Bool}
) -> Mst.Kept(Edit, Mst.put(~S, ~fetch, a, h, k, m2), Mst.put(~S, ~fetch, b, h, k, m2)):
  match m2:
    case Some{v}:
      Mst.insert_kept(~S, ~fetch, ~grows, ~kept, Mst.depth(), h, a, b, Room.top(), k, v, Key.level(k), gr)
    case None{}:
      Mst.delete_kept(~S, ~fetch, ~grows, ~kept, Mst.depth(), h, a, b, Room.top(), k, Key.level(k), gr)

# Proofs of writes
# ----------------

# the comparison c the other way round
def Mst.flip(c: Cmp) -> Cmp:
  match c:
    case LT{}:
      GT{}
    case EQ{}:
      EQ{}
    case GT{}:
      LT{}

# a comparison that is LT is LT
def Mst.lt_sound(c: Cmp) -> {Cmp.is_lt(c) == True{}: Bool} -> {c == LT{}: Cmp}:
  match c:
    case LT{}:
      e => {==}
    case EQ{}:
      e => Empty.absurd({EQ{} == LT{}: Cmp}, Shared.Bool.false_ne_true(e))
    case GT{}:
      e => Empty.absurd({GT{} == LT{}: Cmp}, Shared.Bool.false_ne_true(e))

# no comparison is two of LT, EQ and GT
def Mst.cmp_disc(c: Cmp) -> Type:
  match c:
    case LT{}:
      Unit
    case EQ{}:
      Empty
    case GT{}:
      Empty

# LT is not EQ
def Mst.lt_ne_eq(e: {LT{} == EQ{}: Cmp}) -> Empty:
  %e: Mst.cmp_disc(_)
  Unit{}

# LT is not GT
def Mst.lt_ne_gt(e: {LT{} == GT{}: Cmp}) -> Empty:
  %e: Mst.cmp_disc(_)
  Unit{}

# EQ is not GT
def Mst.eq_ne_gt(e: {EQ{} == GT{}: Cmp}) -> Empty:
  %Equal.sym(Cmp, EQ{}, GT{}, e): Mst.cmp_disc(Mst.flip(_))
  Unit{}

# a comparison of numbers the other way round is flipped
def Mst.nat_flip(a: Nat, b: Nat) -> {Nat.cmp(b, a) == Mst.flip(Nat.cmp(a, b)): Cmp}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      Mst.nat_flip(p, q)

# numbers that compare EQ are equal
def Mst.nat_eq(a: Nat, b: Nat) -> {Nat.cmp(a, b) == EQ{}: Cmp} -> {a == b: Nat}:
  match a b:
    case 0n 0n:
      e => {==}
    case 0n 1n+q:
      e => Empty.absurd({0n == 1n+q: Nat}, Mst.lt_ne_eq(e))
    case 1n+p 0n:
      e => Empty.absurd({1n+p == 0n: Nat}, Mst.eq_ne_gt(Equal.sym(Cmp, GT{}, EQ{}, e)))
    case 1n+p 1n+q:
      e => Equal.cong(Nat, Nat, n => 1n+n, p, q, Mst.nat_eq(p, q)(e))

# LT on numbers is transitive
def Mst.nat_trans(a: Nat, b: Nat, c: Nat) -> {Nat.cmp(a, b) == LT{}: Cmp} -> {Nat.cmp(b, c) == LT{}: Cmp} -> {
  Nat.cmp(a, c) == LT{}: Cmp
}:
  match a b c:
    case 0n 0n z:
      e1 => e2 => Empty.absurd({Nat.cmp(0n, z) == LT{}: Cmp}, Mst.lt_ne_eq(Equal.sym(Cmp, EQ{}, LT{}, e1)))
    case 0n 1n+q 0n:
      e1 => e2 => Empty.absurd({Nat.cmp(0n, 0n) == LT{}: Cmp}, Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e2)))
    case 0n 1n+q 1n+r:
      e1 => e2 => {==}
    case 1n+p 0n z:
      e1 => e2 => Empty.absurd({Nat.cmp(1n+p, z) == LT{}: Cmp}, Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e1)))
    case 1n+p 1n+q 0n:
      e1 => e2 => Empty.absurd({Nat.cmp(1n+p, 0n) == LT{}: Cmp}, Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e2)))
    case 1n+p 1n+q 1n+r:
      Mst.nat_trans(p, q, r)

# a comparison of words the other way round is flipped
def Mst.u32_flip(+x: U32, +y: U32) -> {U32.cmp(y, x) == Mst.flip(U32.cmp(x, y)): Cmp}:
  %Equal.sym(Cmp, U32.cmp(y, x), Nat.cmp(U32.to_nat(y), U32.to_nat(x)), Shared.U32.cmp_to_nat(y, x)): {
    _ == Mst.flip(U32.cmp(x, y)): Cmp
  }
  %Equal.sym(Cmp, U32.cmp(x, y), Nat.cmp(U32.to_nat(x), U32.to_nat(y)), Shared.U32.cmp_to_nat(x, y)): {
    Nat.cmp(U32.to_nat(y), U32.to_nat(x)) == Mst.flip(_): Cmp
  }
  Mst.nat_flip(U32.to_nat(x), U32.to_nat(y))

# words that compare EQ are equal
def Mst.u32_eq(+x: U32, +y: U32) -> {U32.cmp(x, y) == EQ{}: Cmp} -> {x == y: U32}:
  e => Shared.U32.is_eq_sound(x, y)(Equal.cong(Cmp, Bool, Cmp.is_eq, U32.cmp(x, y), EQ{}, e))

# LT on words is transitive
def Mst.u32_trans(+x: U32, +y: U32, +z: U32) -> {U32.cmp(x, y) == LT{}: Cmp} -> {U32.cmp(y, z) == LT{}: Cmp} -> {
  U32.cmp(x, z) == LT{}: Cmp
}:
  e1 => e2 => Equal.trans(
    Cmp,
    U32.cmp(x, z),
    Nat.cmp(U32.to_nat(x), U32.to_nat(z)),
    LT{},
    Shared.U32.cmp_to_nat(x, z),
    Mst.nat_trans(U32.to_nat(x), U32.to_nat(y), U32.to_nat(z))(
      Equal.trans(
        Cmp,
        Nat.cmp(U32.to_nat(x), U32.to_nat(y)),
        U32.cmp(x, y),
        LT{},
        Equal.sym(Cmp, U32.cmp(x, y), Nat.cmp(U32.to_nat(x), U32.to_nat(y)), Shared.U32.cmp_to_nat(x, y)),
        e1
      )
    )(
      Equal.trans(
        Cmp,
        Nat.cmp(U32.to_nat(y), U32.to_nat(z)),
        U32.cmp(y, z),
        LT{},
        Equal.sym(Cmp, U32.cmp(y, z), Nat.cmp(U32.to_nat(y), U32.to_nat(z)), Shared.U32.cmp_to_nat(y, z)),
        e2
      )
    )
  )

# a word compares EQ to itself
def Mst.u32_refl(x: U32) -> {U32.cmp(x, x) == EQ{}: Cmp}:
  Shared.U32.cmp_refl(x)

# Key.cmp of two lists that start with x and y, once x compares to y as c
def Mst.key_step(+c: Cmp, ra: List<&2, U32>, rb: List<&2, U32>) -> Cmp:
  Shared.Bool.when(Cmp, Cmp.is_eq(c), u => Key.cmp(ra, rb), u => c)

# a key step flips with its parts
def Mst.key_flip.step(c: Cmp, k: Cmp, -kf: Cmp, e: {kf == Mst.flip(k): Cmp}) -> {
  Shared.Bool.when(Cmp, Cmp.is_eq(Mst.flip(c)), u => kf, u => Mst.flip(c))
    == Mst.flip(Shared.Bool.when(Cmp, Cmp.is_eq(c), u => k, u => c)): Cmp
}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      e
    case GT{}:
      {==}

# a comparison of keys the other way round is flipped
def Mst.key_flip(a: List<&2, U32>, b: List<&2, U32>) -> {Key.cmp(b, a) == Mst.flip(Key.cmp(a, b)): Cmp}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{y, rb}:
      {==}
    case Con{x, ra} Nil{}:
      {==}
    case Con{+x, +ra} Con{+y, +rb}:
      %Equal.sym(Cmp, U32.cmp(y, x), Mst.flip(U32.cmp(x, y)), Mst.u32_flip(x, y)): {
        Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(rb, ra), u => _)
          == Mst.flip(Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, y)), u => Key.cmp(ra, rb), u => U32.cmp(x, y))): Cmp
      }
      Mst.key_flip.step(U32.cmp(x, y), Key.cmp(ra, rb), Key.cmp(rb, ra), Mst.key_flip(ra, rb))

# Mst.key_eq once x compares to y as c
def Mst.key_eq.step(
  c: Cmp,
  +x: U32,
  +y: U32,
  -ra: List<&2, U32>,
  -rb: List<&2, U32>,
  ec: {U32.cmp(x, y) == c: Cmp},
  ih: {Key.cmp(ra, rb) == EQ{}: Cmp} -> {ra == rb: List<&2, U32>}
) -> {Shared.Bool.when(Cmp, Cmp.is_eq(c), u => Key.cmp(ra, rb), u => c) == EQ{}: Cmp} -> {
  x <> ra == y <> rb: List<&2, U32>
}:
  match c:
    case LT{}:
      e => Empty.absurd({x <> ra == y <> rb: List<&2, U32>}, Mst.lt_ne_eq(e))
    case EQ{}:
      e =>
        %Mst.u32_eq(x, y)(ec): {x <> ra == _ <> rb: List<&2, U32>}
        %ih(e): {x <> ra == x <> _: List<&2, U32>}
        {==}
    case GT{}:
      e => Empty.absurd({x <> ra == y <> rb: List<&2, U32>}, Mst.eq_ne_gt(Equal.sym(Cmp, GT{}, EQ{}, e)))

# keys that compare EQ are equal
def Mst.key_eq(a: List<&2, U32>, b: List<&2, U32>) -> {Key.cmp(a, b) == EQ{}: Cmp} -> {a == b: List<&2, U32>}:
  match a b:
    case Nil{} Nil{}:
      e => {==}
    case Nil{} Con{y, rb}:
      e => Empty.absurd({Nil{} == y <> rb: List<&2, U32>}, Mst.lt_ne_eq(e))
    case Con{x, ra} Nil{}:
      e => Empty.absurd({x <> ra == Nil{}: List<&2, U32>}, Mst.eq_ne_gt(Equal.sym(Cmp, GT{}, EQ{}, e)))
    case Con{+x, +ra} Con{+y, +rb}:
      Mst.key_eq.step(U32.cmp(x, y), x, y, ra, rb, {==}, Mst.key_eq(ra, rb))

# a key compares EQ to itself
def Mst.key_refl(a: List<&2, U32>) -> {Key.cmp(a, a) == EQ{}: Cmp}:
  match a:
    case Nil{}:
      {==}
    case Con{+x, +ra}:
      %Equal.sym(Cmp, U32.cmp(x, x), EQ{}, Mst.u32_refl(x)): {
        Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(ra, ra), u => _) == EQ{}: Cmp
      }
      Mst.key_refl(ra)

# Mst.key_trans once the heads compare as cxy, cyz and cxz
def Mst.key_trans.step(
  cxy: Cmp,
  cyz: Cmp,
  +x: U32,
  +y: U32,
  +z: U32,
  -ra: List<&2, U32>,
  -rb: List<&2, U32>,
  -rc: List<&2, U32>,
  exy: {U32.cmp(x, y) == cxy: Cmp},
  eyz: {U32.cmp(y, z) == cyz: Cmp},
  ih: {Key.cmp(ra, rb) == LT{}: Cmp} -> {Key.cmp(rb, rc) == LT{}: Cmp} -> {Key.cmp(ra, rc) == LT{}: Cmp}
) -> {Mst.key_step(cxy, ra, rb) == LT{}: Cmp} -> {Mst.key_step(cyz, rb, rc) == LT{}: Cmp} -> {
  Mst.key_step(U32.cmp(x, z), ra, rc) == LT{}: Cmp
}:
  match cxy cyz:
    case LT{} LT{}:
      e1 => e2 =>
        %Equal.sym(Cmp, U32.cmp(x, z), LT{}, Mst.u32_trans(x, y, z)(exy)(eyz)): {Mst.key_step(_, ra, rc) == LT{}: Cmp}
        {==}
    case LT{} EQ{}:
      e1 => e2 =>
        %Mst.u32_eq(y, z)(eyz): {Mst.key_step(U32.cmp(x, _), ra, rc) == LT{}: Cmp}
        %Equal.sym(Cmp, U32.cmp(x, y), LT{}, exy): {Mst.key_step(_, ra, rc) == LT{}: Cmp}
        {==}
    case EQ{} LT{}:
      e1 => e2 =>
        %Equal.sym(U32, x, y, Mst.u32_eq(x, y)(exy)): {Mst.key_step(U32.cmp(_, z), ra, rc) == LT{}: Cmp}
        %Equal.sym(Cmp, U32.cmp(y, z), LT{}, eyz): {Mst.key_step(_, ra, rc) == LT{}: Cmp}
        {==}
    case EQ{} EQ{}:
      e1 => e2 =>
        %Equal.sym(U32, x, y, Mst.u32_eq(x, y)(exy)): {Mst.key_step(U32.cmp(_, z), ra, rc) == LT{}: Cmp}
        %Equal.sym(U32, y, z, Mst.u32_eq(y, z)(eyz)): {Mst.key_step(U32.cmp(_, z), ra, rc) == LT{}: Cmp}
        %Equal.sym(Cmp, U32.cmp(z, z), EQ{}, Mst.u32_refl(z)): {Mst.key_step(_, ra, rc) == LT{}: Cmp}
        ih(e1)(e2)
    case GT{} c2:
      e1 => e2 => Empty.absurd(
        {Mst.key_step(U32.cmp(x, z), ra, rc) == LT{}: Cmp},
        Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e1))
      )
    case LT{} GT{}:
      e1 => e2 => Empty.absurd(
        {Mst.key_step(U32.cmp(x, z), ra, rc) == LT{}: Cmp},
        Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e2))
      )
    case EQ{} GT{}:
      e1 => e2 => Empty.absurd(
        {Mst.key_step(U32.cmp(x, z), ra, rc) == LT{}: Cmp},
        Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e2))
      )

# LT on keys is transitive
def Mst.key_trans(a: List<&2, U32>, b: List<&2, U32>, c: List<&2, U32>) -> {Key.cmp(a, b) == LT{}: Cmp} -> {
  Key.cmp(b, c) == LT{}: Cmp
} -> {Key.cmp(a, c) == LT{}: Cmp}:
  match a b c:
    case Nil{} Nil{} z:
      e1 => e2 => Empty.absurd({Key.cmp(Nil{}, z) == LT{}: Cmp}, Mst.lt_ne_eq(Equal.sym(Cmp, EQ{}, LT{}, e1)))
    case Nil{} Con{y, rb} Nil{}:
      e1 => e2 => Empty.absurd({Key.cmp(Nil{}, Nil{}) == LT{}: Cmp}, Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e2)))
    case Nil{} Con{y, rb} Con{z, rc}:
      e1 => e2 => {==}
    case Con{x, ra} Nil{} z:
      e1 => e2 => Empty.absurd({Key.cmp(x <> ra, z) == LT{}: Cmp}, Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e1)))
    case Con{x, ra} Con{y, rb} Nil{}:
      e1 => e2 => Empty.absurd({Key.cmp(x <> ra, Nil{}) == LT{}: Cmp}, Mst.lt_ne_gt(Equal.sym(Cmp, GT{}, LT{}, e2)))
    case Con{+x, +ra} Con{+y, +rb} Con{+z, +rc}:
      Mst.key_trans.step(U32.cmp(x, y), U32.cmp(y, z), x, y, z, ra, rb, rc, {==}, {==}, Mst.key_trans(ra, rb, rc))

# Key.is_lt is the LT of Key.cmp, once x compares to y as c
def Mst.key_lt.step(c: Cmp, -k: Cmp, -b: Bool, e: {Cmp.is_lt(k) == b: Bool}) -> {
  Cmp.is_lt(Shared.Bool.when(Cmp, Cmp.is_eq(c), u => k, u => c)) == Bool.or(Cmp.is_lt(c), Bool.and(Cmp.is_eq(c), b)): Bool
}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      e
    case GT{}:
      {==}

# Key.is_lt is the LT of Key.cmp
def Mst.key_lt(a: List<&2, U32>, b: List<&2, U32>) -> {Cmp.is_lt(Key.cmp(a, b)) == Key.is_lt(a, b): Bool}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{y, rb}:
      {==}
    case Con{x, ra} Nil{}:
      {==}
    case Con{+x, +ra} Con{+y, +rb}:
      Mst.key_lt.step(U32.cmp(x, y), Key.cmp(ra, rb), Key.is_lt(ra, rb), Mst.key_lt(ra, rb))

# a key before another compares LT
def Mst.key_lt_of(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.is_lt(a, b) == True{}: Bool} -> {Key.cmp(a, b) == LT{}: Cmp}:
  e => Mst.lt_sound(Key.cmp(a, b))(Equal.trans(Bool, Cmp.is_lt(Key.cmp(a, b)), Key.is_lt(a, b), True{}, Mst.key_lt(a, b), e))

# a key that compares LT is before
def Mst.key_is_lt(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.cmp(a, b) == LT{}: Cmp} -> {Key.is_lt(a, b) == True{}: Bool}:
  e =>
    %Mst.key_lt(a, b): {_ == True{}: Bool}
    %Equal.sym(Cmp, Key.cmp(a, b), LT{}, e): {Cmp.is_lt(_) == True{}: Bool}
    {==}

# a key that compares GT to another is after it
def Mst.key_gt_lt(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.cmp(a, b) == GT{}: Cmp} -> {Key.cmp(b, a) == LT{}: Cmp}:
  e =>
    %Equal.sym(Cmp, Key.cmp(b, a), Mst.flip(Key.cmp(a, b)), Mst.key_flip(a, b)): {_ == LT{}: Cmp}
    %Equal.sym(Cmp, Key.cmp(a, b), GT{}, e): {Mst.flip(_) == LT{}: Cmp}
    {==}

# a key that compares LT to another, the other compares GT to it
def Mst.key_lt_gt(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.cmp(a, b) == LT{}: Cmp} -> {Key.cmp(b, a) == GT{}: Cmp}:
  e =>
    %Equal.sym(Cmp, Key.cmp(b, a), Mst.flip(Key.cmp(a, b)), Mst.key_flip(a, b)): {_ == GT{}: Cmp}
    %Equal.sym(Cmp, Key.cmp(a, b), LT{}, e): {Mst.flip(_) == GT{}: Cmp}
    {==}

# Shared.List.is_eq calls a key the same as one equal to it
def Mst.key_ne.of(+k: List<&2, U32>, -k2: List<&2, U32>, e: {k2 == k: List<&2, U32>}) -> {
  True{} == Shared.List.is_eq(~U32, ~U32.is_eq, k, k2): Bool
}:
  %Equal.sym(List<&2, U32>, k2, k, e): {True{} == Shared.List.is_eq(~U32, ~U32.is_eq, k, _): Bool}
  Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, k, k), True{}, Shared.List.is_eq_refl(~U32, ~U32.is_eq, ~Shared.U32.laws(), k))

# two keys that Shared.List.is_eq calls different do not compare EQ
def Mst.key_ne(+k: List<&2, U32>, +k2: List<&2, U32>) -> {
  Shared.List.is_eq(~U32, ~U32.is_eq, k, k2) == False{}: Bool
} -> {Key.cmp(k2, k) == EQ{}: Cmp} -> Empty:
  ne => e =>
    Shared.Bool.true_ne_false(
      Equal.trans(
        Bool,
        True{},
        Shared.List.is_eq(~U32, ~U32.is_eq, k, k2),
        False{},
        Mst.key_ne.of(k, k2, Mst.key_eq(k2, k)(e)),
        ne
      )
    )

# what holds of each value of a bit holds of the bit
def Mst.case_bool(
  -P: Bool -> Type,
  b: Bool,
  pt: {b == True{}: Bool} -> P(True{}),
  pf: {b == False{}: Bool} -> P(False{})
) -> P(b):
  match b:
    case True{}:
      pt({==})
    case False{}:
      pf({==})

# what holds of each value of a comparison holds of the comparison
def Mst.case_cmp(
  -P: Cmp -> Type,
  c: Cmp,
  plt: {c == LT{}: Cmp} -> P(LT{}),
  peq: {c == EQ{}: Cmp} -> P(EQ{}),
  pgt: {c == GT{}: Cmp} -> P(GT{})
) -> P(c):
  match c:
    case LT{}:
      plt({==})
    case EQ{}:
      peq({==})
    case GT{}:
      pgt({==})

# a comparison that is GT is GT
def Mst.gt_sound(c: Cmp) -> {Cmp.is_gt(c) == True{}: Bool} -> {c == GT{}: Cmp}:
  match c:
    case LT{}:
      e => Empty.absurd({LT{} == GT{}: Cmp}, Shared.Bool.false_ne_true(e))
    case EQ{}:
      e => Empty.absurd({EQ{} == GT{}: Cmp}, Shared.Bool.false_ne_true(e))
    case GT{}:
      e => {==}

# every key of the items xs compares LT to k
def Mst.all_lt(xs: List<&2, Item>, +k: List<&2, U32>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{Item{ik, iv, r}, rest}:
      Bool.and(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k))

# k2 compares GT to every key of the items xs: a pick of k2 passes them
def Mst.passes(xs: List<&2, Item>, +k2: List<&2, U32>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{Item{ik, iv, r}, rest}:
      Bool.and(Cmp.is_gt(Key.cmp(k2, ik)), Mst.passes(rest, k2))

# a pick of k2 among the items ys stops at once: there is none, or k2 comes
# before the first
def Mst.stops_first(ys: List<&2, Item>, k2: List<&2, U32>) -> Bool:
  match ys:
    case Nil{}:
      True{}
    case Con{Item{ik, iv, r}, rest}:
      Cmp.is_lt(Key.cmp(k2, ik))

# the lower bound lo2 is at or below lo1 (none: no bound)
def Mst.lo_le(+lo2: Maybe<&2, List<&2, U32>>, +lo1: Maybe<&2, List<&2, U32>>) -> Bool:
  match lo2 lo1:
    case None{} y:
      True{}
    case Some{a2} None{}:
      False{}
    case Some{a2} Some{a1}:
      Cmp.is_le(Key.cmp(a2, a1))

# the upper bound hi2 is at or above hi1 (none: no bound)
def Mst.hi_le(+hi1: Maybe<&2, List<&2, U32>>, +hi2: Maybe<&2, List<&2, U32>>) -> Bool:
  match hi1 hi2:
    case x None{}:
      True{}
    case None{} Some{b2}:
      False{}
    case Some{b1} Some{b2}:
      Cmp.is_le(Key.cmp(b1, b2))

# a at or below b, and b before c: a before c
def Mst.key_le_lt(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {
  Cmp.is_le(Key.cmp(a, b)) == True{}: Bool
} -> {Key.cmp(b, c) == LT{}: Cmp} -> {Key.cmp(a, c) == LT{}: Cmp}:
  Mst.case_cmp(
    t => {Key.cmp(a, b) == t: Cmp} -> {Cmp.is_le(t) == True{}: Bool} -> {Key.cmp(b, c) == LT{}: Cmp} -> {
      Key.cmp(a, c) == LT{}: Cmp
    },
    Key.cmp(a, b),
    q => e => l => e1 => Mst.key_trans(a, b, c)(e)(e1),
    q => e => l => e1 =>
      %Equal.sym(List<&2, U32>, a, b, Mst.key_eq(a, b)(e)): {Key.cmp(_, c) == LT{}: Cmp}
      e1,
    q => e => l => e1 => Empty.absurd({Key.cmp(a, c) == LT{}: Cmp}, Shared.Bool.false_ne_true(l))
  )({==})

# a before b, and b at or below c: a before c
def Mst.key_lt_le(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {Key.cmp(a, b) == LT{}: Cmp} -> {
  Cmp.is_le(Key.cmp(b, c)) == True{}: Bool
} -> {Key.cmp(a, c) == LT{}: Cmp}:
  Mst.case_cmp(
    t => {Key.cmp(b, c) == t: Cmp} -> {Key.cmp(a, b) == LT{}: Cmp} -> {Cmp.is_le(t) == True{}: Bool} -> {
      Key.cmp(a, c) == LT{}: Cmp
    },
    Key.cmp(b, c),
    q => e => e1 => l => Mst.key_trans(a, b, c)(e1)(e),
    q => e => e1 => l =>
      %Mst.key_eq(b, c)(e): {Key.cmp(a, _) == LT{}: Cmp}
      e1,
    q => e => e1 => l => Empty.absurd({Key.cmp(a, c) == LT{}: Cmp}, Shared.Bool.false_ne_true(l))
  )({==})

# a key after lo1 is after a lower bound at or below it
def Mst.after_wide(+lo2: Maybe<&2, List<&2, U32>>, +lo1: Maybe<&2, List<&2, U32>>, +x: List<&2, U32>) -> {
  Mst.lo_le(lo2, lo1) == True{}: Bool
} -> {Bound.after(lo1, x) == True{}: Bool} -> {Bound.after(lo2, x) == True{}: Bool}:
  match lo2 lo1:
    case None{} y:
      w => e => {==}
    case Some{a2} None{}:
      w => e => Empty.absurd({Bound.after(Some{a2}, x) == True{}: Bool}, Shared.Bool.false_ne_true(w))
    case Some{+a2} Some{+a1}:
      w => e => Mst.key_is_lt(a2, x)(Mst.key_le_lt(a2, a1, x)(w)(Mst.key_lt_of(a1, x)(e)))

# a key before hi1 is before an upper bound at or above it
def Mst.before_wide(+x: List<&2, U32>, +hi1: Maybe<&2, List<&2, U32>>, +hi2: Maybe<&2, List<&2, U32>>) -> {
  Mst.hi_le(hi1, hi2) == True{}: Bool
} -> {Bound.before(x, hi1) == True{}: Bool} -> {Bound.before(x, hi2) == True{}: Bool}:
  match hi1 hi2:
    case y None{}:
      w => e => {==}
    case None{} Some{b2}:
      w => e => Empty.absurd({Bound.before(x, Some{b2}) == True{}: Bool}, Shared.Bool.false_ne_true(w))
    case Some{+b1} Some{+b2}:
      w => e => Mst.key_is_lt(x, b2)(Mst.key_lt_le(x, b1, b2)(Mst.key_lt_of(x, b1)(e))(w))

# a bound is at or below itself
def Mst.lo_le_refl(+lo: Maybe<&2, List<&2, U32>>) -> {Mst.lo_le(lo, lo) == True{}: Bool}:
  match lo:
    case None{}:
      {==}
    case Some{+a}:
      %Equal.sym(Cmp, Key.cmp(a, a), EQ{}, Mst.key_refl(a)): {Cmp.is_le(_) == True{}: Bool}
      {==}

# a bound is at or above itself
def Mst.hi_le_refl(+hi: Maybe<&2, List<&2, U32>>) -> {Mst.hi_le(hi, hi) == True{}: Bool}:
  match hi:
    case None{}:
      {==}
    case Some{+b}:
      %Equal.sym(Cmp, Key.cmp(b, b), EQ{}, Mst.key_refl(b)): {Cmp.is_le(_) == True{}: Bool}
      {==}

# a lower bound before k is below the bound k
def Mst.lo_le_key(+lo: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>) -> {Bound.after(lo, k) == True{}: Bool} -> {
  Mst.lo_le(lo, Some{k}) == True{}: Bool
}:
  match lo:
    case None{}:
      e => {==}
    case Some{+a}:
      e =>
        %Equal.sym(Cmp, Key.cmp(a, k), LT{}, Mst.key_lt_of(a, k)(e)): {Cmp.is_le(_) == True{}: Bool}
        {==}

# an upper bound after k is above the bound k
def Mst.hi_le_key(+k: List<&2, U32>, +hi: Maybe<&2, List<&2, U32>>) -> {Bound.before(k, hi) == True{}: Bool} -> {
  Mst.hi_le(Some{k}, hi) == True{}: Bool
}:
  match hi:
    case None{}:
      e => {==}
    case Some{+b}:
      e =>
        %Equal.sym(Cmp, Key.cmp(k, b), LT{}, Mst.key_lt_of(k, b)(e)): {Cmp.is_le(_) == True{}: Bool}
        {==}

# items that fit between two bounds fit between wider ones
def Mst.fit_wide(
  xs: List<&2, Item>,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool}
) -> {Items.fit(xs, lo1, hi1) == True{}: Bool} -> {Items.fit(xs, lo2, hi2) == True{}: Bool}:
  match xs:
    case Nil{}:
      +e => {==}
    case Con{Item{+k, v, r}, +rest}:
      +e => Shared.Bool.and_both(
        Bool.and(Bound.after(lo2, k), Bound.before(k, hi2)),
        Items.fit(rest, Some{k}, hi2),
        Shared.Bool.and_both(
          Bound.after(lo2, k),
          Bound.before(k, hi2),
          Mst.after_wide(lo2, lo1, k)(wl)(
            Shared.Bool.and_true_left(
              Bound.after(lo1, k),
              Bound.before(k, hi1),
              Shared.Bool.and_true_left(
                Bool.and(Bound.after(lo1, k), Bound.before(k, hi1)),
                Items.fit(rest, Some{k}, hi1),
                e
              )
            )
          ),
          Mst.before_wide(k, hi1, hi2)(wh)(
            Shared.Bool.and_true_right(
              Bound.after(lo1, k),
              Bound.before(k, hi1),
              Shared.Bool.and_true_left(
                Bool.and(Bound.after(lo1, k), Bound.before(k, hi1)),
                Items.fit(rest, Some{k}, hi1),
                e
              )
            )
          )
        ),
        Mst.fit_wide(rest, Some{k}, Some{k}, hi1, hi2, Mst.lo_le_refl(Some{k}), wh)(
          Shared.Bool.and_true_right(
            Bool.and(Bound.after(lo1, k), Bound.before(k, hi1)),
            Items.fit(rest, Some{k}, hi1),
            e
          )
        )
      )

# items fit in a row as the first fit, and the rest fit after the last of
# the first
def Mst.fit_append(xs: List<&2, Item>, +ys: List<&2, Item>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Items.fit(List.append(&2, Item, xs, ys), lo, hi)
    == Bool.and(Items.fit(xs, lo, hi), Items.fit(ys, Items.last_key(xs, lo), hi)): Bool
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, +rest}:
      %Equal.sym(
        Bool,
        Items.fit(List.append(&2, Item, rest, ys), Some{k}, hi),
        Bool.and(Items.fit(rest, Some{k}, hi), Items.fit(ys, Items.last_key(rest, Some{k}), hi)),
        Mst.fit_append(rest, ys, Some{k}, hi)
      ): {
        Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), _)
          == Bool.and(
            Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Items.fit(rest, Some{k}, hi)),
            Items.fit(ys, Items.last_key(rest, Some{k}), hi)
          ): Bool
      }
      Shared.Bool.and_assoc(
        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
        Items.fit(rest, Some{k}, hi),
        Items.fit(ys, Items.last_key(rest, Some{k}), hi)
      )

# the items with their last subtree set fit as they did
def Mst.fit_set_last(xs: List<&2, Item>, -m: Maybe<&2, Hashes.Hash>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Items.fit(Mst.set_last(xs, m), lo, hi) == Items.fit(xs, lo, hi): Bool
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      %Equal.sym(
        Bool,
        Items.fit(Mst.set_last(y <> rest, m), Some{k}, hi),
        Items.fit(y <> rest, Some{k}, hi),
        Mst.fit_set_last(y <> rest, m, Some{k}, hi)
      ): {Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), _) == Items.fit(Item{k, v, r} <> y <> rest, lo, hi): Bool}
      {==}

# the last key of items with their last subtree set is their last key
def Mst.last_key_set_last(xs: List<&2, Item>, -m: Maybe<&2, Hashes.Hash>, +lo: Maybe<&2, List<&2, U32>>) -> {
  Items.last_key(Mst.set_last(xs, m), lo) == Items.last_key(xs, lo): Maybe<&2, List<&2, U32>>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      Mst.last_key_set_last(y <> rest, m, Some{k})

# a pick passes items with their last subtree set as it passes them
def Mst.passes_set_last(xs: List<&2, Item>, -m: Maybe<&2, Hashes.Hash>, +k2: List<&2, U32>) -> {
  Mst.passes(Mst.set_last(xs, m), k2) == Mst.passes(xs, k2): Bool
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      %Equal.sym(
        Bool,
        Mst.passes(Mst.set_last(y <> rest, m), k2),
        Mst.passes(y <> rest, k2),
        Mst.passes_set_last(y <> rest, m, k2)
      ): {Bool.and(Cmp.is_gt(Key.cmp(k2, k)), _) == Mst.passes(Item{k, v, r} <> y <> rest, k2): Bool}
      {==}

# the last subtree of items with it set to m is m
def Mst.last_set_last(xs: List<&2, Item>, -left: Maybe<&2, Hashes.Hash>, -m: Maybe<&2, Hashes.Hash>) -> {
  Mst.last(Mst.set_last(xs, m), Mst.end_left(xs, left, m)) == m: Maybe<&2, Hashes.Hash>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      Mst.last_set_last(y <> rest, r, m)

# the last key of items in a row is the last key of the second, after the
# first
def Mst.last_key_append(xs: List<&2, Item>, -ys: List<&2, Item>, +lo: Maybe<&2, List<&2, U32>>) -> {
  Items.last_key(List.append(&2, Item, xs, ys), lo) == Items.last_key(ys, Items.last_key(xs, lo)): Maybe<&2, List<&2, U32>>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, +rest}:
      Mst.last_key_append(rest, ys, Some{k})

# items that fit before hi and come before k fit before k
def Mst.fit_below(
  +xs: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> {Items.fit(xs, lo, hi) == True{}: Bool} -> {Mst.all_lt(xs, k) == True{}: Bool} -> {
  Items.fit(xs, lo, Some{k}) == True{}: Bool
}:
  match xs:
    case Nil{}:
      +e => +a => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +e => +a => Shared.Bool.and_both(
        Bool.and(Bound.after(lo, ik), Bound.before(ik, Some{k})),
        Items.fit(rest, Some{ik}, Some{k}),
        Shared.Bool.and_both(
          Bound.after(lo, ik),
          Bound.before(ik, Some{k}),
          Shared.Bool.and_true_left(
            Bound.after(lo, ik),
            Bound.before(ik, hi),
            Shared.Bool.and_true_left(Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)), Items.fit(rest, Some{ik}, hi), e)
          ),
          Mst.key_is_lt(ik, k)(
            Mst.lt_sound(Key.cmp(ik, k))(
              Shared.Bool.and_true_left(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a)
            )
          )
        ),
        Mst.fit_below(rest, Some{ik}, hi, k)(
          Shared.Bool.and_true_right(Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)), Items.fit(rest, Some{ik}, hi), e)
        )(Shared.Bool.and_true_right(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))
      )

# items that all come before k end before k, once their lower bound does
def Mst.last_below(xs: List<&2, Item>, +lo: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>) -> {
  Mst.all_lt(xs, k) == True{}: Bool
} -> {Bound.after(lo, k) == True{}: Bool} -> {Bound.after(Items.last_key(xs, lo), k) == True{}: Bool}:
  match xs:
    case Nil{}:
      +a => +e => e
    case Con{Item{+ik, +iv, +r}, +rest}:
      +a => +e => Mst.last_below(rest, Some{ik}, k)(
        Shared.Bool.and_true_right(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a)
      )(
        Mst.key_is_lt(ik, k)(
          Mst.lt_sound(Key.cmp(ik, k))(Shared.Bool.and_true_left(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))
        )
      )

# items that fit before k come before k
def Mst.fit_all_lt(xs: List<&2, Item>, +lo: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>) -> {
  Items.fit(xs, lo, Some{k}) == True{}: Bool
} -> {Mst.all_lt(xs, k) == True{}: Bool}:
  match xs:
    case Nil{}:
      +e => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +e => Shared.Bool.and_both(
        Cmp.is_lt(Key.cmp(ik, k)),
        Mst.all_lt(rest, k),
        Equal.trans(
          Bool,
          Cmp.is_lt(Key.cmp(ik, k)),
          Key.is_lt(ik, k),
          True{},
          Mst.key_lt(ik, k),
          Shared.Bool.and_true_right(
            Bound.after(lo, ik),
            Key.is_lt(ik, k),
            Shared.Bool.and_true_left(Bool.and(Bound.after(lo, ik), Key.is_lt(ik, k)), Items.fit(rest, Some{ik}, Some{k}), e)
          )
        ),
        Mst.fit_all_lt(rest, Some{ik}, k)(
          Shared.Bool.and_true_right(Bool.and(Bound.after(lo, ik), Key.is_lt(ik, k)), Items.fit(rest, Some{ik}, Some{k}), e)
        )
      )

# a key after k2 passes nothing it does not pass: if k2 is after every key of
# xs, so is a key after k2 (here: a key that compares GT to k2)
def Mst.passes_of_lt(xs: List<&2, Item>, +k: List<&2, U32>, +k2: List<&2, U32>) -> {Mst.all_lt(xs, k) == True{}: Bool} -> {
  Cmp.is_lt(Key.cmp(k, k2)) == True{}: Bool
} -> {Mst.passes(xs, k2) == True{}: Bool}:
  match xs:
    case Nil{}:
      +a => +e => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +a => +e => Shared.Bool.and_both(
        Cmp.is_gt(Key.cmp(k2, ik)),
        Mst.passes(rest, k2),
        Equal.cong(
          Cmp,
          Bool,
          Cmp.is_gt,
          Key.cmp(k2, ik),
          GT{},
          Mst.key_lt_gt(ik, k2)(
            Mst.key_trans(ik, k, k2)(
              Mst.lt_sound(Key.cmp(ik, k))(Shared.Bool.and_true_left(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))
            )(Mst.lt_sound(Key.cmp(k, k2))(e))
          )
        ),
        Mst.passes_of_lt(rest, k, k2)(Shared.Bool.and_true_right(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))(e)
      )

# a pick of k passes the items before k (k itself here)
def Mst.passes_of_all_lt(xs: List<&2, Item>, +k: List<&2, U32>) -> {Mst.all_lt(xs, k) == True{}: Bool} -> {
  Mst.passes(xs, k) == True{}: Bool
}:
  match xs:
    case Nil{}:
      +a => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +a => Shared.Bool.and_both(
        Cmp.is_gt(Key.cmp(k, ik)),
        Mst.passes(rest, k),
        Equal.cong(
          Cmp,
          Bool,
          Cmp.is_gt,
          Key.cmp(k, ik),
          GT{},
          Mst.key_lt_gt(ik, k)(
            Mst.lt_sound(Key.cmp(ik, k))(Shared.Bool.and_true_left(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))
          )
        ),
        Mst.passes_of_all_lt(rest, k)(Shared.Bool.and_true_right(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))
      )

# the items xs before the first whose key is not before k (what a part of
# them at k puts before)
def Mst.pre(xs: List<&2, Item>, +k: List<&2, U32>) -> List<&2, Item>:
  match xs:
    case Nil{}:
      []
    case Con{Item{+ik, +iv, +r}, +rest}:
      Shared.Bool.when(List<&2, Item>, Cmp.is_lt(Key.cmp(ik, k)), u => Item{ik, iv, r} <> Mst.pre(rest, k), u => [])

# the items xs from the first whose key is not before k on
def Mst.post(xs: List<&2, Item>, +k: List<&2, U32>) -> List<&2, Item>:
  match xs:
    case Nil{}:
      []
    case Con{Item{+ik, +iv, +r}, +rest}:
      Shared.Bool.when(List<&2, Item>, Cmp.is_lt(Key.cmp(ik, k)), u => Mst.post(rest, k), u => Item{ik, iv, r} <> rest)

# the first of the items ys (if any) does not come before k
def Mst.head_not_lt(ys: List<&2, Item>, +k: List<&2, U32>) -> Bool:
  match ys:
    case Nil{}:
      True{}
    case Con{Item{ik, iv, r}, rest}:
      Bool.not(Cmp.is_lt(Key.cmp(ik, k)))

# the part of the items xs at k, by Mst.pre and Mst.post
def Mst.part_eq(+xs: List<&2, Item>, +prev: Maybe<&2, Hashes.Hash>, +k: List<&2, U32>, +acc: List<&2, Item>) -> {
  Mst.part(xs, prev, k, acc)
    == Part{List.reverse.go(&2, Item, Mst.pre(xs, k), acc), Mst.last(Mst.pre(xs, k), prev), Mst.post(xs, k)}: Part
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_bool(
        b => {
          Shared.Bool.when(
            Part,
            b,
            u => Mst.part(rest, r, k, Item{ik, iv, r} <> acc),
            u => Part{acc, prev, Item{ik, iv, r} <> rest}
          )
            == Part{
              List.reverse.go(
                &2,
                Item,
                Shared.Bool.when(List<&2, Item>, b, u => Item{ik, iv, r} <> Mst.pre(rest, k), u => []),
                acc
              ),
              Mst.last(Shared.Bool.when(List<&2, Item>, b, u => Item{ik, iv, r} <> Mst.pre(rest, k), u => []), prev),
              Shared.Bool.when(List<&2, Item>, b, u => Mst.post(rest, k), u => Item{ik, iv, r} <> rest)
            }: Part
        },
        Cmp.is_lt(Key.cmp(ik, k)),
        +q => Mst.part_eq(rest, r, k, Item{ik, iv, r} <> acc),
        +q => {==}
      )

# the items before k and from k on are the items
def Mst.pre_post(+xs: List<&2, Item>, +k: List<&2, U32>) -> {
  List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)) == xs: List<&2, Item>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_bool(
        b => {
          List.append(
            &2,
            Item,
            Shared.Bool.when(List<&2, Item>, b, u => Item{ik, iv, r} <> Mst.pre(rest, k), u => []),
            Shared.Bool.when(List<&2, Item>, b, u => Mst.post(rest, k), u => Item{ik, iv, r} <> rest)
          )
            == Item{ik, iv, r} <> rest: List<&2, Item>
        },
        Cmp.is_lt(Key.cmp(ik, k)),
        +q => Equal.cong(
          List<&2, Item>,
          List<&2, Item>,
          ys => Item{ik, iv, r} <> ys,
          List.append(&2, Item, Mst.pre(rest, k), Mst.post(rest, k)),
          rest,
          Mst.pre_post(rest, k)
        ),
        +q => {==}
      )

# the items before k all come before k
def Mst.pre_all_lt(+xs: List<&2, Item>, +k: List<&2, U32>) -> {Mst.all_lt(Mst.pre(xs, k), k) == True{}: Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_bool(
        b => {b == Cmp.is_lt(Key.cmp(ik, k)): Bool} -> {
          Mst.all_lt(Shared.Bool.when(List<&2, Item>, b, u => Item{ik, iv, r} <> Mst.pre(rest, k), u => []), k) == True{}: Bool
        },
        Cmp.is_lt(Key.cmp(ik, k)),
        +q => +e =>
          %e: {Bool.and(_, Mst.all_lt(Mst.pre(rest, k), k)) == True{}: Bool}
          Mst.pre_all_lt(rest, k),
        +q => +e => {==}
      )({==})

# the first item from k on does not come before k
def Mst.post_head(+xs: List<&2, Item>, +k: List<&2, U32>) -> {Mst.head_not_lt(Mst.post(xs, k), k) == True{}: Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_bool(
        b => {b == Cmp.is_lt(Key.cmp(ik, k)): Bool} -> {
          Mst.head_not_lt(Shared.Bool.when(List<&2, Item>, b, u => Mst.post(rest, k), u => Item{ik, iv, r} <> rest), k)
            == True{}: Bool
        },
        Cmp.is_lt(Key.cmp(ik, k)),
        +q => +e => Mst.post_head(rest, k),
        +q => +e =>
          %e: {Bool.not(_) == True{}: Bool}
          {==}
      )({==})

# a list reversed onto zs, then ys, is the list reversed onto zs then ys
def Mst.rev_append(+acc: List<&2, Item>, +zs: List<&2, Item>, +ys: List<&2, Item>) -> {
  List.append(&2, Item, List.reverse.go(&2, Item, acc, zs), ys) == List.reverse.go(&2, Item, acc, List.append(&2, Item, zs, ys)): List<&2, Item>
}:
  match acc:
    case Nil{}:
      {==}
    case Con{+a, +as}:
      Mst.rev_append(as, a <> zs, ys)

# Mst.rejoin of nonempty items reversed onto acc
def Mst.rejoin_rev.go(+xs: List<&2, Item>, +x: Item, +acc: List<&2, Item>, +m: Maybe<&2, Hashes.Hash>, +after: List<&2, Item>) -> {
  Mst.rejoin(List.reverse.go(&2, Item, x <> xs, acc), m, after)
    == List.reverse.go(&2, Item, acc, List.append(&2, Item, Mst.set_last(x <> xs, m), after)): List<&2, Item>
}:
  match xs x:
    case Nil{} Item{+k, +v, +r}:
      Mst.rev_append(acc, [], Item{k, v, m} <> after)
    case Con{+y, +ys} Item{+k, +v, +r}:
      Mst.rejoin_rev.go(ys, y, Item{k, v, r} <> acc, m, after)

# Mst.rejoin of the items before a place, as a part gives them, is the items
# with their last subtree set
def Mst.rejoin_rev(+xs: List<&2, Item>, +m: Maybe<&2, Hashes.Hash>, +after: List<&2, Item>) -> {
  Mst.rejoin(List.reverse.go(&2, Item, xs, []), m, after) == List.append(&2, Item, Mst.set_last(xs, m), after): List<&2, Item>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +rest}:
      Mst.rejoin_rev.go(rest, x, [], m, after)

# a node with no item before a place keeps left, else as Mst.end_left
def Mst.end_left_same(+xs: List<&2, Item>, +left: Maybe<&2, Hashes.Hash>) -> {
  Mst.end_left(xs, left, left) == left: Maybe<&2, Hashes.Hash>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, r}:
      {==}

# Mst.left of the items before a place reversed onto acc
def Mst.left_rev.go(+xs: List<&2, Item>, +acc: List<&2, Item>, +left: Maybe<&2, Hashes.Hash>, +m: Maybe<&2, Hashes.Hash>) -> {
  Mst.left(List.reverse.go(&2, Item, xs, acc), left, m) == Mst.end_left(xs, left, Mst.left(acc, left, m)): Maybe<&2, Hashes.Hash>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +rest}:
      %Equal.sym(
        Maybe<&2, Hashes.Hash>,
        Mst.left(List.reverse.go(&2, Item, rest, x <> acc), left, m),
        Mst.end_left(rest, left, left),
        Mst.left_rev.go(rest, x <> acc, left, m)
      ): {_ == left: Maybe<&2, Hashes.Hash>}
      Mst.end_left_same(rest, left)

# Mst.left of the items before a place, as a part gives them
def Mst.left_rev(+xs: List<&2, Item>, +left: Maybe<&2, Hashes.Hash>, +m: Maybe<&2, Hashes.Hash>) -> {
  Mst.left(List.reverse.go(&2, Item, xs, []), left, m) == Mst.end_left(xs, left, m): Maybe<&2, Hashes.Hash>
}:
  Mst.left_rev.go(xs, [], left, m)

# the head key of items reversed onto acc
def Mst.head_rev.go(+xs: List<&2, Item>, +acc: List<&2, Item>, +lo: Maybe<&2, List<&2, U32>>) -> {
  Items.head_key(List.reverse.go(&2, Item, xs, acc), lo) == Items.last_key(xs, Items.head_key(acc, lo)): Maybe<&2, List<&2, U32>>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, +rest}:
      Mst.head_rev.go(rest, Item{k, v, r} <> acc, lo)

# the head key of the items before a place, as a part gives them, is their
# last key
def Mst.head_rev(+xs: List<&2, Item>, +lo: Maybe<&2, List<&2, U32>>) -> {
  Items.head_key(List.reverse.go(&2, Item, xs, []), lo) == Items.last_key(xs, lo): Maybe<&2, List<&2, U32>>
}:
  Mst.head_rev.go(xs, [], lo)

# a pick passes the items that k2 is after
def Mst.pick_passes(
  +xs: List<&2, Item>,
  +ys: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.passes(xs, k2) == True{}: Bool} -> {
  Mst.pick(List.append(&2, Item, xs, ys), prev, l, lo, hi, k2)
    == Mst.pick(ys, Mst.last(xs, prev), l, Items.last_key(xs, lo), hi, k2): Pick
}:
  match xs:
    case Nil{}:
      +e => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +e =>
        %Equal.sym(
          Cmp,
          Key.cmp(k2, ik),
          GT{},
          Mst.gt_sound(Key.cmp(k2, ik))(Shared.Bool.and_true_left(Cmp.is_gt(Key.cmp(k2, ik)), Mst.passes(rest, k2), e))
        ): {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(_),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(
              Pick,
              Cmp.is_eq(_),
              w => Pick.Hit{iv},
              w => Mst.pick(List.append(&2, Item, rest, ys), r, l, Some{ik}, hi, k2)
            )
          )
            == Mst.pick(ys, Mst.last(rest, r), l, Items.last_key(rest, Some{ik}), hi, k2): Pick
        }
        Mst.pick_passes(rest, ys, r, l, Some{ik}, hi, k2)(
          Shared.Bool.and_true_right(Cmp.is_gt(Key.cmp(k2, ik)), Mst.passes(rest, k2), e)
        )

# a pick that stops within the items xs reads nothing after them
def Mst.pick_stops(
  +xs: List<&2, Item>,
  +ys1: List<&2, Item>,
  +ys2: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.passes(xs, k2) == False{}: Bool} -> {
  Mst.pick(List.append(&2, Item, xs, ys1), prev, l, lo, hi1, k2)
    == Mst.pick(List.append(&2, Item, xs, ys2), prev, l, lo, hi2, k2): Pick
}:
  match xs:
    case Nil{}:
      +e => Empty.absurd(
        {Mst.pick(ys1, prev, l, lo, hi1, k2) == Mst.pick(ys2, prev, l, lo, hi2, k2): Pick},
        Shared.Bool.true_ne_false(e)
      )
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_cmp(
        c => {Bool.and(Cmp.is_gt(c), Mst.passes(rest, k2)) == False{}: Bool} -> {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(
              Pick,
              Cmp.is_eq(c),
              w => Pick.Hit{iv},
              w => Mst.pick(List.append(&2, Item, rest, ys1), r, l, Some{ik}, hi1, k2)
            )
          )
            == Shared.Bool.when(
              Pick,
              Cmp.is_lt(c),
              u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
              u => Shared.Bool.when(
                Pick,
                Cmp.is_eq(c),
                w => Pick.Hit{iv},
                w => Mst.pick(List.append(&2, Item, rest, ys2), r, l, Some{ik}, hi2, k2)
              )
            ): Pick
        },
        Key.cmp(k2, ik),
        +q => +e => {==},
        +q => +e => {==},
        +q => +e => Mst.pick_stops(rest, ys1, ys2, r, l, Some{ik}, hi1, hi2, k2)(e)
      )

# Mst.pick_stops, with the last subtree of the items set on one side
def Mst.pick_stops_set(
  +xs: List<&2, Item>,
  +m: Maybe<&2, Hashes.Hash>,
  +ys1: List<&2, Item>,
  +ys2: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.passes(xs, k2) == False{}: Bool} -> {
  Mst.pick(List.append(&2, Item, Mst.set_last(xs, m), ys1), prev, l, lo, hi1, k2)
    == Mst.pick(List.append(&2, Item, xs, ys2), prev, l, lo, hi2, k2): Pick
}:
  match xs:
    case Nil{}:
      +e => Empty.absurd(
        {Mst.pick(ys1, prev, l, lo, hi1, k2) == Mst.pick(ys2, prev, l, lo, hi2, k2): Pick},
        Shared.Bool.true_ne_false(e)
      )
    case Con{Item{+ik, +iv, +r}, Nil{}}:
      Mst.case_cmp(
        c => {Bool.and(Cmp.is_gt(c), True{}) == False{}: Bool} -> {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(ys1, m, l, Some{ik}, hi1, k2))
          )
            == Shared.Bool.when(
              Pick,
              Cmp.is_lt(c),
              u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
              u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(ys2, r, l, Some{ik}, hi2, k2))
            ): Pick
        },
        Key.cmp(k2, ik),
        +q => +e => {==},
        +q => +e => {==},
        +q => +e => Empty.absurd(
          {Mst.pick(ys1, m, l, Some{ik}, hi1, k2) == Mst.pick(ys2, r, l, Some{ik}, hi2, k2): Pick},
          Shared.Bool.true_ne_false(e)
        )
      )
    case Con{Item{+ik, +iv, +r}, Con{+y, +rest}}:
      Mst.case_cmp(
        c => {Bool.and(Cmp.is_gt(c), Mst.passes(y <> rest, k2)) == False{}: Bool} -> {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(
              Pick,
              Cmp.is_eq(c),
              w => Pick.Hit{iv},
              w => Mst.pick(List.append(&2, Item, Mst.set_last(y <> rest, m), ys1), r, l, Some{ik}, hi1, k2)
            )
          )
            == Shared.Bool.when(
              Pick,
              Cmp.is_lt(c),
              u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
              u => Shared.Bool.when(
                Pick,
                Cmp.is_eq(c),
                w => Pick.Hit{iv},
                w => Mst.pick(List.append(&2, Item, y <> rest, ys2), r, l, Some{ik}, hi2, k2)
              )
            ): Pick
        },
        Key.cmp(k2, ik),
        +q => +e => {==},
        +q => +e => {==},
        +q => +e => Mst.pick_stops_set(y <> rest, m, ys1, ys2, r, l, Some{ik}, hi1, hi2, k2)(e)
      )

# a pick that stops at the first item goes down before it
def Mst.pick_first(
  +ys: List<&2, Item>,
  +m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.stops_first(ys, k2) == True{}: Bool} -> {
  Mst.pick(ys, m, l, lo, hi, k2) == Pick.Down{m, Room.of(l, lo, Items.head_key(ys, hi))}: Pick
}:
  match ys:
    case Nil{}:
      +e => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +e =>
        %Equal.sym(Cmp, Key.cmp(k2, ik), LT{}, Mst.lt_sound(Key.cmp(k2, ik))(e)): {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(_),
            u => Pick.Down{m, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(_), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k2))
          )
            == Pick.Down{m, Room.of(l, lo, Some{ik})}: Pick
        }
        {==}

# a pick that does not stop at the first item reads neither the subtree
# before it nor the bound before it
def Mst.pick_past(
  +ys: List<&2, Item>,
  +m1: Maybe<&2, Hashes.Hash>,
  +m2: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.stops_first(ys, k2) == False{}: Bool} -> {
  Mst.pick(ys, m1, l, lo1, hi, k2) == Mst.pick(ys, m2, l, lo2, hi, k2): Pick
}:
  match ys:
    case Nil{}:
      +e => Empty.absurd(
        {Pick.Down{m1, Room.of(l, lo1, hi)} == Pick.Down{m2, Room.of(l, lo2, hi)}: Pick},
        Shared.Bool.true_ne_false(e)
      )
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_cmp(
        c => {Cmp.is_lt(c) == False{}: Bool} -> {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{m1, Room.of(l, lo1, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k2))
          )
            == Shared.Bool.when(
              Pick,
              Cmp.is_lt(c),
              u => Pick.Down{m2, Room.of(l, lo2, Some{ik})},
              u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k2))
            ): Pick
        },
        Key.cmp(k2, ik),
        +q => +e => Empty.absurd(
          {Pick.Down{m1, Room.of(l, lo1, Some{ik})} == Pick.Down{m2, Room.of(l, lo2, Some{ik})}: Pick},
          Shared.Bool.true_ne_false(e)
        ),
        +q => +e => {==},
        +q => +e => {==}
      )

# the up of a room
def Mst.room_up(r: Room) -> Nat:
  match r:
    case Room{u, lo, hi}:
      u

# the room r2 is at least as wide as r1
def Mst.room_le(r1: Room, r2: Room) -> Bool:
  match r1 r2:
    case Room{u1, lo1, hi1} Room{u2, lo2, hi2}:
      Bool.and(Nat.is_le(u1, u2), Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2)))

# the room r2 is at least as wide as r1, and of the up l
def Mst.down_ok(l: Nat, r1: Room, +r2: Room) -> Bool:
  Bool.and(Mst.room_le(r1, r2), Nat.is_eq(Mst.room_up(r2), l))

# two picks of one key among the same items of a node of the level l: the
# same hit, or the same subtree, in a room at least as wide and of the up l
def Mst.PickSub(l: Nat, p1: Pick, p2: Pick) -> Type:
  match p1 p2:
    case Pick.Hit{v1} Pick.Hit{v2}:
      {v1 == v2: List<&2, U32>}
    case Pick.Down{m1, r1} Pick.Down{m2, r2}:
      {m1 == m2: Maybe<&2, Hashes.Hash>} & {Mst.down_ok(l, r1, r2) == True{}: Bool}
    case Pick.Hit{v1} Pick.Down{m2, r2}:
      Empty
    case Pick.Down{m1, r1} Pick.Hit{v2}:
      Empty

# a room of the up l, between wider bounds, is wider
def Mst.room_le_of(
  +l: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool}
) -> {Mst.room_le(Room{l, lo1, hi1}, Room{l, lo2, hi2}) == True{}: Bool}:
  Shared.Bool.and_both(
    Nat.is_le(l, l),
    Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2)),
    Shared.Nat.le_refl(l),
    Shared.Bool.and_both(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2), wl, wh)
  )

# a pick between wider bounds finds the same, in a wider room
def Mst.pick_wide(
  +xs: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool}
) -> Mst.PickSub(l, Mst.pick(xs, prev, l, lo1, hi1, k), Mst.pick(xs, prev, l, lo2, hi2, k)):
  match xs:
    case Nil{}:
      ({==}, Shared.Bool.and_both(Mst.room_le(Room{l, lo1, hi1}, Room{l, lo2, hi2}), Nat.is_eq(l, l), Mst.room_le_of(l, lo1, lo2, hi1, hi2, wl, wh), Shared.Nat.is_eq_refl(l)))
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_cmp(
        c => Mst.PickSub(
          l,
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo1, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi1, k))
          ),
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo2, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi2, k))
          )
        ),
        Key.cmp(k, ik),
        +q => (
          {==},
          Shared.Bool.and_both(
            Mst.room_le(Room{l, lo1, Some{ik}}, Room{l, lo2, Some{ik}}),
            Nat.is_eq(l, l),
            Mst.room_le_of(l, lo1, lo2, Some{ik}, Some{ik}, wl, Mst.hi_le_refl(Some{ik})),
            Shared.Nat.is_eq_refl(l)
          )
        ),
        +q => {==},
        +q => Mst.pick_wide(rest, r, l, Some{ik}, Some{ik}, hi1, hi2, k, Mst.lo_le_refl(Some{ik}), wh)
      )

# a list of words holds its first
def Mst.contains_head(+w: List<&2, U32>, rest: List<&2, List<&2, U32>>) -> {
  List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), w <> rest, w) == True{}: Bool
}:
  %Equal.sym(
    Bool,
    Shared.List.is_eq(~U32, ~U32.is_eq, w, w),
    True{},
    Shared.List.is_eq_refl(~U32, ~U32.is_eq, ~Shared.U32.laws(), w)
  ): {List.any.if(u => List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), rest, w), _) == True{}: Bool}
  {==}

# a depot that gives the words w under their hash has them
def Mst.has_of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +w: List<&2, U32>,
  e: {fetch(s)(Hashes.Sha.hash(w)) == Some{w}: Maybe<&2, List<&2, U32>>}
) -> {True{} == Depots.Depot.has(~S, ~fetch, s, w): Bool}:
  %Equal.sym(Maybe<&2, List<&2, U32>>, fetch(s)(Hashes.Sha.hash(w)), Some{w}, e): {
    True{}
      == Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), _, Some{w}): Bool
  }
  Equal.sym(
    Bool,
    Shared.List.is_eq(~U32, ~U32.is_eq, w, w),
    True{},
    Shared.List.is_eq_refl(~U32, ~U32.is_eq, ~Shared.U32.laws(), w)
  )

# the depot s has the first of the words ns (none: True)
def Mst.head_has(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +s: S, ns: List<&2, List<&2, U32>>) -> Bool:
  match ns:
    case Nil{}:
      True{}
    case Con{w, rest}:
      Depots.Depot.has(~S, ~fetch, s, w)

# the depot s holds each of the words ns, once a proof says so of each (b:
# whether it has the first)
def Mst.holds_of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ns: List<&2, List<&2, U32>>,
  b: Bool,
  +s: S,
  eb: {Mst.head_has(~S, ~fetch, s, ns) == b: Bool},
  held: @w: List<&2, U32> -> {
    List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ns, w) == True{}: Bool
  } -> {fetch(s)(Hashes.Sha.hash(w)) == Some{w}: Maybe<&2, List<&2, U32>>}
) -> {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool}:
  match ns b:
    case Nil{} b0:
      {==}
    case Con{+w, +rest} True{}:
      %Equal.sym(Bool, Depots.Depot.has(~S, ~fetch, s, w), True{}, eb): {
        List.all.if(u => Depots.Depot.holds(~S, ~fetch, s, rest), _) == True{}: Bool
      }
      Mst.holds_of(
        ~S,
        ~fetch,
        rest,
        Mst.head_has(~S, ~fetch, s, rest),
        s,
        {==},
        +w2 => +c => held(w2)(Shared.List.contains_cons(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), w, rest, w2)(c))
      )
    case Con{+w, +rest} False{}:
      Empty.absurd(
        {Depots.Depot.holds(~S, ~fetch, s, w <> rest) == True{}: Bool},
        Shared.Bool.true_ne_false(
          Equal.trans(
            Bool,
            True{},
            Depots.Depot.has(~S, ~fetch, s, w),
            False{},
            Mst.has_of(~S, ~fetch, s, w, held(w)(Mst.contains_head(w, rest))),
            eb
          )
        )
      )

# a depot that holds the words ws first holds them under their hash
def Mst.holds_head(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ws: List<&2, U32>,
  +ns: List<&2, List<&2, U32>>,
  +e: {Depots.Depot.holds(~S, ~fetch, s, ws <> ns) == True{}: Bool}
) -> {fetch(s)(Hashes.Sha.hash(ws)) == Some{ws}: Maybe<&2, List<&2, U32>>}:
  Shared.Maybe.is_eq_sound(
    ~List<&2, U32>,
    ~Shared.List.is_eq(~U32, ~U32.is_eq),
    x => y => Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), x, y),
    fetch(s)(Hashes.Sha.hash(ws)),
    Some{ws}
  )(Shared.List.all.if_hit(Depots.Depot.has(~S, ~fetch, s, ws), u => Depots.Depot.holds(~S, ~fetch, s, ns))(e))

# a depot that holds words holds the rest of them
def Mst.holds_tail(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ws: List<&2, U32>,
  +ns: List<&2, List<&2, U32>>,
  +e: {Depots.Depot.holds(~S, ~fetch, s, ws <> ns) == True{}: Bool}
) -> {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool}:
  Shared.List.all.if_rest(Depots.Depot.has(~S, ~fetch, s, ws), u => Depots.Depot.holds(~S, ~fetch, s, ns))(e)

# the node whose code a depot holds under its hash is the node of that hash
def Mst.node_code(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +n: Node,
  e: {fetch(s)(Hashes.Sha.hash(Node.code(n, []))) == Some{Node.code(n, [])}: Maybe<&2, List<&2, U32>>}
) -> {Mst.node(~S, ~fetch, s, Hashes.Sha.hash(Node.code(n, []))) == Some{n}: Maybe<&2, Node>}:
  %Equal.sym(Maybe<&2, List<&2, U32>>, fetch(s)(Hashes.Sha.hash(Node.code(n, []))), Some{Node.code(n, [])}, e): {
    Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, _) == Some{n}: Maybe<&2, Node>
  }
  Codes.Code.whole_read(~Node, ~Node.code, ~Node.code.read, ~(x => r => Node.code_read(x, r)), n)

# the node n may sit in the room r: its level is below the up of r, it has
# an item, and its items fit the bounds of r
def Mst.opens(n: Node, r: Room) -> Bool:
  match n r:
    case Node{+l, left, +xs} Room{up, lo, hi}:
      Bool.and(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi))

# a node that sits in a room is itself
def Mst.in_same(n: Node, r: Room, -m: Node) -> {Node.in(n, r) == Some{m}: Maybe<&2, Node>} -> {n == m: Node}:
  match n r:
    case Node{+l, +left, +xs} Room{+up, +lo, +hi}:
      Mst.case_bool(
        b => {Shared.Maybe.when(Node, b, u => Some{Node{l, left, xs}}) == Some{m}: Maybe<&2, Node>} -> {
          Node{l, left, xs} == m: Node
        },
        Bool.and(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi)),
        +q => +e => Shared.Maybe.some_inj(Node, Node{l, left, xs}, m, e),
        +q => +e => Empty.absurd({Node{l, left, xs} == m: Node}, Shared.Maybe.none_ne_some(Node, m, e))
      )

# a node that sits in a room opens there
def Mst.in_opens(n: Node, r: Room, -m: Node) -> {Node.in(n, r) == Some{m}: Maybe<&2, Node>} -> {Mst.opens(n, r) == True{}: Bool}:
  match n r:
    case Node{+l, +left, +xs} Room{+up, +lo, +hi}:
      Mst.case_bool(
        b => {Shared.Maybe.when(Node, b, u => Some{Node{l, left, xs}}) == Some{m}: Maybe<&2, Node>} -> {b == True{}: Bool},
        Bool.and(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi)),
        +q => +e => {==},
        +q => +e => Empty.absurd({False{} == True{}: Bool}, Shared.Maybe.none_ne_some(Node, m, e))
      )

# a node that opens in a room sits there
def Mst.opens_in(n: Node, r: Room) -> {Mst.opens(n, r) == True{}: Bool} -> {Node.in(n, r) == Some{n}: Maybe<&2, Node>}:
  match n r:
    case Node{+l, +left, +xs} Room{+up, +lo, +hi}:
      +e =>
        %Equal.sym(
          Bool,
          Bool.and(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi)),
          True{},
          e
        ): {Shared.Maybe.when(Node, _, u => Some{Node{l, left, xs}}) == Some{Node{l, left, xs}}: Maybe<&2, Node>}
        {==}

# the node that a depot gives in a room is the node it gives
def Mst.bind_in(mn: Maybe<&2, Node>, +r: Room, -m: Node) -> {
  Maybe.bind(&2, Node, Node, mn, n => Node.in(n, r)) == Some{m}: Maybe<&2, Node>
} -> {mn == Some{m}: Maybe<&2, Node>}:
  match mn:
    case None{}:
      +e => e
    case Some{+n}:
      +e => Equal.cong(Node, Maybe<&2, Node>, x => Some{x}, n, m, Mst.in_same(n, r, m)(e))

# the node that a depot gives in a room opens there
def Mst.bind_opens(mn: Maybe<&2, Node>, +r: Room, -m: Node) -> {
  Maybe.bind(&2, Node, Node, mn, n => Node.in(n, r)) == Some{m}: Maybe<&2, Node>
} -> {Mst.opens(m, r) == True{}: Bool}:
  match mn:
    case None{}:
      +e => Empty.absurd({Mst.opens(m, r) == True{}: Bool}, Shared.Maybe.none_ne_some(Node, m, e))
    case Some{+n}:
      +e =>
        %Mst.in_same(n, r, m)(e): {Mst.opens(_, r) == True{}: Bool}
        Mst.in_opens(n, r, m)(e)

# the node of a hash in a room is the node of the hash
def Mst.in_node(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +r: Room,
  -m: Node
) -> {Mst.node.in(~S, ~fetch, s, h, r) == Some{m}: Maybe<&2, Node>} -> {Mst.node(~S, ~fetch, s, h) == Some{m}: Maybe<&2, Node>}:
  Mst.bind_in(Mst.node(~S, ~fetch, s, h), r, m)

# the node of a hash in a room opens there
def Mst.in_open(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +r: Room,
  -m: Node
) -> {Mst.node.in(~S, ~fetch, s, h, r) == Some{m}: Maybe<&2, Node>} -> {Mst.opens(m, r) == True{}: Bool}:
  Mst.bind_opens(Mst.node(~S, ~fetch, s, h), r, m)

# the node of a hash, where it opens, is the node of the hash there
def Mst.node_in_of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +r: Room,
  +m: Node
) -> {Mst.node(~S, ~fetch, s, h) == Some{m}: Maybe<&2, Node>} -> {Mst.opens(m, r) == True{}: Bool} -> {
  Mst.node.in(~S, ~fetch, s, h, r) == Some{m}: Maybe<&2, Node>
}:
  +e => +o =>
    %Equal.sym(Maybe<&2, Node>, Mst.node(~S, ~fetch, s, h), Some{m}, e): {
      Maybe.bind(&2, Node, Node, _, n => Node.in(n, r)) == Some{m}: Maybe<&2, Node>
    }
    Mst.opens_in(m, r)(o)

# the bounds of r2 are at least as wide as those of r1
def Mst.bounds_le(r1: Room, r2: Room) -> Bool:
  match r1 r2:
    case Room{u1, lo1, hi1} Room{u2, lo2, hi2}:
      Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2))

# a room at least as wide has bounds at least as wide
def Mst.room_bounds(r1: Room, r2: Room) -> {Mst.room_le(r1, r2) == True{}: Bool} -> {Mst.bounds_le(r1, r2) == True{}: Bool}:
  match r1 r2:
    case Room{+u1, +lo1, +hi1} Room{+u2, +lo2, +hi2}:
      +e => Shared.Bool.and_true_right(Nat.is_le(u1, u2), Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2)), e)

# a node that opens in a room opens in a wider one
def Mst.opens_wide(n: Node, r1: Room, r2: Room) -> {Mst.opens(n, r1) == True{}: Bool} -> {Mst.room_le(r1, r2) == True{}: Bool} -> {
  Mst.opens(n, r2) == True{}: Bool
}:
  match n r1 r2:
    case Node{+l, +left, +xs} Room{+u1, +lo1, +hi1} Room{+u2, +lo2, +hi2}:
      +e => +w => Shared.Bool.and_both(
        Bool.and(Nat.is_lt(l, u2), Bool.not(List.is_empty(&2, Item, xs))),
        Items.fit(xs, lo2, hi2),
        Shared.Bool.and_both(
          Nat.is_lt(l, u2),
          Bool.not(List.is_empty(&2, Item, xs)),
          Shared.Nat.lt_le(l, u1, u2)(
            Shared.Bool.and_true_left(
              Nat.is_lt(l, u1),
              Bool.not(List.is_empty(&2, Item, xs)),
              Shared.Bool.and_true_left(
                Bool.and(Nat.is_lt(l, u1), Bool.not(List.is_empty(&2, Item, xs))),
                Items.fit(xs, lo1, hi1),
                e
              )
            )
          )(Shared.Bool.and_true_left(Nat.is_le(u1, u2), Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2)), w)),
          Shared.Bool.and_true_right(
            Nat.is_lt(l, u1),
            Bool.not(List.is_empty(&2, Item, xs)),
            Shared.Bool.and_true_left(
              Bool.and(Nat.is_lt(l, u1), Bool.not(List.is_empty(&2, Item, xs))),
              Items.fit(xs, lo1, hi1),
              e
            )
          )
        ),
        Mst.fit_wide(
          xs,
          lo1,
          lo2,
          hi1,
          hi2,
          Shared.Bool.and_true_left(
            Mst.lo_le(lo2, lo1),
            Mst.hi_le(hi1, hi2),
            Shared.Bool.and_true_right(Nat.is_le(u1, u2), Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2)), w)
          ),
          Shared.Bool.and_true_right(
            Mst.lo_le(lo2, lo1),
            Mst.hi_le(hi1, hi2),
            Shared.Bool.and_true_right(Nat.is_le(u1, u2), Bool.and(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2)), w)
          )
        )(Shared.Bool.and_true_right(Bool.and(Nat.is_lt(l, u1), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo1, hi1), e))
      )

# no number is below 0
def Mst.nat_lt_zero(l: Nat) -> {Nat.is_lt(l, 0n) == True{}: Bool} -> Empty:
  match l:
    case 0n:
      +e => Shared.Bool.false_ne_true(e)
    case 1n+p:
      +e => Shared.Bool.false_ne_true(e)

# the level of a node that opens in a room is below its up
def Mst.opens_lt(+l: Nat, -left: Maybe<&2, Hashes.Hash>, +xs: List<&2, Item>, r: Room) -> {
  Mst.opens(Node{l, left, xs}, r) == True{}: Bool
} -> {Nat.is_lt(l, Mst.room_up(r)) == True{}: Bool}:
  match r:
    case Room{+up, +lo, +hi}:
      +e => Shared.Bool.and_true_left(
        Nat.is_lt(l, up),
        Bool.not(List.is_empty(&2, Item, xs)),
        Shared.Bool.and_true_left(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi), e)
      )

# the nodes that a tree m may have at its root in r1 may sit there in r2
def Mst.Hop(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  m: Maybe<&2, Hashes.Hash>,
  -r1: Room,
  -r2: Room
) -> Type:
  match m:
    case None{}:
      Unit
    case Some{h}:
      @n: Node -> {Mst.node(~S, ~fetch, s, h) == Some{n}: Maybe<&2, Node>} -> {Mst.opens(n, r1) == True{}: Bool} -> {
        Mst.opens(n, r2) == True{}: Bool
      }

# a hit tells the same, whatever node it names when it cannot tell
def Mst.look.hit_kept(b: Bool, -v: List<&2, U32>, -h1: Hashes.Hash, -h2: Hashes.Hash, -x: Maybe<&2, List<&2, U32>>) -> {
  Look.known(Shared.Bool.when(Look, b, u => Look.Found{v}, u => Look.Missing{h1})) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Shared.Bool.when(Look, b, u => Look.Found{v}, u => Look.Missing{h2})) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match b:
    case True{}:
      e => e
    case False{}:
      e => Empty.absurd(
        {Look.known(Look.Missing{h2}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )

# a read of a pick tells as a read of a pick in a wider room
def Mst.look.wide.pick(
  +l: Nat,
  +p1: Pick,
  +p2: Pick,
  -h: Hashes.Hash,
  -h2: Hashes.Hash,
  +k: List<&2, U32>,
  -goa: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -gob: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -x: Maybe<&2, List<&2, U32>>,
  ps: Mst.PickSub(l, p1, p2),
  hg: @m: Maybe<&2, Hashes.Hash> -> @r1: Room -> @r2: Room -> {Mst.room_le(r1, r2) == True{}: Bool} -> {
    Mst.room_up(r2) == l: Nat
  } -> {Look.known(goa(m)(r1)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
    Look.known(gob(m)(r2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(Mst.look.pick(p1, h, l, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.pick(p2, h2, l, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match p1 p2:
    case Pick.Hit{+v1} Pick.Hit{+v2}:
      %ps: (
        {Look.known(Mst.look.pick(Pick.Hit{v1}, h, l, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.pick(Pick.Hit{_}, h2, l, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      Mst.look.hit_kept(Nat.is_eq(Key.level(k), l), v1, h, h2, x)
    case Pick.Down{+m1, +r1} Pick.Down{+m2, +r2}:
      match ps:
        case Tuple{+em, +eo}:
          %em: (
            {Look.known(goa(m1)(r1)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
              -> {Look.known(gob(_)(r2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          )
          hg(m1)(r1)(r2)(Shared.Bool.and_true_left(Mst.room_le(r1, r2), Nat.is_eq(Mst.room_up(r2), l), eo))(
            Shared.Nat.is_eq_sound(Mst.room_up(r2), l)(Shared.Bool.and_true_right(Mst.room_le(r1, r2), Nat.is_eq(Mst.room_up(r2), l), eo))
          )
    case Pick.Hit{+v1} Pick.Down{+m2, +r2}:
      +e => Empty.absurd(
        {Look.known(Mst.look.pick(Pick.Down{m2, r2}, h2, l, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        ps
      )
    case Pick.Down{+m1, +r1} Pick.Hit{+v2}:
      +e => Empty.absurd(
        {Look.known(Mst.look.pick(Pick.Hit{v2}, h2, l, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        ps
      )

# a read of a node tells as a read of it in a room with wider bounds
def Mst.look.wide.at(
  -h: Hashes.Hash,
  +na: Maybe<&2, Node>,
  +r1: Room,
  +r2: Room,
  -nb: Maybe<&2, Node>,
  +k: List<&2, U32>,
  -goa: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -gob: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -x: Maybe<&2, List<&2, U32>>,
  -p2: Nat,
  +wb: {Mst.bounds_le(r1, r2) == True{}: Bool},
  hn: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> {nb == Some{n}: Maybe<&2, Node>},
  hl: @l: Nat -> @left: Maybe<&2, Hashes.Hash> -> @xs: List<&2, Item> -> {
    nb == Some{Node{l, left, xs}}: Maybe<&2, Node>
  } -> {Nat.is_le(l, p2) == True{}: Bool},
  hg: @m: Maybe<&2, Hashes.Hash> -> @r3: Room -> @r4: Room -> {Mst.room_le(r3, r4) == True{}: Bool} -> {
    Nat.is_le(Mst.room_up(r4), p2) == True{}: Bool
  } -> {Look.known(goa(m)(r3)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
    Look.known(gob(m)(r4)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(Mst.look.at(h, na, r1, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.at(h, nb, r2, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match na r1 r2:
    case None{} +r5 +r6:
      +e => Empty.absurd(
        {Look.known(Mst.look.at(h, nb, r6, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case Some{Node{+l, +left, +xs}} Room{+u1, +lo1, +hi1} Room{+u2, +lo2, +hi2}:
      +enb = hn(Node{l, left, xs})({==})
      %Equal.sym(Maybe<&2, Node>, nb, Some{Node{l, left, xs}}, enb): (
        {Look.known(Mst.look.at(h, Some{Node{l, left, xs}}, Room{u1, lo1, hi1}, k, goa)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.at(h, _, Room{u2, lo2, hi2}, k, gob)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      Mst.look.wide.pick(
        l,
        Mst.pick(xs, left, l, lo1, hi1, k),
        Mst.pick(xs, left, l, lo2, hi2, k),
        h,
        h,
        k,
        goa,
        gob,
        x,
        Mst.pick_wide(
          xs,
          left,
          l,
          lo1,
          lo2,
          hi1,
          hi2,
          k,
          Shared.Bool.and_true_left(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2), wb),
          Shared.Bool.and_true_right(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2), wb)
        ),
        m => r3 => r4 => w => eu => hg(m)(r3)(r4)(w)(
          Equal.trans(
            Bool,
            Nat.is_le(Mst.room_up(r4), p2),
            Nat.is_le(l, p2),
            True{},
            Equal.cong(Nat, Bool, a => Nat.is_le(a, p2), Mst.room_up(r4), l, eu),
            hl(l)(left)(xs)(enb)
          )
        )
      )

# a read of a node that cannot open tells nothing
def Mst.look.at_none(
  -h: Hashes.Hash,
  +na: Maybe<&2, Node>,
  +r: Room,
  -k: List<&2, U32>,
  -go: Maybe<&2, Hashes.Hash> -> Room -> Look,
  -x: Maybe<&2, List<&2, U32>>,
  hz: @n: Node -> {na == Some{n}: Maybe<&2, Node>} -> Empty
) -> {Look.known(Mst.look.at(h, na, r, k, go)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> Empty:
  match na r:
    case None{} Room{+u, +lo, +hi}:
      +e => Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
    case Some{+n} Room{+u, +lo, +hi}:
      +e => hz(n)({==})

# no node opens in a room whose up is 0
def Mst.opens_zero(n: Node, r: Room, o: {Mst.opens(n, r) == True{}: Bool}, fu: {Nat.is_le(Mst.room_up(r), 0n) == True{}: Bool}) -> Empty:
  match n r:
    case Node{+l, +left, +xs} Room{+up, +lo, +hi}:
      Mst.nat_lt_zero(l)(
        Shared.Nat.lt_le(l, up, 0n)(
          Shared.Bool.and_true_left(
            Nat.is_lt(l, up),
            Bool.not(List.is_empty(&2, Item, xs)),
            Shared.Bool.and_true_left(Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi), o)
          )
        )(fu)
      )

# a root may sit in a wider room
def Mst.hop_of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  +m: Maybe<&2, Hashes.Hash>,
  +r1: Room,
  +r2: Room,
  +w: {Mst.room_le(r1, r2) == True{}: Bool}
) -> Mst.Hop(~S, ~fetch, s, m, r1, r2):
  match m:
    case None{}:
      Unit{}
    case Some{+h}:
      n => +e => +o => Mst.opens_wide(n, r1, r2)(o)(w)

# what a read tells, a read in a room with wider bounds, where the root may
# sit too, tells: with any fuel that reaches the room
def Mst.look.wide(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g2: Nat,
  +g1: Nat,
  +m: Maybe<&2, Hashes.Hash>,
  +s: S,
  +r1: Room,
  +r2: Room,
  +k: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  hop: Mst.Hop(~S, ~fetch, s, m, r1, r2),
  +wb: {Mst.bounds_le(r1, r2) == True{}: Bool},
  +fu: {Nat.is_le(Mst.room_up(r2), g2) == True{}: Bool}
) -> {
  Look.known(Mst.look.go(~S, ~fetch, g1, s, r1, m, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, r2, m, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g2 g1 m:
    case +y +z None{}:
      +e => e
    case +y 0n Some{+h}:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, r2, Some{h}, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 0n 1n+p1 Some{+h}:
      +e => Empty.absurd(
        {Look.known(Look.Missing{h}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.look.at_none(
          h,
          Mst.node.in(~S, ~fetch, s, h, r1),
          r1,
          k,
          +m2 => +r3 => Mst.look.go(~S, ~fetch, p1, s, r3, m2, k),
          x,
          +n => +en => Mst.opens_zero(
            n,
            r2,
            hop(n)(Mst.in_node(~S, ~fetch, s, h, r1, n)(en))(Mst.in_open(~S, ~fetch, s, h, r1, n)(en)),
            fu
          )
        )(e)
      )
    case 1n+(+p2) 1n+p1 Some{+h}:
      Mst.look.wide.at(
        h,
        Mst.node.in(~S, ~fetch, s, h, r1),
        r1,
        r2,
        Mst.node.in(~S, ~fetch, s, h, r2),
        k,
        +m2 => +r3 => Mst.look.go(~S, ~fetch, p1, s, r3, m2, k),
        +m2 => +r3 => Mst.look.go(~S, ~fetch, p2, s, r3, m2, k),
        x,
        p2,
        wb,
        +n => +en => Mst.node_in_of(~S, ~fetch, s, h, r2, n)(Mst.in_node(~S, ~fetch, s, h, r1, n)(en))(
          hop(n)(Mst.in_node(~S, ~fetch, s, h, r1, n)(en))(Mst.in_open(~S, ~fetch, s, h, r1, n)(en))
        ),
        +l => +left => +xs => +en => Shared.Nat.lt_succ_le(l, p2)(
          Shared.Nat.lt_le(l, Mst.room_up(r2), 1n+p2)(
            Mst.opens_lt(l, left, xs, r2)(Mst.in_open(~S, ~fetch, s, h, r2, Node{l, left, xs})(en))
          )(fu)
        ),
        +m2 => +r3 => +r4 => +w => +f => Mst.look.wide(
          ~S,
          ~fetch,
          p2,
          p1,
          m2,
          s,
          r3,
          r4,
          k,
          x,
          Mst.hop_of(~S, ~fetch, s, m2, r3, r4, w),
          Mst.room_bounds(r3, r4)(w),
          f
        )
      )

# a read of a node that opens in its room is the read of its pick
def Mst.look_node(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +p: Nat,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +k: List<&2, U32>,
  +e: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +o: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool}
) -> {
  Mst.look.go(~S, ~fetch, 1n+p, s, Room{u, lo, hi}, Some{h}, k)
    == Mst.look.pick(Mst.pick(xs, left, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k)): Look
}:
  %Equal.sym(
    Maybe<&2, Node>,
    Mst.node.in(~S, ~fetch, s, h, Room{u, lo, hi}),
    Some{Node{l, left, xs}},
    Mst.node_in_of(~S, ~fetch, s, h, Room{u, lo, hi}, Node{l, left, xs})(e)(o)
  ): {
    Mst.look.at(h, _, Room{u, lo, hi}, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k))
      == Mst.look.pick(Mst.pick(xs, left, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k)): Look
  }
  {==}

# the level of the root of the node mn, if any, is below u
def Mst.lvl.at(mn: Maybe<&2, Node>, +u: Nat) -> Bool:
  match mn:
    case None{}:
      True{}
    case Some{Node{l, left, xs}}:
      Nat.is_lt(l, u)

# the level of the root of the tree m, if the depot gives it, is below u
def Mst.lvl(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +s: S, m: Maybe<&2, Hashes.Hash>, +u: Nat) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{h}:
      Mst.lvl.at(Mst.node(~S, ~fetch, s, h), u)

# the level of a root whose level is below u
def Mst.lvl_lt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +l: Nat,
  -left: Maybe<&2, Hashes.Hash>,
  -xs: List<&2, Item>,
  +lv: {Mst.lvl(~S, ~fetch, s, Some{h}, u) == True{}: Bool},
  +e: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>}
) -> {Nat.is_lt(l, u) == True{}: Bool}:
  %e: {Mst.lvl.at(_, u) == True{}: Bool}
  lv

# a root whose level is below u
def Mst.lvl_of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +l: Nat,
  -left: Maybe<&2, Hashes.Hash>,
  -xs: List<&2, Item>,
  +e: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +lt: {Nat.is_lt(l, u) == True{}: Bool}
) -> {Mst.lvl(~S, ~fetch, s, Some{h}, u) == True{}: Bool}:
  %Equal.sym(Maybe<&2, Node>, Mst.node(~S, ~fetch, s, h), Some{Node{l, left, xs}}, e): {Mst.lvl.at(_, u) == True{}: Bool}
  lt

# a root whose level is below u2 and that opens in r1 opens in a room of the
# up u2 with wider bounds
def Mst.opens_lvl(
  n: Node,
  r1: Room,
  r2: Room,
  +lt: {Mst.lvl.at(Some{n}, Mst.room_up(r2)) == True{}: Bool},
  +wb: {Mst.bounds_le(r1, r2) == True{}: Bool}
) -> {Mst.opens(n, r1) == True{}: Bool} -> {Mst.opens(n, r2) == True{}: Bool}:
  match n r1 r2:
    case Node{+l, +left, +xs} Room{+u1, +lo1, +hi1} Room{+u2, +lo2, +hi2}:
      +o => Shared.Bool.and_both(
        Bool.and(Nat.is_lt(l, u2), Bool.not(List.is_empty(&2, Item, xs))),
        Items.fit(xs, lo2, hi2),
        Shared.Bool.and_both(
          Nat.is_lt(l, u2),
          Bool.not(List.is_empty(&2, Item, xs)),
          lt,
          Shared.Bool.and_true_right(
            Nat.is_lt(l, u1),
            Bool.not(List.is_empty(&2, Item, xs)),
            Shared.Bool.and_true_left(Bool.and(Nat.is_lt(l, u1), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo1, hi1), o)
          )
        ),
        Mst.fit_wide(
          xs,
          lo1,
          lo2,
          hi1,
          hi2,
          Shared.Bool.and_true_left(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2), wb),
          Shared.Bool.and_true_right(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2), wb)
        )(Shared.Bool.and_true_right(Bool.and(Nat.is_lt(l, u1), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo1, hi1), o))
      )

# a root whose level is below the up of r2 may sit in r2, of wider bounds
def Mst.hop_lvl(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +r1: Room,
  +r2: Room,
  +lv: {Mst.lvl(~S, ~fetch, s, m, Mst.room_up(r2)) == True{}: Bool},
  +wb: {Mst.bounds_le(r1, r2) == True{}: Bool}
) -> Mst.Hop(~S, ~fetch, s, m, r1, r2):
  match m:
    case None{}:
      Unit{}
    case Some{+h}:
      +n => +e => Mst.opens_lvl(
        n,
        r1,
        r2,
        Equal.trans(
          Bool,
          Mst.lvl.at(Some{n}, Mst.room_up(r2)),
          Mst.lvl.at(Mst.node(~S, ~fetch, s, h), Mst.room_up(r2)),
          True{},
          Equal.cong(
            Maybe<&2, Node>,
            Bool,
            a => Mst.lvl.at(a, Mst.room_up(r2)),
            Some{n},
            Mst.node(~S, ~fetch, s, h),
            Equal.sym(Maybe<&2, Node>, Mst.node(~S, ~fetch, s, h), Some{n}, e)
          ),
          lv
        ),
        wb
      )

# items with their last subtree set, then more, fit as before
def Mst.fit_set_last_append(
  +xs: List<&2, Item>,
  -m: Maybe<&2, Hashes.Hash>,
  -ys: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {
  Items.fit(List.append(&2, Item, Mst.set_last(xs, m), ys), lo, hi) == Items.fit(List.append(&2, Item, xs, ys), lo, hi): Bool
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      %Equal.sym(
        Bool,
        Items.fit(List.append(&2, Item, Mst.set_last(y <> rest, m), ys), Some{k}, hi),
        Items.fit(List.append(&2, Item, y <> rest, ys), Some{k}, hi),
        Mst.fit_set_last_append(y <> rest, m, ys, Some{k}, hi)
      ): {
        Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), _)
          == Items.fit(List.append(&2, Item, Item{k, v, r} <> y <> rest, ys), lo, hi): Bool
      }
      {==}

# items with their last subtree set, then more, are as empty as before
def Mst.empty_set_last_append(+xs: List<&2, Item>, -m: Maybe<&2, Hashes.Hash>, -ys: List<&2, Item>) -> {
  List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xs, m), ys)) == List.is_empty(&2, Item, List.append(&2, Item, xs, ys)): Bool
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      {==}

# a node with the last subtree of its first items set opens where it did
def Mst.opens_set_last(
  +l: Nat,
  -left1: Maybe<&2, Hashes.Hash>,
  -left2: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +m: Maybe<&2, Hashes.Hash>,
  +ys: List<&2, Item>,
  r: Room
) -> {Mst.opens(Node{l, left1, List.append(&2, Item, xs, ys)}, r) == True{}: Bool} -> {
  Mst.opens(Node{l, left2, List.append(&2, Item, Mst.set_last(xs, m), ys)}, r) == True{}: Bool
}:
  match r:
    case Room{+u, +lo, +hi}:
      %Equal.sym(
        Bool,
        List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xs, m), ys)),
        List.is_empty(&2, Item, List.append(&2, Item, xs, ys)),
        Mst.empty_set_last_append(xs, m, ys)
      ): (
        {Mst.opens(Node{l, left1, List.append(&2, Item, xs, ys)}, Room{u, lo, hi}) == True{}: Bool}
          -> {
            Bool.and(
              Bool.and(Nat.is_lt(l, u), Bool.not(_)),
              Items.fit(List.append(&2, Item, Mst.set_last(xs, m), ys), lo, hi)
            )
              == True{}: Bool
          }
      )
      %Equal.sym(
        Bool,
        Items.fit(List.append(&2, Item, Mst.set_last(xs, m), ys), lo, hi),
        Items.fit(List.append(&2, Item, xs, ys), lo, hi),
        Mst.fit_set_last_append(xs, m, ys, lo, hi)
      ): (
        {Mst.opens(Node{l, left1, List.append(&2, Item, xs, ys)}, Room{u, lo, hi}) == True{}: Bool}
          -> {
            Bool.and(Bool.and(Nat.is_lt(l, u), Bool.not(List.is_empty(&2, Item, List.append(&2, Item, xs, ys)))), _)
              == True{}: Bool
          }
      )
      +o => o

# a node of items that are not empty is stored
def Mst.make_full(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +ys: List<&2, Item>,
  +acc: List<&2, List<&2, U32>>
) -> {List.is_empty(&2, Item, ys) == False{}: Bool} -> {Mst.make(l, left, ys, acc) == Mst.store(Node{l, left, ys}, acc): Edit}:
  match ys:
    case Nil{}:
      +e => Empty.absurd({Edit{left, acc} == Mst.store(Node{l, left, []}, acc): Edit}, Shared.Bool.true_ne_false(e))
    case Con{+y, +rest}:
      +e => {==}

# items that a pick does not pass are not empty
def Mst.end_left_full(
  +xs: List<&2, Item>,
  -left: Maybe<&2, Hashes.Hash>,
  -m: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>
) -> {Mst.passes(xs, k2) == False{}: Bool} -> {Mst.end_left(xs, left, m) == left: Maybe<&2, Hashes.Hash>}:
  match xs:
    case Nil{}:
      +e => Empty.absurd({m == left: Maybe<&2, Hashes.Hash>}, Shared.Bool.true_ne_false(e))
    case Con{+x, +rest}:
      +e => {==}

# a pick that passes the first items, with their last subtree set to m, goes
# on from m
def Mst.pick_set_passes(
  +pre: List<&2, Item>,
  +m: Maybe<&2, Hashes.Hash>,
  +post: List<&2, Item>,
  +left: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  +e: {Mst.passes(pre, k2) == True{}: Bool}
) -> {
  Mst.pick(List.append(&2, Item, Mst.set_last(pre, m), post), Mst.end_left(pre, left, m), l, lo, hi, k2)
    == Mst.pick(post, m, l, Items.last_key(pre, lo), hi, k2): Pick
}:
  Equal.trans(
    Pick,
    Mst.pick(List.append(&2, Item, Mst.set_last(pre, m), post), Mst.end_left(pre, left, m), l, lo, hi, k2),
    Mst.pick(post, Mst.last(Mst.set_last(pre, m), Mst.end_left(pre, left, m)), l, Items.last_key(Mst.set_last(pre, m), lo), hi, k2),
    Mst.pick(post, m, l, Items.last_key(pre, lo), hi, k2),
    Mst.pick_passes(Mst.set_last(pre, m), post, Mst.end_left(pre, left, m), l, lo, hi, k2)(
      Equal.trans(Bool, Mst.passes(Mst.set_last(pre, m), k2), Mst.passes(pre, k2), True{}, Mst.passes_set_last(pre, m, k2), e)
    ),
    Equal.trans(
      Pick,
      Mst.pick(post, Mst.last(Mst.set_last(pre, m), Mst.end_left(pre, left, m)), l, Items.last_key(Mst.set_last(pre, m), lo), hi, k2),
      Mst.pick(post, m, l, Items.last_key(Mst.set_last(pre, m), lo), hi, k2),
      Mst.pick(post, m, l, Items.last_key(pre, lo), hi, k2),
      Equal.cong(
        Maybe<&2, Hashes.Hash>,
        Pick,
        a => Mst.pick(post, a, l, Items.last_key(Mst.set_last(pre, m), lo), hi, k2),
        Mst.last(Mst.set_last(pre, m), Mst.end_left(pre, left, m)),
        m,
        Mst.last_set_last(pre, left, m)
      ),
      Equal.cong(
        Maybe<&2, List<&2, U32>>,
        Pick,
        a => Mst.pick(post, m, l, a, hi, k2),
        Items.last_key(Mst.set_last(pre, m), lo),
        Items.last_key(pre, lo),
        Mst.last_key_set_last(pre, m, lo)
      )
    )
  )

# a read of a pick tells as a read of the same pick between wider bounds,
# in any fuel that reaches the level of the node
def Mst.look.same_pick(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +p1: Nat,
  +p2: Nat,
  +s: S,
  +xs: List<&2, Item>,
  +left: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  -h1: Hashes.Hash,
  -h2: Hashes.Hash,
  +k: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool},
  +fl: {Nat.is_le(l, p2) == True{}: Bool}
) -> {
  Look.known(Mst.look.pick(Mst.pick(xs, left, l, lo1, hi1, k), h1, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k)))
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {
  Look.known(Mst.look.pick(Mst.pick(xs, left, l, lo2, hi2, k), h2, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k)))
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  Mst.look.wide.pick(
    l,
    Mst.pick(xs, left, l, lo1, hi1, k),
    Mst.pick(xs, left, l, lo2, hi2, k),
    h1,
    h2,
    k,
    m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k),
    m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k),
    x,
    Mst.pick_wide(xs, left, l, lo1, lo2, hi1, hi2, k, wl, wh),
    +m2 => +r3 => +r4 => +w => +eu => Mst.look.wide(
      ~S,
      ~fetch,
      p2,
      p1,
      m2,
      s,
      r3,
      r4,
      k,
      x,
      Mst.hop_of(~S, ~fetch, s, m2, r3, r4, w),
      Mst.room_bounds(r3, r4)(w),
      Equal.trans(
        Bool,
        Nat.is_le(Mst.room_up(r4), p2),
        Nat.is_le(l, p2),
        True{},
        Equal.cong(Nat, Bool, a => Nat.is_le(a, p2), Mst.room_up(r4), l, eu),
        fl
      )
    )
  )

# Mst.gap_kept, once a pick passes the items before the gap (b2: whether the
# pick stops at the first item after it)
def Mst.gap_kept.first(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b2: Bool,
  +p1: Nat,
  +p2: Nat,
  +s: S,
  +post: List<&2, Item>,
  +g: Maybe<&2, Hashes.Hash>,
  +nc: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lk1: Maybe<&2, List<&2, U32>>,
  +lk2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  -h1: Hashes.Hash,
  -h2: Hashes.Hash,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eb: {Mst.stops_first(post, k2) == b2: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool},
  +fl: {Nat.is_le(l, p2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, lk1, Items.head_key(post, hi1)}, g, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, lk2, Items.head_key(post, hi2)}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
) -> {
  Look.known(Mst.look.pick(Mst.pick(post, g, l, lk1, hi1, k2), h1, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {
  Look.known(Mst.look.pick(Mst.pick(post, nc, l, lk2, hi2, k2), h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match b2:
    case True{}:
      %Equal.sym(
        Pick,
        Mst.pick(post, g, l, lk1, hi1, k2),
        Pick.Down{g, Room.of(l, lk1, Items.head_key(post, hi1))},
        Mst.pick_first(post, g, l, lk1, hi1, k2)(eb)
      ): (
        {
          Look.known(Mst.look.pick(_, h1, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(Mst.pick(post, nc, l, lk2, hi2, k2), h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(post, nc, l, lk2, hi2, k2),
        Pick.Down{nc, Room.of(l, lk2, Items.head_key(post, hi2))},
        Mst.pick_first(post, nc, l, lk2, hi2, k2)(eb)
      ): (
        {
          Look.known(Mst.look.pick(Pick.Down{g, Room.of(l, lk1, Items.head_key(post, hi1))}, h1, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      ih(p1)(p2)(fl)
    case False{}:
      %Mst.pick_past(post, g, nc, l, lk1, lk2, hi2, k2)(eb): (
        {
          Look.known(Mst.look.pick(Mst.pick(post, g, l, lk1, hi1, k2), h1, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.look.same_pick(~S, ~fetch, p1, p2, s, post, g, l, lk1, lk1, hi1, hi2, h1, h2, k2, x, Mst.lo_le_refl(lk1), wh, fl)

# Mst.gap_kept, by whether a pick passes the items before the gap (b)
def Mst.gap_kept.passes(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +p1: Nat,
  +p2: Nat,
  +s: S,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +left: Maybe<&2, Hashes.Hash>,
  +nc: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  -h1: Hashes.Hash,
  -h2: Hashes.Hash,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eb: {Mst.passes(pre, k2) == b: Bool},
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool},
  +fl: {Nat.is_le(l, p2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Items.last_key(pre, lo1), Items.head_key(post, hi1)}, Mst.last(pre, left), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Items.last_key(pre, lo2), Items.head_key(post, hi2)}, nc, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(
    Mst.look.pick(
      Mst.pick(List.append(&2, Item, pre, post), left, l, lo1, hi1, k2),
      h1,
      l,
      k2,
      m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
    )
  )
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {
  Look.known(
    Mst.look.pick(
      Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), Mst.end_left(pre, left, nc), l, lo2, hi2, k2),
      h2,
      l,
      k2,
      m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
    )
  )
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match b:
    case True{}:
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, pre, post), left, l, lo1, hi1, k2),
        Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo1), hi1, k2),
        Mst.pick_passes(pre, post, left, l, lo1, hi1, k2)(eb)
      ): (
        {
          Look.known(Mst.look.pick(_, h1, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), Mst.end_left(pre, left, nc), l, lo2, hi2, k2),
                h2,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), Mst.end_left(pre, left, nc), l, lo2, hi2, k2),
        Mst.pick(post, nc, l, Items.last_key(pre, lo2), hi2, k2),
        Mst.pick_set_passes(pre, nc, post, left, l, lo2, hi2, k2, eb)
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo1), hi1, k2),
              h1,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.gap_kept.first(
        ~S,
        ~fetch,
        Mst.stops_first(post, k2),
        p1,
        p2,
        s,
        post,
        Mst.last(pre, left),
        nc,
        l,
        Items.last_key(pre, lo1),
        Items.last_key(pre, lo2),
        hi1,
        hi2,
        h1,
        h2,
        k2,
        x,
        {==},
        wh,
        fl,
        ih
      )
    case False{}:
      %Equal.sym(
        Maybe<&2, Hashes.Hash>,
        Mst.end_left(pre, left, nc),
        left,
        Mst.end_left_full(pre, left, nc, k2)(eb)
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo1, hi1, k2),
              h1,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), _, l, lo2, hi2, k2),
                h2,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), left, l, lo2, hi2, k2),
        Mst.pick(List.append(&2, Item, pre, post), left, l, lo2, hi2, k2),
        Mst.pick_stops_set(pre, nc, post, post, left, l, lo2, hi2, hi2, k2)(eb)
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo1, hi1, k2),
              h1,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.look.same_pick(~S, ~fetch, p1, p2, s, List.append(&2, Item, pre, post), left, l, lo1, lo2, hi1, hi2, h1, h2, k2, x, wl, wh, fl)

# no node opens below a fuel of 0
def Mst.opens_fuel(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +o: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, 0n) == True{}: Bool}
) -> Empty:
  Mst.nat_lt_zero(l)(Shared.Nat.lt_le(l, u, 0n)(Mst.opens_lt(l, left, xs, Room{u, lo, hi})(o))(fu))

# the level of a node that opens below a fuel of 1+p is at most p
def Mst.opens_fl(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +p: Nat,
  +o: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, 1n+p) == True{}: Bool}
) -> {Nat.is_le(l, p) == True{}: Bool}:
  Shared.Nat.lt_succ_le(l, p)(Shared.Nat.lt_le(l, u, 1n+p)(Mst.opens_lt(l, left, xs, Room{u, lo, hi})(o))(fu))

# a node with one gap replaced reads every key as before, but in the gap,
# where it reads as ih says
def Mst.gap_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +h2: Hashes.Hash,
  +u1: Nat,
  +u2: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{u1, lo1, hi1}) == True{}: Bool},
  +eN2: {
    Mst.node(~S, ~fetch, s, h2)
      == Some{Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}}: Maybe<&2, Node>
  },
  +oN2: {
    Mst.opens(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, Room{u2, lo2, hi2})
      == True{}: Bool
  },
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool},
  +fu: {Nat.is_le(u2, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Items.last_key(pre, lo1), Items.head_key(post, hi1)}, Mst.last(pre, left), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Items.last_key(pre, lo2), Items.head_key(post, hi2)}, nc, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, lo1, hi1}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, lo2, hi2}, Some{h2}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{u2, lo2, hi2}, Some{h2}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{h2}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), post),
          u2,
          lo2,
          hi2,
          oN2,
          fu
        )
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{u1, lo1, hi1}, Some{h}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, pre, post), left, l, lo1, hi1, k2),
          h,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
        ),
        Mst.look_node(~S, ~fetch, p1, s, h, u1, lo1, hi1, l, left, List.append(&2, Item, pre, post), k2, eN, oN)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u2, lo2, hi2}, Some{h2}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u2, lo2, hi2}, Some{h2}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), Mst.end_left(pre, left, nc), l, lo2, hi2, k2),
          h2,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p2,
          s,
          h2,
          u2,
          lo2,
          hi2,
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), post),
          k2,
          eN2,
          oN2
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo1, hi1, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      Mst.gap_kept.passes(
        ~S,
        ~fetch,
        Mst.passes(pre, k2),
        p1,
        p2,
        s,
        pre,
        post,
        left,
        nc,
        l,
        lo1,
        lo2,
        hi1,
        hi2,
        h,
        h2,
        k2,
        x,
        {==},
        wl,
        wh,
        Mst.opens_fl(
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), post),
          u2,
          lo2,
          hi2,
          p2,
          oN2,
          fu
        ),
        ih
      )

# a node with one gap replaced tells of the key k what ih tells, when a
# pick of k passes the items before the gap and stops at the first after it
def Mst.gap_k(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g: Nat,
  +s: S,
  +h2: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN2: {
    Mst.node(~S, ~fetch, s, h2)
      == Some{Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}}: Maybe<&2, Node>
  },
  +oN2: {
    Mst.opens(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, Room{u, lo, hi})
      == True{}: Bool
  },
  +fu: {Nat.is_le(u, g) == True{}: Bool},
  +ep: {Mst.passes(pre, k) == True{}: Bool},
  +es: {Mst.stops_first(post, k) == True{}: Bool},
  ih: @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, nc, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g, s, Room{u, lo, hi}, Some{h2}, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g:
    case 0n:
      Empty.absurd(
        {Look.known(Look.Missing{h2}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), post),
          u,
          lo,
          hi,
          oN2,
          fu
        )
      )
    case 1n+(+p):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p, s, Room{u, lo, hi}, Some{h2}, k),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), Mst.end_left(pre, left, nc), l, lo, hi, k),
          h2,
          l,
          k,
          m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p,
          s,
          h2,
          u,
          lo,
          hi,
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), post),
          k,
          eN2,
          oN2
        )
      ): {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), post), Mst.end_left(pre, left, nc), l, lo, hi, k),
        Mst.pick(post, nc, l, Items.last_key(pre, lo), hi, k),
        Mst.pick_set_passes(pre, nc, post, left, l, lo, hi, k, ep)
      ): {Look.known(Mst.look.pick(_, h2, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k))) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      %Equal.sym(
        Pick,
        Mst.pick(post, nc, l, Items.last_key(pre, lo), hi, k),
        Pick.Down{nc, Room.of(l, Items.last_key(pre, lo), Items.head_key(post, hi))},
        Mst.pick_first(post, nc, l, Items.last_key(pre, lo), hi, k)(es)
      ): {Look.known(Mst.look.pick(_, h2, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k))) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      ih(p)(
        Mst.opens_fl(
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), post),
          u,
          lo,
          hi,
          p,
          oN2,
          fu
        )
      )

# what a read of a node in one room tells, a read of it in a room where it
# opens tells, with any fuel that reaches that room
def Mst.reroom(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +g: Nat,
  +s: S,
  +h: Hashes.Hash,
  +r1: Room,
  +r2: Room,
  +n: Node,
  +k: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +en: {Mst.node.in(~S, ~fetch, s, h, r2) == Some{n}: Maybe<&2, Node>},
  +wb: {Mst.bounds_le(r1, r2) == True{}: Bool},
  +fu: {Nat.is_le(Mst.room_up(r2), g) == True{}: Bool}
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, r1, Some{h}, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g, s, r2, Some{h}, k)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  Mst.look.wide(
    ~S,
    ~fetch,
    g,
    g1,
    Some{h},
    s,
    r1,
    r2,
    k,
    x,
    +n2 => +e2 => +o =>
      %Shared.Maybe.some_inj(
        Node,
        n,
        n2,
        Equal.trans(
          Maybe<&2, Node>,
          Some{n},
          Mst.node(~S, ~fetch, s, h),
          Some{n2},
          Equal.sym(Maybe<&2, Node>, Mst.node(~S, ~fetch, s, h), Some{n}, Mst.in_node(~S, ~fetch, s, h, r2, n)(en)),
          e2
        )
      ): {Mst.opens(_, r2) == True{}: Bool}
      Mst.in_open(~S, ~fetch, s, h, r2, n)(en),
    wb,
    fu
  )

# a read of the empty tree finds the key absent
def Mst.look_none(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g: Nat,
  -s: S,
  -r: Room,
  -k: List<&2, U32>
) -> {Mst.look.go(~S, ~fetch, g, s, r, None{}, k) == Look.Absent{}: Look}:
  match g:
    case 0n:
      {==}
    case 1n+p:
      {==}

# a key after k passes every key before k
def Mst.passes_of_le(xs: List<&2, Item>, +k: List<&2, U32>, +k2: List<&2, U32>) -> {Mst.all_lt(xs, k) == True{}: Bool} -> {
  Cmp.is_le(Key.cmp(k, k2)) == True{}: Bool
} -> {Mst.passes(xs, k2) == True{}: Bool}:
  match xs:
    case Nil{}:
      +a => +e => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +a => +e => Shared.Bool.and_both(
        Cmp.is_gt(Key.cmp(k2, ik)),
        Mst.passes(rest, k2),
        Equal.cong(
          Cmp,
          Bool,
          Cmp.is_gt,
          Key.cmp(k2, ik),
          GT{},
          Mst.key_lt_gt(ik, k2)(
            Mst.key_lt_le(ik, k, k2)(
              Mst.lt_sound(Key.cmp(ik, k))(Shared.Bool.and_true_left(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))
            )(e)
          )
        ),
        Mst.passes_of_le(rest, k, k2)(Shared.Bool.and_true_right(Cmp.is_lt(Key.cmp(ik, k)), Mst.all_lt(rest, k), a))(e)
      )

# a pick that passes every item goes down after the last
def Mst.pick_all(
  +xs: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.passes(xs, k2) == True{}: Bool} -> {
  Mst.pick(xs, prev, l, lo, hi, k2) == Pick.Down{Mst.last(xs, prev), Room.of(l, Items.last_key(xs, lo), hi)}: Pick
}:
  match xs:
    case Nil{}:
      +e => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +e =>
        %Equal.sym(
          Cmp,
          Key.cmp(k2, ik),
          GT{},
          Mst.gt_sound(Key.cmp(k2, ik))(Shared.Bool.and_true_left(Cmp.is_gt(Key.cmp(k2, ik)), Mst.passes(rest, k2), e))
        ): {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(_),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(_), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k2))
          )
            == Pick.Down{Mst.last(rest, r), Room.of(l, Items.last_key(rest, Some{ik}), hi)}: Pick
        }
        Mst.pick_all(rest, r, l, Some{ik}, hi, k2)(Shared.Bool.and_true_right(Cmp.is_gt(Key.cmp(k2, ik)), Mst.passes(rest, k2), e))

# a pick of a key at or before k stops at once among items after k
def Mst.stops_first_of_fit(
  +xs: List<&2, Item>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Items.fit(xs, Some{k}, hi) == True{}: Bool} -> {List.is_empty(&2, Item, xs) == False{}: Bool} -> {
  Cmp.is_le(Key.cmp(k2, k)) == True{}: Bool
} -> {Mst.stops_first(xs, k2) == True{}: Bool}:
  match xs:
    case Nil{}:
      +f => +n => +c => Empty.absurd({True{} == True{}: Bool}, Shared.Bool.true_ne_false(n))
    case Con{Item{+x1, +v1, +r1}, +rest}:
      +f => +n => +c => Equal.cong(
        Cmp,
        Bool,
        Cmp.is_lt,
        Key.cmp(k2, x1),
        LT{},
        Mst.key_le_lt(k2, k, x1)(c)(
          Mst.key_lt_of(k, x1)(
            Shared.Bool.and_true_left(
              Key.is_lt(k, x1),
              Bound.before(x1, hi),
              Shared.Bool.and_true_left(Bool.and(Key.is_lt(k, x1), Bound.before(x1, hi)), Items.fit(rest, Some{x1}, hi), f)
            )
          )
        )
      )

# the items of a node that opens in a room fit its bounds
def Mst.opens_fit(
  +l: Nat,
  -left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +o: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool}
) -> {Items.fit(xs, lo, hi) == True{}: Bool}:
  Shared.Bool.and_true_right(Bool.and(Nat.is_lt(l, u), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi), o)

# a node that opens in a room has an item
def Mst.opens_full(
  +l: Nat,
  -left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +o: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool}
) -> {List.is_empty(&2, Item, xs) == False{}: Bool}:
  Shared.Bool.not_true(List.is_empty(&2, Item, xs))(
    Shared.Bool.and_true_right(
      Nat.is_lt(l, u),
      Bool.not(List.is_empty(&2, Item, xs)),
      Shared.Bool.and_true_left(Bool.and(Nat.is_lt(l, u), Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi), o)
    )
  )

# a node that opens in a room opens in a room of a higher up and wider
# bounds where its level is below the up
def Mst.opens_move(
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +u1: Nat,
  +lo1: Maybe<&2, List<&2, U32>>,
  +hi1: Maybe<&2, List<&2, U32>>,
  +u2: Nat,
  +lo2: Maybe<&2, List<&2, U32>>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +lt: {Nat.is_lt(l, u2) == True{}: Bool},
  +wl: {Mst.lo_le(lo2, lo1) == True{}: Bool},
  +wh: {Mst.hi_le(hi1, hi2) == True{}: Bool},
  +o: {Mst.opens(Node{l, left, xs}, Room{u1, lo1, hi1}) == True{}: Bool}
) -> {Mst.opens(Node{l, left, xs}, Room{u2, lo2, hi2}) == True{}: Bool}:
  Mst.opens_lvl(
    Node{l, left, xs},
    Room{u1, lo1, hi1},
    Room{u2, lo2, hi2},
    lt,
    Shared.Bool.and_both(Mst.lo_le(lo2, lo1), Mst.hi_le(hi1, hi2), wl, wh)
  )(o)

# an edge that opens has a root that opens in its room
def Mst.edge_lvl.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  left: Bool,
  na: Maybe<&2, Node>,
  r: Room,
  -go: Room -> Maybe<&2, Hashes.Hash> -> Bool,
  +s: S,
  +h: Hashes.Hash,
  +en: {Mst.node.in(~S, ~fetch, s, h, r) == na: Maybe<&2, Node>}
) -> {Shared.Bool.when(Bool, left, u => Mst.edge.left.at(na, r, go), u => Mst.edge.right.at(na, r, go)) == True{}: Bool} -> {
  Mst.lvl(~S, ~fetch, s, Some{h}, Mst.room_up(r)) == True{}: Bool
}:
  match left na r:
    case True{} None{} Room{+u, +lo, +hi}:
      +e => Empty.absurd({Mst.lvl(~S, ~fetch, s, Some{h}, u) == True{}: Bool}, Shared.Bool.false_ne_true(e))
    case False{} None{} Room{+u, +lo, +hi}:
      +e => Empty.absurd({Mst.lvl(~S, ~fetch, s, Some{h}, u) == True{}: Bool}, Shared.Bool.false_ne_true(e))
    case b Some{Node{+l, +lf, +xs}} Room{+u, +lo, +hi}:
      +e => Mst.lvl_of(
        ~S,
        ~fetch,
        s,
        h,
        u,
        l,
        lf,
        xs,
        Mst.in_node(~S, ~fetch, s, h, Room{u, lo, hi}, Node{l, lf, xs})(en),
        Mst.opens_lt(l, lf, xs, Room{u, lo, hi})(Mst.in_open(~S, ~fetch, s, h, Room{u, lo, hi}, Node{l, lf, xs})(en))
      )

# an edge that opens has a root whose level is below the up of its room
def Mst.edge_lvl(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +s: S,
  +left: Bool,
  +r: Room
) -> {Mst.edge(~S, ~fetch, f, s, left, r, m) == True{}: Bool} -> {Mst.lvl(~S, ~fetch, s, m, Mst.room_up(r)) == True{}: Bool}:
  match f m:
    case x None{}:
      +e => {==}
    case 0n Some{+h}:
      +e => Empty.absurd({Mst.lvl(~S, ~fetch, s, Some{h}, Mst.room_up(r)) == True{}: Bool}, Shared.Bool.false_ne_true(e))
    case 1n+(+p) Some{+h}:
      Mst.edge_lvl.at(
        ~S,
        ~fetch,
        left,
        Mst.node.in(~S, ~fetch, s, h, r),
        r,
        r2 => c => Mst.edge(~S, ~fetch, p, s, left, r2, c),
        s,
        h,
        {==}
      )

# Mst.edge_left, at the node na of the root h
def Mst.edge_left.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  na: Maybe<&2, Node>,
  g: Nat,
  +p: Nat,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +k: List<&2, U32>,
  +hr: Maybe<&2, List<&2, U32>>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, Some{k}, hr}) == na: Maybe<&2, Node>},
  +lv: {Mst.lvl(~S, ~fetch, s, Some{h}, u) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +fu: {Nat.is_le(u, g) == True{}: Bool},
  +c: {Cmp.is_le(Key.cmp(k2, k)) == True{}: Bool},
  ih: @l: Nat -> @hr2: Maybe<&2, List<&2, U32>> -> @m: Maybe<&2, Hashes.Hash> -> @g2: Nat -> {
    Mst.edge(~S, ~fetch, p, s, True{}, Room{l, Some{k}, hr2}, m) == True{}: Bool
  } -> {Nat.is_le(l, g2) == True{}: Bool} -> {Mst.look.go(~S, ~fetch, g2, s, Room{l, lo, hr2}, m, k2) == Look.Absent{}: Look}
) -> {
  Mst.edge.left.at(na, Room{ur, Some{k}, hr}, r2 => c2 => Mst.edge(~S, ~fetch, p, s, True{}, r2, c2)) == True{}: Bool
} -> {Mst.look.go(~S, ~fetch, g, s, Room{u, lo, hr}, Some{h}, k2) == Look.Absent{}: Look}:
  match na g:
    case None{} g0:
      +e => Empty.absurd({Mst.look.go(~S, ~fetch, g0, s, Room{u, lo, hr}, Some{h}, k2) == Look.Absent{}: Look}, Shared.Bool.false_ne_true(e))
    case Some{Node{+l, +lf, +xs}} 0n:
      +e => Empty.absurd(
        {Look.Missing{h} == Look.Absent{}: Look},
        Mst.nat_lt_zero(l)(
          Shared.Nat.lt_le(l, u, 0n)(
            Mst.lvl_lt(~S, ~fetch, s, h, u, l, lf, xs, lv, Mst.in_node(~S, ~fetch, s, h, Room{ur, Some{k}, hr}, Node{l, lf, xs})(en))
          )(fu)
        )
      )
    case Some{Node{+l, +lf, +xs}} 1n+(+q):
      +e =>
        +o = Mst.in_open(~S, ~fetch, s, h, Room{ur, Some{k}, hr}, Node{l, lf, xs})(en)
        +lt = Mst.lvl_lt(~S, ~fetch, s, h, u, l, lf, xs, lv, Mst.in_node(~S, ~fetch, s, h, Room{ur, Some{k}, hr}, Node{l, lf, xs})(en))
        +o2 = Mst.opens_move(l, lf, xs, ur, Some{k}, hr, u, lo, hr, lt, Mst.lo_le_key(lo, k)(a), Mst.hi_le_refl(hr), o)
        %Equal.sym(
          Look,
          Mst.look.go(~S, ~fetch, 1n+q, s, Room{u, lo, hr}, Some{h}, k2),
          Mst.look.pick(Mst.pick(xs, lf, l, lo, hr, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k2)),
          Mst.look_node(
            ~S,
            ~fetch,
            q,
            s,
            h,
            u,
            lo,
            hr,
            l,
            lf,
            xs,
            k2,
            Mst.in_node(~S, ~fetch, s, h, Room{ur, Some{k}, hr}, Node{l, lf, xs})(en),
            o2
          )
        ): {_ == Look.Absent{}: Look}
        %Equal.sym(
          Pick,
          Mst.pick(xs, lf, l, lo, hr, k2),
          Pick.Down{lf, Room.of(l, lo, Items.head_key(xs, hr))},
          Mst.pick_first(xs, lf, l, lo, hr, k2)(
            Mst.stops_first_of_fit(xs, k, hr, k2)(Mst.opens_fit(l, lf, xs, ur, Some{k}, hr, o))(
              Mst.opens_full(l, lf, xs, ur, Some{k}, hr, o)
            )(c)
          )
        ): {Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k2)) == Look.Absent{}: Look}
        ih(l)(Items.head_key(xs, hr))(lf)(q)(e)(Mst.opens_fl(l, lf, xs, u, lo, hr, q, o2, fu))

# a read of a key at or before k in a tree whose left edge opens in rooms
# after k, in a room of wider bounds, finds the key absent
def Mst.edge_left(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +g: Nat,
  +s: S,
  +ur: Nat,
  +k: List<&2, U32>,
  +hr: Maybe<&2, List<&2, U32>>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.edge(~S, ~fetch, f, s, True{}, Room{ur, Some{k}, hr}, m) == True{}: Bool} -> {
  Mst.lvl(~S, ~fetch, s, m, u) == True{}: Bool
} -> {Bound.after(lo, k) == True{}: Bool} -> {Nat.is_le(u, g) == True{}: Bool} -> {
  Cmp.is_le(Key.cmp(k2, k)) == True{}: Bool
} -> {Mst.look.go(~S, ~fetch, g, s, Room{u, lo, hr}, m, k2) == Look.Absent{}: Look}:
  match f m:
    case x None{}:
      +e => +lv => +a => +fu => +c => Mst.look_none(~S, ~fetch, g, s, Room{u, lo, hr}, k2)
    case 0n Some{+h}:
      +e => +lv => +a => +fu => +c => Empty.absurd(
        {Mst.look.go(~S, ~fetch, g, s, Room{u, lo, hr}, Some{h}, k2) == Look.Absent{}: Look},
        Shared.Bool.false_ne_true(e)
      )
    case 1n+(+p) Some{+h}:
      +e => +lv => +a => +fu => +c => Mst.edge_left.at(
        ~S,
        ~fetch,
        Mst.node.in(~S, ~fetch, s, h, Room{ur, Some{k}, hr}),
        g,
        p,
        s,
        h,
        ur,
        k,
        hr,
        u,
        lo,
        k2,
        {==},
        lv,
        a,
        fu,
        c,
        +l => +hr2 => +m2 => +g2 => +e2 => +f2 => Mst.edge_left(~S, ~fetch, p, m2, g2, s, l, k, hr2, l, lo, k2)(e2)(
          Mst.edge_lvl(~S, ~fetch, p, m2, s, True{}, Room{l, Some{k}, hr2})(e2)
        )(a)(f2)(c)
      )(e)

# Mst.edge_right, at the node na of the root h
def Mst.edge_right.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  na: Maybe<&2, Node>,
  g: Nat,
  +p: Nat,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lr: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +u: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, lr, Some{k}}) == na: Maybe<&2, Node>},
  +lv: {Mst.lvl(~S, ~fetch, s, Some{h}, u) == True{}: Bool},
  +b: {Bound.before(k, hi) == True{}: Bool},
  +fu: {Nat.is_le(u, g) == True{}: Bool},
  +c: {Cmp.is_le(Key.cmp(k, k2)) == True{}: Bool},
  ih: @l: Nat -> @lr2: Maybe<&2, List<&2, U32>> -> @m: Maybe<&2, Hashes.Hash> -> @g2: Nat -> {
    Mst.edge(~S, ~fetch, p, s, False{}, Room{l, lr2, Some{k}}, m) == True{}: Bool
  } -> {Nat.is_le(l, g2) == True{}: Bool} -> {Mst.look.go(~S, ~fetch, g2, s, Room{l, lr2, hi}, m, k2) == Look.Absent{}: Look}
) -> {
  Mst.edge.right.at(na, Room{ur, lr, Some{k}}, r2 => c2 => Mst.edge(~S, ~fetch, p, s, False{}, r2, c2)) == True{}: Bool
} -> {Mst.look.go(~S, ~fetch, g, s, Room{u, lr, hi}, Some{h}, k2) == Look.Absent{}: Look}:
  match na g:
    case None{} g0:
      +e => Empty.absurd({Mst.look.go(~S, ~fetch, g0, s, Room{u, lr, hi}, Some{h}, k2) == Look.Absent{}: Look}, Shared.Bool.false_ne_true(e))
    case Some{Node{+l, +lf, +xs}} 0n:
      +e => Empty.absurd(
        {Look.Missing{h} == Look.Absent{}: Look},
        Mst.nat_lt_zero(l)(
          Shared.Nat.lt_le(l, u, 0n)(
            Mst.lvl_lt(~S, ~fetch, s, h, u, l, lf, xs, lv, Mst.in_node(~S, ~fetch, s, h, Room{ur, lr, Some{k}}, Node{l, lf, xs})(en))
          )(fu)
        )
      )
    case Some{Node{+l, +lf, +xs}} 1n+(+q):
      +e =>
        +o = Mst.in_open(~S, ~fetch, s, h, Room{ur, lr, Some{k}}, Node{l, lf, xs})(en)
        +lt = Mst.lvl_lt(~S, ~fetch, s, h, u, l, lf, xs, lv, Mst.in_node(~S, ~fetch, s, h, Room{ur, lr, Some{k}}, Node{l, lf, xs})(en))
        +o2 = Mst.opens_move(l, lf, xs, ur, lr, Some{k}, u, lr, hi, lt, Mst.lo_le_refl(lr), Mst.hi_le_key(k, hi)(b), o)
        %Equal.sym(
          Look,
          Mst.look.go(~S, ~fetch, 1n+q, s, Room{u, lr, hi}, Some{h}, k2),
          Mst.look.pick(Mst.pick(xs, lf, l, lr, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k2)),
          Mst.look_node(
            ~S,
            ~fetch,
            q,
            s,
            h,
            u,
            lr,
            hi,
            l,
            lf,
            xs,
            k2,
            Mst.in_node(~S, ~fetch, s, h, Room{ur, lr, Some{k}}, Node{l, lf, xs})(en),
            o2
          )
        ): {_ == Look.Absent{}: Look}
        %Equal.sym(
          Pick,
          Mst.pick(xs, lf, l, lr, hi, k2),
          Pick.Down{Mst.last(xs, lf), Room.of(l, Items.last_key(xs, lr), hi)},
          Mst.pick_all(xs, lf, l, lr, hi, k2)(
            Mst.passes_of_le(xs, k, k2)(Mst.fit_all_lt(xs, lr, k)(Mst.opens_fit(l, lf, xs, ur, lr, Some{k}, o)))(c)
          )
        ): {Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k2)) == Look.Absent{}: Look}
        ih(l)(Items.last_key(xs, lr))(Mst.last(xs, lf))(q)(e)(Mst.opens_fl(l, lf, xs, u, lr, hi, q, o2, fu))

# a read of a key at or after k in a tree whose right edge opens in rooms
# before k, in a room of wider bounds, finds the key absent
def Mst.edge_right(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +g: Nat,
  +s: S,
  +ur: Nat,
  +lr: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +u: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Mst.edge(~S, ~fetch, f, s, False{}, Room{ur, lr, Some{k}}, m) == True{}: Bool} -> {
  Mst.lvl(~S, ~fetch, s, m, u) == True{}: Bool
} -> {Bound.before(k, hi) == True{}: Bool} -> {Nat.is_le(u, g) == True{}: Bool} -> {
  Cmp.is_le(Key.cmp(k, k2)) == True{}: Bool
} -> {Mst.look.go(~S, ~fetch, g, s, Room{u, lr, hi}, m, k2) == Look.Absent{}: Look}:
  match f m:
    case x None{}:
      +e => +lv => +b => +fu => +c => Mst.look_none(~S, ~fetch, g, s, Room{u, lr, hi}, k2)
    case 0n Some{+h}:
      +e => +lv => +b => +fu => +c => Empty.absurd(
        {Mst.look.go(~S, ~fetch, g, s, Room{u, lr, hi}, Some{h}, k2) == Look.Absent{}: Look},
        Shared.Bool.false_ne_true(e)
      )
    case 1n+(+p) Some{+h}:
      +e => +lv => +b => +fu => +c => Mst.edge_right.at(
        ~S,
        ~fetch,
        Mst.node.in(~S, ~fetch, s, h, Room{ur, lr, Some{k}}),
        g,
        p,
        s,
        h,
        ur,
        lr,
        k,
        u,
        hi,
        k2,
        {==},
        lv,
        b,
        fu,
        c,
        +l => +lr2 => +m2 => +g2 => +e2 => +f2 => Mst.edge_right(~S, ~fetch, p, m2, g2, s, l, lr2, k, l, hi, k2)(e2)(
          Mst.edge_lvl(~S, ~fetch, p, m2, s, False{}, Room{l, lr2, Some{k}})(e2)
        )(b)(f2)(c)
      )(e)

# the empty tree, read with any fuel and in any room, tells the same
def Mst.none_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  -s: S,
  -r1: Room,
  -r2: Room,
  -k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, r1, None{}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, r2, None{}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match g1 g2:
    case 0n 0n:
      +e => e
    case 0n 1n+q:
      +e => e
    case 1n+p 0n:
      +e => e
    case 1n+p 1n+q:
      +e => e

# a read that finds a key absent tells what a read of the empty tree tells
def Mst.absent_to(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +s: S,
  +r1: Room,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +t: Look,
  +et: {t == Look.Absent{}: Look}
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, r1, None{}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(t) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  +e =>
    %Equal.sym(Look, t, Look.Absent{}, et): {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
    Equal.trans(
      Maybe<&2, Maybe<&2, List<&2, U32>>>,
      Look.known(Look.Absent{}),
      Look.known(Mst.look.go(~S, ~fetch, g1, s, r1, None{}, k2)),
      Some{x},
      Equal.cong(
        Look,
        Maybe<&2, Maybe<&2, List<&2, U32>>>,
        Look.known,
        Look.Absent{},
        Mst.look.go(~S, ~fetch, g1, s, r1, None{}, k2),
        Equal.sym(Look, Mst.look.go(~S, ~fetch, g1, s, r1, None{}, k2), Look.Absent{}, Mst.look_none(~S, ~fetch, g1, s, r1, k2))
      ),
      e
    )

# a number above another is after it
def Mst.nat_gt_lt(+a: Nat, +b: Nat) -> {Nat.cmp(a, b) == GT{}: Cmp} -> {Nat.is_lt(b, a) == True{}: Bool}:
  +e => Equal.cong(
    Cmp,
    Bool,
    Cmp.is_lt,
    Nat.cmp(b, a),
    LT{},
    Equal.trans(Cmp, Nat.cmp(b, a), Mst.flip(Nat.cmp(a, b)), LT{}, Mst.nat_flip(a, b), Equal.cong(Cmp, Cmp, Mst.flip, Nat.cmp(a, b), GT{}, e))
  )

# a number below another is before it
def Mst.nat_lt_of(+a: Nat, +b: Nat) -> {Nat.cmp(a, b) == LT{}: Cmp} -> {Nat.is_lt(a, b) == True{}: Bool}:
  +e => Equal.cong(Cmp, Bool, Cmp.is_lt, Nat.cmp(a, b), LT{}, e)

# a comparison that is LT or EQ is at or below
def Mst.le_of_lt(+c: Cmp) -> {c == LT{}: Cmp} -> {Cmp.is_le(c) == True{}: Bool}:
  +e => Equal.cong(Cmp, Bool, Cmp.is_le, c, LT{}, e)

# a key is at or below itself
def Mst.le_refl_key(+k: List<&2, U32>) -> {Cmp.is_le(Key.cmp(k, k)) == True{}: Bool}:
  Equal.cong(Cmp, Bool, Cmp.is_le, Key.cmp(k, k), EQ{}, Mst.key_refl(k))

# items with their last subtree set are as empty as before
def Mst.empty_set_last(+xs: List<&2, Item>, -m: Maybe<&2, Hashes.Hash>) -> {
  List.is_empty(&2, Item, Mst.set_last(xs, m)) == List.is_empty(&2, Item, xs): Bool
}:
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+k, +v, +r}, Nil{}}:
      {==}
    case Con{Item{+k, +v, +r}, Con{+y, +rest}}:
      {==}

# items that are not empty, then more, are not empty
def Mst.empty_append(+xs: List<&2, Item>, -ys: List<&2, Item>) -> {List.is_empty(&2, Item, xs) == False{}: Bool} -> {
  List.is_empty(&2, Item, List.append(&2, Item, xs, ys)) == False{}: Bool
}:
  match xs:
    case Nil{}:
      +e => Empty.absurd({List.is_empty(&2, Item, ys) == False{}: Bool}, Shared.Bool.true_ne_false(e))
    case Con{+x, +rest}:
      +e => {==}

# k comes before the head key of items after k
def Mst.before_head(+xb: List<&2, Item>, +k: List<&2, U32>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Items.fit(xb, Some{k}, hi) == True{}: Bool
} -> {Bound.before(k, hi) == True{}: Bool} -> {Bound.before(k, Items.head_key(xb, hi)) == True{}: Bool}:
  match xb:
    case Nil{}:
      +f => +b => b
    case Con{Item{+x1, +v1, +r1}, +rest}:
      +f => +b => Shared.Bool.and_true_left(
        Key.is_lt(k, x1),
        Bound.before(x1, hi),
        Shared.Bool.and_true_left(Bool.and(Key.is_lt(k, x1), Bound.before(x1, hi)), Items.fit(rest, Some{x1}, hi), f)
      )

# what holds of items holds of them followed by nothing
def Mst.with_nil(-P: List<&2, Item> -> Type, +xs: List<&2, Item>, p: P(xs)) -> P(List.append(&2, Item, xs, [])):
  %Equal.sym(List<&2, Item>, List.append(&2, Item, xs, []), xs, Shared.List.append_nil(Item, xs)): P(_)
  p

# what a merge reads: below k, as the tree ma in the room after lo; above k,
# as the tree mb in the room before hi; and k, absent; in the room of the up
# u, between lo and hi
def Mst.MergeRead(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -u: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -hi: Maybe<&2, List<&2, U32>>,
  -ma: Maybe<&2, Hashes.Hash>,
  -mb: Maybe<&2, Hashes.Hash>,
  -nc: Maybe<&2, Hashes.Hash>
) -> Type:
  (
    @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @u1: Nat -> @g1: Nat -> @g2: Nat -> {Key.cmp(k2, k) == LT{}: Cmp} -> {
      Nat.is_le(u, g2) == True{}: Bool
    } -> {
      Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, lo, Some{k}}, ma, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
    } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
  )
    & (
      (
        @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @u1: Nat -> @g1: Nat -> @g2: Nat -> {Key.cmp(k2, k) == GT{}: Cmp} -> {
          Nat.is_le(u, g2) == True{}: Bool
        } -> {
          Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, Some{k}, hi}, mb, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
        & (
          @g2: Nat -> {Nat.is_le(u, g2) == True{}: Bool} -> {
            Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, nc, k)) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
        )
    )

# what a merge reads, in any room whose up is above both roots, between
# bounds around k
def Mst.MergeMain(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -lo: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -hi: Maybe<&2, List<&2, U32>>,
  -ma: Maybe<&2, Hashes.Hash>,
  -mb: Maybe<&2, Hashes.Hash>,
  -nc: Maybe<&2, Hashes.Hash>
) -> Type:
  @u: Nat -> {Mst.lvl(~S, ~fetch, s, ma, u) == True{}: Bool} -> {Mst.lvl(~S, ~fetch, s, mb, u) == True{}: Bool} -> {
    Bound.after(lo, k) == True{}: Bool
  } -> {Bound.before(k, hi) == True{}: Bool} -> Mst.MergeRead(~S, ~fetch, s, u, lo, k, hi, ma, mb, nc)

# a merge res of the trees ma, in the room of the up ua after lo, and mb, in
# the room of the up ub before hi, around the key k: once the depot holds its
# new nodes, the roots sit in their rooms, and it reads as Mst.MergeMain says
def Mst.MergeOk(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -ua: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -ub: Nat,
  -hi: Maybe<&2, List<&2, U32>>,
  -ma: Maybe<&2, Hashes.Hash>,
  -mb: Maybe<&2, Hashes.Hash>,
  res: Maybe<&2, Edit>
) -> Type:
  match res:
    case None{}:
      Unit
    case Some{Edit{nc, ns}}:
      {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool} -> (
        ({Mst.lvl(~S, ~fetch, s, ma, ua) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, mb, ub) == True{}: Bool})
          & Mst.MergeMain(~S, ~fetch, s, lo, k, hi, ma, mb, nc)
      )

# a merge of two empty trees
def Mst.merge_ok.none(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  -ua: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  -ub: Nat,
  -hi: Maybe<&2, List<&2, U32>>
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, None{}, None{}, Some{Edit{None{}, []}}):
  +hold => (
    ({==}, {==}),
    +u => +lva => +lvb => +a => +b => (
      +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => Mst.none_kept(~S, ~fetch, g1, g2, s, Room{u1, lo, Some{k}}, Room{u, lo, hi}, k2, x),
      (
        +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => Mst.none_kept(~S, ~fetch, g1, g2, s, Room{u1, Some{k}, hi}, Room{u, lo, hi}, k2, x),
        +g2 => +fu => Equal.cong(
          Look,
          Maybe<&2, Maybe<&2, List<&2, U32>>>,
          Look.known,
          Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, None{}, k),
          Look.Absent{},
          Mst.look_none(~S, ~fetch, g2, s, Room{u, lo, hi}, k)
        )
      )
    )
  )

# a merge of an empty tree and the tree of hb, once its left edge opens (b)
def Mst.merge_ok.lone_b(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +s: S,
  -ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +hb: Hashes.Hash,
  +eb: {Mst.edge(~S, ~fetch, Mst.depth(), s, True{}, Room{ub, Some{k}, hi}, Some{hb}) == b: Bool}
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, None{}, Some{hb}, Shared.Maybe.when(Edit, b, u => Some{Edit{Some{hb}, []}})):
  match b:
    case False{}:
      Unit{}
    case True{}:
      +hold => (
        ({==}, Mst.edge_lvl(~S, ~fetch, Mst.depth(), Some{hb}, s, True{}, Room{ub, Some{k}, hi})(eb)),
        +u => +lva => +lvb => +a => +bb => (
          +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.absent_to(
            ~S,
            ~fetch,
            g1,
            s,
            Room{u1, lo, Some{k}},
            k2,
            x,
            Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{hb}, k2),
            Mst.edge_left(~S, ~fetch, Mst.depth(), Some{hb}, g2, s, ub, k, hi, u, lo, k2)(eb)(lvb)(a)(fu)(
              Mst.le_of_lt(Key.cmp(k2, k))(c)
            )
          )(e),
          (
            +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => Mst.look.wide(
              ~S,
              ~fetch,
              g2,
              g1,
              Some{hb},
              s,
              Room{u1, Some{k}, hi},
              Room{u, lo, hi},
              k2,
              x,
              Mst.hop_lvl(
                ~S,
                ~fetch,
                s,
                Some{hb},
                Room{u1, Some{k}, hi},
                Room{u, lo, hi},
                lvb,
                Shared.Bool.and_both(Mst.lo_le(lo, Some{k}), Mst.hi_le(hi, hi), Mst.lo_le_key(lo, k)(a), Mst.hi_le_refl(hi))
              ),
              Shared.Bool.and_both(Mst.lo_le(lo, Some{k}), Mst.hi_le(hi, hi), Mst.lo_le_key(lo, k)(a), Mst.hi_le_refl(hi)),
              fu
            ),
            +g2 => +fu => Equal.cong(
              Look,
              Maybe<&2, Maybe<&2, List<&2, U32>>>,
              Look.known,
              Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{hb}, k),
              Look.Absent{},
              Mst.edge_left(~S, ~fetch, Mst.depth(), Some{hb}, g2, s, ub, k, hi, u, lo, k)(eb)(lvb)(a)(fu)(Mst.le_refl_key(k))
            )
          )
        )
      )

# a merge of the tree of ha and an empty tree, once its right edge opens (b)
def Mst.merge_ok.lone_a(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +s: S,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  -ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +ha: Hashes.Hash,
  +eb: {Mst.edge(~S, ~fetch, Mst.depth(), s, False{}, Room{ua, lo, Some{k}}, Some{ha}) == b: Bool}
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, None{}, Shared.Maybe.when(Edit, b, u => Some{Edit{Some{ha}, []}})):
  match b:
    case False{}:
      Unit{}
    case True{}:
      +hold => (
        (Mst.edge_lvl(~S, ~fetch, Mst.depth(), Some{ha}, s, False{}, Room{ua, lo, Some{k}})(eb), {==}),
        +u => +lva => +lvb => +a => +bb => (
          +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => Mst.look.wide(
            ~S,
            ~fetch,
            g2,
            g1,
            Some{ha},
            s,
            Room{u1, lo, Some{k}},
            Room{u, lo, hi},
            k2,
            x,
            Mst.hop_lvl(
              ~S,
              ~fetch,
              s,
              Some{ha},
              Room{u1, lo, Some{k}},
              Room{u, lo, hi},
              lva,
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(Some{k}, hi), Mst.lo_le_refl(lo), Mst.hi_le_key(k, hi)(bb))
            ),
            Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(Some{k}, hi), Mst.lo_le_refl(lo), Mst.hi_le_key(k, hi)(bb)),
            fu
          ),
          (
            +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.absent_to(
              ~S,
              ~fetch,
              g1,
              s,
              Room{u1, Some{k}, hi},
              k2,
              x,
              Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{ha}, k2),
              Mst.edge_right(~S, ~fetch, Mst.depth(), Some{ha}, g2, s, ua, lo, k, u, hi, k2)(eb)(lva)(bb)(fu)(
                Mst.le_of_lt(Key.cmp(k, k2))(Mst.key_gt_lt(k2, k)(c))
              )
            )(e),
            +g2 => +fu => Equal.cong(
              Look,
              Maybe<&2, Maybe<&2, List<&2, U32>>>,
              Look.known,
              Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{ha}, k),
              Look.Absent{},
              Mst.edge_right(~S, ~fetch, Mst.depth(), Some{ha}, g2, s, ua, lo, k, u, hi, k)(eb)(lva)(bb)(fu)(Mst.le_refl_key(k))
            )
          )
        )
      )

# a node of the items of a, the subtree between them merged, then the items
# of b opens in a room of the up u around k
def Mst.opens_both(
  +la: Nat,
  -el: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +lt: {Nat.is_lt(la, u) == True{}: Bool},
  +na: {List.is_empty(&2, Item, xa) == False{}: Bool},
  +fa: {Items.fit(xa, lo, Some{k}) == True{}: Bool},
  +fb: {Items.fit(xb, Some{k}, hi) == True{}: Bool},
  +ak: {Bound.after(Items.last_key(xa, lo), k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool}
) -> {Mst.opens(Node{la, el, List.append(&2, Item, Mst.set_last(xa, mc), xb)}, Room{u, lo, hi}) == True{}: Bool}:
  Shared.Bool.and_both(
    Bool.and(Nat.is_lt(la, u), Bool.not(List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xa, mc), xb)))),
    Items.fit(List.append(&2, Item, Mst.set_last(xa, mc), xb), lo, hi),
    Shared.Bool.and_both(
      Nat.is_lt(la, u),
      Bool.not(List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xa, mc), xb))),
      lt,
      Equal.cong(
        Bool,
        Bool,
        Bool.not,
        List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xa, mc), xb)),
        False{},
        Equal.trans(
          Bool,
          List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xa, mc), xb)),
          List.is_empty(&2, Item, List.append(&2, Item, xa, xb)),
          False{},
          Mst.empty_set_last_append(xa, mc, xb),
          Mst.empty_append(xa, xb)(na)
        )
      )
    ),
    Equal.trans(
      Bool,
      Items.fit(List.append(&2, Item, Mst.set_last(xa, mc), xb), lo, hi),
      Items.fit(List.append(&2, Item, xa, xb), lo, hi),
      True{},
      Mst.fit_set_last_append(xa, mc, xb, lo, hi),
      Equal.trans(
        Bool,
        Items.fit(List.append(&2, Item, xa, xb), lo, hi),
        Bool.and(Items.fit(xa, lo, hi), Items.fit(xb, Items.last_key(xa, lo), hi)),
        True{},
        Mst.fit_append(xa, xb, lo, hi),
        Shared.Bool.and_both(
          Items.fit(xa, lo, hi),
          Items.fit(xb, Items.last_key(xa, lo), hi),
          Mst.fit_wide(xa, lo, lo, Some{k}, hi, Mst.lo_le_refl(lo), Mst.hi_le_key(k, hi)(bb))(fa),
          Mst.fit_wide(xb, Some{k}, Items.last_key(xa, lo), hi, hi, Mst.lo_le_key(Items.last_key(xa, lo), k)(ak), Mst.hi_le_refl(hi))(fb)
        )
      )
    )
  )

# what a merge whose a is of a higher level reads, from what the merge of the
# last subtree of a with b reads (tri)
def Mst.merge_ok.gt.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ha: Hashes.Hash,
  -hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +hold: {
    Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, []) <> ns)
      == True{}: Bool
  },
  +u: Nat,
  +lva: {Mst.lvl(~S, ~fetch, s, Some{ha}, u) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  tri: Mst.MergeRead(~S, ~fetch, s, la, Items.last_key(xa, lo), k, hi, Mst.last(xa, lefta), Some{hb}, mc)
) -> Mst.MergeRead(
  ~S,
  ~fetch,
  s,
  u,
  lo,
  k,
  hi,
  Some{ha},
  Some{hb},
  Some{Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, []))}
):
  (ilo, r3) = tri
  (ihi, ik) = r3
  +eA = Mst.in_node(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +oA = Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +lt = Mst.lvl_lt(~S, ~fetch, s, ha, u, la, lefta, xa, lva, eA)
  +all = Mst.fit_all_lt(xa, lo, k)(Mst.opens_fit(la, lefta, xa, ua, lo, Some{k}, oA))
  +eN = Mst.node_code(
    ~S,
    ~fetch,
    s,
    Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)},
    Mst.holds_head(~S, ~fetch, s, Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, []), ns, hold)
  )
  +oN = Mst.opens_set_last(la, lefta, Mst.end_left(xa, lefta, mc), xa, mc, [], Room{u, lo, hi})(
    Mst.with_nil(
      ys => {Mst.opens(Node{la, lefta, ys}, Room{u, lo, hi}) == True{}: Bool},
      xa,
      Mst.opens_move(la, lefta, xa, ua, lo, Some{k}, u, lo, hi, lt, Mst.lo_le_refl(lo), Mst.hi_le_key(k, hi)(bb), oA)
    )
  )
  +eN2 = Mst.with_nil(
    ys => {
      Mst.node(~S, ~fetch, s, Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, [])))
        == Some{Node{la, Mst.end_left(xa, lefta, mc), ys}}: Maybe<&2, Node>
    },
    Mst.set_last(xa, mc),
    eN
  )
  (
    +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.gap_kept(
      ~S,
      ~fetch,
      ua,
      g2,
      s,
      ha,
      Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, [])),
      ua,
      u,
      lo,
      lo,
      Some{k},
      hi,
      la,
      lefta,
      xa,
      [],
      mc,
      k2,
      x,
      Mst.with_nil(ys => {Mst.node(~S, ~fetch, s, ha) == Some{Node{la, lefta, ys}}: Maybe<&2, Node>}, xa, eA),
      Mst.with_nil(ys => {Mst.opens(Node{la, lefta, ys}, Room{ua, lo, Some{k}}) == True{}: Bool}, xa, oA),
      eN2,
      oN,
      Mst.lo_le_refl(lo),
      Mst.hi_le_key(k, hi)(bb),
      fu,
      +g3 => +g4 => +fl => +e3 => ilo(k2)(x)(la)(g3)(g4)(c)(fl)(e3)
    )(
      Mst.reroom(
        ~S,
        ~fetch,
        g1,
        ua,
        s,
        ha,
        Room{u1, lo, Some{k}},
        Room{ua, lo, Some{k}},
        Node{la, lefta, xa},
        k2,
        x,
        ena,
        Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(Some{k}, Some{k}), Mst.lo_le_refl(lo), Mst.hi_le_refl(Some{k})),
        Shared.Nat.le_refl(ua)
      )(e)
    ),
    (
      +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.gap_k(
        ~S,
        ~fetch,
        g2,
        s,
        Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, [])),
        u,
        lo,
        hi,
        la,
        lefta,
        xa,
        [],
        mc,
        k2,
        x,
        eN2,
        oN,
        fu,
        Mst.passes_of_le(xa, k, k2)(all)(Mst.le_of_lt(Key.cmp(k, k2))(Mst.key_gt_lt(k2, k)(c))),
        {==},
        +g4 => +fl => ihi(k2)(x)(u1)(g1)(g4)(c)(fl)(e)
      ),
      +g2 => +fu => Mst.gap_k(
        ~S,
        ~fetch,
        g2,
        s,
        Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, [])),
        u,
        lo,
        hi,
        la,
        lefta,
        xa,
        [],
        mc,
        k,
        None{},
        eN2,
        oN,
        fu,
        Mst.passes_of_all_lt(xa, k)(all),
        {==},
        +g4 => +fl => ik(g4)(fl)
      )
    )
  )

# the roots of a merge whose a is of a higher level, and what it reads, from
# those of the merge of the last subtree of a with b (bi)
def Mst.merge_ok.gt.body(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(la, lb) == GT{}: Cmp},
  +hold: {
    Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, []) <> ns)
      == True{}: Bool
  },
  bi: ({Mst.lvl(~S, ~fetch, s, Mst.last(xa, lefta), la) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, Some{hb}, ub) == True{}: Bool})
    & Mst.MergeMain(~S, ~fetch, s, Items.last_key(xa, lo), k, hi, Mst.last(xa, lefta), Some{hb}, mc)
) -> ({Mst.lvl(~S, ~fetch, s, Some{ha}, ua) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, Some{hb}, ub) == True{}: Bool})
  & Mst.MergeMain(
    ~S,
    ~fetch,
    s,
    lo,
    k,
    hi,
    Some{ha},
    Some{hb},
    Some{Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, []))}
  ):
  (lvs2, main2) = bi
  (lva2, lvb2) = lvs2
  +eA = Mst.in_node(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +oA = Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +eB = Mst.in_node(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +oB = Mst.in_open(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  (
    (
      Mst.lvl_of(~S, ~fetch, s, ha, ua, la, lefta, xa, eA, Mst.opens_lt(la, lefta, xa, Room{ua, lo, Some{k}})(oA)),
      Mst.lvl_of(~S, ~fetch, s, hb, ub, lb, leftb, xb, eB, Mst.opens_lt(lb, leftb, xb, Room{ub, Some{k}, hi})(oB))
    ),
    +u => +lva => +lvb => +a => +bb => Mst.merge_ok.gt.read(
      ~S,
      ~fetch,
      s,
      ha,
      hb,
      ua,
      lo,
      k,
      hi,
      la,
      lefta,
      xa,
      mc,
      ns,
      ena,
      hold,
      u,
      lva,
      a,
      bb,
      main2(la)(lva2)(Mst.lvl_of(~S, ~fetch, s, hb, la, lb, leftb, xb, eB, Mst.nat_gt_lt(la, lb)(ec)))(
        Mst.last_below(xa, lo, k)(Mst.fit_all_lt(xa, lo, k)(Mst.opens_fit(la, lefta, xa, ua, lo, Some{k}, oA)))(a)
      )(bb)
    )
  )

# a merge whose a is of a higher level: a with its last subtree merged with b
def Mst.merge_ok.gt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  res: Maybe<&2, Edit>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(la, lb) == GT{}: Cmp},
  ih: Mst.MergeOk(~S, ~fetch, s, la, Items.last_key(xa, lo), k, ub, hi, Mst.last(xa, lefta), Some{hb}, res)
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, Some{hb}, Mst.with_last(la, lefta, xa, res)):
  match res:
    case None{}:
      Unit{}
    case Some{Edit{+mc, +ns}}:
      %Equal.sym(
        Edit,
        Mst.make(la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc), ns),
        Mst.store(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, ns),
        Mst.make_full(la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc), ns)(
          Equal.trans(
            Bool,
            List.is_empty(&2, Item, Mst.set_last(xa, mc)),
            List.is_empty(&2, Item, xa),
            False{},
            Mst.empty_set_last(xa, mc),
            Mst.opens_full(la, lefta, xa, ua, lo, Some{k}, Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena))
          )
        )
      ): Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, Some{hb}, Some{_})
      +hold => Mst.merge_ok.gt.body(
        ~S,
        ~fetch,
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        mc,
        ns,
        ena,
        enb,
        ec,
        hold,
        ih(Mst.holds_tail(~S, ~fetch, s, Node.code(Node{la, Mst.end_left(xa, lefta, mc), Mst.set_last(xa, mc)}, []), ns, hold))
      )

# what a merge whose b is of a higher level reads, from what the merge of a
# with the left subtree of b reads (tri)
def Mst.merge_ok.lt.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  -ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ub: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +hold: {Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{lb, mc, xb}, []) <> ns) == True{}: Bool},
  +u: Nat,
  +lvb: {Mst.lvl(~S, ~fetch, s, Some{hb}, u) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  tri: Mst.MergeRead(~S, ~fetch, s, lb, lo, k, Items.head_key(xb, hi), Some{ha}, leftb, mc)
) -> Mst.MergeRead(~S, ~fetch, s, u, lo, k, hi, Some{ha}, Some{hb}, Some{Hashes.Sha.hash(Node.code(Node{lb, mc, xb}, []))}):
  (ilo, r3) = tri
  (ihi, ik) = r3
  +eB = Mst.in_node(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +oB = Mst.in_open(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +lt = Mst.lvl_lt(~S, ~fetch, s, hb, u, lb, leftb, xb, lvb, eB)
  +fb = Mst.opens_fit(lb, leftb, xb, ub, Some{k}, hi, oB)
  +nb = Mst.opens_full(lb, leftb, xb, ub, Some{k}, hi, oB)
  +eN = Mst.node_code(~S, ~fetch, s, Node{lb, mc, xb}, Mst.holds_head(~S, ~fetch, s, Node.code(Node{lb, mc, xb}, []), ns, hold))
  +oN = Mst.opens_move(lb, leftb, xb, ub, Some{k}, hi, u, lo, hi, lt, Mst.lo_le_key(lo, k)(a), Mst.hi_le_refl(hi), oB)
  (
    +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.gap_k(
      ~S,
      ~fetch,
      g2,
      s,
      Hashes.Sha.hash(Node.code(Node{lb, mc, xb}, [])),
      u,
      lo,
      hi,
      lb,
      leftb,
      [],
      xb,
      mc,
      k2,
      x,
      eN,
      oN,
      fu,
      {==},
      Mst.stops_first_of_fit(xb, k, hi, k2)(fb)(nb)(Mst.le_of_lt(Key.cmp(k2, k))(c)),
      +g4 => +fl => ilo(k2)(x)(u1)(g1)(g4)(c)(fl)(e)
    ),
    (
      +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.gap_kept(
        ~S,
        ~fetch,
        ub,
        g2,
        s,
        hb,
        Hashes.Sha.hash(Node.code(Node{lb, mc, xb}, [])),
        ub,
        u,
        Some{k},
        lo,
        hi,
        hi,
        lb,
        leftb,
        [],
        xb,
        mc,
        k2,
        x,
        eB,
        oB,
        eN,
        oN,
        Mst.lo_le_key(lo, k)(a),
        Mst.hi_le_refl(hi),
        fu,
        +g3 => +g4 => +fl => +e3 => ihi(k2)(x)(lb)(g3)(g4)(c)(fl)(e3)
      )(
        Mst.reroom(
          ~S,
          ~fetch,
          g1,
          ub,
          s,
          hb,
          Room{u1, Some{k}, hi},
          Room{ub, Some{k}, hi},
          Node{lb, leftb, xb},
          k2,
          x,
          enb,
          Shared.Bool.and_both(Mst.lo_le(Some{k}, Some{k}), Mst.hi_le(hi, hi), Mst.lo_le_refl(Some{k}), Mst.hi_le_refl(hi)),
          Shared.Nat.le_refl(ub)
        )(e)
      ),
      +g2 => +fu => Mst.gap_k(
        ~S,
        ~fetch,
        g2,
        s,
        Hashes.Sha.hash(Node.code(Node{lb, mc, xb}, [])),
        u,
        lo,
        hi,
        lb,
        leftb,
        [],
        xb,
        mc,
        k,
        None{},
        eN,
        oN,
        fu,
        {==},
        Mst.stops_first_of_fit(xb, k, hi, k)(fb)(nb)(Mst.le_refl_key(k)),
        +g4 => +fl => ik(g4)(fl)
      )
    )
  )

# the roots of a merge whose b is of a higher level, and what it reads, from
# those of the merge of a with the left subtree of b (bi)
def Mst.merge_ok.lt.body(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(la, lb) == LT{}: Cmp},
  +hold: {Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{lb, mc, xb}, []) <> ns) == True{}: Bool},
  bi: ({Mst.lvl(~S, ~fetch, s, Some{ha}, ua) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, leftb, lb) == True{}: Bool})
    & Mst.MergeMain(~S, ~fetch, s, lo, k, Items.head_key(xb, hi), Some{ha}, leftb, mc)
) -> ({Mst.lvl(~S, ~fetch, s, Some{ha}, ua) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, Some{hb}, ub) == True{}: Bool})
  & Mst.MergeMain(~S, ~fetch, s, lo, k, hi, Some{ha}, Some{hb}, Some{Hashes.Sha.hash(Node.code(Node{lb, mc, xb}, []))}):
  (lvs2, main2) = bi
  (lva2, lvb2) = lvs2
  +eA = Mst.in_node(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +oA = Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +eB = Mst.in_node(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +oB = Mst.in_open(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  (
    (
      Mst.lvl_of(~S, ~fetch, s, ha, ua, la, lefta, xa, eA, Mst.opens_lt(la, lefta, xa, Room{ua, lo, Some{k}})(oA)),
      Mst.lvl_of(~S, ~fetch, s, hb, ub, lb, leftb, xb, eB, Mst.opens_lt(lb, leftb, xb, Room{ub, Some{k}, hi})(oB))
    ),
    +u => +lva => +lvb => +a => +bb => Mst.merge_ok.lt.read(
      ~S,
      ~fetch,
      s,
      ha,
      hb,
      ub,
      lo,
      k,
      hi,
      lb,
      leftb,
      xb,
      mc,
      ns,
      enb,
      hold,
      u,
      lvb,
      a,
      main2(lb)(Mst.lvl_of(~S, ~fetch, s, ha, lb, la, lefta, xa, eA, Mst.nat_lt_of(la, lb)(ec)))(lvb2)(a)(
        Mst.before_head(xb, k, hi)(Mst.opens_fit(lb, leftb, xb, ub, Some{k}, hi, oB))(bb)
      )
    )
  )

# a merge whose b is of a higher level: b with its left subtree merged with a
def Mst.merge_ok.lt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  res: Maybe<&2, Edit>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(la, lb) == LT{}: Cmp},
  ih: Mst.MergeOk(~S, ~fetch, s, ua, lo, k, lb, Items.head_key(xb, hi), Some{ha}, leftb, res)
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, Some{hb}, Mst.with_first(lb, xb, res)):
  match res:
    case None{}:
      Unit{}
    case Some{Edit{+mc, +ns}}:
      %Equal.sym(
        Edit,
        Mst.make(lb, mc, xb, ns),
        Mst.store(Node{lb, mc, xb}, ns),
        Mst.make_full(lb, mc, xb, ns)(
          Mst.opens_full(lb, leftb, xb, ub, Some{k}, hi, Mst.in_open(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb))
        )
      ): Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, Some{hb}, Some{_})
      +hold => Mst.merge_ok.lt.body(
        ~S,
        ~fetch,
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        mc,
        ns,
        ena,
        enb,
        ec,
        hold,
        ih(Mst.holds_tail(~S, ~fetch, s, Node.code(Node{lb, mc, xb}, []), ns, hold))
      )

# Mst.merge_eq_lo, by whether a pick passes the items of a (b)
def Mst.merge_eq_lo.passes(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +p1: Nat,
  +p2: Nat,
  +s: S,
  -ha: Hashes.Hash,
  -hn: Hashes.Hash,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eb: {Mst.passes(xa, k2) == b: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +c: {Key.cmp(k2, k) == LT{}: Cmp},
  +fb: {Items.fit(xb, Some{k}, hi) == True{}: Bool},
  +nb: {List.is_empty(&2, Item, xb) == False{}: Bool},
  +fl: {Nat.is_le(la, p2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(la, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{la, Items.last_key(xa, lo), Some{k}}, Mst.last(xa, lefta), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{la, Items.last_key(xa, lo), Items.head_key(xb, hi)}, mc, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(Mst.look.pick(Mst.pick(xa, lefta, la, lo, Some{k}, k2), ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {
  Look.known(
    Mst.look.pick(
      Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), Mst.end_left(xa, lefta, mc), la, lo, hi, k2),
      hn,
      la,
      k2,
      m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
    )
  )
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match b:
    case True{}:
      %Equal.sym(
        Pick,
        Mst.pick(xa, lefta, la, lo, Some{k}, k2),
        Pick.Down{Mst.last(xa, lefta), Room.of(la, Items.last_key(xa, lo), Some{k})},
        Mst.pick_all(xa, lefta, la, lo, Some{k}, k2)(eb)
      ): (
        {
          Look.known(Mst.look.pick(_, ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), Mst.end_left(xa, lefta, mc), la, lo, hi, k2),
                hn,
                la,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), Mst.end_left(xa, lefta, mc), la, lo, hi, k2),
        Mst.pick(xb, mc, la, Items.last_key(xa, lo), hi, k2),
        Mst.pick_set_passes(xa, mc, xb, lefta, la, lo, hi, k2, eb)
      ): (
        {
          Look.known(
            Mst.look.pick(
              Pick.Down{Mst.last(xa, lefta), Room.of(la, Items.last_key(xa, lo), Some{k})},
              ha,
              la,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(xb, mc, la, Items.last_key(xa, lo), hi, k2),
        Pick.Down{mc, Room.of(la, Items.last_key(xa, lo), Items.head_key(xb, hi))},
        Mst.pick_first(xb, mc, la, Items.last_key(xa, lo), hi, k2)(
          Mst.stops_first_of_fit(xb, k, hi, k2)(fb)(nb)(Mst.le_of_lt(Key.cmp(k2, k))(c))
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Pick.Down{Mst.last(xa, lefta), Room.of(la, Items.last_key(xa, lo), Some{k})},
              ha,
              la,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      ih(p1)(p2)(fl)
    case False{}:
      %Equal.sym(Maybe<&2, Hashes.Hash>, Mst.end_left(xa, lefta, mc), lefta, Mst.end_left_full(xa, lefta, mc, k2)(eb)): (
        {
          Look.known(Mst.look.pick(Mst.pick(xa, lefta, la, lo, Some{k}, k2), ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), _, la, lo, hi, k2),
                hn,
                la,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), lefta, la, lo, hi, k2),
        Mst.pick(List.append(&2, Item, xa, []), lefta, la, lo, hi, k2),
        Mst.pick_stops_set(xa, mc, xb, [], lefta, la, lo, hi, hi, k2)(eb)
      ): (
        {
          Look.known(Mst.look.pick(Mst.pick(xa, lefta, la, lo, Some{k}, k2), ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(List<&2, Item>, List.append(&2, Item, xa, []), xa, Shared.List.append_nil(Item, xa)): (
        {
          Look.known(Mst.look.pick(Mst.pick(xa, lefta, la, lo, Some{k}, k2), ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(Mst.pick(_, lefta, la, lo, hi, k2), hn, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.look.same_pick(~S, ~fetch, p1, p2, s, xa, lefta, la, lo, lo, Some{k}, hi, ha, hn, k2, x, Mst.lo_le_refl(lo), Mst.hi_le_key(k, hi)(bb), fl)

# a merge of two nodes of one level reads a key below k as a did
def Mst.merge_eq_lo(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +ha: Hashes.Hash,
  +hn: Hashes.Hash,
  +ua: Nat,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eA: {Mst.node(~S, ~fetch, s, ha) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +oA: {Mst.opens(Node{la, lefta, xa}, Room{ua, lo, Some{k}}) == True{}: Bool},
  +eN: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}}: Maybe<&2, Node>
  },
  +oN: {
    Mst.opens(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, Room{u, lo, hi})
      == True{}: Bool
  },
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +c: {Key.cmp(k2, k) == LT{}: Cmp},
  +fb: {Items.fit(xb, Some{k}, hi) == True{}: Bool},
  +nb: {List.is_empty(&2, Item, xb) == False{}: Bool},
  +fu: {Nat.is_le(u, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(la, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{la, Items.last_key(xa, lo), Some{k}}, Mst.last(xa, lefta), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{la, Items.last_key(xa, lo), Items.head_key(xb, hi)}, mc, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ua, lo, Some{k}}, Some{ha}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{u, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{hn}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), u, lo, hi, oN, fu)
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{ua, lo, Some{k}}, Some{ha}, k2),
        Mst.look.pick(Mst.pick(xa, lefta, la, lo, Some{k}, k2), ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p1, s, ha, ua, lo, Some{k}, la, lefta, xa, k2, eA, oA)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u, lo, hi}, Some{hn}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), Mst.end_left(xa, lefta, mc), la, lo, hi, k2),
          hn,
          la,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p2,
          s,
          hn,
          u,
          lo,
          hi,
          la,
          Mst.end_left(xa, lefta, mc),
          List.append(&2, Item, Mst.set_last(xa, mc), xb),
          k2,
          eN,
          oN
        )
      ): (
        {
          Look.known(Mst.look.pick(Mst.pick(xa, lefta, la, lo, Some{k}, k2), ha, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      Mst.merge_eq_lo.passes(
        ~S,
        ~fetch,
        Mst.passes(xa, k2),
        p1,
        p2,
        s,
        ha,
        hn,
        lo,
        k,
        hi,
        la,
        lefta,
        xa,
        mc,
        xb,
        k2,
        x,
        {==},
        bb,
        c,
        fb,
        nb,
        Mst.opens_fl(la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), u, lo, hi, p2, oN, fu),
        ih
      )

# a merge of two nodes of one level reads a key above k as b did
def Mst.merge_eq_hi(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +hb: Hashes.Hash,
  +hn: Hashes.Hash,
  +ub: Nat,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eB: {Mst.node(~S, ~fetch, s, hb) == Some{Node{la, leftb, xb}}: Maybe<&2, Node>},
  +oB: {Mst.opens(Node{la, leftb, xb}, Room{ub, Some{k}, hi}) == True{}: Bool},
  +eN: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}}: Maybe<&2, Node>
  },
  +oN: {
    Mst.opens(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, Room{u, lo, hi})
      == True{}: Bool
  },
  +ps: {Mst.passes(xa, k2) == True{}: Bool},
  +fu: {Nat.is_le(u, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(la, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{la, Some{k}, Items.head_key(xb, hi)}, leftb, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{la, Items.last_key(xa, lo), Items.head_key(xb, hi)}, mc, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ub, Some{k}, hi}, Some{hb}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{u, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{hn}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), u, lo, hi, oN, fu)
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{ub, Some{k}, hi}, Some{hb}, k2),
        Mst.look.pick(Mst.pick(xb, leftb, la, Some{k}, hi, k2), hb, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p1, s, hb, ub, Some{k}, hi, la, leftb, xb, k2, eB, oB)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u, lo, hi}, Some{hn}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), Mst.end_left(xa, lefta, mc), la, lo, hi, k2),
          hn,
          la,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p2,
          s,
          hn,
          u,
          lo,
          hi,
          la,
          Mst.end_left(xa, lefta, mc),
          List.append(&2, Item, Mst.set_last(xa, mc), xb),
          k2,
          eN,
          oN
        )
      ): (
        {
          Look.known(Mst.look.pick(Mst.pick(xb, leftb, la, Some{k}, hi, k2), hb, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(xa, mc), xb), Mst.end_left(xa, lefta, mc), la, lo, hi, k2),
        Mst.pick(xb, mc, la, Items.last_key(xa, lo), hi, k2),
        Mst.pick_set_passes(xa, mc, xb, lefta, la, lo, hi, k2, ps)
      ): (
        {
          Look.known(Mst.look.pick(Mst.pick(xb, leftb, la, Some{k}, hi, k2), hb, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, la, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.gap_kept.first(
        ~S,
        ~fetch,
        Mst.stops_first(xb, k2),
        p1,
        p2,
        s,
        xb,
        leftb,
        mc,
        la,
        Some{k},
        Items.last_key(xa, lo),
        hi,
        hi,
        hb,
        hn,
        k2,
        x,
        {==},
        Mst.hi_le_refl(hi),
        Mst.opens_fl(la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), u, lo, hi, p2, oN, fu),
        ih
      )

# what a merge of two nodes of one level reads, from what the merge of the
# subtrees between them reads (tri)
def Mst.merge_ok.eq.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +elab: {la == lb: Nat},
  +hold: {
    Depots.Depot.holds(
      ~S,
      ~fetch,
      s,
      Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, []) <> ns
    )
      == True{}: Bool
  },
  +u: Nat,
  +lva: {Mst.lvl(~S, ~fetch, s, Some{ha}, u) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  tri: Mst.MergeRead(~S, ~fetch, s, la, Items.last_key(xa, lo), k, Items.head_key(xb, hi), Mst.last(xa, lefta), leftb, mc)
) -> Mst.MergeRead(
  ~S,
  ~fetch,
  s,
  u,
  lo,
  k,
  hi,
  Some{ha},
  Some{hb},
  Some{Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, []))}
):
  (ilo, r3) = tri
  (ihi, ik) = r3
  +eA = Mst.in_node(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +oA = Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +eB = Mst.in_node(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +oB = Mst.in_open(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +lt = Mst.lvl_lt(~S, ~fetch, s, ha, u, la, lefta, xa, lva, eA)
  +fa = Mst.opens_fit(la, lefta, xa, ua, lo, Some{k}, oA)
  +fb = Mst.opens_fit(lb, leftb, xb, ub, Some{k}, hi, oB)
  +nb = Mst.opens_full(lb, leftb, xb, ub, Some{k}, hi, oB)
  +all = Mst.fit_all_lt(xa, lo, k)(fa)
  +ak = Mst.last_below(xa, lo, k)(all)(a)
  +eN = Mst.node_code(
    ~S,
    ~fetch,
    s,
    Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)},
    Mst.holds_head(
      ~S,
      ~fetch,
      s,
      Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, []),
      ns,
      hold
    )
  )
  +oN = Mst.opens_both(la, Mst.end_left(xa, lefta, mc), xa, mc, xb, u, lo, k, hi, lt, Mst.opens_full(la, lefta, xa, ua, lo, Some{k}, oA), fa, fb, ak, bb)
  +eB2 = Equal.trans(
    Maybe<&2, Node>,
    Mst.node(~S, ~fetch, s, hb),
    Some{Node{lb, leftb, xb}},
    Some{Node{la, leftb, xb}},
    eB,
    Equal.cong(Nat, Maybe<&2, Node>, n => Some{Node{n, leftb, xb}}, lb, la, Equal.sym(Nat, la, lb, elab))
  )
  +oB2 = Equal.trans(
    Bool,
    Mst.opens(Node{la, leftb, xb}, Room{ub, Some{k}, hi}),
    Mst.opens(Node{lb, leftb, xb}, Room{ub, Some{k}, hi}),
    True{},
    Equal.cong(Nat, Bool, n => Mst.opens(Node{n, leftb, xb}, Room{ub, Some{k}, hi}), la, lb, elab),
    oB
  )
  (
    +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.merge_eq_lo(
      ~S,
      ~fetch,
      ua,
      g2,
      s,
      ha,
      Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, [])),
      ua,
      u,
      lo,
      k,
      hi,
      la,
      lefta,
      xa,
      mc,
      xb,
      k2,
      x,
      eA,
      oA,
      eN,
      oN,
      bb,
      c,
      fb,
      nb,
      fu,
      +g3 => +g4 => +fl => +e3 => ilo(k2)(x)(la)(g3)(g4)(c)(fl)(e3)
    )(
      Mst.reroom(
        ~S,
        ~fetch,
        g1,
        ua,
        s,
        ha,
        Room{u1, lo, Some{k}},
        Room{ua, lo, Some{k}},
        Node{la, lefta, xa},
        k2,
        x,
        ena,
        Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(Some{k}, Some{k}), Mst.lo_le_refl(lo), Mst.hi_le_refl(Some{k})),
        Shared.Nat.le_refl(ua)
      )(e)
    ),
    (
      +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.merge_eq_hi(
        ~S,
        ~fetch,
        ub,
        g2,
        s,
        hb,
        Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, [])),
        ub,
        u,
        lo,
        k,
        hi,
        la,
        lefta,
        xa,
        mc,
        leftb,
        xb,
        k2,
        x,
        eB2,
        oB2,
        eN,
        oN,
        Mst.passes_of_le(xa, k, k2)(all)(Mst.le_of_lt(Key.cmp(k, k2))(Mst.key_gt_lt(k2, k)(c))),
        fu,
        +g3 => +g4 => +fl => +e3 => ihi(k2)(x)(la)(g3)(g4)(c)(fl)(e3)
      )(
        Mst.reroom(
          ~S,
          ~fetch,
          g1,
          ub,
          s,
          hb,
          Room{u1, Some{k}, hi},
          Room{ub, Some{k}, hi},
          Node{lb, leftb, xb},
          k2,
          x,
          enb,
          Shared.Bool.and_both(Mst.lo_le(Some{k}, Some{k}), Mst.hi_le(hi, hi), Mst.lo_le_refl(Some{k}), Mst.hi_le_refl(hi)),
          Shared.Nat.le_refl(ub)
        )(e)
      ),
      +g2 => +fu => Mst.gap_k(
        ~S,
        ~fetch,
        g2,
        s,
        Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, [])),
        u,
        lo,
        hi,
        la,
        lefta,
        xa,
        xb,
        mc,
        k,
        None{},
        eN,
        oN,
        fu,
        Mst.passes_of_all_lt(xa, k)(all),
        Mst.stops_first_of_fit(xb, k, hi, k)(fb)(nb)(Mst.le_refl_key(k)),
        +g4 => +fl => ik(g4)(fl)
      )
    )
  )

# the roots of a merge of two nodes of one level, and what it reads, from
# those of the merge of the subtrees between them (bi)
def Mst.merge_ok.eq.body(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +mc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +elab: {la == lb: Nat},
  +hold: {
    Depots.Depot.holds(
      ~S,
      ~fetch,
      s,
      Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, []) <> ns
    )
      == True{}: Bool
  },
  bi: ({Mst.lvl(~S, ~fetch, s, Mst.last(xa, lefta), la) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, leftb, lb) == True{}: Bool})
    & Mst.MergeMain(~S, ~fetch, s, Items.last_key(xa, lo), k, Items.head_key(xb, hi), Mst.last(xa, lefta), leftb, mc)
) -> ({Mst.lvl(~S, ~fetch, s, Some{ha}, ua) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, Some{hb}, ub) == True{}: Bool})
  & Mst.MergeMain(
    ~S,
    ~fetch,
    s,
    lo,
    k,
    hi,
    Some{ha},
    Some{hb},
    Some{Hashes.Sha.hash(Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, []))}
  ):
  (lvs2, main2) = bi
  (lva2, lvb2) = lvs2
  +eA = Mst.in_node(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +oA = Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena)
  +eB = Mst.in_node(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  +oB = Mst.in_open(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}, Node{lb, leftb, xb})(enb)
  (
    (
      Mst.lvl_of(~S, ~fetch, s, ha, ua, la, lefta, xa, eA, Mst.opens_lt(la, lefta, xa, Room{ua, lo, Some{k}})(oA)),
      Mst.lvl_of(~S, ~fetch, s, hb, ub, lb, leftb, xb, eB, Mst.opens_lt(lb, leftb, xb, Room{ub, Some{k}, hi})(oB))
    ),
    +u => +lva => +lvb => +a => +bb => Mst.merge_ok.eq.read(
      ~S,
      ~fetch,
      s,
      ha,
      hb,
      ua,
      lo,
      k,
      ub,
      hi,
      la,
      lefta,
      xa,
      lb,
      leftb,
      xb,
      mc,
      ns,
      ena,
      enb,
      elab,
      hold,
      u,
      lva,
      a,
      bb,
      main2(la)(lva2)(
        Equal.trans(
          Bool,
          Mst.lvl(~S, ~fetch, s, leftb, la),
          Mst.lvl(~S, ~fetch, s, leftb, lb),
          True{},
          Equal.cong(Nat, Bool, n => Mst.lvl(~S, ~fetch, s, leftb, n), la, lb, elab),
          lvb2
        )
      )(Mst.last_below(xa, lo, k)(Mst.fit_all_lt(xa, lo, k)(Mst.opens_fit(la, lefta, xa, ua, lo, Some{k}, oA)))(a))(
        Mst.before_head(xb, k, hi)(Mst.opens_fit(lb, leftb, xb, ub, Some{k}, hi, oB))(bb)
      )
    )
  )

# a merge of two nodes of one level: one node of the items of both, the
# subtrees between them merged
def Mst.merge_ok.eq(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  res: Maybe<&2, Edit>,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(la, lb) == EQ{}: Cmp},
  ih: Mst.MergeOk(~S, ~fetch, s, la, Items.last_key(xa, lo), k, lb, Items.head_key(xb, hi), Mst.last(xa, lefta), leftb, res)
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, Some{hb}, Mst.with_both(la, lefta, xa, xb, res)):
  match res:
    case None{}:
      Unit{}
    case Some{Edit{+mc, +ns}}:
      %Equal.sym(
        Edit,
        Mst.make(la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), ns),
        Mst.store(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, ns),
        Mst.make_full(la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb), ns)(
          Equal.trans(
            Bool,
            List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(xa, mc), xb)),
            List.is_empty(&2, Item, List.append(&2, Item, xa, xb)),
            False{},
            Mst.empty_set_last_append(xa, mc, xb),
            Mst.empty_append(xa, xb)(
              Mst.opens_full(la, lefta, xa, ua, lo, Some{k}, Mst.in_open(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}, Node{la, lefta, xa})(ena))
            )
          )
        )
      ): Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, Some{ha}, Some{hb}, Some{_})
      +hold => Mst.merge_ok.eq.body(
        ~S,
        ~fetch,
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        mc,
        ns,
        ena,
        enb,
        Mst.nat_eq(la, lb)(ec),
        hold,
        ih(
          Mst.holds_tail(
            ~S,
            ~fetch,
            s,
            Node.code(Node{la, Mst.end_left(xa, lefta, mc), List.append(&2, Item, Mst.set_last(xa, mc), xb)}, []),
            ns,
            hold
          )
        )
      )

# the merge of two nodes, by how their levels compare (c)
def Mst.merge_ok.nodes(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +p: Nat,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +la: Nat,
  +lefta: Maybe<&2, Hashes.Hash>,
  +xa: List<&2, Item>,
  +lb: Nat,
  +leftb: Maybe<&2, Hashes.Hash>,
  +xb: List<&2, Item>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == Some{Node{la, lefta, xa}}: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == Some{Node{lb, leftb, xb}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(la, lb) == c: Cmp},
  ih: @ua2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @ub2: Nat -> @hi2: Maybe<&2, List<&2, U32>> -> @ma2: Maybe<&2, Hashes.Hash> -> @mb2: Maybe<
    &2,
    Hashes.Hash> -> Mst.MergeOk(
    ~S,
    ~fetch,
    s,
    ua2,
    lo2,
    k,
    ub2,
    hi2,
    ma2,
    mb2,
    Mst.merge(~S, ~fetch, p, s, Room{ua2, lo2, Some{k}}, Room{ub2, Some{k}, hi2}, ma2, mb2)
  )
) -> Mst.MergeOk(
  ~S,
  ~fetch,
  s,
  ua,
  lo,
  k,
  ub,
  hi,
  Some{ha},
  Some{hb},
  Mst.merge.nodes(
    c,
    ha,
    Room{ua, lo, Some{k}},
    la,
    lefta,
    xa,
    hb,
    Room{ub, Some{k}, hi},
    lb,
    leftb,
    xb,
    r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y)
  )
):
  match c:
    case GT{}:
      Mst.merge_ok.gt(
        ~S,
        ~fetch,
        Mst.merge(~S, ~fetch, p, s, Room{la, Items.last_key(xa, lo), Some{k}}, Room{ub, Some{k}, hi}, Mst.last(xa, lefta), Some{hb}),
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        ena,
        enb,
        ec,
        ih(la)(Items.last_key(xa, lo))(ub)(hi)(Mst.last(xa, lefta))(Some{hb})
      )
    case LT{}:
      Mst.merge_ok.lt(
        ~S,
        ~fetch,
        Mst.merge(~S, ~fetch, p, s, Room{ua, lo, Some{k}}, Room{lb, Some{k}, Items.head_key(xb, hi)}, Some{ha}, leftb),
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        ena,
        enb,
        ec,
        ih(ua)(lo)(lb)(Items.head_key(xb, hi))(Some{ha})(leftb)
      )
    case EQ{}:
      Mst.merge_ok.eq(
        ~S,
        ~fetch,
        Mst.merge(
          ~S,
          ~fetch,
          p,
          s,
          Room{la, Items.last_key(xa, lo), Some{k}},
          Room{lb, Some{k}, Items.head_key(xb, hi)},
          Mst.last(xa, lefta),
          leftb
        ),
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        ena,
        enb,
        ec,
        ih(la)(Items.last_key(xa, lo))(lb)(Items.head_key(xb, hi))(Mst.last(xa, lefta))(leftb)
      )

# the merge of the nodes na and nb that a depot gives
def Mst.merge_ok.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  na: Maybe<&2, Node>,
  nb: Maybe<&2, Node>,
  +p: Nat,
  +s: S,
  +ha: Hashes.Hash,
  +hb: Hashes.Hash,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>,
  +ena: {Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}) == na: Maybe<&2, Node>},
  +enb: {Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}) == nb: Maybe<&2, Node>},
  ih: @ua2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @ub2: Nat -> @hi2: Maybe<&2, List<&2, U32>> -> @ma2: Maybe<&2, Hashes.Hash> -> @mb2: Maybe<
    &2,
    Hashes.Hash> -> Mst.MergeOk(
    ~S,
    ~fetch,
    s,
    ua2,
    lo2,
    k,
    ub2,
    hi2,
    ma2,
    mb2,
    Mst.merge(~S, ~fetch, p, s, Room{ua2, lo2, Some{k}}, Room{ub2, Some{k}, hi2}, ma2, mb2)
  )
) -> Mst.MergeOk(
  ~S,
  ~fetch,
  s,
  ua,
  lo,
  k,
  ub,
  hi,
  Some{ha},
  Some{hb},
  Mst.merge.at(na, nb, ha, Room{ua, lo, Some{k}}, hb, Room{ub, Some{k}, hi}, r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y))
):
  match na nb:
    case Some{Node{+la, +lefta, +xa}} Some{Node{+lb, +leftb, +xb}}:
      Mst.merge_ok.nodes(
        ~S,
        ~fetch,
        Nat.cmp(la, lb),
        p,
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        la,
        lefta,
        xa,
        lb,
        leftb,
        xb,
        ena,
        enb,
        {==},
        ih
      )
    case Some{Node{+la, +lefta, +xa}} None{}:
      Unit{}
    case None{} y:
      Unit{}

# a merge of two trees around the key k, each in its room, reads as
# Mst.MergeOk says
def Mst.merge_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  ma: Maybe<&2, Hashes.Hash>,
  mb: Maybe<&2, Hashes.Hash>,
  +s: S,
  +ua: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ub: Nat,
  +hi: Maybe<&2, List<&2, U32>>
) -> Mst.MergeOk(~S, ~fetch, s, ua, lo, k, ub, hi, ma, mb, Mst.merge(~S, ~fetch, f, s, Room{ua, lo, Some{k}}, Room{ub, Some{k}, hi}, ma, mb)):
  match f ma mb:
    case 0n None{} None{}:
      Mst.merge_ok.none(~S, ~fetch, s, ua, lo, k, ub, hi)
    case 1n+p None{} None{}:
      Mst.merge_ok.none(~S, ~fetch, s, ua, lo, k, ub, hi)
    case 0n None{} Some{+hb}:
      Mst.merge_ok.lone_b(
        ~S,
        ~fetch,
        Mst.edge(~S, ~fetch, Mst.depth(), s, True{}, Room{ub, Some{k}, hi}, Some{hb}),
        s,
        ua,
        lo,
        k,
        ub,
        hi,
        hb,
        {==}
      )
    case 1n+p None{} Some{+hb}:
      Mst.merge_ok.lone_b(
        ~S,
        ~fetch,
        Mst.edge(~S, ~fetch, Mst.depth(), s, True{}, Room{ub, Some{k}, hi}, Some{hb}),
        s,
        ua,
        lo,
        k,
        ub,
        hi,
        hb,
        {==}
      )
    case 0n Some{+ha} None{}:
      Mst.merge_ok.lone_a(
        ~S,
        ~fetch,
        Mst.edge(~S, ~fetch, Mst.depth(), s, False{}, Room{ua, lo, Some{k}}, Some{ha}),
        s,
        ua,
        lo,
        k,
        ub,
        hi,
        ha,
        {==}
      )
    case 1n+p Some{+ha} None{}:
      Mst.merge_ok.lone_a(
        ~S,
        ~fetch,
        Mst.edge(~S, ~fetch, Mst.depth(), s, False{}, Room{ua, lo, Some{k}}, Some{ha}),
        s,
        ua,
        lo,
        k,
        ub,
        hi,
        ha,
        {==}
      )
    case 0n Some{ha} Some{hb}:
      Unit{}
    case 1n+(+p) Some{+ha} Some{+hb}:
      Mst.merge_ok.at(
        ~S,
        ~fetch,
        Mst.node.in(~S, ~fetch, s, ha, Room{ua, lo, Some{k}}),
        Mst.node.in(~S, ~fetch, s, hb, Room{ub, Some{k}, hi}),
        p,
        s,
        ha,
        hb,
        ua,
        lo,
        k,
        ub,
        hi,
        {==},
        {==},
        +ua2 => +lo2 => +ub2 => +hi2 => +ma2 => +mb2 => Mst.merge_ok(~S, ~fetch, p, ma2, mb2, s, ua2, lo2, k, ub2, hi2)
      )

# a root below the level u is below a level at or above u
def Mst.lvl.at_mono(mn: Maybe<&2, Node>, +u: Nat, +u2: Nat) -> {Mst.lvl.at(mn, u) == True{}: Bool} -> {Nat.is_le(u, u2) == True{}: Bool} -> {
  Mst.lvl.at(mn, u2) == True{}: Bool
}:
  match mn:
    case None{}:
      +e => +w => {==}
    case Some{Node{+l, +left, +xs}}:
      +e => +w => Shared.Nat.lt_le(l, u, u2)(e)(w)

# Mst.lvl.at_mono, of the root of a tree
def Mst.lvl_mono(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +u: Nat,
  +u2: Nat
) -> {Mst.lvl(~S, ~fetch, s, m, u) == True{}: Bool} -> {Nat.is_le(u, u2) == True{}: Bool} -> {Mst.lvl(~S, ~fetch, s, m, u2) == True{}: Bool}:
  match m:
    case None{}:
      +e => +w => {==}
    case Some{+h}:
      Mst.lvl.at_mono(Mst.node(~S, ~fetch, s, h), u, u2)

# the new nodes of a node made from items, in front of acc, hold acc
def Mst.make_acc(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +acc: List<&2, List<&2, U32>>
) -> {Depots.Depot.holds(~S, ~fetch, s, Edit.nodes(Mst.make(l, left, xs, acc))) == True{}: Bool} -> {
  Depots.Depot.holds(~S, ~fetch, s, acc) == True{}: Bool
}:
  match xs:
    case Nil{}:
      +e => e
    case Con{+x, +rest}:
      +e => Mst.holds_tail(~S, ~fetch, s, Node.code(Node{l, left, x <> rest}, []), acc, e)

# a pick of a key at or before k among items after k stops at once
def Mst.stops_first_fit(
  +post: List<&2, Item>,
  +k: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>
) -> {Items.fit(post, Some{k}, hi) == True{}: Bool} -> {Cmp.is_le(Key.cmp(k2, k)) == True{}: Bool} -> {
  Mst.stops_first(post, k2) == True{}: Bool
}:
  match post:
    case Nil{}:
      +f => +c => {==}
    case Con{+y, +rest}:
      +f => +c => Mst.stops_first_of_fit(y <> rest, k, hi, k2)(f)({==})(c)

# a comparison neither LT nor EQ is GT
def Mst.gt_of(c: Cmp) -> {Cmp.is_lt(c) == False{}: Bool} -> {Cmp.is_eq(c) == False{}: Bool} -> {c == GT{}: Cmp}:
  match c:
    case LT{}:
      +a => +b => Empty.absurd({LT{} == GT{}: Cmp}, Shared.Bool.true_ne_false(a))
    case EQ{}:
      +a => +b => Empty.absurd({EQ{} == GT{}: Cmp}, Shared.Bool.true_ne_false(b))
    case GT{}:
      +a => +b => {==}

# the items from k on, when the first is not k, fit after k
def Mst.post_after(
  +post: List<&2, Item>,
  -b: List<&2, Item>,
  -g: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Mst.head_not_lt(post, k) == True{}: Bool} -> {Part.hits(Part{b, g, post}, k) == False{}: Bool} -> {
  Items.fit(post, lo, hi) == True{}: Bool
} -> {Items.fit(post, Some{k}, hi) == True{}: Bool}:
  match post:
    case Nil{}:
      +hn => +hh => +f => {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      +hn => +hh => +f => Shared.Bool.and_both(
        Bool.and(Key.is_lt(k, ik), Bound.before(ik, hi)),
        Items.fit(rest, Some{ik}, hi),
        Shared.Bool.and_both(
          Key.is_lt(k, ik),
          Bound.before(ik, hi),
          Mst.key_is_lt(k, ik)(
            Mst.key_gt_lt(ik, k)(Mst.gt_of(Key.cmp(ik, k))(Shared.Bool.not_true(Cmp.is_lt(Key.cmp(ik, k)))(hn))(hh))
          ),
          Shared.Bool.and_true_right(
            Bound.after(lo, ik),
            Bound.before(ik, hi),
            Shared.Bool.and_true_left(Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)), Items.fit(rest, Some{ik}, hi), f)
          )
        ),
        Shared.Bool.and_true_right(Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)), Items.fit(rest, Some{ik}, hi), f)
      )

# a read of a node whose pick goes down to m in r tells what a read of m in
# r tells, with less fuel (cont)
def Mst.old_down(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -G: Type,
  g1: Nat,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +m: Maybe<&2, Hashes.Hash>,
  +r: Room,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool},
  +ep: {Mst.pick(xs, left, l, lo, hi, k2) == Pick.Down{m, r}: Pick},
  cont: @g3: Nat -> {Look.known(Mst.look.go(~S, ~fetch, g3, s, r, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> G
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> G:
  match g1:
    case 0n:
      +e => Empty.absurd(G, Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e))
    case 1n+(+p):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p, s, Room{u, lo, hi}, Some{h}, k2),
        Mst.look.pick(Mst.pick(xs, left, l, lo, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p, s, h, u, lo, hi, l, left, xs, k2, eN, oN)
      ): ({Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> G)
      %Equal.sym(Pick, Mst.pick(xs, left, l, lo, hi, k2), Pick.Down{m, r}, ep): (
        {
          Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> G
      )
      cont(p)

# a read of a new node whose pick goes down to m in a room of its level tells
# what ih says a read of m there tells
def Mst.new_down(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +m: Maybe<&2, Hashes.Hash>,
  +a: Maybe<&2, List<&2, U32>>,
  +b: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, g2) == True{}: Bool},
  +ep: {Mst.pick(xs, left, l, lo, hi, k2) == Pick.Down{m, Room{l, a, b}}: Pick},
  ih: @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, a, b}, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g2:
    case 0n:
      Empty.absurd(
        {Look.known(Look.Missing{h}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(l, left, xs, u, lo, hi, oN, fu)
      )
    case 1n+(+p):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p, s, Room{u, lo, hi}, Some{h}, k2),
        Mst.look.pick(Mst.pick(xs, left, l, lo, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p, s, h, u, lo, hi, l, left, xs, k2, eN, oN)
      ): {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      %Equal.sym(Pick, Mst.pick(xs, left, l, lo, hi, k2), Pick.Down{m, Room{l, a, b}}, ep): {
        Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k2)))
          == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
      }
      ih(p)(Mst.opens_fl(l, left, xs, u, lo, hi, p, oN, fu))

# a node of the level l with items opens in a room above its level whose
# bounds the items fit
def Mst.opens_of(
  +l: Nat,
  -left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +lt: {Nat.is_lt(l, u) == True{}: Bool},
  +ne: {List.is_empty(&2, Item, xs) == False{}: Bool},
  +f: {Items.fit(xs, lo, hi) == True{}: Bool}
) -> {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool}:
  %Equal.sym(Bool, List.is_empty(&2, Item, xs), False{}, ne) :
    {Bool.and(Bool.and(Cmp.is_lt(Nat.cmp(l, u)), Bool.not(_)), Items.fit(xs, lo, hi)) == True{} : Bool}
  %Equal.sym(Bool, Cmp.is_lt(Nat.cmp(l, u)), True{}, lt) :
    {Bool.and(Bool.and(_, True{}), Items.fit(xs, lo, hi)) == True{} : Bool}
  f

# the items before k of items that fit, then nothing, fit before k
def Mst.pre_fit(
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> {Items.fit(List.append(&2, Item, pre, post), lo, hi) == True{}: Bool} -> {Mst.all_lt(pre, k) == True{}: Bool} -> {
  Items.fit(List.append(&2, Item, pre, []), lo, Some{k}) == True{}: Bool
}:
  +f => +a => Mst.with_nil(
    ys => {Items.fit(ys, lo, Some{k}) == True{}: Bool},
    pre,
    Mst.fit_below(pre, lo, hi, k)(
      Shared.Bool.and_true_left(
        Items.fit(pre, lo, hi),
        Items.fit(post, Items.last_key(pre, lo), hi),
        Equal.trans(
          Bool,
          Bool.and(Items.fit(pre, lo, hi), Items.fit(post, Items.last_key(pre, lo), hi)),
          Items.fit(List.append(&2, Item, pre, post), lo, hi),
          True{},
          Equal.sym(
            Bool,
            Items.fit(List.append(&2, Item, pre, post), lo, hi),
            Bool.and(Items.fit(pre, lo, hi), Items.fit(post, Items.last_key(pre, lo), hi)),
            Mst.fit_append(pre, post, lo, hi)
          ),
          f
        )
      )
    )(a)
  )

# the items from k on of items that fit fit after the last before k
def Mst.post_fit(
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Items.fit(List.append(&2, Item, pre, post), lo, hi) == True{}: Bool} -> {
  Items.fit(post, Items.last_key(pre, lo), hi) == True{}: Bool
}:
  match pre:
    case Nil{}:
      x => x
    case Con{head, tail}:
      match head:
        case Item{key, value, right}:
          x => Mst.post_fit(tail, post, Some{key}, hi)(Shared.Bool.and_true_right(Bool.and(Bound.after(lo, key), Bound.before(key, hi)), Items.fit(List.append(&2, Item, tail, post), Some{key}, hi))(x))

# what a split reads: below k, the lower half as the tree; above k, the upper
# half as the tree; each half in a room above its root
def Mst.SplitRead(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -lo: Maybe<&2, List<&2, U32>>,
  -hi: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -m: Maybe<&2, Hashes.Hash>,
  -hl: Maybe<&2, Hashes.Hash>,
  -hh: Maybe<&2, Hashes.Hash>
) -> Type:
  (
    @u2: Nat -> {Mst.lvl(~S, ~fetch, s, m, u2) == True{}: Bool} -> @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @u1: Nat -> @g1: Nat -> @g2: Nat -> {
      Key.cmp(k2, k) == LT{}: Cmp
    } -> {Nat.is_le(u2, g2) == True{}: Bool} -> {
      Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, lo, hi}, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
    } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, lo, Some{k}}, hl, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
  )
    & (
      @u2: Nat -> {Mst.lvl(~S, ~fetch, s, m, u2) == True{}: Bool} -> @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @u1: Nat -> @g1: Nat -> @g2: Nat -> {
        Key.cmp(k2, k) == GT{}: Cmp
      } -> {Nat.is_le(u2, g2) == True{}: Bool} -> {
        Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, lo, hi}, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
      } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, Some{k}, hi}, hh, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
    )

# a split res of the tree m, in the room of the up ur between lo and hi, at
# k: once the depot holds its new nodes, the root sits in its room, and it
# reads as Mst.SplitRead says
def Mst.SplitOk(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -ur: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -hi: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -m: Maybe<&2, Hashes.Hash>,
  res: Maybe<&2, Halves>
) -> Type:
  match res:
    case None{}:
      Unit
    case Some{Halves{hl, hh, ns}}:
      {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool} -> (
        {Mst.lvl(~S, ~fetch, s, m, ur) == True{}: Bool} & Mst.SplitRead(~S, ~fetch, s, lo, hi, k, m, hl, hh)
      )

# Mst.gap_lo, by whether a pick passes the items before the gap (b)
def Mst.gap_lo.passes(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +p1: Nat,
  +p2: Nat,
  +s: S,
  -h: Hashes.Hash,
  -hn: Hashes.Hash,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +post2: List<&2, Item>,
  +clo: Maybe<&2, Hashes.Hash>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eb: {Mst.passes(pre, k2) == b: Bool},
  +sf: {Mst.stops_first(post, k2) == True{}: Bool},
  +sf2: {Mst.stops_first(post2, k2) == True{}: Bool},
  +fl: {Nat.is_le(l, p2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Items.last_key(pre, lo), Items.head_key(post2, hi2)}, clo, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {
  Look.known(
    Mst.look.pick(Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2))
  )
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
} -> {
  Look.known(
    Mst.look.pick(
      Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), Mst.end_left(pre, left, clo), l, lo, hi2, k2),
      hn,
      l,
      k2,
      m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
    )
  )
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match b:
    case True{}:
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
        Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2),
        Mst.pick_passes(pre, post, left, l, lo, hi, k2)(eb)
      ): (
        {
          Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), Mst.end_left(pre, left, clo), l, lo, hi2, k2),
                hn,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2),
        Pick.Down{Mst.last(pre, left), Room.of(l, Items.last_key(pre, lo), Items.head_key(post, hi))},
        Mst.pick_first(post, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2)(sf)
      ): (
        {
          Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), Mst.end_left(pre, left, clo), l, lo, hi2, k2),
                hn,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), Mst.end_left(pre, left, clo), l, lo, hi2, k2),
        Pick.Down{clo, Room.of(l, Items.last_key(pre, lo), Items.head_key(post2, hi2))},
        Equal.trans(
          Pick,
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), Mst.end_left(pre, left, clo), l, lo, hi2, k2),
          Mst.pick(post2, clo, l, Items.last_key(pre, lo), hi2, k2),
          Pick.Down{clo, Room.of(l, Items.last_key(pre, lo), Items.head_key(post2, hi2))},
          Mst.pick_set_passes(pre, clo, post2, left, l, lo, hi2, k2, eb),
          Mst.pick_first(post2, clo, l, Items.last_key(pre, lo), hi2, k2)(sf2)
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Pick.Down{Mst.last(pre, left), Room.of(l, Items.last_key(pre, lo), Items.head_key(post, hi))},
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      ih(p1)(p2)(fl)
    case False{}:
      %Equal.sym(Maybe<&2, Hashes.Hash>, Mst.end_left(pre, left, clo), left, Mst.end_left_full(pre, left, clo, k2)(eb)): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), _, l, lo, hi2, k2),
                hn,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), left, l, lo, hi2, k2),
        Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
        Mst.pick_stops_set(pre, clo, post2, post, left, l, lo, hi2, hi, k2)(eb)
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.look.same_pick(
        ~S,
        ~fetch,
        p1,
        p2,
        s,
        List.append(&2, Item, pre, post),
        left,
        l,
        lo,
        lo,
        hi,
        hi,
        h,
        hn,
        k2,
        x,
        Mst.lo_le_refl(lo),
        Mst.hi_le_refl(hi),
        fl
      )

# a node whose gap is replaced by the subtree clo, then the items post2,
# reads a key that a pick of passes the items before the gap and stops at
# the first item after it, as the node did, but in the gap, as ih says
def Mst.gap_lo(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +hn: Hashes.Hash,
  +ur: Nat,
  +u2: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +post2: List<&2, Item>,
  +clo: Maybe<&2, Hashes.Hash>,
  +hi2: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +eL: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), post2)}}: Maybe<&2, Node>
  },
  +oL: {
    Mst.opens(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), post2)}, Room{u2, lo, hi2})
      == True{}: Bool
  },
  +sf: {Mst.stops_first(post, k2) == True{}: Bool},
  +sf2: {Mst.stops_first(post2, k2) == True{}: Bool},
  +fu: {Nat.is_le(u2, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Items.last_key(pre, lo), Items.head_key(post2, hi2)}, clo, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, lo, hi2}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{u2, lo, hi2}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{hn}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), post2), u2, lo, hi2, oL, fu)
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{ur, lo, hi}, Some{h}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
          h,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
        ),
        Mst.look_node(~S, ~fetch, p1, s, h, ur, lo, hi, l, left, List.append(&2, Item, pre, post), k2, eN, oN)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u2, lo, hi2}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u2, lo, hi2}, Some{hn}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), post2), Mst.end_left(pre, left, clo), l, lo, hi2, k2),
          hn,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p2,
          s,
          hn,
          u2,
          lo,
          hi2,
          l,
          Mst.end_left(pre, left, clo),
          List.append(&2, Item, Mst.set_last(pre, clo), post2),
          k2,
          eL,
          oL
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      Mst.gap_lo.passes(
        ~S,
        ~fetch,
        Mst.passes(pre, k2),
        p1,
        p2,
        s,
        h,
        hn,
        lo,
        hi,
        k,
        l,
        left,
        pre,
        post,
        post2,
        clo,
        hi2,
        k2,
        x,
        {==},
        sf,
        sf2,
        Mst.opens_fl(l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), post2), u2, lo, hi2, p2, oL, fu),
        ih
      )

# the upper half of a split node, of the items after k, reads a key above k
# as the node did
def Mst.split_hi_full(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +hn: Hashes.Hash,
  +ur: Nat,
  +u2: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +chi: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +eH: {Mst.node(~S, ~fetch, s, hn) == Some{Node{l, chi, post}}: Maybe<&2, Node>},
  +oH: {Mst.opens(Node{l, chi, post}, Room{u2, Some{k}, hi}) == True{}: Bool},
  +ps: {Mst.passes(pre, k2) == True{}: Bool},
  +fu: {Nat.is_le(u2, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Some{k}, Items.head_key(post, hi)}, chi, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, Some{k}, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{u2, Some{k}, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{hn}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(l, chi, post, u2, Some{k}, hi, oH, fu)
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{ur, lo, hi}, Some{h}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
          h,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
        ),
        Mst.look_node(~S, ~fetch, p1, s, h, ur, lo, hi, l, left, List.append(&2, Item, pre, post), k2, eN, oN)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u2, Some{k}, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u2, Some{k}, hi}, Some{hn}, k2),
        Mst.look.pick(Mst.pick(post, chi, l, Some{k}, hi, k2), hn, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p2, s, hn, u2, Some{k}, hi, l, chi, post, k2, eH, oH)
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
        Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2),
        Mst.pick_passes(pre, post, left, l, lo, hi, k2)(ps)
      ): (
        {
          Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(Mst.pick(post, chi, l, Some{k}, hi, k2), hn, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.gap_kept.first(
        ~S,
        ~fetch,
        Mst.stops_first(post, k2),
        p1,
        p2,
        s,
        post,
        Mst.last(pre, left),
        chi,
        l,
        Items.last_key(pre, lo),
        Some{k},
        hi,
        hi,
        h,
        hn,
        k2,
        x,
        {==},
        Mst.hi_le_refl(hi),
        Mst.opens_fl(l, chi, post, u2, Some{k}, hi, p2, oH, fu),
        ih
      )


# the halves of a split node of the items pre, then post, once its gap is
# split into clo and chi (bi: what that split reads)
def Mst.split_ok.halves(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  pre: List<&2, Item>,
  post: List<&2, Item>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +clo: Maybe<&2, Hashes.Hash>,
  +chi: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  bi: {Mst.lvl(~S, ~fetch, s, Mst.last(pre, left), l) == True{}: Bool}
    & Mst.SplitRead(~S, ~fetch, s, Items.last_key(pre, lo), Items.head_key(post, hi), k, Mst.last(pre, left), clo, chi)
) -> {
  Depots.Depot.holds(
    ~S,
    ~fetch,
    s,
    Edit.nodes(
      Mst.make(
        l,
        chi,
        post,
        Edit.nodes(Mst.make(l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), []), ns))
      )
    )
  )
    == True{}: Bool
} -> {Mst.lvl(~S, ~fetch, s, Some{h}, ur) == True{}: Bool}
  & Mst.SplitRead(
    ~S,
    ~fetch,
    s,
    lo,
    hi,
    k,
    Some{h},
    Edit.root(Mst.make(l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), []), ns)),
    Edit.root(
      Mst.make(
        l,
        chi,
        post,
        Edit.nodes(Mst.make(l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), []), ns))
      )
    )
  ):
  match pre post:
    case Nil{} Nil{}:
      Empty.absurd(
        {
          Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool
        } -> {Mst.lvl(~S, ~fetch, s, Some{h}, ur) == True{}: Bool} & Mst.SplitRead(~S, ~fetch, s, lo, hi, k, Some{h}, clo, chi),
        Shared.Bool.true_ne_false(Mst.opens_full(l, left, [], ur, lo, hi, oN))
      )
    case Nil{} Con{+y, +ys}:
      (+lvg, sr) = bi
      (srlo, srhi) = sr
      +hold => (
        Mst.lvl_of(~S, ~fetch, s, h, ur, l, left, y <> ys, eN, Mst.opens_lt(l, left, y <> ys, Room{ur, lo, hi})(oN)),
        (
          +u2 => +lvm => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.old_down(
            ~S,
            ~fetch,
            {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, lo, Some{k}}, clo, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
            ur,
            s,
            h,
            ur,
            lo,
            hi,
            l,
            left,
            y <> ys,
            k2,
            x,
            left,
            Room.of(l, lo, Items.head_key(y <> ys, hi)),
            eN,
            oN,
            Mst.pick_first(y <> ys, left, l, lo, hi, k2)(Mst.stops_first_fit(y <> ys, k, hi, k2)(pk)(Mst.le_of_lt(Key.cmp(k2, k))(c))),
            +g3 => +e3 => srlo(u2)(
              Mst.lvl_mono(~S, ~fetch, s, left, l, u2)(lvg)(
                Shared.Nat.lt_weak(l, u2)(Mst.lvl_lt(~S, ~fetch, s, h, u2, l, left, y <> ys, lvm, eN))
              )
            )(k2)(x)(l)(g3)(g2)(c)(fu)(e3)
          )(
            Mst.reroom(
              ~S,
              ~fetch,
              g1,
              ur,
              s,
              h,
              Room{u1, lo, hi},
              Room{ur, lo, hi},
              Node{l, left, y <> ys},
              k2,
              x,
              Mst.node_in_of(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, y <> ys})(eN)(oN),
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(hi, hi), Mst.lo_le_refl(lo), Mst.hi_le_refl(hi)),
              Shared.Nat.le_refl(ur)
            )(e)
          ),
          +u2 => +lvm => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.split_hi_full(
            ~S,
            ~fetch,
            ur,
            g2,
            s,
            h,
            Hashes.Sha.hash(Node.code(Node{l, chi, y <> ys}, [])),
            ur,
            u2,
            lo,
            hi,
            k,
            l,
            left,
            [],
            y <> ys,
            chi,
            k2,
            x,
            eN,
            oN,
            Mst.node_code(~S, ~fetch, s, Node{l, chi, y <> ys}, Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, chi, y <> ys}, []), ns, hold)),
            Mst.opens_of(l, chi, y <> ys, u2, Some{k}, hi, Mst.lvl_lt(~S, ~fetch, s, h, u2, l, left, y <> ys, lvm, eN), {==}, pk),
            {==},
            fu,
            +g3 => +g4 => +fl => +e3 => srhi(l)(lvg)(k2)(x)(l)(g3)(g4)(c)(fl)(e3)
          )(
            Mst.reroom(
              ~S,
              ~fetch,
              g1,
              ur,
              s,
              h,
              Room{u1, lo, hi},
              Room{ur, lo, hi},
              Node{l, left, y <> ys},
              k2,
              x,
              Mst.node_in_of(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, y <> ys})(eN)(oN),
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(hi, hi), Mst.lo_le_refl(lo), Mst.hi_le_refl(hi)),
              Shared.Nat.le_refl(ur)
            )(e)
          )
        )
      )
    case Con{+x0, +r0} Nil{}:
      (+lvg, sr) = bi
      (srlo, srhi) = sr
      %Equal.sym(
        Edit,
        Mst.make(l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), []), ns),
        Mst.store(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, ns),
        Mst.make_full(l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), []), ns)(
          Equal.trans(
            Bool,
            List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])),
            List.is_empty(&2, Item, List.append(&2, Item, x0 <> r0, [])),
            False{},
            Mst.empty_set_last_append(x0 <> r0, clo, []),
            {==}
          )
        )
      ): (
        {Depots.Depot.holds(~S, ~fetch, s, Edit.nodes(Mst.make(l, chi, [], Edit.nodes(_)))) == True{}: Bool}
          -> {Mst.lvl(~S, ~fetch, s, Some{h}, ur) == True{}: Bool}
          & Mst.SplitRead(~S, ~fetch, s, lo, hi, k, Some{h}, Edit.root(_), Edit.root(Mst.make(l, chi, [], Edit.nodes(_))))
      )
      +hold => (
        Mst.lvl_of(~S, ~fetch, s, h, ur, l, left, List.append(&2, Item, x0 <> r0, []), eN, Mst.opens_lt(l, left, List.append(&2, Item, x0 <> r0, []), Room{ur, lo, hi})(oN)),
        (
          +u2 => +lvm => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.gap_lo(
            ~S,
            ~fetch,
            ur,
            g2,
            s,
            h,
            Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, [])),
            ur,
            u2,
            lo,
            hi,
            k,
            l,
            left,
            x0 <> r0,
            [],
            [],
            clo,
            Some{k},
            k2,
            x,
            eN,
            oN,
            Mst.node_code(~S, ~fetch, s, Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, []), ns, hold)),
            Mst.opens_set_last(l, left, Mst.end_left(x0 <> r0, left, clo), x0 <> r0, clo, [], Room{u2, lo, Some{k}})(
              Mst.opens_of(
                l,
                left,
                List.append(&2, Item, x0 <> r0, []),
                u2,
                lo,
                Some{k},
                Mst.lvl_lt(~S, ~fetch, s, h, u2, l, left, List.append(&2, Item, x0 <> r0, []), lvm, eN),
                {==},
                Mst.pre_fit(x0 <> r0, [], lo, hi, k)(Mst.opens_fit(l, left, List.append(&2, Item, x0 <> r0, []), ur, lo, hi, oN))(all)
              )
            ),
            {==},
            {==},
            fu,
            +g3 => +g4 => +fl => +e3 => srlo(l)(lvg)(k2)(x)(l)(g3)(g4)(c)(fl)(e3)
          )(
            Mst.reroom(
              ~S,
              ~fetch,
              g1,
              ur,
              s,
              h,
              Room{u1, lo, hi},
              Room{ur, lo, hi},
              Node{l, left, List.append(&2, Item, x0 <> r0, [])},
              k2,
              x,
              Mst.node_in_of(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, List.append(&2, Item, x0 <> r0, [])})(eN)(oN),
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(hi, hi), Mst.lo_le_refl(lo), Mst.hi_le_refl(hi)),
              Shared.Nat.le_refl(ur)
            )(e)
          ),
          +u2 => +lvm => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.old_down(
            ~S,
            ~fetch,
            {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u2, Some{k}, hi}, chi, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
            ur,
            s,
            h,
            ur,
            lo,
            hi,
            l,
            left,
            List.append(&2, Item, x0 <> r0, []),
            k2,
            x,
            Mst.last(x0 <> r0, left),
            Room.of(l, Items.last_key(x0 <> r0, lo), hi),
            eN,
            oN,
            Mst.pick_passes(x0 <> r0, [], left, l, lo, hi, k2)(Mst.passes_of_lt(x0 <> r0, k, k2)(all)(Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k, k2), LT{}, Mst.key_gt_lt(k2, k)(c)))),
            +g3 => +e3 => srhi(u2)(Mst.lvl_mono(~S, ~fetch, s, Mst.last(x0 <> r0, left), l, u2)(lvg)(Shared.Nat.lt_weak(l, u2)(Mst.lvl_lt(~S, ~fetch, s, h, u2, l, left, List.append(&2, Item, x0 <> r0, []), lvm, eN))))(k2)(x)(l)(g3)(g2)(c)(fu)(e3)
          )(
            Mst.reroom(
              ~S,
              ~fetch,
              g1,
              ur,
              s,
              h,
              Room{u1, lo, hi},
              Room{ur, lo, hi},
              Node{l, left, List.append(&2, Item, x0 <> r0, [])},
              k2,
              x,
              Mst.node_in_of(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, List.append(&2, Item, x0 <> r0, [])})(eN)(oN),
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(hi, hi), Mst.lo_le_refl(lo), Mst.hi_le_refl(hi)),
              Shared.Nat.le_refl(ur)
            )(e)
          )
        )
      )
    case Con{+x0, +r0} Con{+y, +ys}:
      (+lvg, sr) = bi
      (srlo, srhi) = sr
      %Equal.sym(
        Edit,
        Mst.make(l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), []), ns),
        Mst.store(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, ns),
        Mst.make_full(l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), []), ns)(
          Equal.trans(
            Bool,
            List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])),
            List.is_empty(&2, Item, List.append(&2, Item, x0 <> r0, [])),
            False{},
            Mst.empty_set_last_append(x0 <> r0, clo, []),
            {==}
          )
        )
      ): (
        {Depots.Depot.holds(~S, ~fetch, s, Edit.nodes(Mst.make(l, chi, y <> ys, Edit.nodes(_)))) == True{}: Bool}
          -> {Mst.lvl(~S, ~fetch, s, Some{h}, ur) == True{}: Bool}
          & Mst.SplitRead(~S, ~fetch, s, lo, hi, k, Some{h}, Edit.root(_), Edit.root(Mst.make(l, chi, y <> ys, Edit.nodes(_))))
      )
      +hold => (
        Mst.lvl_of(~S, ~fetch, s, h, ur, l, left, List.append(&2, Item, x0 <> r0, y <> ys), eN, Mst.opens_lt(l, left, List.append(&2, Item, x0 <> r0, y <> ys), Room{ur, lo, hi})(oN)),
        (
          +u2 => +lvm => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.gap_lo(
            ~S,
            ~fetch,
            ur,
            g2,
            s,
            h,
            Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, [])),
            ur,
            u2,
            lo,
            hi,
            k,
            l,
            left,
            x0 <> r0,
            y <> ys,
            [],
            clo,
            Some{k},
            k2,
            x,
            eN,
            oN,
            Mst.node_code(~S, ~fetch, s, Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, []), ns, Mst.holds_tail(~S, ~fetch, s, Node.code(Node{l, chi, y <> ys}, []), Node.code(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, []) <> ns, hold))),
            Mst.opens_set_last(l, left, Mst.end_left(x0 <> r0, left, clo), x0 <> r0, clo, [], Room{u2, lo, Some{k}})(
              Mst.opens_of(
                l,
                left,
                List.append(&2, Item, x0 <> r0, []),
                u2,
                lo,
                Some{k},
                Mst.lvl_lt(~S, ~fetch, s, h, u2, l, left, List.append(&2, Item, x0 <> r0, y <> ys), lvm, eN),
                {==},
                Mst.pre_fit(x0 <> r0, y <> ys, lo, hi, k)(Mst.opens_fit(l, left, List.append(&2, Item, x0 <> r0, y <> ys), ur, lo, hi, oN))(all)
              )
            ),
            Mst.stops_first_fit(y <> ys, k, hi, k2)(pk)(Mst.le_of_lt(Key.cmp(k2, k))(c)),
            {==},
            fu,
            +g3 => +g4 => +fl => +e3 => srlo(l)(lvg)(k2)(x)(l)(g3)(g4)(c)(fl)(e3)
          )(
            Mst.reroom(
              ~S,
              ~fetch,
              g1,
              ur,
              s,
              h,
              Room{u1, lo, hi},
              Room{ur, lo, hi},
              Node{l, left, List.append(&2, Item, x0 <> r0, y <> ys)},
              k2,
              x,
              Mst.node_in_of(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, List.append(&2, Item, x0 <> r0, y <> ys)})(eN)(oN),
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(hi, hi), Mst.lo_le_refl(lo), Mst.hi_le_refl(hi)),
              Shared.Nat.le_refl(ur)
            )(e)
          ),
          +u2 => +lvm => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => +e => Mst.split_hi_full(
            ~S,
            ~fetch,
            ur,
            g2,
            s,
            h,
            Hashes.Sha.hash(Node.code(Node{l, chi, y <> ys}, [])),
            ur,
            u2,
            lo,
            hi,
            k,
            l,
            left,
            x0 <> r0,
            y <> ys,
            chi,
            k2,
            x,
            eN,
            oN,
            Mst.node_code(~S, ~fetch, s, Node{l, chi, y <> ys}, Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, chi, y <> ys}, []), Node.code(Node{l, Mst.end_left(x0 <> r0, left, clo), List.append(&2, Item, Mst.set_last(x0 <> r0, clo), [])}, []) <> ns, hold)),
            Mst.opens_of(l, chi, y <> ys, u2, Some{k}, hi, Mst.lvl_lt(~S, ~fetch, s, h, u2, l, left, List.append(&2, Item, x0 <> r0, y <> ys), lvm, eN), {==}, pk),
            Mst.passes_of_lt(x0 <> r0, k, k2)(all)(Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k, k2), LT{}, Mst.key_gt_lt(k2, k)(c))),
            fu,
            +g3 => +g4 => +fl => +e3 => srhi(l)(lvg)(k2)(x)(l)(g3)(g4)(c)(fl)(e3)
          )(
            Mst.reroom(
              ~S,
              ~fetch,
              g1,
              ur,
              s,
              h,
              Room{u1, lo, hi},
              Room{ur, lo, hi},
              Node{l, left, List.append(&2, Item, x0 <> r0, y <> ys)},
              k2,
              x,
              Mst.node_in_of(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, List.append(&2, Item, x0 <> r0, y <> ys)})(eN)(oN),
              Shared.Bool.and_both(Mst.lo_le(lo, lo), Mst.hi_le(hi, hi), Mst.lo_le_refl(lo), Mst.hi_le_refl(hi)),
              Shared.Nat.le_refl(ur)
            )(e)
          )
        )
      )

# the split of a node of the items pre, then post, once its gap is split (ms)
def Mst.split_ok.done(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ms: Maybe<&2, Halves>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  ihs: Mst.SplitOk(~S, ~fetch, s, l, Items.last_key(pre, lo), Items.head_key(post, hi), k, Mst.last(pre, left), ms)
) -> Mst.SplitOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  k,
  Some{h},
  Mst.split.done(l, left, Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post}, ms)
):
  match ms:
    case None{}:
      Unit{}
    case Some{Halves{+clo, +chi, +ns}}:
      %Equal.sym(
        Maybe<&2, Hashes.Hash>,
        Mst.left(List.reverse.go(&2, Item, pre, []), left, clo),
        Mst.end_left(pre, left, clo),
        Mst.left_rev(pre, left, clo)
      ): Mst.SplitOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        k,
        Some{h},
        Some{
          Halves{
            Edit.root(Mst.make(l, _, Mst.rejoin(List.reverse.go(&2, Item, pre, []), clo, []), ns)),
            Edit.root(Mst.make(l, chi, post, Edit.nodes(Mst.make(l, _, Mst.rejoin(List.reverse.go(&2, Item, pre, []), clo, []), ns)))),
            Edit.nodes(Mst.make(l, chi, post, Edit.nodes(Mst.make(l, _, Mst.rejoin(List.reverse.go(&2, Item, pre, []), clo, []), ns))))
          }
        }
      )
      %Equal.sym(
        List<&2, Item>,
        Mst.rejoin(List.reverse.go(&2, Item, pre, []), clo, []),
        List.append(&2, Item, Mst.set_last(pre, clo), []),
        Mst.rejoin_rev(pre, clo, [])
      ): Mst.SplitOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        k,
        Some{h},
        Some{
          Halves{
            Edit.root(Mst.make(l, Mst.end_left(pre, left, clo), _, ns)),
            Edit.root(Mst.make(l, chi, post, Edit.nodes(Mst.make(l, Mst.end_left(pre, left, clo), _, ns)))),
            Edit.nodes(Mst.make(l, chi, post, Edit.nodes(Mst.make(l, Mst.end_left(pre, left, clo), _, ns))))
          }
        }
      )
      +hold => Mst.split_ok.halves(
        ~S,
        ~fetch,
        pre,
        post,
        s,
        h,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        clo,
        chi,
        ns,
        eN,
        oN,
        all,
        pk,
        ihs(
          Mst.make_acc(~S, ~fetch, s, l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), []), ns)(
            Mst.make_acc(
              ~S,
              ~fetch,
              s,
              l,
              chi,
              post,
              Edit.nodes(Mst.make(l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), []), ns))
            )(hold)
          )
        )
      )(hold)

# the split of a node at k, by whether the node holds k (b0)
def Mst.split_ok.hit(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b0: Bool,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(post, k) == True{}: Bool},
  +eb0: {Part.hits(Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post}, k) == b0: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> Mst.SplitOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    k,
    m2,
    Mst.split(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k)
  )
) -> Mst.SplitOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  k,
  Some{h},
  Shared.Bool.when(
    Maybe<&2, Halves>,
    b0,
    u => None{},
    u => Mst.split.done(
      l,
      left,
      Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
      Mst.split(
        ~S,
        ~fetch,
        p,
        s,
        Room{l, Items.head_key(List.reverse.go(&2, Item, pre, []), lo), Items.head_key(post, hi)},
        Mst.last(pre, left),
        k
      )
    )
  )
):
  match b0:
    case True{}:
      Unit{}
    case False{}:
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, pre, []), lo),
        Items.last_key(pre, lo),
        Mst.head_rev(pre, lo)
      ): Mst.SplitOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        k,
        Some{h},
        Mst.split.done(
          l,
          left,
          Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
          Mst.split(~S, ~fetch, p, s, Room{l, _, Items.head_key(post, hi)}, Mst.last(pre, left), k)
        )
      )
      Mst.split_ok.done(
        ~S,
        ~fetch,
        Mst.split(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        pre,
        post,
        eN,
        oN,
        all,
        Mst.post_after(post, List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), k, Items.last_key(pre, lo), hi)(hn)(eb0)(
          Mst.post_fit(pre, post, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, post), ur, lo, hi, oN))
        ),
        ih(l)(Items.last_key(pre, lo))(Items.head_key(post, hi))(Mst.last(pre, left))
      )

# the split of the node na of the hash h
def Mst.split_ok.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  na: Maybe<&2, Node>,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}) == na: Maybe<&2, Node>},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> Mst.SplitOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    k,
    m2,
    Mst.split(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k)
  )
) -> Mst.SplitOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  k,
  Some{h},
  Mst.split.at(na, Room{ur, lo, hi}, k, r2 => c => Mst.split(~S, ~fetch, p, s, r2, c, k))
):
  match na:
    case None{}:
      Unit{}
    case Some{Node{+l, +left, +xs}}:
      %Equal.sym(
        Part,
        Mst.part(xs, left, k, []),
        Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)},
        Mst.part_eq(xs, left, k, [])
      ): Mst.SplitOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        k,
        Some{h},
        Shared.Bool.when(
          Maybe<&2, Halves>,
          Part.hits(_, k),
          u => None{},
          u => Mst.split.done(l, left, _, Mst.split(~S, ~fetch, p, s, Part.room(_, l, lo, hi), Part.gap(_), k))
        )
      )
      Mst.split_ok.hit(
        ~S,
        ~fetch,
        Part.hits(Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)}, k),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        Mst.pre(xs, k),
        Mst.post(xs, k),
        Equal.trans(
          Maybe<&2, Node>,
          Mst.node(~S, ~fetch, s, h),
          Some{Node{l, left, xs}},
          Some{Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}},
          Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
          Equal.cong(
            List<&2, Item>,
            Maybe<&2, Node>,
            ys => Some{Node{l, left, ys}},
            xs,
            List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
            Equal.sym(List<&2, Item>, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)), xs, Mst.pre_post(xs, k))
          )
        ),
        Equal.trans(
          Bool,
          Mst.opens(Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}, Room{ur, lo, hi}),
          Mst.opens(Node{l, left, xs}, Room{ur, lo, hi}),
          True{},
          Equal.cong(
            List<&2, Item>,
            Bool,
            ys => Mst.opens(Node{l, left, ys}, Room{ur, lo, hi}),
            List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
            xs,
            Mst.pre_post(xs, k)
          ),
          Mst.in_open(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en)
        ),
        Mst.pre_all_lt(xs, k),
        Mst.post_head(xs, k),
        {==},
        ih
      )

# the split of an empty tree
def Mst.split_ok.none(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  -ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> Mst.SplitOk(~S, ~fetch, s, ur, lo, hi, k, None{}, Some{Halves{None{}, None{}, []}}):
  +hold => (
    {==},
    (
      +u2 => +lv => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => Mst.none_kept(~S, ~fetch, g1, g2, s, Room{u1, lo, hi}, Room{u2, lo, Some{k}}, k2, x),
      +u2 => +lv => +k2 => +x => +u1 => +g1 => +g2 => +c => +fu => Mst.none_kept(~S, ~fetch, g1, g2, s, Room{u1, lo, hi}, Room{u2, Some{k}, hi}, k2, x)
    )
  )

# a split of a tree at k, in its room, reads as Mst.SplitOk says
def Mst.split_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +s: S,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> Mst.SplitOk(~S, ~fetch, s, ur, lo, hi, k, m, Mst.split(~S, ~fetch, f, s, Room{ur, lo, hi}, m, k)):
  match f m:
    case 0n None{}:
      Mst.split_ok.none(~S, ~fetch, s, ur, lo, hi, k)
    case 1n+q None{}:
      Mst.split_ok.none(~S, ~fetch, s, ur, lo, hi, k)
    case 0n Some{h}:
      Unit{}
    case 1n+(+p) Some{+h}:
      Mst.split_ok.at(
        ~S,
        ~fetch,
        Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        {==},
        +ur2 => +lo2 => +hi2 => +m2 => Mst.split_ok(~S, ~fetch, p, m2, s, ur2, lo2, hi2, k)
      )

# a pick of k among items that start with k hits its value
def Mst.hit_first(
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +b: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +a: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Mst.pick(Item{k, v, b} <> rest, a, l, lo, hi, k) == Pick.Hit{v}: Pick}:
  %Equal.sym(Cmp, Key.cmp(k, k), EQ{}, Mst.key_refl(k)) :
    {Shared.Bool.when(Pick, Cmp.is_lt(_), u => Pick.Down{a, Room.of(l, lo, Some{k})}, u => Shared.Bool.when(Pick, Cmp.is_eq(_), w => Pick.Hit{v}, w => Mst.pick(rest, b, l, Some{k}, hi, k))) == Pick.Hit{v} : Pick}
  {==}

# the level of k, checked against the level L of k
def Mst.level_ok(+k: List<&2, U32>, +l: Nat, +el: {Key.level(k) == l: Nat}) -> {Nat.is_eq(Key.level(k), l) == True{}: Bool}:
  %Equal.sym(Nat, Level.of(Hashes.Sha.go.of(List.length(&2, U32, k), Hashes.Hash{1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225}, k, 0, Hashes.Block.of(List.take(&2, U32, k, 16n)))), l, el) : {Cmp.is_eq(Nat.cmp(_, l)) == True{} : Bool}; Shared.Nat.is_eq_refl(l)

# a read of a node whose pick hits the value v, of a key of the level of the
# node, finds v
def Mst.new_hit(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g: Nat,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, g) == True{}: Bool},
  +ep: {Mst.pick(xs, left, l, lo, hi, k) == Pick.Hit{v}: Pick},
  +el: {Nat.is_eq(Key.level(k), l) == True{}: Bool}
) -> {Look.known(Mst.look.go(~S, ~fetch, g, s, Room{u, lo, hi}, Some{h}, k)) == Some{Some{v}}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match g:
    case 0n:
      Empty.absurd(
        {Look.known(Look.Missing{h}) == Some{Some{v}}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(l, left, xs, u, lo, hi, oN, fu)
      )
    case 1n+(+p):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p, s, Room{u, lo, hi}, Some{h}, k),
        Mst.look.pick(Mst.pick(xs, left, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k)),
        Mst.look_node(~S, ~fetch, p, s, h, u, lo, hi, l, left, xs, k, eN, oN)
      ): {Look.known(_) == Some{Some{v}}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      %Equal.sym(Pick, Mst.pick(xs, left, l, lo, hi, k), Pick.Hit{v}, ep): {
        Look.known(Mst.look.pick(_, h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, p, s, r2, m2, k)))
          == Some{Some{v}}: Maybe<&2, Maybe<&2, List<&2, U32>>>
      }
      %Equal.sym(Bool, Nat.is_eq(Key.level(k), l), True{}, el): {
        Look.known(Shared.Bool.when(Look, _, u2 => Look.Found{v}, u2 => Look.Missing{h}))
          == Some{Some{v}}: Maybe<&2, Maybe<&2, List<&2, U32>>>
      }
      {==}

# items with their last subtree set to their own last subtree are the items
def Mst.set_last_last(+xs: List<&2, Item>, +left: Maybe<&2, Hashes.Hash>) -> {Mst.set_last(xs, Mst.last(xs, left)) == xs: List<&2, Item>}:
  match xs:
    case Nil{}:
      {==}
    case Con{head, tail}:
      match head:
        case Item{key, value, right}:
          match tail:
            case Nil{}:
              {==}
            case Con{head, tail1}:
              %Equal.sym(List<&2, Item>, Mst.set_last(head <> tail1, Mst.last(head <> tail1, right)), head <> tail1, Mst.set_last_last(head <> tail1, right)) : {Item{key, value, right} <> _ == Item{key, value, right} <> head <> tail1 : List<&2, Item>}; {==}

# a pick of another key than k reads no value of k
def Mst.pick_val(
  +pre: List<&2, Item>,
  +k: List<&2, U32>,
  +v1: List<&2, U32>,
  +v2: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  +ne: {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool}
) -> {
  Mst.pick(List.append(&2, Item, pre, Item{k, v1, r} <> rest), prev, l, lo, hi, k2)
    == Mst.pick(List.append(&2, Item, pre, Item{k, v2, r} <> rest), prev, l, lo, hi, k2): Pick
}:
  match pre:
    case Nil{}:
      Mst.case_cmp(
        c => {Cmp.is_eq(c) == False{}: Bool} -> {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{k})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{v1}, w => Mst.pick(rest, r, l, Some{k}, hi, k2))
          )
            == Shared.Bool.when(
              Pick,
              Cmp.is_lt(c),
              u => Pick.Down{prev, Room.of(l, lo, Some{k})},
              u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{v2}, w => Mst.pick(rest, r, l, Some{k}, hi, k2))
            ): Pick
        },
        Key.cmp(k2, k),
        +q => +e => {==},
        +q => +e => Empty.absurd({Pick.Hit{v1} == Pick.Hit{v2}: Pick}, Shared.Bool.true_ne_false(e)),
        +q => +e => {==}
      )(ne)
    case Con{Item{+ik, +iv, +ir}, +tl}:
      Mst.case_cmp(
        c => {
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(
              Pick,
              Cmp.is_eq(c),
              w => Pick.Hit{iv},
              w => Mst.pick(List.append(&2, Item, tl, Item{k, v1, r} <> rest), ir, l, Some{ik}, hi, k2)
            )
          )
            == Shared.Bool.when(
              Pick,
              Cmp.is_lt(c),
              u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
              u => Shared.Bool.when(
                Pick,
                Cmp.is_eq(c),
                w => Pick.Hit{iv},
                w => Mst.pick(List.append(&2, Item, tl, Item{k, v2, r} <> rest), ir, l, Some{ik}, hi, k2)
              )
            ): Pick
        },
        Key.cmp(k2, ik),
        +q => {==},
        +q => {==},
        +q => Mst.pick_val(tl, k, v1, v2, r, rest, ir, l, Some{ik}, hi, k2, ne)
      )

# items of other values fit as the items
def Mst.fit_val(
  +pre: List<&2, Item>,
  +k: List<&2, U32>,
  -v1: List<&2, U32>,
  -v2: List<&2, U32>,
  -r: Maybe<&2, Hashes.Hash>,
  -rest: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {
  Items.fit(List.append(&2, Item, pre, Item{k, v1, r} <> rest), lo, hi)
    == Items.fit(List.append(&2, Item, pre, Item{k, v2, r} <> rest), lo, hi): Bool
}:
  match pre:
    case Nil{}:
      {==}
    case Con{Item{+ik, +iv, +ir}, +tl}:
      Equal.cong(
        Bool,
        Bool,
        b => Bool.and(Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)), b),
        Items.fit(List.append(&2, Item, tl, Item{k, v1, r} <> rest), Some{ik}, hi),
        Items.fit(List.append(&2, Item, tl, Item{k, v2, r} <> rest), Some{ik}, hi),
        Mst.fit_val(tl, k, v1, v2, r, rest, Some{ik}, hi)
      )

# items, then one more and more, are not empty
def Mst.empty_app_con(+pre: List<&2, Item>, -y: Item, -ys: List<&2, Item>) -> {
  List.is_empty(&2, Item, List.append(&2, Item, pre, y <> ys)) == False{}: Bool
}:
  match pre:
    case Nil{}:
      {==}
    case Con{head, tail}:
      {==}

# a node of items of other values opens where the node opens
def Mst.opens_val(
  +l: Nat,
  -left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +k: List<&2, U32>,
  +v1: List<&2, U32>,
  +v2: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +o: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, v1, r} <> rest)}, Room{u, lo, hi}) == True{}: Bool}
) -> {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, v2, r} <> rest)}, Room{u, lo, hi}) == True{}: Bool}:
  Mst.opens_of(l, left, List.append(&2, Item, pre, Item{k, v2, r} <> rest), u, lo, hi, Mst.opens_lt(l, left, List.append(&2, Item, pre, Item{k, v1, r} <> rest), Room{u, lo, hi})(o), Mst.empty_app_con(pre, Item{k, v2, r}, rest), (%Mst.opens_fit(l, left, List.append(&2, Item, pre, Item{k, v1, r} <> rest), u, lo, hi, o) : {Items.fit(List.append(&2, Item, pre, Item{k, v2, r} <> rest), lo, hi) == _ : Bool}; Mst.fit_val(pre, k, v2, v1, r, rest, lo, hi)))

# two nodes in one room whose picks of k2 are the same read k2 the same
def Mst.same_read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +h2: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left1: Maybe<&2, Hashes.Hash>,
  +xs1: List<&2, Item>,
  +left2: Maybe<&2, Hashes.Hash>,
  +xs2: List<&2, Item>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left1, xs1}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left1, xs1}, Room{u, lo, hi}) == True{}: Bool},
  +eN2: {Mst.node(~S, ~fetch, s, h2) == Some{Node{l, left2, xs2}}: Maybe<&2, Node>},
  +oN2: {Mst.opens(Node{l, left2, xs2}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, g2) == True{}: Bool},
  +ep: {Mst.pick(xs2, left2, l, lo, hi, k2) == Mst.pick(xs1, left1, l, lo, hi, k2): Pick}
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{h2}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{u, lo, hi}, Some{h2}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{h2}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(l, left2, xs2, u, lo, hi, oN2, fu)
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{u, lo, hi}, Some{h}, k2),
        Mst.look.pick(Mst.pick(xs1, left1, l, lo, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p1, s, h, u, lo, hi, l, left1, xs1, k2, eN, oN)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u, lo, hi}, Some{h2}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{u, lo, hi}, Some{h2}, k2),
        Mst.look.pick(Mst.pick(xs2, left2, l, lo, hi, k2), h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)),
        Mst.look_node(~S, ~fetch, p2, s, h2, u, lo, hi, l, left2, xs2, k2, eN2, oN2)
      ): (
        {
          Look.known(Mst.look.pick(Mst.pick(xs1, left1, l, lo, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(Pick, Mst.pick(xs2, left2, l, lo, hi, k2), Mst.pick(xs1, left1, l, lo, hi, k2), ep): (
        {
          Look.known(Mst.look.pick(Mst.pick(xs1, left1, l, lo, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, h2, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.look.same_pick(
        ~S,
        ~fetch,
        p1,
        p2,
        s,
        xs1,
        left1,
        l,
        lo,
        lo,
        hi,
        hi,
        h,
        h2,
        k2,
        x,
        Mst.lo_le_refl(lo),
        Mst.hi_le_refl(hi),
        Mst.opens_fl(l, left2, xs2, u, lo, hi, p2, oN2, fu)
      )

# a read of a node of one item k, of a key below k, reads the subtree before it
def Mst.single_lt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g2: Nat,
  +s: S,
  +ht: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +a: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +b: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eT: {Mst.node(~S, ~fetch, s, ht) == Some{Node{l, a, [Item{k, v, b}]}}: Maybe<&2, Node>},
  +oT: {Mst.opens(Node{l, a, [Item{k, v, b}]}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, g2) == True{}: Bool},
  +c: {Key.cmp(k2, k) == LT{}: Cmp},
  ih: @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, lo, Some{k}}, a, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{ht}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  Mst.new_down(~S, ~fetch, g2, s, ht, u, lo, hi, l, a, [Item{k, v, b}], k2, x, a, lo, Some{k}, eT, oT, fu, (%Equal.sym(Cmp, Key.cmp(k2, k), LT{}, c) : {Shared.Bool.when(Pick, Cmp.is_lt(_), u => Pick.Down{a, Room.of(l, lo, Some{k})}, u => Shared.Bool.when(Pick, Cmp.is_eq(_), w => Pick.Hit{v}, w => Mst.pick([], b, l, Some{k}, hi, k2))) == Pick.Down{a, Room{l, lo, Some{k}}} : Pick}; {==}), ih)

# a read of a node of one item k, of a key above k, reads the subtree after it
def Mst.single_gt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g2: Nat,
  +s: S,
  +ht: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +a: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +b: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eT: {Mst.node(~S, ~fetch, s, ht) == Some{Node{l, a, [Item{k, v, b}]}}: Maybe<&2, Node>},
  +oT: {Mst.opens(Node{l, a, [Item{k, v, b}]}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, g2) == True{}: Bool},
  +c: {Key.cmp(k2, k) == GT{}: Cmp},
  ih: @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Some{k}, hi}, b, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, Some{ht}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  Mst.new_down(~S, ~fetch, g2, s, ht, u, lo, hi, l, a, [Item{k, v, b}], k2, x, b, Some{k}, hi, eT, oT, fu, (%Equal.sym(Cmp, Key.cmp(k2, k), GT{}, c) : {Shared.Bool.when(Pick, Cmp.is_lt(_), u => Pick.Down{a, Room.of(l, lo, Some{k})}, u => Shared.Bool.when(Pick, Cmp.is_eq(_), w => Pick.Hit{v}, w => Mst.pick([], b, l, Some{k}, hi, k2))) == Pick.Down{b, Room{l, Some{k}, hi}} : Pick}; {==}), ih)

# what a write of k as v reads: k, as v; any other key, as the tree m did
def Mst.InsRead(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -ur: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -hi: Maybe<&2, List<&2, U32>>,
  -m: Maybe<&2, Hashes.Hash>,
  -k: List<&2, U32>,
  -v: Maybe<&2, List<&2, U32>>,
  -nr: Maybe<&2, Hashes.Hash>
) -> Type:
  (
    @g: Nat -> {Nat.is_le(ur, g) == True{}: Bool} -> {
      Look.known(Mst.look.go(~S, ~fetch, g, s, Room{ur, lo, hi}, nr, k)) == Some{v}: Maybe<&2, Maybe<&2, List<&2, U32>>>
    }
  )
    & (
      @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @g1: Nat -> @g2: Nat -> {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool} -> {
        Nat.is_le(ur, g2) == True{}: Bool
      } -> {
        Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
      } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, nr, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
    )

# a write res of k as v (none: a delete) to the tree m in the room of the up
# ur between lo and hi: once the depot holds its new nodes, it reads as
# Mst.InsRead says
def Mst.InsOk(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -ur: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -hi: Maybe<&2, List<&2, U32>>,
  -m: Maybe<&2, Hashes.Hash>,
  -k: List<&2, U32>,
  -v: Maybe<&2, List<&2, U32>>,
  res: Maybe<&2, Edit>
) -> Type:
  match res:
    case None{}:
      Unit
    case Some{Edit{nr, ns}}:
      {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool} -> Mst.InsRead(~S, ~fetch, s, ur, lo, hi, m, k, v, nr)


# a key that is not k does not compare EQ to it
def Mst.ne_eq(+k2: List<&2, U32>, +k: List<&2, U32>, +ne: {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool}, +c: {Key.cmp(k2, k) == EQ{}: Cmp}) -> Empty:
  Shared.Bool.true_ne_false(
    Equal.trans(
      Bool,
      True{},
      Cmp.is_eq(Key.cmp(k2, k)),
      False{},
      Equal.sym(Bool, Cmp.is_eq(Key.cmp(k2, k)), True{}, Equal.cong(Cmp, Bool, Cmp.is_eq, Key.cmp(k2, k), EQ{}, c)),
      ne
    )
  )

# items with k put between those before it and those after it fit
def Mst.fit_ins(
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +chi: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Items.fit(List.append(&2, Item, pre, post), lo, hi) == True{}: Bool} -> {Mst.all_lt(pre, k) == True{}: Bool} -> {
  Bound.after(lo, k) == True{}: Bool
} -> {Bound.before(k, hi) == True{}: Bool} -> {Items.fit(post, Some{k}, hi) == True{}: Bool} -> {
  Items.fit(List.append(&2, Item, pre, Item{k, v, chi} <> post), lo, hi) == True{}: Bool
}:
  +f => +al => +a => +b => +fp => Equal.trans(
    Bool,
    Items.fit(List.append(&2, Item, pre, Item{k, v, chi} <> post), lo, hi),
    Bool.and(Items.fit(pre, lo, hi), Items.fit(Item{k, v, chi} <> post, Items.last_key(pre, lo), hi)),
    True{},
    Mst.fit_append(pre, Item{k, v, chi} <> post, lo, hi),
    Shared.Bool.and_both(
      Items.fit(pre, lo, hi),
      Items.fit(Item{k, v, chi} <> post, Items.last_key(pre, lo), hi),
      Shared.Bool.and_true_left(
        Items.fit(pre, lo, hi),
        Items.fit(post, Items.last_key(pre, lo), hi),
        Equal.trans(
          Bool,
          Bool.and(Items.fit(pre, lo, hi), Items.fit(post, Items.last_key(pre, lo), hi)),
          Items.fit(List.append(&2, Item, pre, post), lo, hi),
          True{},
          Equal.sym(
            Bool,
            Items.fit(List.append(&2, Item, pre, post), lo, hi),
            Bool.and(Items.fit(pre, lo, hi), Items.fit(post, Items.last_key(pre, lo), hi)),
            Mst.fit_append(pre, post, lo, hi)
          ),
          f
        )
      ),
      Shared.Bool.and_both(
        Bool.and(Bound.after(Items.last_key(pre, lo), k), Bound.before(k, hi)),
        Items.fit(post, Some{k}, hi),
        Shared.Bool.and_both(Bound.after(Items.last_key(pre, lo), k), Bound.before(k, hi), Mst.last_below(pre, lo, k)(al)(a), b),
        fp
      )
    )
  )

# a pick of a key after k among k and more steps past k
def Mst.pick_past_k(
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +chi: Maybe<&2, Hashes.Hash>,
  +post: List<&2, Item>,
  +clo: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lk: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k2: List<&2, U32>,
  +c: {Key.cmp(k2, k) == GT{}: Cmp}
) -> {Mst.pick(Item{k, v, chi} <> post, clo, l, lk, hi, k2) == Mst.pick(post, chi, l, Some{k}, hi, k2): Pick}:
  %Equal.sym(Cmp, Key.cmp(k2, k), GT{}, c): {
    Shared.Bool.when(
      Pick,
      Cmp.is_lt(_),
      u => Pick.Down{clo, Room.of(l, lk, Some{k})},
      u => Shared.Bool.when(Pick, Cmp.is_eq(_), w => Pick.Hit{v}, w => Mst.pick(post, chi, l, Some{k}, hi, k2))
    )
      == Mst.pick(post, chi, l, Some{k}, hi, k2): Pick
  }
  {==}

# a node with k put into its gap, between its halves, reads a key above k as
# the node did, but in the upper half, as ih says
def Mst.ins_hi(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +hn: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +clo: Maybe<&2, Hashes.Hash>,
  +chi: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +eG: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}}: Maybe<&2, Node>
  },
  +oG: {
    Mst.opens(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, Room{ur, lo, hi})
      == True{}: Bool
  },
  +ps: {Mst.passes(pre, k2) == True{}: Bool},
  +c: {Key.cmp(k2, k) == GT{}: Cmp},
  +fu: {Nat.is_le(ur, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Some{k}, Items.head_key(post, hi)}, chi, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{hn}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(
          l,
          Mst.end_left(pre, left, clo),
          List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post),
          ur,
          lo,
          hi,
          oG,
          fu
        )
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{ur, lo, hi}, Some{h}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
          h,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
        ),
        Mst.look_node(~S, ~fetch, p1, s, h, ur, lo, hi, l, left, List.append(&2, Item, pre, post), k2, eN, oN)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{ur, lo, hi}, Some{hn}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post), Mst.end_left(pre, left, clo), l, lo, hi, k2),
          hn,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p2,
          s,
          hn,
          ur,
          lo,
          hi,
          l,
          Mst.end_left(pre, left, clo),
          List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post),
          k2,
          eG,
          oG
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, pre, post), left, l, lo, hi, k2),
        Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2),
        Mst.pick_passes(pre, post, left, l, lo, hi, k2)(ps)
      ): (
        {
          Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post), Mst.end_left(pre, left, clo), l, lo, hi, k2),
                hn,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post), Mst.end_left(pre, left, clo), l, lo, hi, k2),
        Mst.pick(post, chi, l, Some{k}, hi, k2),
        Equal.trans(
          Pick,
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post), Mst.end_left(pre, left, clo), l, lo, hi, k2),
          Mst.pick(Item{k, v, chi} <> post, clo, l, Items.last_key(pre, lo), hi, k2),
          Mst.pick(post, chi, l, Some{k}, hi, k2),
          Mst.pick_set_passes(pre, clo, Item{k, v, chi} <> post, left, l, lo, hi, k2, ps),
          Mst.pick_past_k(k, v, chi, post, clo, l, Items.last_key(pre, lo), hi, k2, c)
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(post, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.gap_kept.first(
        ~S,
        ~fetch,
        Mst.stops_first(post, k2),
        p1,
        p2,
        s,
        post,
        Mst.last(pre, left),
        chi,
        l,
        Items.last_key(pre, lo),
        Some{k},
        hi,
        hi,
        h,
        hn,
        k2,
        x,
        {==},
        Mst.hi_le_refl(hi),
        Mst.opens_fl(
          l,
          Mst.end_left(pre, left, clo),
          List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post),
          ur,
          lo,
          hi,
          p2,
          oG,
          fu
        ),
        ih
      )

# a write of k into an empty tree
def Mst.ins_ok.none(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +el: {Key.level(k) == ll: Nat},
  +lt: {Nat.is_lt(ll, ur) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool}
) -> Mst.InsOk(~S, ~fetch, s, ur, lo, hi, None{}, k, Some{v}, Some{Mst.store(Node{ll, None{}, [Item{k, v, None{}}]}, [])}):
  +hold =>
    +eT = Mst.node_code(
      ~S,
      ~fetch,
      s,
      Node{ll, None{}, [Item{k, v, None{}}]},
      Mst.holds_head(~S, ~fetch, s, Node.code(Node{ll, None{}, [Item{k, v, None{}}]}, []), [], hold)
    )
    +oT = Mst.opens_of(
      ll,
      None{},
      [Item{k, v, None{}}],
      ur,
      lo,
      hi,
      lt,
      {==},
      Shared.Bool.and_both(
        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
        True{},
        Shared.Bool.and_both(Bound.after(lo, k), Bound.before(k, hi), a, bb),
        {==}
      )
    )
    (
      +g => +fu => Mst.new_hit(
        ~S,
        ~fetch,
        g,
        s,
        Hashes.Sha.hash(Node.code(Node{ll, None{}, [Item{k, v, None{}}]}, [])),
        ur,
        lo,
        hi,
        ll,
        None{},
        [Item{k, v, None{}}],
        k,
        v,
        eT,
        oT,
        fu,
        Mst.hit_first(k, v, None{}, [], None{}, ll, lo, hi),
        Mst.level_ok(k, ll, el)
      ),
      +k2 => +x => +g1 => +g2 => +ne => +fu => +e => Mst.case_cmp(
        t => {Key.cmp(k2, k) == t: Cmp} -> {
          Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{Hashes.Sha.hash(Node.code(Node{ll, None{}, [Item{k, v, None{}}]}, []))}, k2))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        },
        Key.cmp(k2, k),
        +q => +c => Mst.single_lt(
          ~S,
          ~fetch,
          g2,
          s,
          Hashes.Sha.hash(Node.code(Node{ll, None{}, [Item{k, v, None{}}]}, [])),
          ur,
          lo,
          hi,
          ll,
          None{},
          k,
          v,
          None{},
          k2,
          x,
          eT,
          oT,
          fu,
          c,
          +g4 => +fl => Mst.none_kept(~S, ~fetch, g1, g4, s, Room{ur, lo, hi}, Room{ll, lo, Some{k}}, k2, x)(e)
        ),
        +q => +c => Empty.absurd(
          {
            Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{Hashes.Sha.hash(Node.code(Node{ll, None{}, [Item{k, v, None{}}]}, []))}, k2))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          },
          Mst.ne_eq(k2, k, ne, c)
        ),
        +q => +c => Mst.single_gt(
          ~S,
          ~fetch,
          g2,
          s,
          Hashes.Sha.hash(Node.code(Node{ll, None{}, [Item{k, v, None{}}]}, [])),
          ur,
          lo,
          hi,
          ll,
          None{},
          k,
          v,
          None{},
          k2,
          x,
          eT,
          oT,
          fu,
          c,
          +g4 => +fl => Mst.none_kept(~S, ~fetch, g1, g4, s, Room{ur, lo, hi}, Room{ll, Some{k}, hi}, k2, x)(e)
        )
      )({==})
    )

# Mst.ins_ok.top.read, for a key other than k, by how it compares to k (c)
def Mst.ins_ok.top.k2(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +hl: Maybe<&2, Hashes.Hash>,
  +hh: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  +x: Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +g2: Nat,
  +ec: {Key.cmp(k2, k) == c: Cmp},
  +eT: {Mst.node(~S, ~fetch, s, Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, []))) == Some{Node{ll, hl, [Item{k, v, hh}]}}: Maybe<&2, Node>},
  +oT: {Mst.opens(Node{ll, hl, [Item{k, v, hh}]}, Room{ur, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(ur, g2) == True{}: Bool},
  +ne: {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool},
  +lv: {Mst.lvl(~S, ~fetch, s, Some{h}, ll) == True{}: Bool},
  +e: {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
  sr: Mst.SplitRead(~S, ~fetch, s, lo, hi, k, Some{h}, hl, hh)
) -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, []))}, k2))
    == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match c:
    case LT{}:
      (slo, shi) = sr
      Mst.single_lt(
        ~S,
        ~fetch,
        g2,
        s,
        Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, [])),
        ur,
        lo,
        hi,
        ll,
        hl,
        k,
        v,
        hh,
        k2,
        x,
        eT,
        oT,
        fu,
        ec,
        +g4 => +fl => slo(ll)(lv)(k2)(x)(ur)(g1)(g4)(ec)(fl)(e)
      )
    case GT{}:
      (slo, shi) = sr
      Mst.single_gt(
        ~S,
        ~fetch,
        g2,
        s,
        Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, [])),
        ur,
        lo,
        hi,
        ll,
        hl,
        k,
        v,
        hh,
        k2,
        x,
        eT,
        oT,
        fu,
        ec,
        +g4 => +fl => shi(ll)(lv)(k2)(x)(ur)(g1)(g4)(ec)(fl)(e)
      )
    case EQ{}:
      Empty.absurd(
        {
          Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, []))}, k2))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        },
        Mst.ne_eq(k2, k, ne, ec)
      )

# what a write of k as a new root reads, from what the split of the old root
# reads (bi)
def Mst.ins_ok.top.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +hl: Maybe<&2, Hashes.Hash>,
  +hh: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(l, ll) == LT{}: Cmp},
  +el: {Key.level(k) == ll: Nat},
  +lt: {Nat.is_lt(ll, ur) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +hold: {Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{ll, hl, [Item{k, v, hh}]}, []) <> ns) == True{}: Bool},
  bi: {Mst.lvl(~S, ~fetch, s, Some{h}, ur) == True{}: Bool} & Mst.SplitRead(~S, ~fetch, s, lo, hi, k, Some{h}, hl, hh)
) -> Mst.InsRead(~S, ~fetch, s, ur, lo, hi, Some{h}, k, Some{v}, Some{Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, []))}):
  (lvh, sr) = bi
  +eT = Mst.node_code(
    ~S,
    ~fetch,
    s,
    Node{ll, hl, [Item{k, v, hh}]},
    Mst.holds_head(~S, ~fetch, s, Node.code(Node{ll, hl, [Item{k, v, hh}]}, []), ns, hold)
  )
  +oT = Mst.opens_of(
    ll,
    hl,
    [Item{k, v, hh}],
    ur,
    lo,
    hi,
    lt,
    {==},
    Shared.Bool.and_both(
      Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
      True{},
      Shared.Bool.and_both(Bound.after(lo, k), Bound.before(k, hi), a, bb),
      {==}
    )
  )
  (
    +g => +fu => Mst.new_hit(
      ~S,
      ~fetch,
      g,
      s,
      Hashes.Sha.hash(Node.code(Node{ll, hl, [Item{k, v, hh}]}, [])),
      ur,
      lo,
      hi,
      ll,
      hl,
      [Item{k, v, hh}],
      k,
      v,
      eT,
      oT,
      fu,
      Mst.hit_first(k, v, hh, [], hl, ll, lo, hi),
      Mst.level_ok(k, ll, el)
    ),
    +k2 => +x => +g1 => +g2 => +ne => +fu => +e => Mst.ins_ok.top.k2(
      ~S,
      ~fetch,
      Key.cmp(k2, k),
      s,
      h,
      ur,
      lo,
      hi,
      k,
      v,
      ll,
      hl,
      hh,
      k2,
      x,
      g1,
      g2,
      {==},
      eT,
      oT,
      fu,
      ne,
      Mst.lvl_of(~S, ~fetch, s, h, ll, l, left, xs, eN, Mst.nat_lt_of(l, ll)(ec)),
      e,
      sr
    )
  )

# a write of k into a tree of a lower level: a new root over its split
def Mst.ins_ok.top(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ms: Maybe<&2, Halves>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +ec: {Nat.cmp(l, ll) == LT{}: Cmp},
  +el: {Key.level(k) == ll: Nat},
  +lt: {Nat.is_lt(ll, ur) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ihs: Mst.SplitOk(~S, ~fetch, s, ur, lo, hi, k, Some{h}, ms)
) -> Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, Some{v}, Mst.insert.top(ll, k, v, ms)):
  match ms:
    case None{}:
      Unit{}
    case Some{Halves{+hl, +hh, +ns}}:
      +hold => Mst.ins_ok.top.read(
        ~S,
        ~fetch,
        s,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        ll,
        l,
        left,
        xs,
        hl,
        hh,
        ns,
        eN,
        ec,
        el,
        lt,
        a,
        bb,
        hold,
        ihs(Mst.holds_tail(~S, ~fetch, s, Node.code(Node{ll, hl, [Item{k, v, hh}]}, []), ns, hold))
      )

# a write of k as v to a node of its level that holds k: the value replaced
def Mst.ins_ok.replace(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +ell: {Nat.is_eq(Key.level(k), l) == True{}: Bool}
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Some{Mst.store(Node{l, left, Mst.rejoin(List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), Item{k, v, r} <> rest)}, [])}
):
  %Equal.sym(
    List<&2, Item>,
    Mst.rejoin(List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), Item{k, v, r} <> rest),
    List.append(&2, Item, Mst.set_last(pre, Mst.last(pre, left)), Item{k, v, r} <> rest),
    Mst.rejoin_rev(pre, Mst.last(pre, left), Item{k, v, r} <> rest)
  ): Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, Some{v}, Some{Mst.store(Node{l, left, _}, [])})
  %Equal.sym(List<&2, Item>, Mst.set_last(pre, Mst.last(pre, left)), pre, Mst.set_last_last(pre, left)): Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur,
    lo,
    hi,
    Some{h},
    k,
    Some{v},
    Some{Mst.store(Node{l, left, List.append(&2, Item, _, Item{k, v, r} <> rest)}, [])}
  )
  +hold =>
    +eR = Mst.node_code(
      ~S,
      ~fetch,
      s,
      Node{l, left, List.append(&2, Item, pre, Item{k, v, r} <> rest)},
      Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, left, List.append(&2, Item, pre, Item{k, v, r} <> rest)}, []), [], hold)
    )
    +oR = Mst.opens_val(l, left, pre, k, iv, v, r, rest, ur, lo, hi, oN)
    (
      +g => +fu => Mst.new_hit(
        ~S,
        ~fetch,
        g,
        s,
        Hashes.Sha.hash(Node.code(Node{l, left, List.append(&2, Item, pre, Item{k, v, r} <> rest)}, [])),
        ur,
        lo,
        hi,
        l,
        left,
        List.append(&2, Item, pre, Item{k, v, r} <> rest),
        k,
        v,
        eR,
        oR,
        fu,
        Equal.trans(
          Pick,
          Mst.pick(List.append(&2, Item, pre, Item{k, v, r} <> rest), left, l, lo, hi, k),
          Mst.pick(Item{k, v, r} <> rest, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k),
          Pick.Hit{v},
          Mst.pick_passes(pre, Item{k, v, r} <> rest, left, l, lo, hi, k)(Mst.passes_of_all_lt(pre, k)(all)),
          Mst.hit_first(k, v, r, rest, Mst.last(pre, left), l, Items.last_key(pre, lo), hi)
        ),
        ell
      ),
      +k2 => +x => +g1 => +g2 => +ne => +fu => +e => Mst.same_read(
        ~S,
        ~fetch,
        g1,
        g2,
        s,
        h,
        Hashes.Sha.hash(Node.code(Node{l, left, List.append(&2, Item, pre, Item{k, v, r} <> rest)}, [])),
        ur,
        lo,
        hi,
        l,
        left,
        List.append(&2, Item, pre, Item{k, iv, r} <> rest),
        left,
        List.append(&2, Item, pre, Item{k, v, r} <> rest),
        k2,
        x,
        eN,
        oN,
        eR,
        oR,
        fu,
        Mst.pick_val(pre, k, v, iv, r, rest, left, l, lo, hi, k2, ne)
      )(e)
    )

# Mst.ins_ok.gap.read, for a key other than k, by how it compares to k (c)
def Mst.ins_ok.gap.k2(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +s: S,
  +h: Hashes.Hash,
  +hn: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +clo: Maybe<&2, Hashes.Hash>,
  +chi: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  +x: Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +g2: Nat,
  +ec: {Key.cmp(k2, k) == c: Cmp},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +eG: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}}: Maybe<&2, Node>
  },
  +oG: {
    Mst.opens(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, Room{ur, lo, hi})
      == True{}: Bool
  },
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  +fu: {Nat.is_le(ur, g2) == True{}: Bool},
  +ne: {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool},
  +lvg: {Mst.lvl(~S, ~fetch, s, Mst.last(pre, left), l) == True{}: Bool},
  +e: {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
  sr: Mst.SplitRead(~S, ~fetch, s, Items.last_key(pre, lo), Items.head_key(post, hi), k, Mst.last(pre, left), clo, chi)
) -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match c:
    case LT{}:
      (slo, shi) = sr
      Mst.gap_lo(
        ~S,
        ~fetch,
        g1,
        g2,
        s,
        h,
        hn,
        ur,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        pre,
        post,
        Item{k, v, chi} <> post,
        clo,
        hi,
        k2,
        x,
        eN,
        oN,
        eG,
        oG,
        Mst.stops_first_fit(post, k, hi, k2)(pk)(Mst.le_of_lt(Key.cmp(k2, k))(ec)),
        Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k2, k), LT{}, ec),
        fu,
        +g3 => +g4 => +fl => +e3 => slo(l)(lvg)(k2)(x)(l)(g3)(g4)(ec)(fl)(e3)
      )(e)
    case GT{}:
      (slo, shi) = sr
      Mst.ins_hi(
        ~S,
        ~fetch,
        g1,
        g2,
        s,
        h,
        hn,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        pre,
        post,
        clo,
        chi,
        k2,
        x,
        eN,
        oN,
        eG,
        oG,
        Mst.passes_of_lt(pre, k, k2)(all)(Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k, k2), LT{}, Mst.key_gt_lt(k2, k)(ec))),
        ec,
        fu,
        +g3 => +g4 => +fl => +e3 => shi(l)(lvg)(k2)(x)(l)(g3)(g4)(ec)(fl)(e3)
      )(e)
    case EQ{}:
      Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.ne_eq(k2, k, ne, ec)
      )

# what a write of k into the gap of a node of its level reads, from what the
# split of the gap reads (bi)
def Mst.ins_ok.gap.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +clo: Maybe<&2, Hashes.Hash>,
  +chi: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +ell: {Nat.is_eq(Key.level(k), l) == True{}: Bool},
  +hold: {
    Depots.Depot.holds(
      ~S,
      ~fetch,
      s,
      Node.code(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, []) <> ns
    )
      == True{}: Bool
  },
  bi: {Mst.lvl(~S, ~fetch, s, Mst.last(pre, left), l) == True{}: Bool}
    & Mst.SplitRead(~S, ~fetch, s, Items.last_key(pre, lo), Items.head_key(post, hi), k, Mst.last(pre, left), clo, chi)
) -> Mst.InsRead(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Some{Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, []))}
):
  (+lvg, sr) = bi
  +eG = Mst.node_code(
    ~S,
    ~fetch,
    s,
    Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)},
    Mst.holds_head(
      ~S,
      ~fetch,
      s,
      Node.code(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, []),
      ns,
      hold
    )
  )
  +oG = Mst.opens_set_last(l, left, Mst.end_left(pre, left, clo), pre, clo, Item{k, v, chi} <> post, Room{ur, lo, hi})(
    Mst.opens_of(
      l,
      left,
      List.append(&2, Item, pre, Item{k, v, chi} <> post),
      ur,
      lo,
      hi,
      Mst.opens_lt(l, left, List.append(&2, Item, pre, post), Room{ur, lo, hi})(oN),
      Mst.empty_app_con(pre, Item{k, v, chi}, post),
      Mst.fit_ins(pre, post, k, v, chi, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, post), ur, lo, hi, oN))(all)(a)(bb)(pk)
    )
  )
  (
    +g => +fu => Mst.new_hit(
      ~S,
      ~fetch,
      g,
      s,
      Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, [])),
      ur,
      lo,
      hi,
      l,
      Mst.end_left(pre, left, clo),
      List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post),
      k,
      v,
      eG,
      oG,
      fu,
      Equal.trans(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post), Mst.end_left(pre, left, clo), l, lo, hi, k),
        Mst.pick(Item{k, v, chi} <> post, clo, l, Items.last_key(pre, lo), hi, k),
        Pick.Hit{v},
        Mst.pick_set_passes(pre, clo, Item{k, v, chi} <> post, left, l, lo, hi, k, Mst.passes_of_all_lt(pre, k)(all)),
        Mst.hit_first(k, v, chi, post, clo, l, Items.last_key(pre, lo), hi)
      ),
      ell
    ),
    +k2 => +x => +g1 => +g2 => +ne => +fu => +e => Mst.ins_ok.gap.k2(
      ~S,
      ~fetch,
      Key.cmp(k2, k),
      s,
      h,
      Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, [])),
      ur,
      lo,
      hi,
      k,
      v,
      l,
      left,
      pre,
      post,
      clo,
      chi,
      k2,
      x,
      g1,
      g2,
      {==},
      eN,
      oN,
      eG,
      oG,
      all,
      pk,
      fu,
      ne,
      lvg,
      e,
      sr
    )
  )

# a write of k into the gap of a node of its level, once the gap is split (ms)
def Mst.ins_ok.gap(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ms: Maybe<&2, Halves>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +ell: {Nat.is_eq(Key.level(k), l) == True{}: Bool},
  ihs: Mst.SplitOk(~S, ~fetch, s, l, Items.last_key(pre, lo), Items.head_key(post, hi), k, Mst.last(pre, left), ms)
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Mst.insert.gap(l, left, k, v, Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post}, ms)
):
  match ms:
    case None{}:
      Unit{}
    case Some{Halves{+clo, +chi, +ns}}:
      %Equal.sym(
        Maybe<&2, Hashes.Hash>,
        Mst.left(List.reverse.go(&2, Item, pre, []), left, clo),
        Mst.end_left(pre, left, clo),
        Mst.left_rev(pre, left, clo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        Some{v},
        Some{Mst.store(Node{l, _, Mst.rejoin(List.reverse.go(&2, Item, pre, []), clo, Item{k, v, chi} <> post)}, ns)}
      )
      %Equal.sym(
        List<&2, Item>,
        Mst.rejoin(List.reverse.go(&2, Item, pre, []), clo, Item{k, v, chi} <> post),
        List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post),
        Mst.rejoin_rev(pre, clo, Item{k, v, chi} <> post)
      ): Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, Some{v}, Some{Mst.store(Node{l, Mst.end_left(pre, left, clo), _}, ns)})
      +hold => Mst.ins_ok.gap.read(
        ~S,
        ~fetch,
        s,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        pre,
        post,
        clo,
        chi,
        ns,
        eN,
        oN,
        all,
        pk,
        a,
        bb,
        ell,
        hold,
        ihs(
          Mst.holds_tail(
            ~S,
            ~fetch,
            s,
            Node.code(Node{l, Mst.end_left(pre, left, clo), List.append(&2, Item, Mst.set_last(pre, clo), Item{k, v, chi} <> post)}, []),
            ns,
            hold
          )
        )
      )

# a write of k to a node of its level whose first item from k on is ik, by
# whether ik is k (b)
def Mst.ins_ok.here.b(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +eb: {Cmp.is_eq(Key.cmp(ik, k)) == b: Bool},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(Item{ik, iv, r} <> rest, k) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +ell: {Nat.is_eq(Key.level(k), l) == True{}: Bool}
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Shared.Bool.when(
    Maybe<&2, Edit>,
    b,
    u => Some{Mst.store(Node{l, left, Mst.rejoin(List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), Item{k, v, r} <> rest)}, [])},
    u => Mst.insert.gap(
      l,
      left,
      k,
      v,
      Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), Item{ik, iv, r} <> rest},
      Mst.split(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Some{ik}}, Mst.last(pre, left), k)
    )
  )
):
  match b:
    case True{}:
      +eik = Mst.key_eq(ik, k)(Shared.Cmp.is_eq_sound(Key.cmp(ik, k))(eb))
      Mst.ins_ok.replace(
        ~S,
        ~fetch,
        s,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        pre,
        iv,
        r,
        rest,
        Equal.trans(
          Maybe<&2, Node>,
          Mst.node(~S, ~fetch, s, h),
          Some{Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}},
          Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}},
          eN,
          Equal.cong(List<&2, U32>, Maybe<&2, Node>, z => Some{Node{l, left, List.append(&2, Item, pre, Item{z, iv, r} <> rest)}}, ik, k, eik)
        ),
        Equal.trans(
          Bool,
          Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}),
          Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}, Room{ur, lo, hi}),
          True{},
          Equal.cong(
            List<&2, U32>,
            Bool,
            z => Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{z, iv, r} <> rest)}, Room{ur, lo, hi}),
            k,
            ik,
            Equal.sym(List<&2, U32>, ik, k, eik)
          ),
          oN
        ),
        all,
        ell
      )
    case False{}:
      Mst.ins_ok.gap(
        ~S,
        ~fetch,
        Mst.split(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Some{ik}}, Mst.last(pre, left), k),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        pre,
        Item{ik, iv, r} <> rest,
        eN,
        oN,
        all,
        Mst.post_after(Item{ik, iv, r} <> rest, List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), k, Items.last_key(pre, lo), hi)(hn)(eb)(
          Mst.post_fit(pre, Item{ik, iv, r} <> rest, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest), ur, lo, hi, oN))
        ),
        a,
        bb,
        ell,
        Mst.split_ok(~S, ~fetch, p, Mst.last(pre, left), s, l, Items.last_key(pre, lo), Some{ik}, k)
      )

# a write of k to a node of its level, by the items from k on (post)
def Mst.ins_ok.here(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  post: List<&2, Item>,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(post, k) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +ell: {Nat.is_eq(Key.level(k), l) == True{}: Bool}
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Mst.insert.here(
    l,
    left,
    k,
    v,
    Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
    c => Mst.split(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, c, k)
  )
):
  match post:
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.ins_ok.here.b(
        ~S,
        ~fetch,
        Cmp.is_eq(Key.cmp(ik, k)),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        pre,
        ik,
        iv,
        r,
        rest,
        {==},
        eN,
        oN,
        all,
        hn,
        a,
        bb,
        ell
      )
    case Nil{}:
      Mst.ins_ok.gap(
        ~S,
        ~fetch,
        Mst.split(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), hi}, Mst.last(pre, left), k),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        pre,
        [],
        eN,
        oN,
        all,
        {==},
        a,
        bb,
        ell,
        Mst.split_ok(~S, ~fetch, p, Mst.last(pre, left), s, l, Items.last_key(pre, lo), hi, k)
      )

# what a write of k (as m) below a node of a higher level reads, from what the
# write into its gap reads (bi)
def Mst.ins_ok.gtw.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +m: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  +hold: {
    Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, []) <> ns)
      == True{}: Bool
  },
  bi: Mst.InsRead(~S, ~fetch, s, l, Items.last_key(pre, lo), Items.head_key(post, hi), Mst.last(pre, left), k, m, nc)
) -> Mst.InsRead(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  m,
  Some{Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, []))}
):
  (i1, i2) = bi
  +eW = Mst.node_code(
    ~S,
    ~fetch,
    s,
    Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)},
    Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, []), ns, hold)
  )
  +oW = Mst.opens_set_last(l, left, Mst.end_left(pre, left, nc), pre, nc, post, Room{ur, lo, hi})(oN)
  (
    +g => +fu => Mst.gap_k(
      ~S,
      ~fetch,
      g,
      s,
      Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, [])),
      ur,
      lo,
      hi,
      l,
      left,
      pre,
      post,
      nc,
      k,
      m,
      eW,
      oW,
      fu,
      Mst.passes_of_all_lt(pre, k)(all),
      Mst.stops_first_fit(post, k, hi, k)(pk)(Mst.le_refl_key(k)),
      +g4 => +fl => i1(g4)(fl)
    ),
    +k2 => +x => +g1 => +g2 => +ne => +fu => +e => Mst.gap_kept(
      ~S,
      ~fetch,
      g1,
      g2,
      s,
      h,
      Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, [])),
      ur,
      ur,
      lo,
      lo,
      hi,
      hi,
      l,
      left,
      pre,
      post,
      nc,
      k2,
      x,
      eN,
      oN,
      eW,
      oW,
      Mst.lo_le_refl(lo),
      Mst.hi_le_refl(hi),
      fu,
      +g3 => +g4 => +fl => +e3 => i2(k2)(x)(g3)(g4)(ne)(fl)(e3)
    )(e)
  )

# a write of k (as m) below a node of a higher level, once its gap is written
# (ein)
def Mst.ins_ok.gtw(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ein: Maybe<&2, Edit>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +m: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +pk: {Items.fit(post, Some{k}, hi) == True{}: Bool},
  ihi: Mst.InsOk(~S, ~fetch, s, l, Items.last_key(pre, lo), Items.head_key(post, hi), Mst.last(pre, left), k, m, ein)
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  m,
  Mst.with_gap(l, left, Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post}, ein)
):
  match ein:
    case None{}:
      Unit{}
    case Some{Edit{+nc, +ns}}:
      %Equal.sym(
        Maybe<&2, Hashes.Hash>,
        Mst.left(List.reverse.go(&2, Item, pre, []), left, nc),
        Mst.end_left(pre, left, nc),
        Mst.left_rev(pre, left, nc)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        m,
        Some{Mst.make(l, _, Mst.rejoin(List.reverse.go(&2, Item, pre, []), nc, post), ns)}
      )
      %Equal.sym(
        List<&2, Item>,
        Mst.rejoin(List.reverse.go(&2, Item, pre, []), nc, post),
        List.append(&2, Item, Mst.set_last(pre, nc), post),
        Mst.rejoin_rev(pre, nc, post)
      ): Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, m, Some{Mst.make(l, Mst.end_left(pre, left, nc), _, ns)})
      %Equal.sym(
        Edit,
        Mst.make(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post), ns),
        Mst.store(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, ns),
        Mst.make_full(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post), ns)(
          Equal.trans(
            Bool,
            List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(pre, nc), post)),
            List.is_empty(&2, Item, List.append(&2, Item, pre, post)),
            False{},
            Mst.empty_set_last_append(pre, nc, post),
            Mst.opens_full(l, left, List.append(&2, Item, pre, post), ur, lo, hi, oN)
          )
        )
      ): Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, m, Some{_})
      +hold => Mst.ins_ok.gtw.read(
        ~S,
        ~fetch,
        s,
        h,
        ur,
        lo,
        hi,
        k,
        m,
        l,
        left,
        pre,
        post,
        nc,
        ns,
        eN,
        oN,
        all,
        pk,
        hold,
        ihi(
          Mst.holds_tail(
            ~S,
            ~fetch,
            s,
            Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), post)}, []),
            ns,
            hold
          )
        )
      )

# an insert of k below a node of a higher level, by whether the node holds k
# (b0)
def Mst.ins_ok.gt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b0: Bool,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +eb0: {Part.hits(Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post}, k) == b0: Bool},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(post, k) == True{}: Bool},
  +el: {Key.level(k) == ll: Nat},
  +ec: {Nat.cmp(l, ll) == GT{}: Cmp},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> {Key.level(k) == ll: Nat} -> {
    Nat.is_lt(ll, ur2) == True{}: Bool
  } -> {Bound.after(lo2, k) == True{}: Bool} -> {Bound.before(k, hi2) == True{}: Bool} -> Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    m2,
    k,
    Some{v},
    Mst.insert(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k, v, ll)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Shared.Bool.when(
    Maybe<&2, Edit>,
    b0,
    u => None{},
    u => Mst.with_gap(
      l,
      left,
      Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
      Mst.insert(
        ~S,
        ~fetch,
        p,
        s,
        Room{l, Items.head_key(List.reverse.go(&2, Item, pre, []), lo), Items.head_key(post, hi)},
        Mst.last(pre, left),
        k,
        v,
        ll
      )
    )
  )
):
  match b0:
    case True{}:
      Unit{}
    case False{}:
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, pre, []), lo),
        Items.last_key(pre, lo),
        Mst.head_rev(pre, lo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        Some{v},
        Mst.with_gap(
          l,
          left,
          Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
          Mst.insert(~S, ~fetch, p, s, Room{l, _, Items.head_key(post, hi)}, Mst.last(pre, left), k, v, ll)
        )
      )
      +pk = Mst.post_after(post, List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), k, Items.last_key(pre, lo), hi)(hn)(eb0)(
        Mst.post_fit(pre, post, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, post), ur, lo, hi, oN))
      )
      Mst.ins_ok.gtw(
        ~S,
        ~fetch,
        Mst.insert(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k, v, ll),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        Some{v},
        l,
        left,
        pre,
        post,
        eN,
        oN,
        all,
        pk,
        ih(l)(Items.last_key(pre, lo))(Items.head_key(post, hi))(Mst.last(pre, left))(el)(Mst.nat_gt_lt(l, ll)(ec))(
          Mst.last_below(pre, lo, k)(all)(a)
        )(Mst.before_head(post, k, hi)(pk)(bb))
      )

# an insert of k at the node of the hash h, by how its level compares to the
# level of k (c)
def Mst.ins_ok.node(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +ec: {Nat.cmp(l, ll) == c: Cmp},
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +el: {Key.level(k) == ll: Nat},
  +lt: {Nat.is_lt(ll, ur) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> {Key.level(k) == ll: Nat} -> {
    Nat.is_lt(ll, ur2) == True{}: Bool
  } -> {Bound.after(lo2, k) == True{}: Bool} -> {Bound.before(k, hi2) == True{}: Bool} -> Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    m2,
    k,
    Some{v},
    Mst.insert(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k, v, ll)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Mst.insert.node(
    c,
    h,
    l,
    left,
    xs,
    lo,
    hi,
    k,
    v,
    ll,
    c2 => Mst.split(~S, ~fetch, p, s, Room{ur, lo, hi}, c2, k),
    r2 => c2 => Mst.split(~S, ~fetch, p, s, r2, c2, k),
    r2 => c2 => Mst.insert(~S, ~fetch, p, s, r2, c2, k, v, ll)
  )
):
  match c:
    case LT{}:
      Mst.ins_ok.top(
        ~S,
        ~fetch,
        Mst.split(~S, ~fetch, p, s, Room{ur, lo, hi}, Some{h}, k),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        ll,
        l,
        left,
        xs,
        Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
        ec,
        el,
        lt,
        a,
        bb,
        Mst.split_ok(~S, ~fetch, p, Some{h}, s, ur, lo, hi, k)
      )
    case EQ{}:
      %Equal.sym(
        Part,
        Mst.part(xs, left, k, []),
        Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)},
        Mst.part_eq(xs, left, k, [])
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        Some{v},
        Mst.insert.here(l, left, k, v, _, c2 => Mst.split(~S, ~fetch, p, s, Part.room(_, l, lo, hi), c2, k))
      )
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, Mst.pre(xs, k), []), lo),
        Items.last_key(Mst.pre(xs, k), lo),
        Mst.head_rev(Mst.pre(xs, k), lo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        Some{v},
        Mst.insert.here(
          l,
          left,
          k,
          v,
          Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)},
          c2 => Mst.split(~S, ~fetch, p, s, Room{l, _, Items.head_key(Mst.post(xs, k), hi)}, c2, k)
        )
      )
      +eN = Equal.trans(
        Maybe<&2, Node>,
        Mst.node(~S, ~fetch, s, h),
        Some{Node{l, left, xs}},
        Some{Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}},
        Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
        Equal.cong(
          List<&2, Item>,
          Maybe<&2, Node>,
          ys => Some{Node{l, left, ys}},
          xs,
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          Equal.sym(List<&2, Item>, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)), xs, Mst.pre_post(xs, k))
        )
      )
      +oN = Equal.trans(
        Bool,
        Mst.opens(Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}, Room{ur, lo, hi}),
        Mst.opens(Node{l, left, xs}, Room{ur, lo, hi}),
        True{},
        Equal.cong(
          List<&2, Item>,
          Bool,
          ys => Mst.opens(Node{l, left, ys}, Room{ur, lo, hi}),
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          xs,
          Mst.pre_post(xs, k)
        ),
        Mst.in_open(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en)
      )
      Mst.ins_ok.here(
        ~S,
        ~fetch,
        Mst.post(xs, k),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        l,
        left,
        Mst.pre(xs, k),
        eN,
        oN,
        Mst.pre_all_lt(xs, k),
        Mst.post_head(xs, k),
        a,
        bb,
        Mst.level_ok(k, l, Equal.trans(Nat, Key.level(k), ll, l, el, Equal.sym(Nat, l, ll, Mst.nat_eq(l, ll)(ec))))
      )
    case GT{}:
      %Equal.sym(
        Part,
        Mst.part(xs, left, k, []),
        Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)},
        Mst.part_eq(xs, left, k, [])
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        Some{v},
        Shared.Bool.when(
          Maybe<&2, Edit>,
          Part.hits(_, k),
          u => None{},
          u => Mst.with_gap(l, left, _, Mst.insert(~S, ~fetch, p, s, Part.room(_, l, lo, hi), Part.gap(_), k, v, ll))
        )
      )
      +eN = Equal.trans(
        Maybe<&2, Node>,
        Mst.node(~S, ~fetch, s, h),
        Some{Node{l, left, xs}},
        Some{Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}},
        Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
        Equal.cong(
          List<&2, Item>,
          Maybe<&2, Node>,
          ys => Some{Node{l, left, ys}},
          xs,
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          Equal.sym(List<&2, Item>, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)), xs, Mst.pre_post(xs, k))
        )
      )
      +oN = Equal.trans(
        Bool,
        Mst.opens(Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}, Room{ur, lo, hi}),
        Mst.opens(Node{l, left, xs}, Room{ur, lo, hi}),
        True{},
        Equal.cong(
          List<&2, Item>,
          Bool,
          ys => Mst.opens(Node{l, left, ys}, Room{ur, lo, hi}),
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          xs,
          Mst.pre_post(xs, k)
        ),
        Mst.in_open(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en)
      )
      Mst.ins_ok.gt(
        ~S,
        ~fetch,
        Part.hits(Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)}, k),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        ll,
        l,
        left,
        Mst.pre(xs, k),
        Mst.post(xs, k),
        {==},
        eN,
        oN,
        Mst.pre_all_lt(xs, k),
        Mst.post_head(xs, k),
        el,
        ec,
        a,
        bb,
        ih
      )

# an insert of k at the node na of the hash h
def Mst.ins_ok.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  na: Maybe<&2, Node>,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat,
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}) == na: Maybe<&2, Node>},
  +el: {Key.level(k) == ll: Nat},
  +lt: {Nat.is_lt(ll, ur) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> {Key.level(k) == ll: Nat} -> {
    Nat.is_lt(ll, ur2) == True{}: Bool
  } -> {Bound.after(lo2, k) == True{}: Bool} -> {Bound.before(k, hi2) == True{}: Bool} -> Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    m2,
    k,
    Some{v},
    Mst.insert(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k, v, ll)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  Some{v},
  Mst.insert.at(
    na,
    h,
    Room{ur, lo, hi},
    k,
    v,
    ll,
    c2 => Mst.split(~S, ~fetch, p, s, Room{ur, lo, hi}, c2, k),
    r2 => c2 => Mst.split(~S, ~fetch, p, s, r2, c2, k),
    r2 => c2 => Mst.insert(~S, ~fetch, p, s, r2, c2, k, v, ll)
  )
):
  match na:
    case None{}:
      Unit{}
    case Some{Node{+l, +left, +xs}}:
      Mst.ins_ok.node(~S, ~fetch, Nat.cmp(l, ll), s, p, h, ur, lo, hi, k, v, ll, l, left, xs, {==}, en, el, lt, a, bb, ih)

# a write of k as v to a tree in its room, around k and above the level of
# k, reads as Mst.InsOk says
def Mst.ins_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +s: S,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ll: Nat
) -> {Key.level(k) == ll: Nat} -> {Nat.is_lt(ll, ur) == True{}: Bool} -> {Bound.after(lo, k) == True{}: Bool} -> {
  Bound.before(k, hi) == True{}: Bool
} -> Mst.InsOk(~S, ~fetch, s, ur, lo, hi, m, k, Some{v}, Mst.insert(~S, ~fetch, f, s, Room{ur, lo, hi}, m, k, v, ll)):
  match f m:
    case 0n None{}:
      +el => +lt => +a => +bb => Mst.ins_ok.none(~S, ~fetch, s, ur, lo, hi, k, v, ll, el, lt, a, bb)
    case 1n+q None{}:
      +el => +lt => +a => +bb => Mst.ins_ok.none(~S, ~fetch, s, ur, lo, hi, k, v, ll, el, lt, a, bb)
    case 0n Some{h}:
      +el => +lt => +a => +bb => Unit{}
    case 1n+(+p) Some{+h}:
      +el => +lt => +a => +bb => Mst.ins_ok.at(
        ~S,
        ~fetch,
        Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        v,
        ll,
        {==},
        el,
        lt,
        a,
        bb,
        +ur2 => +lo2 => +hi2 => +m2 => Mst.ins_ok(~S, ~fetch, p, m2, s, ur2, lo2, hi2, k, v, ll)
      )

# a room is at least as wide as itself
def Mst.room_le_refl(r: Room) -> {Mst.room_le(r, r) == True{}: Bool}:
  match r:
    case Room{+u, +lo, +hi}:
      Mst.room_le_of(u, lo, lo, hi, hi, Mst.lo_le_refl(lo), Mst.hi_le_refl(hi))

# the room of a pick that goes down is of the level of the node
def Mst.PickUp(l: Nat, p: Pick) -> Data:
  match p:
    case Pick.Hit{v}:
      Unit
    case Pick.Down{m, r}:
      {Mst.room_up(r) == l: Nat}

# a pick goes down into a room of the level of the node
def Mst.pick_up(
  +xs: List<&2, Item>,
  +prev: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> Mst.PickUp(l, Mst.pick(xs, prev, l, lo, hi, k)):
  match xs:
    case Nil{}:
      {==}
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.case_cmp(
        c => Mst.PickUp(
          l,
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k))
          )
        ),
        Key.cmp(k, ik),
        +q => {==},
        +q => Unit{},
        +q => Mst.pick_up(rest, r, l, Some{ik}, hi, k)
      )

# a read of a node whose pick of k goes down to a subtree where k is absent
# finds k absent
def Mst.del_same(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g: Nat,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +k: List<&2, U32>,
  +p: Nat,
  +m: Maybe<&2, Hashes.Hash>,
  +a: Maybe<&2, List<&2, U32>>,
  +b: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, xs}, Room{u, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(u, g) == True{}: Bool},
  +ep: {Mst.pick(xs, left, l, lo, hi, k) == Pick.Down{m, Room{l, a, b}}: Pick},
  +ab: {Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{l, a, b}, m, k)) == True{}: Bool}
) -> {Look.known(Mst.look.go(~S, ~fetch, g, s, Room{u, lo, hi}, Some{h}, k)) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  Mst.new_down(
    ~S,
    ~fetch,
    g,
    s,
    h,
    u,
    lo,
    hi,
    l,
    left,
    xs,
    k,
    None{},
    m,
    a,
    b,
    eN,
    oN,
    fu,
    ep,
    +g4 => +fl => Mst.look.wide(
      ~S,
      ~fetch,
      g4,
      p,
      m,
      s,
      Room{l, a, b},
      Room{l, a, b},
      k,
      None{},
      Mst.hop_of(~S, ~fetch, s, m, Room{l, a, b}, Room{l, a, b}, Mst.room_le_refl(Room{l, a, b})),
      Mst.room_bounds(Room{l, a, b}, Room{l, a, b})(Mst.room_le_refl(Room{l, a, b})),
      fl
    )(Look.absent_known(Mst.look.go(~S, ~fetch, p, s, Room{l, a, b}, m, k))(ab))
  )

# a tree read with more fuel in the same room tells the same
def Mst.del_keep(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +g2: Nat,
  +s: S,
  +m: Maybe<&2, Hashes.Hash>,
  +r: Room,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +fu: {Nat.is_le(Mst.room_up(r), g2) == True{}: Bool}
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, r, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, r, m, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  Mst.look.wide(
    ~S,
    ~fetch,
    g2,
    g1,
    m,
    s,
    r,
    r,
    k2,
    x,
    Mst.hop_of(~S, ~fetch, s, m, r, r, Mst.room_le_refl(r)),
    Mst.room_bounds(r, r)(Mst.room_le_refl(r)),
    fu
  )

# a delete that leaves the tree as it is, once a read finds k absent (bb)
def Mst.del_ok.when(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  bb: Bool,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  -t: Look,
  +ebb: {Look.is_absent(t) == bb: Bool},
  d1: {Look.is_absent(t) == True{}: Bool} -> @g: Nat -> {Nat.is_le(ur, g) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g, s, Room{ur, lo, hi}, Some{h}, k)) == Some{None{}}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, None{}, Shared.Maybe.when(Edit, bb, u => Some{Edit{Some{h}, []}})):
  match bb:
    case False{}:
      Unit{}
    case True{}:
      +hold => (
        d1(ebb),
        +k2 => +x => +g1 => +g2 => +ne => +fu => Mst.del_keep(~S, ~fetch, g1, g2, s, Some{h}, Room{ur, lo, hi}, k2, x, fu)
      )

# a delete from an empty tree
def Mst.del_ok.none(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> Mst.InsOk(~S, ~fetch, s, ur, lo, hi, None{}, k, None{}, Some{Edit{None{}, []}}):
  +hold => (
    +g => +fu => Equal.cong(
      Look,
      Maybe<&2, Maybe<&2, List<&2, U32>>>,
      Look.known,
      Mst.look.go(~S, ~fetch, g, s, Room{ur, lo, hi}, None{}, k),
      Look.Absent{},
      Mst.look_none(~S, ~fetch, g, s, Room{ur, lo, hi}, k)
    ),
    +k2 => +x => +g1 => +g2 => +ne => +fu => Mst.none_kept(~S, ~fetch, g1, g2, s, Room{ur, lo, hi}, Room{ur, lo, hi}, k2, x)
  )

# items with one item k taken out fit as before
def Mst.fit_del(
  +pre: List<&2, Item>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Items.fit(List.append(&2, Item, pre, Item{k, iv, r} <> rest), lo, hi) == True{}: Bool} -> {
  Items.fit(List.append(&2, Item, pre, rest), lo, hi) == True{}: Bool
}:
  +f =>
    +both = Equal.trans(
      Bool,
      Bool.and(Items.fit(pre, lo, hi), Items.fit(Item{k, iv, r} <> rest, Items.last_key(pre, lo), hi)),
      Items.fit(List.append(&2, Item, pre, Item{k, iv, r} <> rest), lo, hi),
      True{},
      Equal.sym(
        Bool,
        Items.fit(List.append(&2, Item, pre, Item{k, iv, r} <> rest), lo, hi),
        Bool.and(Items.fit(pre, lo, hi), Items.fit(Item{k, iv, r} <> rest, Items.last_key(pre, lo), hi)),
        Mst.fit_append(pre, Item{k, iv, r} <> rest, lo, hi)
      ),
      f
    )
    +fk = Shared.Bool.and_true_right(Items.fit(pre, lo, hi), Items.fit(Item{k, iv, r} <> rest, Items.last_key(pre, lo), hi), both)
    Equal.trans(
      Bool,
      Items.fit(List.append(&2, Item, pre, rest), lo, hi),
      Bool.and(Items.fit(pre, lo, hi), Items.fit(rest, Items.last_key(pre, lo), hi)),
      True{},
      Mst.fit_append(pre, rest, lo, hi),
      Shared.Bool.and_both(
        Items.fit(pre, lo, hi),
        Items.fit(rest, Items.last_key(pre, lo), hi),
        Shared.Bool.and_true_left(Items.fit(pre, lo, hi), Items.fit(Item{k, iv, r} <> rest, Items.last_key(pre, lo), hi), both),
        Mst.fit_wide(
          rest,
          Some{k},
          Items.last_key(pre, lo),
          hi,
          hi,
          Mst.lo_le_key(Items.last_key(pre, lo), k)(
            Shared.Bool.and_true_left(
              Bound.after(Items.last_key(pre, lo), k),
              Bound.before(k, hi),
              Shared.Bool.and_true_left(
                Bool.and(Bound.after(Items.last_key(pre, lo), k), Bound.before(k, hi)),
                Items.fit(rest, Some{k}, hi),
                fk
              )
            )
          ),
          Mst.hi_le_refl(hi)
        )(Shared.Bool.and_true_right(Bool.and(Bound.after(Items.last_key(pre, lo), k), Bound.before(k, hi)), Items.fit(rest, Some{k}, hi), fk))
      )
    )

# the items after k of items that fit, k among them, fit after k
def Mst.fit_rest(
  +pre: List<&2, Item>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Items.fit(List.append(&2, Item, pre, Item{k, iv, r} <> rest), lo, hi) == True{}: Bool} -> {Items.fit(rest, Some{k}, hi) == True{}: Bool}:
  +f => Shared.Bool.and_true_right(
    Bool.and(Bound.after(Items.last_key(pre, lo), k), Bound.before(k, hi)),
    Items.fit(rest, Some{k}, hi),
    Mst.post_fit(pre, Item{k, iv, r} <> rest, lo, hi)(f)
  )

# what a merge reads below k (the first part of Mst.MergeRead)
def Mst.MergeLo(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -u: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -hi: Maybe<&2, List<&2, U32>>,
  -ma: Maybe<&2, Hashes.Hash>,
  -nc: Maybe<&2, Hashes.Hash>
) -> Type:
  @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @u1: Nat -> @g1: Nat -> @g2: Nat -> {Key.cmp(k2, k) == LT{}: Cmp} -> {
    Nat.is_le(u, g2) == True{}: Bool
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, lo, Some{k}}, ma, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}

# what a merge reads above k (the second part of Mst.MergeRead)
def Mst.MergeHi(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -s: S,
  -u: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -k: List<&2, U32>,
  -hi: Maybe<&2, List<&2, U32>>,
  -mb: Maybe<&2, Hashes.Hash>,
  -nc: Maybe<&2, Hashes.Hash>
) -> Type:
  @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> @u1: Nat -> @g1: Nat -> @g2: Nat -> {Key.cmp(k2, k) == GT{}: Cmp} -> {
    Nat.is_le(u, g2) == True{}: Bool
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{u1, Some{k}, hi}, mb, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{u, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}

# a node with the item k taken out and the subtrees beside it merged reads a
# key above k as the node did, but past k, as ih says
def Mst.del_hi(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  g1: Nat,
  g2: Nat,
  +s: S,
  +h: Hashes.Hash,
  +hn: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +rest: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  -x: Maybe<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +eD: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}}: Maybe<&2, Node>
  },
  +oD: {
    Mst.opens(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, Room{ur, lo, hi})
      == True{}: Bool
  },
  +ps: {Mst.passes(pre, k2) == True{}: Bool},
  +c: {Key.cmp(k2, k) == GT{}: Cmp},
  +fu: {Nat.is_le(ur, g2) == True{}: Bool},
  ih: @g3: Nat -> @g4: Nat -> {Nat.is_le(l, g4) == True{}: Bool} -> {
    Look.known(Mst.look.go(~S, ~fetch, g3, s, Room{l, Some{k}, Items.head_key(rest, hi)}, r, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  } -> {
    Look.known(Mst.look.go(~S, ~fetch, g4, s, Room{l, Items.last_key(pre, lo), Items.head_key(rest, hi)}, nc, k2))
      == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
  }
) -> {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
}:
  match g1 g2:
    case 0n y:
      +e => Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, y, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, x, e)
      )
    case 1n+p1 0n:
      +e => Empty.absurd(
        {Look.known(Look.Missing{hn}) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.opens_fuel(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest), ur, lo, hi, oD, fu)
      )
    case 1n+(+p1) 1n+(+p2):
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p1, s, Room{ur, lo, hi}, Some{h}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, pre, Item{k, iv, r} <> rest), left, l, lo, hi, k2),
          h,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
        ),
        Mst.look_node(~S, ~fetch, p1, s, h, ur, lo, hi, l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest), k2, eN, oN)
      ): (
        {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
          -> {Look.known(Mst.look.go(~S, ~fetch, 1n+p2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Look,
        Mst.look.go(~S, ~fetch, 1n+p2, s, Room{ur, lo, hi}, Some{hn}, k2),
        Mst.look.pick(
          Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), rest), Mst.end_left(pre, left, nc), l, lo, hi, k2),
          hn,
          l,
          k2,
          m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
        ),
        Mst.look_node(
          ~S,
          ~fetch,
          p2,
          s,
          hn,
          ur,
          lo,
          hi,
          l,
          Mst.end_left(pre, left, nc),
          List.append(&2, Item, Mst.set_last(pre, nc), rest),
          k2,
          eD,
          oD
        )
      ): (
        {
          Look.known(
            Mst.look.pick(
              Mst.pick(List.append(&2, Item, pre, Item{k, iv, r} <> rest), left, l, lo, hi, k2),
              h,
              l,
              k2,
              m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)
            )
          )
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {Look.known(_) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, pre, Item{k, iv, r} <> rest), left, l, lo, hi, k2),
        Mst.pick(rest, r, l, Some{k}, hi, k2),
        Equal.trans(
          Pick,
          Mst.pick(List.append(&2, Item, pre, Item{k, iv, r} <> rest), left, l, lo, hi, k2),
          Mst.pick(Item{k, iv, r} <> rest, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2),
          Mst.pick(rest, r, l, Some{k}, hi, k2),
          Mst.pick_passes(pre, Item{k, iv, r} <> rest, left, l, lo, hi, k2)(ps),
          Mst.pick_past_k(k, iv, r, rest, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k2, c)
        )
      ): (
        {
          Look.known(Mst.look.pick(_, h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(
              Mst.look.pick(
                Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), rest), Mst.end_left(pre, left, nc), l, lo, hi, k2),
                hn,
                l,
                k2,
                m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)
              )
            )
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      %Equal.sym(
        Pick,
        Mst.pick(List.append(&2, Item, Mst.set_last(pre, nc), rest), Mst.end_left(pre, left, nc), l, lo, hi, k2),
        Mst.pick(rest, nc, l, Items.last_key(pre, lo), hi, k2),
        Mst.pick_set_passes(pre, nc, rest, left, l, lo, hi, k2, ps)
      ): (
        {
          Look.known(Mst.look.pick(Mst.pick(rest, r, l, Some{k}, hi, k2), h, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p1, s, r2, m2, k2)))
            == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
        }
          -> {
            Look.known(Mst.look.pick(_, hn, l, k2, m2 => r2 => Mst.look.go(~S, ~fetch, p2, s, r2, m2, k2)))
              == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
          }
      )
      Mst.gap_kept.first(
        ~S,
        ~fetch,
        Mst.stops_first(rest, k2),
        p1,
        p2,
        s,
        rest,
        r,
        nc,
        l,
        Some{k},
        Items.last_key(pre, lo),
        hi,
        hi,
        h,
        hn,
        k2,
        x,
        {==},
        Mst.hi_le_refl(hi),
        Mst.opens_fl(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest), ur, lo, hi, p2, oD, fu),
        ih
      )

# a delete of the one item k of a node, whose merged subtrees rise in its
# place, for a key other than k, by how it compares to k (c)
def Mst.del_ok.rise.k2(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +nc: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  +x: Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +g2: Nat,
  +ec: {Key.cmp(k2, k) == c: Cmp},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, [Item{k, iv, r}]}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, [Item{k, iv, r}]}, Room{ur, lo, hi}) == True{}: Bool},
  +fu: {Nat.is_le(ur, g2) == True{}: Bool},
  +ne: {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool},
  +e: {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
  mlo: Mst.MergeLo(~S, ~fetch, s, ur, lo, k, hi, left, nc),
  mhi: Mst.MergeHi(~S, ~fetch, s, ur, lo, k, hi, r, nc)
) -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match c:
    case LT{}:
      Mst.old_down(
        ~S,
        ~fetch,
        {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        g1,
        s,
        h,
        ur,
        lo,
        hi,
        l,
        left,
        [Item{k, iv, r}],
        k2,
        x,
        left,
        Room.of(l, lo, Some{k}),
        eN,
        oN,
        Mst.pick_first([Item{k, iv, r}], left, l, lo, hi, k2)(Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k2, k), LT{}, ec)),
        +g3 => +e3 => mlo(k2)(x)(l)(g3)(g2)(ec)(fu)(e3)
      )(e)
    case GT{}:
      Mst.old_down(
        ~S,
        ~fetch,
        {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        g1,
        s,
        h,
        ur,
        lo,
        hi,
        l,
        left,
        [Item{k, iv, r}],
        k2,
        x,
        r,
        Room.of(l, Some{k}, hi),
        eN,
        oN,
        Mst.pick_all([Item{k, iv, r}], left, l, lo, hi, k2)(
          Shared.Bool.and_both(Cmp.is_gt(Key.cmp(k2, k)), True{}, Equal.cong(Cmp, Bool, Cmp.is_gt, Key.cmp(k2, k), GT{}, ec), {==})
        ),
        +g3 => +e3 => mhi(k2)(x)(l)(g3)(g2)(ec)(fu)(e3)
      )(e)
    case EQ{}:
      Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, nc, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.ne_eq(k2, k, ne, ec)
      )

# what a delete of the one item k of a node reads, from what the merge of the
# subtrees beside k reads (tri)
def Mst.del_ok.rise.go(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +nc: Maybe<&2, Hashes.Hash>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, [Item{k, iv, r}]}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, [Item{k, iv, r}]}, Room{ur, lo, hi}) == True{}: Bool},
  tri: Mst.MergeRead(~S, ~fetch, s, ur, lo, k, hi, left, r, nc)
) -> Mst.InsRead(~S, ~fetch, s, ur, lo, hi, Some{h}, k, None{}, nc):
  (mlo, r3) = tri
  (mhi, mk) = r3
  (
    +g => +fu => mk(g)(fu),
    +k2 => +x => +g1 => +g2 => +ne => +fu => +e => Mst.del_ok.rise.k2(
      ~S,
      ~fetch,
      Key.cmp(k2, k),
      s,
      h,
      ur,
      lo,
      hi,
      k,
      iv,
      r,
      l,
      left,
      nc,
      k2,
      x,
      g1,
      g2,
      {==},
      eN,
      oN,
      fu,
      ne,
      e,
      mlo,
      mhi
    )
  )

# what a delete of the one item k of a node reads, from what its merge reads
# (bi)
def Mst.del_ok.rise.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +nc: Maybe<&2, Hashes.Hash>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, [Item{k, iv, r}]}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, [Item{k, iv, r}]}, Room{ur, lo, hi}) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  bi: ({Mst.lvl(~S, ~fetch, s, left, l) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, r, l) == True{}: Bool})
    & Mst.MergeMain(~S, ~fetch, s, lo, k, hi, left, r, nc)
) -> Mst.InsRead(~S, ~fetch, s, ur, lo, hi, Some{h}, k, None{}, nc):
  (lvs, main2) = bi
  (lva, lvb) = lvs
  +lt = Shared.Nat.lt_weak(l, ur)(Mst.opens_lt(l, left, [Item{k, iv, r}], Room{ur, lo, hi})(oN))
  Mst.del_ok.rise.go(
    ~S,
    ~fetch,
    s,
    h,
    ur,
    lo,
    hi,
    k,
    iv,
    r,
    l,
    left,
    nc,
    eN,
    oN,
    main2(ur)(Mst.lvl_mono(~S, ~fetch, s, left, l, ur)(lva)(lt))(Mst.lvl_mono(~S, ~fetch, s, r, l, ur)(lvb)(lt))(a)(bb)
  )

# a delete of k from a node of its level that holds more items, for a key
# other than k, by how it compares to k (c)
def Mst.del_ok.store.k2(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +s: S,
  +h: Hashes.Hash,
  +hn: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +rest: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +k2: List<&2, U32>,
  +x: Maybe<&2, List<&2, U32>>,
  +g1: Nat,
  +g2: Nat,
  +ec: {Key.cmp(k2, k) == c: Cmp},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +eD: {
    Mst.node(~S, ~fetch, s, hn)
      == Some{Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}}: Maybe<&2, Node>
  },
  +oD: {
    Mst.opens(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, Room{ur, lo, hi})
      == True{}: Bool
  },
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +fr: {Items.fit(rest, Some{k}, hi) == True{}: Bool},
  +fu: {Nat.is_le(ur, g2) == True{}: Bool},
  +ne: {Cmp.is_eq(Key.cmp(k2, k)) == False{}: Bool},
  +e: {Look.known(Mst.look.go(~S, ~fetch, g1, s, Room{ur, lo, hi}, Some{h}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
  mlo: Mst.MergeLo(~S, ~fetch, s, l, Items.last_key(pre, lo), k, Items.head_key(rest, hi), Mst.last(pre, left), nc),
  mhi: Mst.MergeHi(~S, ~fetch, s, l, Items.last_key(pre, lo), k, Items.head_key(rest, hi), r, nc)
) -> {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}:
  match c:
    case LT{}:
      Mst.gap_lo(
        ~S,
        ~fetch,
        g1,
        g2,
        s,
        h,
        hn,
        ur,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        pre,
        Item{k, iv, r} <> rest,
        rest,
        nc,
        hi,
        k2,
        x,
        eN,
        oN,
        eD,
        oD,
        Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k2, k), LT{}, ec),
        Mst.stops_first_fit(rest, k, hi, k2)(fr)(Mst.le_of_lt(Key.cmp(k2, k))(ec)),
        fu,
        +g3 => +g4 => +fl => +e3 => mlo(k2)(x)(l)(g3)(g4)(ec)(fl)(e3)
      )(e)
    case GT{}:
      Mst.del_hi(
        ~S,
        ~fetch,
        g1,
        g2,
        s,
        h,
        hn,
        ur,
        lo,
        hi,
        k,
        iv,
        r,
        l,
        left,
        pre,
        rest,
        nc,
        k2,
        x,
        eN,
        oN,
        eD,
        oD,
        Mst.passes_of_lt(pre, k, k2)(all)(Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(k, k2), LT{}, Mst.key_gt_lt(k2, k)(ec))),
        ec,
        fu,
        +g3 => +g4 => +fl => +e3 => mhi(k2)(x)(l)(g3)(g4)(ec)(fl)(e3)
      )(e)
    case EQ{}:
      Empty.absurd(
        {Look.known(Mst.look.go(~S, ~fetch, g2, s, Room{ur, lo, hi}, Some{hn}, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>},
        Mst.ne_eq(k2, k, ne, ec)
      )

# what a delete of k from a node of its level that holds more items reads,
# from what the merge of the subtrees beside k reads (tri)
def Mst.del_ok.store.go(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +rest: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +ne: {List.is_empty(&2, Item, List.append(&2, Item, pre, rest)) == False{}: Bool},
  +hold: {
    Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, []) <> ns)
      == True{}: Bool
  },
  tri: Mst.MergeRead(~S, ~fetch, s, l, Items.last_key(pre, lo), k, Items.head_key(rest, hi), Mst.last(pre, left), r, nc)
) -> Mst.InsRead(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Some{Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, []))}
):
  (mlo, r3) = tri
  (mhi, mk) = r3
  +fr = Mst.fit_rest(pre, k, iv, r, rest, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest), ur, lo, hi, oN))
  +eD = Mst.node_code(
    ~S,
    ~fetch,
    s,
    Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)},
    Mst.holds_head(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, []), ns, hold)
  )
  +oD = Mst.opens_set_last(l, left, Mst.end_left(pre, left, nc), pre, nc, rest, Room{ur, lo, hi})(
    Mst.opens_of(
      l,
      left,
      List.append(&2, Item, pre, rest),
      ur,
      lo,
      hi,
      Mst.opens_lt(l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest), Room{ur, lo, hi})(oN),
      ne,
      Mst.fit_del(pre, k, iv, r, rest, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest), ur, lo, hi, oN))
    )
  )
  (
    +g => +fu => Mst.gap_k(
      ~S,
      ~fetch,
      g,
      s,
      Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, [])),
      ur,
      lo,
      hi,
      l,
      left,
      pre,
      rest,
      nc,
      k,
      None{},
      eD,
      oD,
      fu,
      Mst.passes_of_all_lt(pre, k)(all),
      Mst.stops_first_fit(rest, k, hi, k)(fr)(Mst.le_refl_key(k)),
      +g4 => +fl => mk(g4)(fl)
    ),
    +k2 => +x => +g1 => +g2 => +ne2 => +fu => +e => Mst.del_ok.store.k2(
      ~S,
      ~fetch,
      Key.cmp(k2, k),
      s,
      h,
      Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, [])),
      ur,
      lo,
      hi,
      k,
      iv,
      r,
      l,
      left,
      pre,
      rest,
      nc,
      k2,
      x,
      g1,
      g2,
      {==},
      eN,
      oN,
      eD,
      oD,
      all,
      fr,
      fu,
      ne2,
      e,
      mlo,
      mhi
    )
  )

# what a delete of k from a node of its level that holds more items reads,
# from what its merge reads (bi)
def Mst.del_ok.store.read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +rest: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +ne: {List.is_empty(&2, Item, List.append(&2, Item, pre, rest)) == False{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  +hold: {
    Depots.Depot.holds(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, []) <> ns)
      == True{}: Bool
  },
  bi: ({Mst.lvl(~S, ~fetch, s, Mst.last(pre, left), l) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, r, l) == True{}: Bool})
    & Mst.MergeMain(~S, ~fetch, s, Items.last_key(pre, lo), k, Items.head_key(rest, hi), Mst.last(pre, left), r, nc)
) -> Mst.InsRead(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Some{Hashes.Sha.hash(Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, []))}
):
  (lvs, main2) = bi
  (lva, lvb) = lvs
  Mst.del_ok.store.go(
    ~S,
    ~fetch,
    s,
    h,
    ur,
    lo,
    hi,
    k,
    iv,
    r,
    l,
    left,
    pre,
    rest,
    nc,
    ns,
    eN,
    oN,
    all,
    ne,
    hold,
    main2(l)(lva)(lvb)(Mst.last_below(pre, lo, k)(all)(a))(
      Mst.before_head(rest, k, hi)(
        Mst.fit_rest(pre, k, iv, r, rest, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest), ur, lo, hi, oN))
      )(bb)
    )
  )

# a delete of k from a node of its level that holds more items, once the
# subtrees beside k are merged into nc
def Mst.del_ok.store(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +rest: List<&2, Item>,
  +nc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +ne: {List.is_empty(&2, Item, List.append(&2, Item, pre, rest)) == False{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ihm: {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool} -> (
    ({Mst.lvl(~S, ~fetch, s, Mst.last(pre, left), l) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, r, l) == True{}: Bool})
      & Mst.MergeMain(~S, ~fetch, s, Items.last_key(pre, lo), k, Items.head_key(rest, hi), Mst.last(pre, left), r, nc)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Some{Mst.make(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest), ns)}
):
  %Equal.sym(
    Edit,
    Mst.make(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest), ns),
    Mst.store(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, ns),
    Mst.make_full(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest), ns)(
      Equal.trans(
        Bool,
        List.is_empty(&2, Item, List.append(&2, Item, Mst.set_last(pre, nc), rest)),
        List.is_empty(&2, Item, List.append(&2, Item, pre, rest)),
        False{},
        Mst.empty_set_last_append(pre, nc, rest),
        ne
      )
    )
  ): Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, None{}, Some{_})
  +hold => Mst.del_ok.store.read(
    ~S,
    ~fetch,
    s,
    h,
    ur,
    lo,
    hi,
    k,
    iv,
    r,
    l,
    left,
    pre,
    rest,
    nc,
    ns,
    eN,
    oN,
    all,
    ne,
    a,
    bb,
    hold,
    ihm(Mst.holds_tail(~S, ~fetch, s, Node.code(Node{l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest)}, []), ns, hold))
  )

# a delete of k from a node of its level, by the items around k
def Mst.del_ok.hit.mk(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  pre: List<&2, Item>,
  rest: List<&2, Item>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +nc: Maybe<&2, Hashes.Hash>,
  +ns: List<&2, List<&2, U32>>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ihm: {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool} -> (
    ({Mst.lvl(~S, ~fetch, s, Mst.last(pre, left), l) == True{}: Bool} & {Mst.lvl(~S, ~fetch, s, r, l) == True{}: Bool})
      & Mst.MergeMain(~S, ~fetch, s, Items.last_key(pre, lo), k, Items.head_key(rest, hi), Mst.last(pre, left), r, nc)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Some{Mst.make(l, Mst.end_left(pre, left, nc), List.append(&2, Item, Mst.set_last(pre, nc), rest), ns)}
):
  match pre rest:
    case Nil{} Nil{}:
      +hold => Mst.del_ok.rise.read(~S, ~fetch, s, h, ur, lo, hi, k, iv, r, l, left, nc, eN, oN, a, bb, ihm(hold))
    case Nil{} Con{+y, +ys}:
      Mst.del_ok.store(~S, ~fetch, s, h, ur, lo, hi, k, iv, r, l, left, [], y <> ys, nc, ns, eN, oN, all, {==}, a, bb, ihm)
    case Con{+x0, +r0} q:
      Mst.del_ok.store(~S, ~fetch, s, h, ur, lo, hi, k, iv, r, l, left, x0 <> r0, q, nc, ns, eN, oN, all, {==}, a, bb, ihm)

# a delete of k from a node of its level that holds k, once the subtrees
# beside k are merged (res)
def Mst.del_ok.hit(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  res: Maybe<&2, Edit>,
  +s: S,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +rest: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ihm: Mst.MergeOk(~S, ~fetch, s, l, Items.last_key(pre, lo), k, l, Items.head_key(rest, hi), Mst.last(pre, left), r, res)
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Mst.with_gap(l, left, Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), rest}, res)
):
  match res:
    case None{}:
      Unit{}
    case Some{Edit{+nc, +ns}}:
      %Equal.sym(
        Maybe<&2, Hashes.Hash>,
        Mst.left(List.reverse.go(&2, Item, pre, []), left, nc),
        Mst.end_left(pre, left, nc),
        Mst.left_rev(pre, left, nc)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Some{Mst.make(l, _, Mst.rejoin(List.reverse.go(&2, Item, pre, []), nc, rest), ns)}
      )
      %Equal.sym(
        List<&2, Item>,
        Mst.rejoin(List.reverse.go(&2, Item, pre, []), nc, rest),
        List.append(&2, Item, Mst.set_last(pre, nc), rest),
        Mst.rejoin_rev(pre, nc, rest)
      ): Mst.InsOk(~S, ~fetch, s, ur, lo, hi, Some{h}, k, None{}, Some{Mst.make(l, Mst.end_left(pre, left, nc), _, ns)})
      Mst.del_ok.hit.mk(~S, ~fetch, pre, rest, s, h, ur, lo, hi, k, iv, r, l, left, nc, ns, eN, oN, all, a, bb, ihm)

# a delete of k at a node of a lower level, by the pick of k there (pk)
def Mst.del_ok.lacks(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  pk: Pick,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +ep: {Mst.pick(xs, left, l, lo, hi, k) == pk: Pick},
  pu: Mst.PickUp(l, pk),
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, xs}, Room{ur, lo, hi}) == True{}: Bool}
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Shared.Maybe.when(Edit, Mst.delete.lacks(pk, r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k)), u => Some{Edit{Some{h}, []}})
):
  match pk:
    case Pick.Hit{v}:
      Unit{}
    case Pick.Down{+m, Room{+u2, +a, +b}}:
      +pe = pu
      Mst.del_ok.when(
        ~S,
        ~fetch,
        Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{u2, a, b}, m, k)),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        Mst.look.go(~S, ~fetch, p, s, Room{u2, a, b}, m, k),
        {==},
        +ab => +g => +fu => Mst.del_same(
          ~S,
          ~fetch,
          g,
          s,
          h,
          ur,
          lo,
          hi,
          l,
          left,
          xs,
          k,
          p,
          m,
          a,
          b,
          eN,
          oN,
          fu,
          Equal.trans(
            Pick,
            Mst.pick(xs, left, l, lo, hi, k),
            Pick.Down{m, Room{u2, a, b}},
            Pick.Down{m, Room{l, a, b}},
            ep,
            Equal.cong(Nat, Pick, n => Pick.Down{m, Room{n, a, b}}, u2, l, pe)
          ),
          Equal.trans(
            Bool,
            Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{l, a, b}, m, k)),
            Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{u2, a, b}, m, k)),
            True{},
            Equal.cong(Nat, Bool, n => Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{n, a, b}, m, k)), l, u2, Equal.sym(Nat, u2, l, pe)),
            ab
          )
        )
      )

# a delete of k from a node of its level whose first item from k on is ik, by
# whether ik is k (b)
def Mst.del_ok.here.b(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b: Bool,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +eb: {Cmp.is_eq(Key.cmp(ik, k)) == b: Bool},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(Item{ik, iv, r} <> rest, k) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool}
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Shared.Bool.when(
    Maybe<&2, Edit>,
    b,
    u => Mst.with_gap(
      l,
      left,
      Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), rest},
      Mst.merge(
        ~S,
        ~fetch,
        p,
        s,
        Room{l, Items.head_key(List.reverse.go(&2, Item, pre, []), lo), Some{ik}},
        Room{l, Some{ik}, Items.head_key(rest, hi)},
        Mst.last(pre, left),
        r
      )
    ),
    u => Mst.delete.none(
      h,
      Room{l, Items.head_key(List.reverse.go(&2, Item, pre, []), lo), Some{ik}},
      Mst.last(pre, left),
      r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k)
    )
  )
):
  match b:
    case True{}:
      +eik = Mst.key_eq(ik, k)(Shared.Cmp.is_eq_sound(Key.cmp(ik, k))(eb))
      %Equal.sym(List<&2, U32>, ik, k, eik): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Mst.with_gap(
          l,
          left,
          Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), rest},
          Mst.merge(
            ~S,
            ~fetch,
            p,
            s,
            Room{l, Items.head_key(List.reverse.go(&2, Item, pre, []), lo), Some{_}},
            Room{l, Some{_}, Items.head_key(rest, hi)},
            Mst.last(pre, left),
            r
          )
        )
      )
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, pre, []), lo),
        Items.last_key(pre, lo),
        Mst.head_rev(pre, lo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Mst.with_gap(
          l,
          left,
          Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), rest},
          Mst.merge(~S, ~fetch, p, s, Room{l, _, Some{k}}, Room{l, Some{k}, Items.head_key(rest, hi)}, Mst.last(pre, left), r)
        )
      )
      Mst.del_ok.hit(
        ~S,
        ~fetch,
        Mst.merge(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Some{k}}, Room{l, Some{k}, Items.head_key(rest, hi)}, Mst.last(pre, left), r),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        iv,
        r,
        l,
        left,
        pre,
        rest,
        Equal.trans(
          Maybe<&2, Node>,
          Mst.node(~S, ~fetch, s, h),
          Some{Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}},
          Some{Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}},
          eN,
          Equal.cong(List<&2, U32>, Maybe<&2, Node>, z => Some{Node{l, left, List.append(&2, Item, pre, Item{z, iv, r} <> rest)}}, ik, k, eik)
        ),
        Equal.trans(
          Bool,
          Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{k, iv, r} <> rest)}, Room{ur, lo, hi}),
          Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest)}, Room{ur, lo, hi}),
          True{},
          Equal.cong(
            List<&2, U32>,
            Bool,
            z => Mst.opens(Node{l, left, List.append(&2, Item, pre, Item{z, iv, r} <> rest)}, Room{ur, lo, hi}),
            k,
            ik,
            Equal.sym(List<&2, U32>, ik, k, eik)
          ),
          oN
        ),
        all,
        a,
        bb,
        Mst.merge_ok(~S, ~fetch, p, Mst.last(pre, left), r, s, l, Items.last_key(pre, lo), k, l, Items.head_key(rest, hi))
      )
    case False{}:
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, pre, []), lo),
        Items.last_key(pre, lo),
        Mst.head_rev(pre, lo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Mst.delete.none(h, Room{l, _, Some{ik}}, Mst.last(pre, left), r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k))
      )
      Mst.del_ok.when(
        ~S,
        ~fetch,
        Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Some{ik}}, Mst.last(pre, left), k)),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        Mst.look.go(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Some{ik}}, Mst.last(pre, left), k),
        {==},
        +ab => +g => +fu => Mst.del_same(
          ~S,
          ~fetch,
          g,
          s,
          h,
          ur,
          lo,
          hi,
          l,
          left,
          List.append(&2, Item, pre, Item{ik, iv, r} <> rest),
          k,
          p,
          Mst.last(pre, left),
          Items.last_key(pre, lo),
          Some{ik},
          eN,
          oN,
          fu,
          Equal.trans(
            Pick,
            Mst.pick(List.append(&2, Item, pre, Item{ik, iv, r} <> rest), left, l, lo, hi, k),
            Mst.pick(Item{ik, iv, r} <> rest, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k),
            Pick.Down{Mst.last(pre, left), Room{l, Items.last_key(pre, lo), Some{ik}}},
            Mst.pick_passes(pre, Item{ik, iv, r} <> rest, left, l, lo, hi, k)(Mst.passes_of_all_lt(pre, k)(all)),
            Mst.pick_first(Item{ik, iv, r} <> rest, Mst.last(pre, left), l, Items.last_key(pre, lo), hi, k)(
              Mst.stops_first_fit(Item{ik, iv, r} <> rest, k, hi, k)(
                Mst.post_after(Item{ik, iv, r} <> rest, List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), k, Items.last_key(pre, lo), hi)(hn)(eb)(
                  Mst.post_fit(pre, Item{ik, iv, r} <> rest, lo, hi)(
                    Mst.opens_fit(l, left, List.append(&2, Item, pre, Item{ik, iv, r} <> rest), ur, lo, hi, oN)
                  )
                )
              )(Mst.le_refl_key(k))
            )
          ),
          ab
        )
      )

# a delete of k from a node of its level, by the items from k on (post)
def Mst.del_ok.here(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  post: List<&2, Item>,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(post, k) == True{}: Bool},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool}
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Mst.delete.here(
    h,
    l,
    left,
    k,
    Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
    lo,
    hi,
    r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y),
    r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k)
  )
):
  match post:
    case Con{Item{+ik, +iv, +r}, +rest}:
      Mst.del_ok.here.b(~S, ~fetch, Cmp.is_eq(Key.cmp(ik, k)), s, p, h, ur, lo, hi, k, l, left, pre, ik, iv, r, rest, {==}, eN, oN, all, hn, a, bb)
    case Nil{}:
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, pre, []), lo),
        Items.last_key(pre, lo),
        Mst.head_rev(pre, lo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Mst.delete.none(h, Room{l, _, hi}, Mst.last(pre, left), r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k))
      )
      Mst.del_ok.when(
        ~S,
        ~fetch,
        Look.is_absent(Mst.look.go(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), hi}, Mst.last(pre, left), k)),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        Mst.look.go(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), hi}, Mst.last(pre, left), k),
        {==},
        +ab => +g => +fu => Mst.del_same(
          ~S,
          ~fetch,
          g,
          s,
          h,
          ur,
          lo,
          hi,
          l,
          left,
          List.append(&2, Item, pre, []),
          k,
          p,
          Mst.last(pre, left),
          Items.last_key(pre, lo),
          hi,
          eN,
          oN,
          fu,
          Mst.pick_passes(pre, [], left, l, lo, hi, k)(Mst.passes_of_all_lt(pre, k)(all)),
          ab
        )
      )

# a delete of k below a node of a higher level, by whether the node holds k
# (b0)
def Mst.del_ok.gt(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  b0: Bool,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ll: Nat,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +pre: List<&2, Item>,
  +post: List<&2, Item>,
  +eb0: {Part.hits(Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post}, k) == b0: Bool},
  +eN: {Mst.node(~S, ~fetch, s, h) == Some{Node{l, left, List.append(&2, Item, pre, post)}}: Maybe<&2, Node>},
  +oN: {Mst.opens(Node{l, left, List.append(&2, Item, pre, post)}, Room{ur, lo, hi}) == True{}: Bool},
  +all: {Mst.all_lt(pre, k) == True{}: Bool},
  +hn: {Mst.head_not_lt(post, k) == True{}: Bool},
  +el: {Key.level(k) == ll: Nat},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> {Key.level(k) == ll: Nat} -> {
    Bound.after(lo2, k) == True{}: Bool
  } -> {Bound.before(k, hi2) == True{}: Bool} -> Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    m2,
    k,
    None{},
    Mst.delete(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k, ll)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Shared.Bool.when(
    Maybe<&2, Edit>,
    b0,
    u => None{},
    u => Mst.with_gap(
      l,
      left,
      Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
      Mst.delete(
        ~S,
        ~fetch,
        p,
        s,
        Room{l, Items.head_key(List.reverse.go(&2, Item, pre, []), lo), Items.head_key(post, hi)},
        Mst.last(pre, left),
        k,
        ll
      )
    )
  )
):
  match b0:
    case True{}:
      Unit{}
    case False{}:
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Items.head_key(List.reverse.go(&2, Item, pre, []), lo),
        Items.last_key(pre, lo),
        Mst.head_rev(pre, lo)
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Mst.with_gap(
          l,
          left,
          Part{List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), post},
          Mst.delete(~S, ~fetch, p, s, Room{l, _, Items.head_key(post, hi)}, Mst.last(pre, left), k, ll)
        )
      )
      +pk = Mst.post_after(post, List.reverse.go(&2, Item, pre, []), Mst.last(pre, left), k, Items.last_key(pre, lo), hi)(hn)(eb0)(
        Mst.post_fit(pre, post, lo, hi)(Mst.opens_fit(l, left, List.append(&2, Item, pre, post), ur, lo, hi, oN))
      )
      Mst.ins_ok.gtw(
        ~S,
        ~fetch,
        Mst.delete(~S, ~fetch, p, s, Room{l, Items.last_key(pre, lo), Items.head_key(post, hi)}, Mst.last(pre, left), k, ll),
        s,
        h,
        ur,
        lo,
        hi,
        k,
        None{},
        l,
        left,
        pre,
        post,
        eN,
        oN,
        all,
        pk,
        ih(l)(Items.last_key(pre, lo))(Items.head_key(post, hi))(Mst.last(pre, left))(el)(Mst.last_below(pre, lo, k)(all)(a))(
          Mst.before_head(post, k, hi)(pk)(bb)
        )
      )

# a delete of k at the node of the hash h, by how its level compares to the
# level of k (c)
def Mst.del_ok.node(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ll: Nat,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  +el: {Key.level(k) == ll: Nat},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> {Key.level(k) == ll: Nat} -> {
    Bound.after(lo2, k) == True{}: Bool
  } -> {Bound.before(k, hi2) == True{}: Bool} -> Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    m2,
    k,
    None{},
    Mst.delete(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k, ll)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Mst.delete.node(
    c,
    h,
    l,
    left,
    xs,
    lo,
    hi,
    k,
    r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y),
    r2 => c2 => Mst.delete(~S, ~fetch, p, s, r2, c2, k, ll),
    r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k)
  )
):
  match c:
    case LT{}:
      Mst.del_ok.lacks(
        ~S,
        ~fetch,
        Mst.pick(xs, left, l, lo, hi, k),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        xs,
        {==},
        Mst.pick_up(xs, left, l, lo, hi, k),
        Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
        Mst.in_open(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en)
      )
    case EQ{}:
      %Equal.sym(
        Part,
        Mst.part(xs, left, k, []),
        Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)},
        Mst.part_eq(xs, left, k, [])
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Mst.delete.here(
          h,
          l,
          left,
          k,
          _,
          lo,
          hi,
          r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y),
          r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k)
        )
      )
      +eN = Equal.trans(
        Maybe<&2, Node>,
        Mst.node(~S, ~fetch, s, h),
        Some{Node{l, left, xs}},
        Some{Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}},
        Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
        Equal.cong(
          List<&2, Item>,
          Maybe<&2, Node>,
          ys => Some{Node{l, left, ys}},
          xs,
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          Equal.sym(List<&2, Item>, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)), xs, Mst.pre_post(xs, k))
        )
      )
      +oN = Equal.trans(
        Bool,
        Mst.opens(Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}, Room{ur, lo, hi}),
        Mst.opens(Node{l, left, xs}, Room{ur, lo, hi}),
        True{},
        Equal.cong(
          List<&2, Item>,
          Bool,
          ys => Mst.opens(Node{l, left, ys}, Room{ur, lo, hi}),
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          xs,
          Mst.pre_post(xs, k)
        ),
        Mst.in_open(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en)
      )
      Mst.del_ok.here(
        ~S,
        ~fetch,
        Mst.post(xs, k),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        l,
        left,
        Mst.pre(xs, k),
        eN,
        oN,
        Mst.pre_all_lt(xs, k),
        Mst.post_head(xs, k),
        a,
        bb
      )
    case GT{}:
      %Equal.sym(
        Part,
        Mst.part(xs, left, k, []),
        Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)},
        Mst.part_eq(xs, left, k, [])
      ): Mst.InsOk(
        ~S,
        ~fetch,
        s,
        ur,
        lo,
        hi,
        Some{h},
        k,
        None{},
        Shared.Bool.when(
          Maybe<&2, Edit>,
          Part.hits(_, k),
          u => None{},
          u => Mst.with_gap(l, left, _, Mst.delete(~S, ~fetch, p, s, Part.room(_, l, lo, hi), Part.gap(_), k, ll))
        )
      )
      +eN = Equal.trans(
        Maybe<&2, Node>,
        Mst.node(~S, ~fetch, s, h),
        Some{Node{l, left, xs}},
        Some{Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}},
        Mst.in_node(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en),
        Equal.cong(
          List<&2, Item>,
          Maybe<&2, Node>,
          ys => Some{Node{l, left, ys}},
          xs,
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          Equal.sym(List<&2, Item>, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)), xs, Mst.pre_post(xs, k))
        )
      )
      +oN = Equal.trans(
        Bool,
        Mst.opens(Node{l, left, List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k))}, Room{ur, lo, hi}),
        Mst.opens(Node{l, left, xs}, Room{ur, lo, hi}),
        True{},
        Equal.cong(
          List<&2, Item>,
          Bool,
          ys => Mst.opens(Node{l, left, ys}, Room{ur, lo, hi}),
          List.append(&2, Item, Mst.pre(xs, k), Mst.post(xs, k)),
          xs,
          Mst.pre_post(xs, k)
        ),
        Mst.in_open(~S, ~fetch, s, h, Room{ur, lo, hi}, Node{l, left, xs})(en)
      )
      Mst.del_ok.gt(
        ~S,
        ~fetch,
        Part.hits(Part{List.reverse.go(&2, Item, Mst.pre(xs, k), []), Mst.last(Mst.pre(xs, k), left), Mst.post(xs, k)}, k),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        ll,
        l,
        left,
        Mst.pre(xs, k),
        Mst.post(xs, k),
        {==},
        eN,
        oN,
        Mst.pre_all_lt(xs, k),
        Mst.post_head(xs, k),
        el,
        a,
        bb,
        ih
      )

# a delete of k at the node na of the hash h
def Mst.del_ok.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  na: Maybe<&2, Node>,
  +s: S,
  +p: Nat,
  +h: Hashes.Hash,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ll: Nat,
  +en: {Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}) == na: Maybe<&2, Node>},
  +el: {Key.level(k) == ll: Nat},
  +a: {Bound.after(lo, k) == True{}: Bool},
  +bb: {Bound.before(k, hi) == True{}: Bool},
  ih: @ur2: Nat -> @lo2: Maybe<&2, List<&2, U32>> -> @hi2: Maybe<&2, List<&2, U32>> -> @m2: Maybe<&2, Hashes.Hash> -> {Key.level(k) == ll: Nat} -> {
    Bound.after(lo2, k) == True{}: Bool
  } -> {Bound.before(k, hi2) == True{}: Bool} -> Mst.InsOk(
    ~S,
    ~fetch,
    s,
    ur2,
    lo2,
    hi2,
    m2,
    k,
    None{},
    Mst.delete(~S, ~fetch, p, s, Room{ur2, lo2, hi2}, m2, k, ll)
  )
) -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  Some{h},
  k,
  None{},
  Mst.delete.at(
    na,
    h,
    Room{ur, lo, hi},
    k,
    ll,
    r1 => r2 => x => y => Mst.merge(~S, ~fetch, p, s, r1, r2, x, y),
    r2 => c2 => Mst.delete(~S, ~fetch, p, s, r2, c2, k, ll),
    r2 => c2 => Mst.look.go(~S, ~fetch, p, s, r2, c2, k)
  )
):
  match na:
    case None{}:
      Unit{}
    case Some{Node{+l, +left, +xs}}:
      Mst.del_ok.node(~S, ~fetch, Nat.cmp(l, ll), s, p, h, ur, lo, hi, k, ll, l, left, xs, en, el, a, bb, ih)

# a delete of k from a tree in its room around k reads as Mst.InsOk says
def Mst.del_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  m: Maybe<&2, Hashes.Hash>,
  +s: S,
  +ur: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +ll: Nat
) -> {Key.level(k) == ll: Nat} -> {Bound.after(lo, k) == True{}: Bool} -> {Bound.before(k, hi) == True{}: Bool} -> Mst.InsOk(
  ~S,
  ~fetch,
  s,
  ur,
  lo,
  hi,
  m,
  k,
  None{},
  Mst.delete(~S, ~fetch, f, s, Room{ur, lo, hi}, m, k, ll)
):
  match f m:
    case 0n None{}:
      +el => +a => +bb => Mst.del_ok.none(~S, ~fetch, s, ur, lo, hi, k)
    case 1n+q None{}:
      +el => +a => +bb => Mst.del_ok.none(~S, ~fetch, s, ur, lo, hi, k)
    case 0n Some{h}:
      +el => +a => +bb => Unit{}
    case 1n+(+p) Some{+h}:
      +el => +a => +bb => Mst.del_ok.at(
        ~S,
        ~fetch,
        Mst.node.in(~S, ~fetch, s, h, Room{ur, lo, hi}),
        s,
        p,
        h,
        ur,
        lo,
        hi,
        k,
        ll,
        {==},
        el,
        a,
        bb,
        +ur2 => +lo2 => +hi2 => +m2 => Mst.del_ok(~S, ~fetch, p, m2, s, ur2, lo2, hi2, k, ll)
      )

# the number of zero groups of 5 bits at the top of x, f groups at most, is at
# most f
def Mst.zeros_le(+f: Nat, +x: U32) -> {Nat.is_le(Level.zeros(f, x), f) == True{}: Bool}:
  match f:
    case 0n:
      {==}
    case 1n+(+p):
      Mst.case_bool(
        b => {Nat.is_le(Shared.Bool.when(Nat, b, u => 1n+Level.zeros(p, U32.mul(x, 32)), u => 0n), 1n+p) == True{}: Bool},
        U32.is_eq(U32.and(x, 4160749568), 0),
        +q => Mst.zeros_le(p, U32.mul(x, 32)),
        +q => Shared.Nat.le_zero(1n+p)
      )

# the level of a key is at most 12
def Mst.level_le(+hh: Hashes.Hash) -> {Nat.is_le(Level.of(hh), 12n) == True{}: Bool}:
  match hh:
    case Hashes.Hash{+a, +b, +c, +d, +e, +f, +g, +i}:
      Mst.case_bool(
        t => {
          Nat.is_le(Shared.Bool.when(Nat, t, u => Nat.add(6n, Level.zeros(6n, b)), u => Level.zeros(6n, a)), 12n) == True{}: Bool
        },
        Nat.is_eq(Level.zeros(6n, a), 6n),
        +q => Mst.zeros_le(6n, b),
        +q => Shared.Nat.le_trans(Level.zeros(6n, a), 6n, 12n)(Mst.zeros_le(6n, a))({==})
      )

# the level of a key is below the depth of a tree
def Mst.level_lt(+k: List<&2, U32>) -> {Nat.is_lt(Key.level(k), Mst.depth()) == True{}: Bool}:
  Shared.Nat.le_lt(Key.level(k), 12n, 64n)(Mst.level_le(Hashes.Sha.hash(k)))({==})

# a read that tells m is the read Look.of(m)
def Mst.known_of(t: Look, -m: Maybe<&2, List<&2, U32>>) -> {Look.known(t) == Some{m}: Maybe<&2, Maybe<&2, List<&2, U32>>>} -> {
  t == Look.of(m): Look
}:
  match t:
    case Look.Found{+v}:
      +e =>
        %Shared.Maybe.some_inj(Maybe<&2, List<&2, U32>>, Some{v}, m, e): {Look.Found{v} == Look.of(_): Look}
        {==}
    case Look.Absent{}:
      +e =>
        %Shared.Maybe.some_inj(Maybe<&2, List<&2, U32>>, None{}, m, e): {Look.Absent{} == Look.of(_): Look}
        {==}
    case Look.Missing{h}:
      +e => Empty.absurd({Look.Missing{h} == Look.of(m): Look}, Shared.Maybe.none_ne_some(Maybe<&2, List<&2, U32>>, m, e))

# a comparison that is not EQ
def Mst.is_eq_false(c: Cmp, f: {c == EQ{}: Cmp} -> Empty) -> {Cmp.is_eq(c) == False{}: Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      Empty.absurd({True{} == False{}: Bool}, f({==}))
    case GT{}:
      {==}

# a write of k as m to a tree reads as Mst.InsOk says
def Mst.put_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  m: Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>
) -> Mst.InsOk(~S, ~fetch, s, Mst.depth(), None{}, None{}, h, k, m, Mst.put(~S, ~fetch, s, h, k, m)):
  match m:
    case Some{+v}:
      Mst.ins_ok(~S, ~fetch, Mst.depth(), h, s, Mst.depth(), None{}, None{}, k, v, Key.level(k))({==})(Mst.level_lt(k))({==})({==})
    case None{}:
      Mst.del_ok(~S, ~fetch, Mst.depth(), h, s, Mst.depth(), None{}, None{}, k, Key.level(k))({==})({==})({==})

# a write res that gave the edit e reads, once the depot holds its new nodes,
# as Mst.InsRead says
def Mst.put_read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  e: Edit,
  -res: Maybe<&2, Edit>,
  +s: S,
  +h: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +m: Maybe<&2, List<&2, U32>>,
  +er: {res == Some{e}: Maybe<&2, Edit>}
) -> Mst.InsOk(~S, ~fetch, s, Mst.depth(), None{}, None{}, h, k, m, res) -> {Depots.Depot.holds(~S, ~fetch, s, Edit.nodes(e)) == True{}: Bool} -> Mst.InsRead(
  ~S,
  ~fetch,
  s,
  Mst.depth(),
  None{},
  None{},
  h,
  k,
  m,
  Edit.root(e)
):
  match e:
    case Edit{+nr, +ns}:
      %Equal.sym(Maybe<&2, Edit>, res, Some{Edit{nr, ns}}, er): (
        Mst.InsOk(~S, ~fetch, s, Mst.depth(), None{}, None{}, h, k, m, _)
          -> {Depots.Depot.holds(~S, ~fetch, s, ns) == True{}: Bool}
          -> Mst.InsRead(~S, ~fetch, s, Mst.depth(), None{}, None{}, h, k, m, nr)
      )
      ok => +hold => ok(hold)

# the two parts of Laws.Write, from what the write reads (bi)
def Mst.writes.of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +m: Maybe<&2, List<&2, U32>>,
  +nr: Maybe<&2, Hashes.Hash>,
  bi: Mst.InsRead(~S, ~fetch, s, Mst.depth(), None{}, None{}, h, k, m, nr)
) -> {Mst.look(~S, ~fetch, s, nr, k) == Look.of(m): Look}
  & (
    @k2: List<&2, U32> -> @x: Maybe<&2, List<&2, U32>> -> {Shared.List.is_eq(~U32, ~U32.is_eq, k, k2) == False{}: Bool} -> {
      Look.known(Mst.look(~S, ~fetch, s, h, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>
    } -> {Look.known(Mst.look(~S, ~fetch, s, nr, k2)) == Some{x}: Maybe<&2, Maybe<&2, List<&2, U32>>>}
):
  (i1, i2) = bi
  (
    Mst.known_of(Mst.look(~S, ~fetch, s, nr, k), m)(i1(Mst.depth())(Shared.Nat.le_refl(Mst.depth()))),
    +k2 => +x => +ne => +e => i2(k2)(x)(Mst.depth())(Mst.depth())(Mst.is_eq_false(Key.cmp(k2, k), +c => Mst.key_ne(k, k2)(ne)(c)))(
      Shared.Nat.le_refl(Mst.depth())
    )(e)
  )

# a read then k, where the read and each k keep what they give, keeps what
# it gives
def Mst.kept.bind(
  -A: Data,
  -B: Data,
  m: Maybe<&2, A>,
  -m2: Maybe<&2, A>,
  -k: A -> Maybe<&2, B>,
  -k2: A -> Maybe<&2, B>,
  hm: Mst.Kept(A, m, m2),
  hk: @a: A -> Mst.Kept(B, k(a), k2(a))
) -> Mst.Kept(B, Maybe.bind(&2, A, B, m, k), Maybe.bind(&2, A, B, m2, k2)):
  match m:
    case None{}:
      +x => +e => Empty.absurd({Maybe.bind(&2, A, B, m2, k2) == Some{x}: Maybe<&2, B>}, Shared.Maybe.none_ne_some(B, x, e))
    case Some{+y}:
      %Equal.sym(Maybe<&2, A>, m2, Some{y}, hm(y)({==})): Mst.Kept(B, k(y), Maybe.bind(&2, A, B, _, k2))
      hk(y)

# the pieces of a node that a depot gives, a depot that grows from it gives
# too
def Mst.open_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  +sa: S,
  +sb: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +gr: {grows(sa, sb) == True{}: Bool}
) -> Mst.Kept(List<&2, Piece>, Mst.open(~S, ~fetch, sa, h, up, lo, hi), Mst.open(~S, ~fetch, sb, h, up, lo, hi)):
  Mst.kept.bind(
    List<&2, U32>,
    List<&2, Piece>,
    fetch(sa)(h),
    fetch(sb)(h),
    +ws => Shared.Maybe.when(
      List<&2, Piece>,
      Hashes.Hash.is_eq(Hashes.Sha.hash(ws), h),
      u => Maybe.bind(
        &2,
        Node,
        List<&2, Piece>,
        Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
        n => Mst.open.node(n, up, lo, hi)
      )
    ),
    +ws => Shared.Maybe.when(
      List<&2, Piece>,
      Hashes.Hash.is_eq(Hashes.Sha.hash(ws), h),
      u => Maybe.bind(
        &2,
        Node,
        List<&2, Piece>,
        Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
        n => Mst.open.node(n, up, lo, hi)
      )
    ),
    +w => +e => kept(sa)(sb)(h)(w)(gr)(e),
    +w => +x => +e => e
  )

# a listing that a depot gives, a depot that grows from it gives too
def Mst.range_go_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  ps: List<&2, Piece>,
  +sa: S,
  +sb: S,
  +p: List<&2, U32>,
  +gr: {grows(sa, sb) == True{}: Bool}
) -> Mst.Kept(List<&2, Binding>, Mst.range.go(~S, ~fetch, f, sa, p, ps), Mst.range.go(~S, ~fetch, f, sb, p, ps)):
  match f ps:
    case 0n Nil{}:
      +x => +e => e
    case 1n+q Nil{}:
      +x => +e => e
    case 0n Con{y, rest}:
      +x => +e => e
    case 1n+(+q) Con{Piece.Bind{+k, +v}, +rest}:
      Mst.kept.app(
        List<&2, Binding>,
        List<&2, Binding>,
        mm => Maybe.map(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          +bs => Shared.Bool.when(List<&2, Binding>, Key.leads(p, k), u => Binding{k, v} <> bs, u => bs),
          mm
        ),
        Mst.range.go(~S, ~fetch, 1n+q, sa, p, rest),
        Mst.range.go(~S, ~fetch, 1n+q, sb, p, rest),
        {==},
        Mst.range_go_kept(~S, ~fetch, ~grows, ~kept, 1n+q, rest, sa, sb, p, gr)
      )
    case 1n+(+q) Con{Piece.Sub{+h, +up, +lo, +hi}, +rest}:
      Mst.kept.when(
        List<&2, Binding>,
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, sa, h, up, lo, hi),
          ks => Maybe.bind(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, q, sa, p, ks),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, sa, p, rest)
            )
          )
        ),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, sb, h, up, lo, hi),
          ks => Maybe.bind(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, q, sb, p, ks),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, sb, p, rest)
            )
          )
        ),
        u => Mst.range.go(~S, ~fetch, 1n+q, sa, p, rest),
        u => Mst.range.go(~S, ~fetch, 1n+q, sb, p, rest),
        Mst.kept.bind(
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, sa, h, up, lo, hi),
          Mst.open(~S, ~fetch, sb, h, up, lo, hi),
          ks => Maybe.bind(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, q, sa, p, ks),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, sa, p, rest)
            )
          ),
          ks => Maybe.bind(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, q, sb, p, ks),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, sb, p, rest)
            )
          ),
          Mst.open_kept(~S, ~fetch, ~grows, ~kept, sa, sb, h, up, lo, hi, gr),
          +ks => Mst.kept.bind(
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, q, sa, p, ks),
            Mst.range.go(~S, ~fetch, q, sb, p, ks),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, sa, p, rest)
            ),
            a => Maybe.map(
              &2,
              List<&2, Binding>,
              List<&2, Binding>,
              b => List.append(&2, Binding, a, b),
              Mst.range.go(~S, ~fetch, 1n+q, sb, p, rest)
            ),
            Mst.range_go_kept(~S, ~fetch, ~grows, ~kept, q, ks, sa, sb, p, gr),
            +a => Mst.kept.app(
              List<&2, Binding>,
              List<&2, Binding>,
              mm => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a, b), mm),
              Mst.range.go(~S, ~fetch, 1n+q, sa, p, rest),
              Mst.range.go(~S, ~fetch, 1n+q, sb, p, rest),
              {==},
              Mst.range_go_kept(~S, ~fetch, ~grows, ~kept, 1n+q, rest, sa, sb, p, gr)
            )
          )
        ),
        Mst.range_go_kept(~S, ~fetch, ~grows, ~kept, 1n+q, rest, sa, sb, p, gr)
      )

# the pieces of a run, each subtree opened, that a depot gives, a depot that
# grows from it gives too
def Mst.open_all_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  ps: List<&2, Piece>,
  +sa: S,
  +sb: S,
  +gr: {grows(sa, sb) == True{}: Bool}
) -> Mst.Kept(List<&2, Piece>, Mst.open.all(~S, ~fetch, sa, ps), Mst.open.all(~S, ~fetch, sb, ps)):
  match ps:
    case Nil{}:
      +x => +e => e
    case Con{Piece.Bind{+k, +v}, +rest}:
      Mst.kept.app(
        List<&2, Piece>,
        List<&2, Piece>,
        mm => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, r => Piece.Bind{k, v} <> r, mm),
        Mst.open.all(~S, ~fetch, sa, rest),
        Mst.open.all(~S, ~fetch, sb, rest),
        {==},
        Mst.open_all_kept(~S, ~fetch, ~grows, ~kept, rest, sa, sb, gr)
      )
    case Con{Piece.Sub{+h, +u, +lo, +hi}, +rest}:
      Mst.kept.bind(
        List<&2, Piece>,
        List<&2, Piece>,
        Mst.open(~S, ~fetch, sa, h, u, lo, hi),
        Mst.open(~S, ~fetch, sb, h, u, lo, hi),
        a => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, a, b), Mst.open.all(~S, ~fetch, sa, rest)),
        a => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, a, b), Mst.open.all(~S, ~fetch, sb, rest)),
        Mst.open_kept(~S, ~fetch, ~grows, ~kept, sa, sb, h, u, lo, hi, gr),
        +a => Mst.kept.app(
          List<&2, Piece>,
          List<&2, Piece>,
          mm => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, a, b), mm),
          Mst.open.all(~S, ~fetch, sa, rest),
          Mst.open.all(~S, ~fetch, sb, rest),
          {==},
          Mst.open_all_kept(~S, ~fetch, ~grows, ~kept, rest, sa, sb, gr)
        )
      )

# the round of a run that a depot gives, a depot that grows from it gives too
def Mst.step_at_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  p: Runs,
  +sa: S,
  +sb: S,
  +gr: {grows(sa, sb) == True{}: Bool}
) -> Mst.Kept(Round, Mst.step.at(~S, ~fetch, sa, p), Mst.step.at(~S, ~fetch, sb, p)):
  match p:
    case Runs{+a, +b}:
      Mst.kept.when(
        Round,
        Bool.or(Pieces.has_sub(a), Pieces.has_sub(b)),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          Round,
          Mst.open.all(~S, ~fetch, sa, a),
          a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, sa, b))
        ),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          Round,
          Mst.open.all(~S, ~fetch, sb, a),
          a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, sb, b))
        ),
        u => Some{Round{Pieces.keys(a, Pieces.keys(b, [])), []}},
        u => Some{Round{Pieces.keys(a, Pieces.keys(b, [])), []}},
        Mst.kept.bind(
          List<&2, Piece>,
          Round,
          Mst.open.all(~S, ~fetch, sa, a),
          Mst.open.all(~S, ~fetch, sb, a),
          a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, sa, b)),
          a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, sb, b)),
          Mst.open_all_kept(~S, ~fetch, ~grows, ~kept, a, sa, sb, gr),
          +a2 => Mst.kept.app(
            List<&2, Piece>,
            Round,
            mm => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, mm),
            Mst.open.all(~S, ~fetch, sa, b),
            Mst.open.all(~S, ~fetch, sb, b),
            {==},
            Mst.open_all_kept(~S, ~fetch, ~grows, ~kept, b, sa, sb, gr)
          )
        ),
        +x => +e => e
      )

# the rounds of runs that a depot gives, a depot that grows from it gives too
def Mst.step_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  ps: List<&2, Runs>,
  +sa: S,
  +sb: S,
  +gr: {grows(sa, sb) == True{}: Bool}
) -> Mst.Kept(Round, Mst.step(~S, ~fetch, sa, ps), Mst.step(~S, ~fetch, sb, ps)):
  match ps:
    case Nil{}:
      +x => +e => e
    case Con{+p, +rest}:
      Mst.kept.bind(
        Round,
        Round,
        Mst.step.at(~S, ~fetch, sa, Runs.trim(p)),
        Mst.step.at(~S, ~fetch, sb, Runs.trim(p)),
        a => Maybe.map(&2, Round, Round, b => Round.append(a, b), Mst.step(~S, ~fetch, sa, rest)),
        a => Maybe.map(&2, Round, Round, b => Round.append(a, b), Mst.step(~S, ~fetch, sb, rest)),
        Mst.step_at_kept(~S, ~fetch, ~grows, ~kept, Runs.trim(p), sa, sb, gr),
        +a => Mst.kept.app(
          Round,
          Round,
          mm => Maybe.map(&2, Round, Round, b => Round.append(a, b), mm),
          Mst.step(~S, ~fetch, sa, rest),
          Mst.step(~S, ~fetch, sb, rest),
          {==},
          Mst.step_kept(~S, ~fetch, ~grows, ~kept, rest, sa, sb, gr)
        )
      )

# a difference that a depot gives, a depot that grows from it gives too
def Mst.diff_go_kept(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  ~grows: S -> S -> Bool,
  ~kept: Depots.Depot.Keeps(S, fetch, grows),
  f: Nat,
  ps: List<&2, Runs>,
  +sa: S,
  +sb: S,
  +gr: {grows(sa, sb) == True{}: Bool}
) -> Mst.Kept(List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, f, sa, ps), Mst.diff.go(~S, ~fetch, f, sb, ps)):
  match f ps:
    case 0n Nil{}:
      +x => +e => e
    case 1n+q Nil{}:
      +x => +e => e
    case 0n Con{y, rest}:
      +x => +e => e
    case 1n+(+q) Con{Runs{+a, +b}, +rest}:
      Mst.kept.bind(
        Round,
        List<&2, List<&2, U32>>,
        Mst.step(~S, ~fetch, sa, Round.pairs(Mst.cut(a, b, [], []))),
        Mst.step(~S, ~fetch, sb, Round.pairs(Mst.cut(a, b, [], []))),
        +r => Maybe.bind(
          &2,
          List<&2, List<&2, U32>>,
          List<&2, List<&2, U32>>,
          Mst.diff.go(~S, ~fetch, q, sa, Round.pairs(r)),
          k3 => Maybe.map(
            &2,
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            k4 => List.append(
              &2,
              List<&2, U32>,
              Round.keys(Mst.cut(a, b, [], [])),
              List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, sa, rest)
          )
        ),
        +r => Maybe.bind(
          &2,
          List<&2, List<&2, U32>>,
          List<&2, List<&2, U32>>,
          Mst.diff.go(~S, ~fetch, q, sb, Round.pairs(r)),
          k3 => Maybe.map(
            &2,
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            k4 => List.append(
              &2,
              List<&2, U32>,
              Round.keys(Mst.cut(a, b, [], [])),
              List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, sb, rest)
          )
        ),
        Mst.step_kept(~S, ~fetch, ~grows, ~kept, Round.pairs(Mst.cut(a, b, [], [])), sa, sb, gr),
        +r => Mst.kept.bind(
          List<&2, List<&2, U32>>,
          List<&2, List<&2, U32>>,
          Mst.diff.go(~S, ~fetch, q, sa, Round.pairs(r)),
          Mst.diff.go(~S, ~fetch, q, sb, Round.pairs(r)),
          k3 => Maybe.map(
            &2,
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            k4 => List.append(
              &2,
              List<&2, U32>,
              Round.keys(Mst.cut(a, b, [], [])),
              List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, sa, rest)
          ),
          k3 => Maybe.map(
            &2,
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            k4 => List.append(
              &2,
              List<&2, U32>,
              Round.keys(Mst.cut(a, b, [], [])),
              List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, sb, rest)
          ),
          Mst.diff_go_kept(~S, ~fetch, ~grows, ~kept, q, Round.pairs(r), sa, sb, gr),
          +k3 => Mst.kept.app(
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            mm => Maybe.map(
              &2,
              List<&2, List<&2, U32>>,
              List<&2, List<&2, U32>>,
              k4 => List.append(
                &2,
                List<&2, U32>,
                Round.keys(Mst.cut(a, b, [], [])),
                List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
              ),
              mm
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, sa, rest),
            Mst.diff.go(~S, ~fetch, 1n+q, sb, rest),
            {==},
            Mst.diff_go_kept(~S, ~fetch, ~grows, ~kept, 1n+q, rest, sa, sb, gr)
          )
        )
      )

# what a read tells stays, in a depot that keeps what it holds
law Mst.reads_final:
  for ~S: Data
  for ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>
  for ~grows: S -> S -> Bool
  for ~kept: Depots.Depot.Keeps(S, fetch, grows)
  Laws.Final(S, grows, Mst.ops(~S, ~fetch))

def Mst.reads_final(S, fetch, grows, kept):
  h => k => a => b => x => gr => Mst.look.go_kept(~S, ~fetch, ~grows, ~kept, Mst.depth(), h, a, b, Room.top(), k, x, gr)

# a write stays, in a depot that keeps what it holds
law Mst.puts_final:
  for ~S: Data
  for ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>
  for ~grows: S -> S -> Bool
  for ~kept: Depots.Depot.Keeps(S, fetch, grows)
  Laws.PutFinal(S, grows, Mst.ops(~S, ~fetch))

def Mst.puts_final(S, fetch, grows, kept):
  s => s2 => h => k => m => e => he => gr => Mst.put_kept(~S, ~fetch, ~grows, ~kept, m, s, s2, h, k, gr)(e)(he)

# a write changes its key and no other
law Mst.writes:
  for ~S: Data
  for ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>
  for ~grows: S -> S -> Bool
  for ~kept: Depots.Depot.Keeps(S, fetch, grows)
  Laws.Write(S, fetch, grows, Mst.ops(~S, ~fetch))

def Mst.writes(S, fetch, grows, kept):
  s => +s2 => +h => +k => +m => +e => he => gr => held => Mst.writes.of(
    ~S,
    ~fetch,
    s2,
    h,
    k,
    m,
    Edit.root(e),
    Mst.put_read(
      ~S,
      ~fetch,
      e,
      Mst.put(~S, ~fetch, s2, h, k, m),
      s2,
      h,
      k,
      m,
      Mst.put_kept(~S, ~fetch, ~grows, ~kept, m, s, s2, h, k, gr)(e)(he)
    )(Mst.put_ok(~S, ~fetch, m, s2, h, k))(
      Mst.holds_of(~S, ~fetch, Edit.nodes(e), Mst.head_has(~S, ~fetch, s2, Edit.nodes(e)), s2, {==}, held)
    )
  )

# The order of keys
# -----------------

# the comparison c, seen from the other side
def Cmp.flip(c: Cmp) -> Cmp:
  match c:
    case LT{}:
      GT{}
    case EQ{}:
      EQ{}
    case GT{}:
      LT{}

# no LT is an EQ
def Cmp.lt_ne_eq(e: {LT{} == EQ{}: Cmp}) -> Empty:
  Shared.Bool.false_ne_true(Equal.cong(Cmp, Bool, Cmp.is_eq, LT{}, EQ{}, e))

# no GT is an EQ
def Cmp.gt_ne_eq(e: {GT{} == EQ{}: Cmp}) -> Empty:
  Shared.Bool.false_ne_true(Equal.cong(Cmp, Bool, Cmp.is_eq, GT{}, EQ{}, e))

# no GT is an LT
def Cmp.gt_ne_lt(e: {GT{} == LT{}: Cmp}) -> Empty:
  Shared.Bool.false_ne_true(Equal.cong(Cmp, Bool, Cmp.is_lt, GT{}, LT{}, e))

# no EQ is an LT
def Cmp.eq_ne_lt(e: {EQ{} == LT{}: Cmp}) -> Empty:
  Shared.Bool.false_ne_true(Equal.cong(Cmp, Bool, Cmp.is_lt, EQ{}, LT{}, e))

# two numbers compare the other way round from the other side
def Nat.cmp_flip(a: Nat, b: Nat) -> {Nat.cmp(b, a) == Cmp.flip(Nat.cmp(a, b)): Cmp}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      Nat.cmp_flip(p, q)

# a < b and b < c give a < c
def Nat.cmp_trans(a: Nat, b: Nat, c: Nat) -> {Nat.cmp(a, b) == LT{}: Cmp} -> {Nat.cmp(b, c) == LT{}: Cmp} -> {
  Nat.cmp(a, c) == LT{}: Cmp
}:
  match a b c:
    case 0n 0n z:
      h => k => Empty.absurd({Nat.cmp(0n, z) == LT{}: Cmp}, Cmp.eq_ne_lt(h))
    case 1n+p 0n z:
      h => k => Empty.absurd({Nat.cmp(1n+p, z) == LT{}: Cmp}, Cmp.gt_ne_lt(h))
    case 0n 1n+q 0n:
      h => k => Empty.absurd({Nat.cmp(0n, 0n) == LT{}: Cmp}, Cmp.gt_ne_lt(k))
    case 0n 1n+q 1n+w:
      h => k => {==}
    case 1n+p 1n+q 0n:
      h => k => Empty.absurd({Nat.cmp(1n+p, 0n) == LT{}: Cmp}, Cmp.gt_ne_lt(k))
    case 1n+p 1n+q 1n+w:
      Nat.cmp_trans(p, q, w)

# two words compare the other way round from the other side
def U32.cmp_flip(+x: U32, +y: U32) -> {U32.cmp(y, x) == Cmp.flip(U32.cmp(x, y)): Cmp}:
  %Equal.sym(Cmp, U32.cmp(y, x), Nat.cmp(U32.to_nat(y), U32.to_nat(x)), Shared.U32.cmp_to_nat(y, x)): {
    _ == Cmp.flip(U32.cmp(x, y)): Cmp
  }
  %Equal.sym(Cmp, U32.cmp(x, y), Nat.cmp(U32.to_nat(x), U32.to_nat(y)), Shared.U32.cmp_to_nat(x, y)): {
    Nat.cmp(U32.to_nat(y), U32.to_nat(x)) == Cmp.flip(_): Cmp
  }
  Nat.cmp_flip(U32.to_nat(x), U32.to_nat(y))

# x < y and y < z give x < z
def U32.cmp_trans(+x: U32, +y: U32, +z: U32) -> {U32.cmp(x, y) == LT{}: Cmp} -> {U32.cmp(y, z) == LT{}: Cmp} -> {
  U32.cmp(x, z) == LT{}: Cmp
}:
  h => k =>
    %Equal.sym(Cmp, U32.cmp(x, z), Nat.cmp(U32.to_nat(x), U32.to_nat(z)), Shared.U32.cmp_to_nat(x, z)): {
      _ == LT{}: Cmp
    }
    Nat.cmp_trans(
      U32.to_nat(x),
      U32.to_nat(y),
      U32.to_nat(z)
    )(
      Equal.trans(
        Cmp,
        Nat.cmp(U32.to_nat(x), U32.to_nat(y)),
        U32.cmp(x, y),
        LT{},
        Equal.sym(Cmp, U32.cmp(x, y), Nat.cmp(U32.to_nat(x), U32.to_nat(y)), Shared.U32.cmp_to_nat(x, y)),
        h
      )
    )(
      Equal.trans(
        Cmp,
        Nat.cmp(U32.to_nat(y), U32.to_nat(z)),
        U32.cmp(y, z),
        LT{},
        Equal.sym(Cmp, U32.cmp(y, z), Nat.cmp(U32.to_nat(y), U32.to_nat(z)), Shared.U32.cmp_to_nat(y, z)),
        k
      )
    )

# words that compare EQ are equal
def U32.cmp_eq(+x: U32, +y: U32) -> {U32.cmp(x, y) == EQ{}: Cmp} -> {x == y: U32}:
  h => Shared.U32.is_eq_sound(x, y)(Shared.Cmp.is_eq_of(U32.cmp(x, y), Equal.sym(Cmp, U32.cmp(x, y), EQ{}, h)))

# a key compares EQ to itself
def Key.cmp_refl(a: List<&2, U32>) -> {Key.cmp(a, a) == EQ{}: Cmp}:
  match a:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      %Equal.sym(Cmp, U32.cmp(x, x), EQ{}, Shared.U32.cmp_refl(x)): {
        Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(r, r), u => _) == EQ{}: Cmp
      }
      Key.cmp_refl(r)

# Key.cmp_eq for two keys of heads x and y, whose comparison is c
def Key.cmp_eq.con(
  c: Cmp,
  +x: U32,
  +y: U32,
  +ra: List<&2, U32>,
  +rb: List<&2, U32>,
  ec: {U32.cmp(x, y) == c: Cmp},
  ih: {Key.cmp(ra, rb) == EQ{}: Cmp} -> {ra == rb: List<&2, U32>}
) -> {Shared.Bool.when(Cmp, Cmp.is_eq(c), u => Key.cmp(ra, rb), u => c) == EQ{}: Cmp} -> {
  x <> ra == y <> rb: List<&2, U32>
}:
  match c:
    case EQ{}:
      h =>
        %U32.cmp_eq(x, y)(ec): {x <> ra == _ <> rb: List<&2, U32>}
        %ih(h): {x <> ra == x <> _: List<&2, U32>}
        {==}
    case LT{}:
      h => Empty.absurd({x <> ra == y <> rb: List<&2, U32>}, Cmp.lt_ne_eq(h))
    case GT{}:
      h => Empty.absurd({x <> ra == y <> rb: List<&2, U32>}, Cmp.gt_ne_eq(h))

# keys that compare EQ are equal
def Key.cmp_eq(a: List<&2, U32>, b: List<&2, U32>) -> {Key.cmp(a, b) == EQ{}: Cmp} -> {a == b: List<&2, U32>}:
  match a b:
    case Nil{} Nil{}:
      h => {==}
    case Nil{} Con{y, rb}:
      h => Empty.absurd({[] == y <> rb: List<&2, U32>}, Cmp.lt_ne_eq(h))
    case Con{x, ra} Nil{}:
      h => Empty.absurd({x <> ra == []: List<&2, U32>}, Cmp.gt_ne_eq(h))
    case Con{+x, +ra} Con{+y, +rb}:
      Key.cmp_eq.con(U32.cmp(x, y), x, y, ra, rb, {==}, Key.cmp_eq(ra, rb))

# Key.cmp_flip for two keys of heads that compare as c, and rests that compare
# as r
def Key.cmp_flip.con(c: Cmp, r: Cmp) -> {
  Shared.Bool.when(Cmp, Cmp.is_eq(Cmp.flip(c)), u => Cmp.flip(r), u => Cmp.flip(c))
    == Cmp.flip(Shared.Bool.when(Cmp, Cmp.is_eq(c), u => r, u => c)): Cmp
}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

# two keys compare the other way round from the other side
def Key.cmp_flip(a: List<&2, U32>, b: List<&2, U32>) -> {Key.cmp(b, a) == Cmp.flip(Key.cmp(a, b)): Cmp}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{y, rb}:
      {==}
    case Con{x, ra} Nil{}:
      {==}
    case Con{+x, +ra} Con{+y, +rb}:
      %Equal.sym(Cmp, U32.cmp(y, x), Cmp.flip(U32.cmp(x, y)), U32.cmp_flip(x, y)): {
        Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(rb, ra), u => _)
          == Cmp.flip(Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, y)), u => Key.cmp(ra, rb), u => U32.cmp(x, y))): Cmp
      }
      %Equal.sym(Cmp, Key.cmp(rb, ra), Cmp.flip(Key.cmp(ra, rb)), Key.cmp_flip(ra, rb)): {
        Shared.Bool.when(Cmp, Cmp.is_eq(Cmp.flip(U32.cmp(x, y))), u => _, u => Cmp.flip(U32.cmp(x, y)))
          == Cmp.flip(Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, y)), u => Key.cmp(ra, rb), u => U32.cmp(x, y))): Cmp
      }
      Key.cmp_flip.con(U32.cmp(x, y), Key.cmp(ra, rb))

# Key.cmp_trans for three keys of heads x, y and z, where x and y compare as
# c1, and y and z as c2
def Key.cmp_trans.con(
  c1: Cmp,
  c2: Cmp,
  +x: U32,
  +y: U32,
  +z: U32,
  +ra: List<&2, U32>,
  +rb: List<&2, U32>,
  +rc: List<&2, U32>,
  e1: {U32.cmp(x, y) == c1: Cmp},
  e2: {U32.cmp(y, z) == c2: Cmp},
  ih: {Key.cmp(ra, rb) == LT{}: Cmp} -> {Key.cmp(rb, rc) == LT{}: Cmp} -> {Key.cmp(ra, rc) == LT{}: Cmp}
) -> {Shared.Bool.when(Cmp, Cmp.is_eq(c1), u => Key.cmp(ra, rb), u => c1) == LT{}: Cmp} -> {
  Shared.Bool.when(Cmp, Cmp.is_eq(c2), u => Key.cmp(rb, rc), u => c2) == LT{}: Cmp
} -> {Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, z)), u => Key.cmp(ra, rc), u => U32.cmp(x, z)) == LT{}: Cmp}:
  match c1 c2:
    case LT{} LT{}:
      h => k =>
        %Equal.sym(Cmp, U32.cmp(x, z), LT{}, U32.cmp_trans(x, y, z)(e1)(e2)): {
          Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(ra, rc), u => _) == LT{}: Cmp
        }
        {==}
    case LT{} EQ{}:
      h => k =>
        %U32.cmp_eq(y, z)(e2): {
          Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, _)), u => Key.cmp(ra, rc), u => U32.cmp(x, _)) == LT{}: Cmp
        }
        %Equal.sym(Cmp, U32.cmp(x, y), LT{}, e1): {
          Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(ra, rc), u => _) == LT{}: Cmp
        }
        {==}
    case EQ{} LT{}:
      h => k =>
        %Equal.sym(U32, x, y, U32.cmp_eq(x, y)(e1)): {
          Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(_, z)), u => Key.cmp(ra, rc), u => U32.cmp(_, z)) == LT{}: Cmp
        }
        %Equal.sym(Cmp, U32.cmp(y, z), LT{}, e2): {
          Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(ra, rc), u => _) == LT{}: Cmp
        }
        {==}
    case EQ{} EQ{}:
      h => k =>
        %Equal.sym(U32, x, y, U32.cmp_eq(x, y)(e1)): {
          Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(_, z)), u => Key.cmp(ra, rc), u => U32.cmp(_, z)) == LT{}: Cmp
        }
        %U32.cmp_eq(y, z)(e2): {
          Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(y, _)), u => Key.cmp(ra, rc), u => U32.cmp(y, _)) == LT{}: Cmp
        }
        %Equal.sym(Cmp, U32.cmp(y, y), EQ{}, Shared.U32.cmp_refl(y)): {
          Shared.Bool.when(Cmp, Cmp.is_eq(_), u => Key.cmp(ra, rc), u => _) == LT{}: Cmp
        }
        ih(h)(k)
    case GT{} w:
      h => k => Empty.absurd(
        {Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, z)), u => Key.cmp(ra, rc), u => U32.cmp(x, z)) == LT{}: Cmp},
        Cmp.gt_ne_lt(h)
      )
    case w GT{}:
      h => k => Empty.absurd(
        {Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, z)), u => Key.cmp(ra, rc), u => U32.cmp(x, z)) == LT{}: Cmp},
        Cmp.gt_ne_lt(k)
      )

# a < b and b < c give a < c
def Key.cmp_trans(a: List<&2, U32>, b: List<&2, U32>, c: List<&2, U32>) -> {Key.cmp(a, b) == LT{}: Cmp} -> {
  Key.cmp(b, c) == LT{}: Cmp
} -> {Key.cmp(a, c) == LT{}: Cmp}:
  match a b c:
    case Nil{} Nil{} z:
      h => k => Empty.absurd({Key.cmp([], z) == LT{}: Cmp}, Cmp.eq_ne_lt(h))
    case Con{x, ra} Nil{} z:
      h => k => Empty.absurd({Key.cmp(x <> ra, z) == LT{}: Cmp}, Cmp.gt_ne_lt(h))
    case Nil{} Con{y, rb} Nil{}:
      h => k => Empty.absurd({Key.cmp([], []) == LT{}: Cmp}, Cmp.gt_ne_lt(k))
    case Nil{} Con{y, rb} Con{z, rc}:
      h => k => {==}
    case Con{x, ra} Con{y, rb} Nil{}:
      h => k => Empty.absurd({Key.cmp(x <> ra, []) == LT{}: Cmp}, Cmp.gt_ne_lt(k))
    case Con{+x, +ra} Con{+y, +rb} Con{+z, +rc}:
      Key.cmp_trans.con(U32.cmp(x, y), U32.cmp(y, z), x, y, z, ra, rb, rc, {==}, {==}, Key.cmp_trans(ra, rb, rc))

# Key.is_lt_cmp for two keys of heads that compare as c, and rests that
# compare as r
def Key.is_lt_cmp.con(c: Cmp, r: Cmp) -> {
  Bool.or(Cmp.is_lt(c), Bool.and(Cmp.is_eq(c), Cmp.is_lt(r))) == Cmp.is_lt(Shared.Bool.when(Cmp, Cmp.is_eq(c), u => r, u => c)): Bool
}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

# Key.is_lt is the LT of Key.cmp
def Key.is_lt_cmp(a: List<&2, U32>, b: List<&2, U32>) -> {Key.is_lt(a, b) == Cmp.is_lt(Key.cmp(a, b)): Bool}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Con{x, ra} Nil{}:
      {==}
    case Nil{} Con{y, rb}:
      {==}
    case Con{+x, +ra} Con{+y, +rb}:
      %Equal.sym(Bool, Key.is_lt(ra, rb), Cmp.is_lt(Key.cmp(ra, rb)), Key.is_lt_cmp(ra, rb)): {
        Bool.or(U32.is_lt(x, y), Bool.and(U32.is_eq(x, y), _))
          == Cmp.is_lt(Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, y)), u => Key.cmp(ra, rb), u => U32.cmp(x, y))): Bool
      }
      Key.is_lt_cmp.con(U32.cmp(x, y), Key.cmp(ra, rb))

# Key.is_eq_cmp for two keys of heads that compare as c, and rests that
# compare as r
def Key.is_eq_cmp.con(c: Cmp, r: Cmp) -> {
  List.all.if(u => Cmp.is_eq(r), Cmp.is_eq(c)) == Cmp.is_eq(Shared.Bool.when(Cmp, Cmp.is_eq(c), u => r, u => c)): Bool
}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

# the equality of words of keys is the EQ of Key.cmp
def Key.is_eq_cmp(a: List<&2, U32>, b: List<&2, U32>) -> {
  Shared.List.is_eq(~U32, ~U32.is_eq, a, b) == Cmp.is_eq(Key.cmp(a, b)): Bool
}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Con{x, ra} Nil{}:
      {==}
    case Nil{} Con{y, rb}:
      {==}
    case Con{+x, +ra} Con{+y, +rb}:
      %Equal.sym(
        Bool,
        Shared.List.is_eq(~U32, ~U32.is_eq, ra, rb),
        Cmp.is_eq(Key.cmp(ra, rb)),
        Key.is_eq_cmp(ra, rb)
      ): {
        List.all.if(u => _, U32.is_eq(x, y))
          == Cmp.is_eq(Shared.Bool.when(Cmp, Cmp.is_eq(U32.cmp(x, y)), u => Key.cmp(ra, rb), u => U32.cmp(x, y))): Bool
      }
      Key.is_eq_cmp.con(U32.cmp(x, y), Key.cmp(ra, rb))

# Opened nodes
# ------------

# an is_lt that is True is of LT
def Cmp.lt_true(c: Cmp) -> {Cmp.is_lt(c) == True{}: Bool} -> {c == LT{}: Cmp}:
  match c:
    case LT{}:
      h => {==}
    case EQ{}:
      h => Empty.absurd({EQ{} == LT{}: Cmp}, Shared.Bool.false_ne_true(h))
    case GT{}:
      h => Empty.absurd({GT{} == LT{}: Cmp}, Shared.Bool.false_ne_true(h))

# a key before b compares as c, then Key.is_lt asks for LT
def Key.lt_of(+a: List<&2, U32>, +b: List<&2, U32>, -c: Cmp) -> {Key.cmp(a, b) == c: Cmp} -> {
  Key.is_lt(a, b) == Cmp.is_lt(c): Bool
}:
  e =>
    %Equal.sym(Bool, Key.is_lt(a, b), Cmp.is_lt(Key.cmp(a, b)), Key.is_lt_cmp(a, b)): {_ == Cmp.is_lt(c): Bool}
    Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(a, b), c, e)

# a key a that compares to b as c is after b as the flip of c is LT
def Key.gt_of(+a: List<&2, U32>, +b: List<&2, U32>, -c: Cmp) -> {Key.cmp(a, b) == c: Cmp} -> {
  Key.is_lt(b, a) == Cmp.is_lt(Cmp.flip(c)): Bool
}:
  e =>
    %Equal.sym(Bool, Key.is_lt(b, a), Cmp.is_lt(Key.cmp(b, a)), Key.is_lt_cmp(b, a)): {_ == Cmp.is_lt(Cmp.flip(c)): Bool}
    %Equal.sym(Cmp, Key.cmp(b, a), Cmp.flip(Key.cmp(a, b)), Key.cmp_flip(a, b)): {Cmp.is_lt(_) == Cmp.is_lt(Cmp.flip(c)): Bool}
    Equal.cong(Cmp, Bool, x => Cmp.is_lt(Cmp.flip(x)), Key.cmp(a, b), c, e)

# a key a that compares to b as c has the words of b as the flip of c is EQ
def Key.eq_of(+a: List<&2, U32>, +b: List<&2, U32>, -c: Cmp) -> {Key.cmp(a, b) == c: Cmp} -> {
  Shared.List.is_eq(~U32, ~U32.is_eq, b, a) == Cmp.is_eq(Cmp.flip(c)): Bool
}:
  e =>
    %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, b, a), Cmp.is_eq(Key.cmp(b, a)), Key.is_eq_cmp(b, a)): {
      _ == Cmp.is_eq(Cmp.flip(c)): Bool
    }
    %Equal.sym(Cmp, Key.cmp(b, a), Cmp.flip(Key.cmp(a, b)), Key.cmp_flip(a, b)): {Cmp.is_eq(_) == Cmp.is_eq(Cmp.flip(c)): Bool}
    Equal.cong(Cmp, Bool, x => Cmp.is_eq(Cmp.flip(x)), Key.cmp(a, b), c, e)

# a < b and b < c give a < c
def Key.lt_trans(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {Key.is_lt(a, b) == True{}: Bool} -> {
  Key.is_lt(b, c) == True{}: Bool
} -> {Key.is_lt(a, c) == True{}: Bool}:
  h => k =>
    %Equal.sym(Bool, Key.is_lt(a, c), Cmp.is_lt(Key.cmp(a, c)), Key.is_lt_cmp(a, c)): {_ == True{}: Bool}
    %Equal.sym(
      Cmp,
      Key.cmp(a, c),
      LT{},
      Key.cmp_trans(
        a,
        b,
        c
      )(
        Cmp.lt_true(Key.cmp(a, b))(Equal.trans(Bool, Cmp.is_lt(Key.cmp(a, b)), Key.is_lt(a, b), True{}, Equal.sym(Bool, Key.is_lt(a, b), Cmp.is_lt(Key.cmp(a, b)), Key.is_lt_cmp(a, b)), h))
      )(
        Cmp.lt_true(Key.cmp(b, c))(Equal.trans(Bool, Cmp.is_lt(Key.cmp(b, c)), Key.is_lt(b, c), True{}, Equal.sym(Bool, Key.is_lt(b, c), Cmp.is_lt(Key.cmp(b, c)), Key.is_lt_cmp(b, c)), k))
      )
    ): {Cmp.is_lt(_) == True{}: Bool}
    {==}

# no key is before the empty key
def Key.lt_nil(k: List<&2, U32>) -> {Key.is_lt(k, []) == False{}: Bool}:
  match k:
    case Nil{}:
      {==}
    case Con{x, r}:
      {==}

# a key after the bound lo is after it once it grows: lo < a < k
def Bound.after_trans(+lo: Maybe<&2, List<&2, U32>>, +a: List<&2, U32>, +k: List<&2, U32>) -> {
  Bound.after(lo, a) == True{}: Bool
} -> {Key.is_lt(a, k) == True{}: Bool} -> {Bound.after(lo, k) == True{}: Bool}:
  match lo:
    case None{}:
      h => g => {==}
    case Some{+b}:
      h => g => Key.lt_trans(b, a, k)(h)(g)

# a key before the bound hi is before it: k < a < hi
def Bound.before_trans(+k: List<&2, U32>, +a: List<&2, U32>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Key.is_lt(k, a) == True{}: Bool
} -> {Bound.before(a, hi) == True{}: Bool} -> {Bound.before(k, hi) == True{}: Bool}:
  match hi:
    case None{}:
      g => h => {==}
    case Some{+b}:
      g => h => Key.lt_trans(k, a, b)(g)(h)

# Key.leads_before for heads that compare as c, and rests r1 and r2
def Key.leads_before.con(c: Cmp, r1: Bool, r2: Bool, ih: {r1 == True{}: Bool} -> {r2 == True{}: Bool}) -> {
  Bool.or(Cmp.is_lt(c), Bool.and(Cmp.is_eq(c), r1)) == True{}: Bool
} -> {Bool.or(Cmp.is_lt(c), Bool.and(Cmp.is_eq(c), r2)) == True{}: Bool}:
  match c:
    case LT{}:
      h => {==}
    case EQ{}:
      h => ih(h)
    case GT{}:
      h => h

# a key that starts with p and is before b has p before b
def Key.leads_before(p: List<&2, U32>, +k: List<&2, U32>, +b: List<&2, U32>) -> {Key.leads(p, k) == True{}: Bool} -> {
  Key.is_lt(k, b) == True{}: Bool
} -> {Key.is_lt(p, b) == True{}: Bool}:
  match p k b:
    case Nil{} k2 Nil{}:
      h1 => h2 => Empty.absurd(
        {Key.is_lt([], []) == True{}: Bool},
        Shared.Bool.false_ne_true(Equal.trans(Bool, False{}, Key.is_lt(k2, []), True{}, Equal.sym(Bool, Key.is_lt(k2, []), False{}, Key.lt_nil(k2)), h2))
      )
    case Nil{} k2 Con{z, rb}:
      h1 => h2 => {==}
    case Con{x, rp} Nil{} b2:
      h1 => h2 => Empty.absurd({Key.is_lt(x <> rp, b2) == True{}: Bool}, Shared.Bool.false_ne_true(h1))
    case Con{x, rp} Con{y, rk} Nil{}:
      h1 => h2 => Empty.absurd({Key.is_lt(x <> rp, []) == True{}: Bool}, Shared.Bool.false_ne_true(h2))
    case Con{+x, +rp} Con{+y, +rk} Con{+z, +rb}:
      +h1 => h2 =>
        %Equal.sym(U32, x, y, Shared.U32.is_eq_sound(x, y)(Shared.List.all.if_hit(U32.is_eq(x, y), u => Key.leads(rp, rk))(h1))): {
          Bool.or(U32.is_lt(_, z), Bool.and(U32.is_eq(_, z), Key.is_lt(rp, rb))) == True{}: Bool
        }
        Key.leads_before.con(
          U32.cmp(y, z),
          Key.is_lt(rk, rb),
          Key.is_lt(rp, rb),
          Key.leads_before(rp, rk, rb)(Shared.List.all.if_rest(U32.is_eq(x, y), u => Key.leads(rp, rk))(h1))
        )(h2)

# Key.leads_after for heads that compare as c
def Key.leads_after.con(
  c: Cmp,
  r1: Bool,
  a1: Bool,
  b1: Bool,
  ih: {r1 == True{}: Bool} -> {Bool.or(a1, b1) == True{}: Bool}
) -> {Bool.or(Cmp.is_lt(c), Bool.and(Cmp.is_eq(c), r1)) == True{}: Bool} -> {
  Bool.or(Bool.or(Cmp.is_lt(c), Bool.and(Cmp.is_eq(c), a1)), List.all.if(u => b1, Cmp.is_eq(Cmp.flip(c)))) == True{}: Bool
}:
  match c:
    case LT{}:
      h => {==}
    case EQ{}:
      h => ih(h)
    case GT{}:
      h => h

# a key that starts with p and is after a has a before p, or starts with p
def Key.leads_after(p: List<&2, U32>, +k: List<&2, U32>, +a: List<&2, U32>) -> {Key.leads(p, k) == True{}: Bool} -> {
  Key.is_lt(a, k) == True{}: Bool
} -> {Bool.or(Key.is_lt(a, p), Key.leads(p, a)) == True{}: Bool}:
  match p k a:
    case Nil{} k2 a2:
      h1 => h2 =>
        %Equal.sym(Bool, Key.is_lt(a2, []), False{}, Key.lt_nil(a2)): {Bool.or(_, Key.leads([], a2)) == True{}: Bool}
        {==}
    case Con{x, rp} Nil{} a2:
      h1 => h2 => Empty.absurd(
        {Bool.or(Key.is_lt(a2, x <> rp), Key.leads(x <> rp, a2)) == True{}: Bool},
        Shared.Bool.false_ne_true(h1)
      )
    case Con{x, rp} Con{y, rk} Nil{}:
      h1 => h2 => {==}
    case Con{+x, +rp} Con{+y, +rk} Con{+z, +ra}:
      +h1 => h2 =>
        %Equal.sym(U32, x, y, Shared.U32.is_eq_sound(x, y)(Shared.List.all.if_hit(U32.is_eq(x, y), u => Key.leads(rp, rk))(h1))): {
          Bool.or(Bool.or(U32.is_lt(z, _), Bool.and(U32.is_eq(z, _), Key.is_lt(ra, rp))), List.all.if(u => Key.leads(rp, ra), U32.is_eq(_, z)))
            == True{}: Bool
        }
        %Equal.sym(Cmp, U32.cmp(y, z), Cmp.flip(U32.cmp(z, y)), U32.cmp_flip(z, y)): {
          Bool.or(Bool.or(U32.is_lt(z, y), Bool.and(U32.is_eq(z, y), Key.is_lt(ra, rp))), List.all.if(u => Key.leads(rp, ra), Cmp.is_eq(_)))
            == True{}: Bool
        }
        Key.leads_after.con(
          U32.cmp(z, y),
          Key.is_lt(ra, rk),
          Key.is_lt(ra, rp),
          Key.leads(rp, ra),
          Key.leads_after(rp, rk, ra)(Shared.List.all.if_rest(U32.is_eq(x, y), u => Key.leads(rp, rk))(h1))
        )(h2)

# a key that starts with p, between lo and hi, makes p meet both bounds
def Bound.meets(+p: List<&2, U32>, +k: List<&2, U32>, lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> {
  Key.leads(p, k) == True{}: Bool
} -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool} -> {
  Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)) == True{}: Bool
}:
  match lo hi:
    case None{} None{}:
      h1 => h2 => {==}
    case None{} Some{+b}:
      h1 => h2 => Key.leads_before(p, k, b)(h1)(h2)
    case Some{+a} None{}:
      +h1 => h2 => Shared.Bool.and_both(
        Bool.or(Key.is_lt(a, p), Key.leads(p, a)),
        True{}
      )(Key.leads_after(p, k, a)(h1)(Shared.Bool.and_true_left(Key.is_lt(a, k), True{})(h2)))({==})
    case Some{+a} Some{+b}:
      +h1 => +h2 => Shared.Bool.and_both(
        Bool.or(Key.is_lt(a, p), Key.leads(p, a)),
        Key.is_lt(p, b)
      )(Key.leads_after(p, k, a)(h1)(Shared.Bool.and_true_left(Key.is_lt(a, k), Key.is_lt(k, b))(h2)))(
        Key.leads_before(p, k, b)(h1)(Shared.Bool.and_true_right(Key.is_lt(a, k), Key.is_lt(k, b))(h2))
      )

# a bind that gives x: m holds a value a, and f gives x of a
def Maybe.bind_cases(
  -A: Data,
  -B: Data,
  m: Maybe<&2, A>,
  -f: A -> Maybe<&2, B>,
  -x: B,
  -P: Type,
  k: @a: A -> {m == Some{a}: Maybe<&2, A>} -> {f(a) == Some{x}: Maybe<&2, B>} -> P
) -> {Maybe.bind(&2, A, B, m, f) == Some{x}: Maybe<&2, B>} -> P:
  match m:
    case None{}:
      e => Empty.absurd(P, Shared.Maybe.none_ne_some(B, x, e))
    case Some{+a}:
      e => k(a)({==})(e)

# a map that gives x: m holds a value a, and f gives x of a
def Maybe.map_cases(
  -A: Data,
  -B: Data,
  m: Maybe<&2, A>,
  -f: A -> B,
  -x: B,
  -P: Type,
  k: @a: A -> {m == Some{a}: Maybe<&2, A>} -> {f(a) == x: B} -> P
) -> {Maybe.map(&2, A, B, f, m) == Some{x}: Maybe<&2, B>} -> P:
  match m:
    case None{}:
      e => Empty.absurd(P, Shared.Maybe.none_ne_some(B, x, e))
    case Some{+a}:
      e => k(a)({==})(Shared.Maybe.some_inj(B, f(a), x, e))

# a Shared.Maybe.when that gives x: its test holds, and its body gives x
def Maybe.when_cases(
  -B: Data,
  b: Bool,
  -g: Unit -> Maybe<&2, B>,
  -x: B,
  -P: Type,
  k: {b == True{}: Bool} -> {g(Unit{}) == Some{x}: Maybe<&2, B>} -> P
) -> {Shared.Maybe.when(B, b, g) == Some{x}: Maybe<&2, B>} -> P:
  match b:
    case True{}:
      e => k({==})(e)
    case False{}:
      e => Empty.absurd(P, Shared.Maybe.none_ne_some(B, x, e))

# the pieces of an opened node: of a node below up with an item, by its items
def Mst.open.node_cases(
  n: Node,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -ps: List<&2, Piece>,
  -P: Type,
  k: @l: Nat -> @left: Maybe<&2, Hashes.Hash> -> @xs: List<&2, Item> -> {n == Node{l, left, xs}: Node} -> {
    Nat.is_lt(l, up) == True{}: Bool
  } -> {List.is_empty(&2, Item, xs) == False{}: Bool} -> {
    Mst.pieces(xs, l, left, lo, hi) == Some{ps}: Maybe<&2, List<&2, Piece>>
  } -> P
) -> {Mst.open.node(n, up, lo, hi) == Some{ps}: Maybe<&2, List<&2, Piece>>} -> P:
  match n:
    case Node{+l, +left, +xs}:
      e => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs))),
        u => Mst.pieces(xs, l, left, lo, hi),
        ps,
        P,
        +c => ep => k(l)(left)(xs)({==})(
          Shared.Bool.and_true_left(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs)))(c)
        )(
          Shared.Bool.not_true(
            List.is_empty(&2, Item, xs)
          )(Shared.Bool.and_true_right(Nat.is_lt(l, up), Bool.not(List.is_empty(&2, Item, xs)))(c))
        )(ep)
      )(e)

# the keys of the items of a node that gives pieces fit its bounds
def Mst.pieces_fit(
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -ps: List<&2, Piece>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ps}: Maybe<&2, List<&2, Piece>>} -> {Items.fit(xs, lo, hi) == True{}: Bool}:
  match xs:
    case Nil{}:
      e => {==}
    case Con{Item{+k, +v, +r}, +rest}:
      e => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(k), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, k)))),
          Bool.and(Bound.after(lo, k), Bound.before(k, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{k}, Piece.Bind{k, v} <> ps2),
          Mst.pieces(rest, l, r, Some{k}, hi)
        ),
        ps,
        {Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Items.fit(rest, Some{k}, hi)) == True{}: Bool},
        c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{k}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{k}, Piece.Bind{k, v} <> ps2),
          ps,
          {Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Items.fit(rest, Some{k}, hi)) == True{}: Bool},
          ps2 => e3 => e4 => Shared.Bool.and_both(
            Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
            Items.fit(rest, Some{k}, hi)
          )(
            Shared.Bool.and_true_right(
              Bool.and(Nat.is_eq(Key.level(k), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, k)))),
              Bool.and(Bound.after(lo, k), Bound.before(k, hi))
            )(c)
          )(Mst.pieces_fit(rest, l, r, Some{k}, hi, ps2)(e3))
        )(e2)
      )(e)

# the node that a depot holds, once its words read whole as a node that may
# sit in the room of up, lo and hi
def Mst.node.in_of(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ws: List<&2, U32>,
  +l: Nat,
  +left: Maybe<&2, Hashes.Hash>,
  +xs: List<&2, Item>,
  ew: {fetch(s)(h) == Some{ws}: Maybe<&2, List<&2, U32>>},
  er: {Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws) == Some{Node{l, left, xs}}: Maybe<&2, Node>},
  elt: {Nat.is_lt(l, up) == True{}: Bool},
  ee: {List.is_empty(&2, Item, xs) == False{}: Bool},
  ef: {Items.fit(xs, lo, hi) == True{}: Bool}
) -> {Mst.node.in(~S, ~fetch, s, h, Room{up, lo, hi}) == Some{Node{l, left, xs}}: Maybe<&2, Node>}:
  %Equal.sym(Maybe<&2, List<&2, U32>>, fetch(s)(h), Some{ws}, ew): {
    Maybe.bind(&2, Node, Node, Codes.Code.whole.of(~Node, ~Node.code, ~Node.code.read, _), n => Node.in(n, Room{up, lo, hi}))
      == Some{Node{l, left, xs}}: Maybe<&2, Node>
  }
  %Equal.sym(Maybe<&2, Node>, Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws), Some{Node{l, left, xs}}, er): {
    Maybe.bind(&2, Node, Node, _, n => Node.in(n, Room{up, lo, hi})) == Some{Node{l, left, xs}}: Maybe<&2, Node>
  }
  %Equal.sym(Bool, Nat.is_lt(l, up), True{}, elt): {
    Shared.Maybe.when(
      Node,
      Bool.and(Bool.and(_, Bool.not(List.is_empty(&2, Item, xs))), Items.fit(xs, lo, hi)),
      u => Some{Node{l, left, xs}}
    ) == Some{Node{l, left, xs}}: Maybe<&2, Node>
  }
  %Equal.sym(Bool, List.is_empty(&2, Item, xs), False{}, ee): {
    Shared.Maybe.when(Node, Bool.and(Bool.and(True{}, Bool.not(_)), Items.fit(xs, lo, hi)), u => Some{Node{l, left, xs}})
      == Some{Node{l, left, xs}}: Maybe<&2, Node>
  }
  %Equal.sym(Bool, Items.fit(xs, lo, hi), True{}, ef): {
    Shared.Maybe.when(Node, Bool.and(Bool.and(True{}, Bool.not(False{})), _), u => Some{Node{l, left, xs}})
      == Some{Node{l, left, xs}}: Maybe<&2, Node>
  }
  {==}

# what an opened node is: the depot holds its code under its hash, a read
# finds it in its room, and its items give the pieces
def Mst.open_cases(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -ps: List<&2, Piece>,
  -P: Type,
  k: @l: Nat -> @left: Maybe<&2, Hashes.Hash> -> @xs: List<&2, Item> -> {
    fetch(s)(h) == Some{Node.code(Node{l, left, xs}, [])}: Maybe<&2, List<&2, U32>>
  } -> {Hashes.Sha.hash(Node.code(Node{l, left, xs}, [])) == h: Hashes.Hash} -> {
    Mst.node.in(~S, ~fetch, s, h, Room{up, lo, hi}) == Some{Node{l, left, xs}}: Maybe<&2, Node>
  } -> {Nat.is_lt(l, up) == True{}: Bool} -> {List.is_empty(&2, Item, xs) == False{}: Bool} -> {
    Mst.pieces(xs, l, left, lo, hi) == Some{ps}: Maybe<&2, List<&2, Piece>>
  } -> P
) -> {Mst.open(~S, ~fetch, s, h, up, lo, hi) == Some{ps}: Maybe<&2, List<&2, Piece>>} -> P:
  e => Maybe.bind_cases(
    List<&2, U32>,
    List<&2, Piece>,
    fetch(s)(h),
    +ws => Shared.Maybe.when(
      List<&2, Piece>,
      Hashes.Hash.is_eq(Hashes.Sha.hash(ws), h),
      u => Maybe.bind(
        &2,
        Node,
        List<&2, Piece>,
        Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
        n => Mst.open.node(n, up, lo, hi)
      )
    ),
    ps,
    P,
    +ws => +ew => e1 => Maybe.when_cases(
      List<&2, Piece>,
      Hashes.Hash.is_eq(Hashes.Sha.hash(ws), h),
      u => Maybe.bind(
        &2,
        Node,
        List<&2, Piece>,
        Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
        n => Mst.open.node(n, up, lo, hi)
      ),
      ps,
      P,
      +eh => e2 => Maybe.bind_cases(
        Node,
        List<&2, Piece>,
        Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
        n => Mst.open.node(n, up, lo, hi),
        ps,
        P,
        +n => +er => e3 => Mst.open.node_cases(
          n,
          up,
          lo,
          hi,
          ps,
          P,
          +l => +left => +xs => +en => +elt => +ee => +ep =>
            +er2 = Equal.trans(
              Maybe<&2, Node>,
              Codes.Code.whole.read(~Node, ~Node.code, ~Node.code.read, ws),
              Some{n},
              Some{Node{l, left, xs}},
              er,
              Equal.cong(Node, Maybe<&2, Node>, x => Some{x}, n, Node{l, left, xs}, en)
            )
            +w = Equal.sym(
              List<&2, U32>,
              Node.code(Node{l, left, xs}, []),
              ws,
              Codes.Code.whole_back(~Node, ~Node.code, ~Node.code.read, ws, Node{l, left, xs})(er2)
            )
            k(l)(left)(xs)(
              Equal.trans(
                Maybe<&2, List<&2, U32>>,
                fetch(s)(h),
                Some{ws},
                Some{Node.code(Node{l, left, xs}, [])},
                ew,
                Equal.cong(List<&2, U32>, Maybe<&2, List<&2, U32>>, x => Some{x}, ws, Node.code(Node{l, left, xs}, []), w)
              )
            )(
              Equal.trans(
                Hashes.Hash,
                Hashes.Sha.hash(Node.code(Node{l, left, xs}, [])),
                Hashes.Sha.hash(ws),
                h,
                Equal.cong(
                  List<&2, U32>,
                  Hashes.Hash,
                  x => Hashes.Sha.hash(x),
                  Node.code(Node{l, left, xs}, []),
                  ws,
                  Equal.sym(List<&2, U32>, ws, Node.code(Node{l, left, xs}, []), w)
                ),
                Hashes.Hash.is_eq_sound(Hashes.Sha.hash(ws), h)(eh)
              )
            )(Mst.node.in_of(~S, ~fetch, s, h, up, lo, hi, ws, l, left, xs, ew, er2, elt, ee, Mst.pieces_fit(xs, l, left, lo, hi, ps)(ep)))(elt)(ee)(ep)
        )(e3)
      )(e2)
    )(e1)
  )(e)

# Listings
# --------

# the read l found the value v
def Look.has(l: Look, v: List<&2, U32>) -> Bool:
  Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Look.value(l), Some{v})

# the pieces ps hold the key k bound to v, as reads f levels down find it: as
# a binding, or in a subtree whose bounds hold k
def Pieces.has(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +k: List<&2, U32>,
  +v: List<&2, U32>
) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{Piece.Bind{k2, v2}, rest}:
      Bool.or(Binding.is_eq(Binding{k2, v2}, Binding{k, v}), Pieces.has(~S, ~fetch, f, s, rest, k, v))
    case Con{Piece.Sub{h, up, +lo, +hi}, rest}:
      Bool.or(
        Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{up, lo, hi}, Some{h}, k), v)),
        Pieces.has(~S, ~fetch, f, s, rest, k, v)
      )

# the pieces of a subtree m hold k bound to v when its bounds hold k and a
# read of m finds v
def Pieces.has_at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +k: List<&2, U32>,
  +v: List<&2, U32>
) -> {
  Pieces.has(~S, ~fetch, f, s, Piece.sub(m, l, lo, hi, rest), k, v)
    == Bool.or(
      Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, m, k), v)),
      Pieces.has(~S, ~fetch, f, s, rest, k, v)
    ): Bool
}:
  match m:
    case None{}:
      %Equal.sym(Look, Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, None{}, k), Look.Absent{}, Mst.look_none(~S, ~fetch, f, s, Room{l, lo, hi}, k)): {
        Pieces.has(~S, ~fetch, f, s, rest, k, v)
          == Bool.or(Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(_, v)), Pieces.has(~S, ~fetch, f, s, rest, k, v)): Bool
      }
      %Equal.sym(
        Bool,
        Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), False{}),
        False{},
        Shared.Bool.and_false_right(Bool.and(Bound.after(lo, k), Bound.before(k, hi)))
      ): {Pieces.has(~S, ~fetch, f, s, rest, k, v) == Bool.or(_, Pieces.has(~S, ~fetch, f, s, rest, k, v)): Bool}
      {==}
    case Some{h}:
      {==}

# Mst.has_pick where k comes before the key of the item: the subtree before
# it decides
def Mst.has_pick.lt(
  b: Bool,
  l1: Bool,
  l2: Bool,
  e: Bool,
  a: Bool,
  -v: Bool,
  x: Bool,
  -y: Bool,
  eb: {b == True{}: Bool},
  el1: {l1 == True{}: Bool},
  el2: {l2 == False{}: Bool},
  ee: {e == False{}: Bool}
) -> {
  Bool.or(Bool.and(Bool.and(a, l1), x), Bool.or(List.all.if(u => v, e), Bool.and(Bool.and(l2, b), y)))
    == Bool.and(Bool.and(a, b), x): Bool
}:
  match b l1 l2 e:
    case True{} True{} False{} False{}:
      Equal.sym(Bool, Bool.and(Bool.and(a, True{}), x), Bool.or(Bool.and(Bool.and(a, True{}), x), False{}), Shared.Bool.or_false(Bool.and(Bool.and(a, True{}), x)))
    case False{} w1 w2 w3:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(a, w1), x), Bool.or(List.all.if(u => v, w3), Bool.and(Bool.and(w2, False{}), y)))
            == Bool.and(Bool.and(a, False{}), x): Bool
        },
        Shared.Bool.false_ne_true(eb)
      )
    case True{} False{} w2 w3:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(a, False{}), x), Bool.or(List.all.if(u => v, w3), Bool.and(Bool.and(w2, True{}), y)))
            == Bool.and(Bool.and(a, True{}), x): Bool
        },
        Shared.Bool.false_ne_true(el1)
      )
    case True{} True{} True{} w3:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(a, True{}), x), Bool.or(List.all.if(u => v, w3), Bool.and(Bool.and(True{}, True{}), y)))
            == Bool.and(Bool.and(a, True{}), x): Bool
        },
        Shared.Bool.true_ne_false(el2)
      )
    case True{} True{} False{} True{}:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(a, True{}), x), Bool.or(List.all.if(u => v, True{}), Bool.and(Bool.and(False{}, True{}), y)))
            == Bool.and(Bool.and(a, True{}), x): Bool
        },
        Shared.Bool.true_ne_false(ee)
      )

# Mst.has_pick where k is the key of the item: its value decides
def Mst.has_pick.eq(
  a: Bool,
  b: Bool,
  l1: Bool,
  l2: Bool,
  e: Bool,
  w: Bool,
  -x: Bool,
  -y: Bool,
  +h: Hashes.Hash,
  +iv: List<&2, U32>,
  +v: List<&2, U32>,
  ea: {a == True{}: Bool},
  eb: {b == True{}: Bool},
  el1: {l1 == False{}: Bool},
  el2: {l2 == False{}: Bool},
  ee: {e == True{}: Bool},
  ew: {w == True{}: Bool}
) -> {
  Bool.or(
    Bool.and(Bool.and(a, l1), x),
    Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), e), Bool.and(Bool.and(l2, b), y))
  )
    == Bool.and(Bool.and(a, b), Look.has(Shared.Bool.when(Look, w, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
}:
  match a b l1 l2 e w:
    case True{} True{} False{} False{} True{} True{}:
      Equal.sym(
        Bool,
        Shared.List.is_eq(~U32, ~U32.is_eq, iv, v),
        Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), False{}),
        Shared.Bool.or_false(Shared.List.is_eq(~U32, ~U32.is_eq, iv, v))
      )
    case False{} w1 w2 w3 w4 w5:
      Empty.absurd(
        {
          Bool.or(
            Bool.and(Bool.and(False{}, w2), x),
            Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), w4), Bool.and(Bool.and(w3, w1), y))
          )
            == Bool.and(Bool.and(False{}, w1), Look.has(Shared.Bool.when(Look, w5, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
        },
        Shared.Bool.false_ne_true(ea)
      )
    case True{} False{} w2 w3 w4 w5:
      Empty.absurd(
        {
          Bool.or(
            Bool.and(Bool.and(True{}, w2), x),
            Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), w4), Bool.and(Bool.and(w3, False{}), y))
          )
            == Bool.and(Bool.and(True{}, False{}), Look.has(Shared.Bool.when(Look, w5, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
        },
        Shared.Bool.false_ne_true(eb)
      )
    case True{} True{} True{} w3 w4 w5:
      Empty.absurd(
        {
          Bool.or(
            Bool.and(Bool.and(True{}, True{}), x),
            Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), w4), Bool.and(Bool.and(w3, True{}), y))
          )
            == Bool.and(Bool.and(True{}, True{}), Look.has(Shared.Bool.when(Look, w5, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
        },
        Shared.Bool.true_ne_false(el1)
      )
    case True{} True{} False{} True{} w4 w5:
      Empty.absurd(
        {
          Bool.or(
            Bool.and(Bool.and(True{}, False{}), x),
            Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), w4), Bool.and(Bool.and(True{}, True{}), y))
          )
            == Bool.and(Bool.and(True{}, True{}), Look.has(Shared.Bool.when(Look, w5, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
        },
        Shared.Bool.true_ne_false(el2)
      )
    case True{} True{} False{} False{} False{} w5:
      Empty.absurd(
        {
          Bool.or(
            Bool.and(Bool.and(True{}, False{}), x),
            Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), False{}), Bool.and(Bool.and(False{}, True{}), y))
          )
            == Bool.and(Bool.and(True{}, True{}), Look.has(Shared.Bool.when(Look, w5, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
        },
        Shared.Bool.false_ne_true(ee)
      )
    case True{} True{} False{} False{} True{} False{}:
      Empty.absurd(
        {
          Bool.or(
            Bool.and(Bool.and(True{}, False{}), x),
            Bool.or(List.all.if(u => Shared.List.is_eq(~U32, ~U32.is_eq, iv, v), True{}), Bool.and(Bool.and(False{}, True{}), y))
          )
            == Bool.and(Bool.and(True{}, True{}), Look.has(Shared.Bool.when(Look, False{}, u => Look.Found{iv}, u => Look.Missing{h}), v)): Bool
        },
        Shared.Bool.false_ne_true(ew)
      )

# Mst.has_pick where k comes after the key of the item: the items after it
# decide
def Mst.has_pick.gt(
  a: Bool,
  l1: Bool,
  l2: Bool,
  e: Bool,
  -b: Bool,
  -v: Bool,
  -x: Bool,
  -y: Bool,
  ea: {a == True{}: Bool},
  el1: {l1 == False{}: Bool},
  el2: {l2 == True{}: Bool},
  ee: {e == False{}: Bool}
) -> {
  Bool.or(Bool.and(Bool.and(a, l1), x), Bool.or(List.all.if(u => v, e), Bool.and(Bool.and(l2, b), y)))
    == Bool.and(Bool.and(a, b), y): Bool
}:
  match a l1 l2 e:
    case True{} False{} True{} False{}:
      {==}
    case False{} w1 w2 w3:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(False{}, w1), x), Bool.or(List.all.if(u => v, w3), Bool.and(Bool.and(w2, b), y)))
            == Bool.and(Bool.and(False{}, b), y): Bool
        },
        Shared.Bool.false_ne_true(ea)
      )
    case True{} True{} w2 w3:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(True{}, True{}), x), Bool.or(List.all.if(u => v, w3), Bool.and(Bool.and(w2, b), y)))
            == Bool.and(Bool.and(True{}, b), y): Bool
        },
        Shared.Bool.true_ne_false(el1)
      )
    case True{} False{} False{} w3:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(True{}, False{}), x), Bool.or(List.all.if(u => v, w3), Bool.and(Bool.and(False{}, b), y)))
            == Bool.and(Bool.and(True{}, b), y): Bool
        },
        Shared.Bool.false_ne_true(el2)
      )
    case True{} False{} True{} True{}:
      Empty.absurd(
        {
          Bool.or(Bool.and(Bool.and(True{}, False{}), x), Bool.or(List.all.if(u => v, True{}), Bool.and(Bool.and(True{}, b), y)))
            == Bool.and(Bool.and(True{}, b), y): Bool
        },
        Shared.Bool.true_ne_false(ee)
      )

# Mst.has_pick at an item of the key ik, whose comparison with k is c
def Mst.has_pick.con(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  +ec: {Key.cmp(k, ik) == c: Cmp},
  ea: {Bound.after(lo, ik) == True{}: Bool},
  eb: {Bound.before(ik, hi) == True{}: Bool},
  ew: {Nat.is_eq(Key.level(ik), l) == True{}: Bool}
) -> {
  Bool.or(
    Bool.and(Bool.and(Bound.after(lo, k), Key.is_lt(k, ik)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, Some{ik}}, prev, k), v)),
    Bool.or(
      Binding.is_eq(Binding{ik, iv}, Binding{k, v}),
      Bool.and(
        Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)),
        Look.has(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)), v)
      )
    )
  )
    == Bool.and(
      Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
      Look.has(
        Mst.look.pick(
          Shared.Bool.when(
            Pick,
            Cmp.is_lt(c),
            u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
            u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k))
          ),
          h,
          l,
          k,
          m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)
        ),
        v
      )
    ): Bool
}:
  match c:
    case LT{}:
      +l1 = Key.lt_of(k, ik, LT{})(ec)
      Mst.has_pick.lt(
        Bound.before(k, hi),
        Key.is_lt(k, ik),
        Key.is_lt(ik, k),
        Shared.List.is_eq(~U32, ~U32.is_eq, ik, k),
        Bound.after(lo, k),
        Shared.List.is_eq(~U32, ~U32.is_eq, iv, v),
        Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, Some{ik}}, prev, k), v),
        Look.has(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)), v),
        Bound.before_trans(k, ik, hi)(l1)(eb),
        l1,
        Key.gt_of(k, ik, LT{})(ec),
        Key.eq_of(k, ik, LT{})(ec)
      )
    case EQ{}:
      +ke = Key.cmp_eq(k, ik)(ec)
      Mst.has_pick.eq(
        Bound.after(lo, k),
        Bound.before(k, hi),
        Key.is_lt(k, ik),
        Key.is_lt(ik, k),
        Shared.List.is_eq(~U32, ~U32.is_eq, ik, k),
        Nat.is_eq(Key.level(k), l),
        Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, Some{ik}}, prev, k), v),
        Look.has(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)), v),
        h,
        iv,
        v,
        Equal.trans(Bool, Bound.after(lo, k), Bound.after(lo, ik), True{}, Equal.cong(List<&2, U32>, Bool, x => Bound.after(lo, x), k, ik, ke), ea),
        Equal.trans(Bool, Bound.before(k, hi), Bound.before(ik, hi), True{}, Equal.cong(List<&2, U32>, Bool, x => Bound.before(x, hi), k, ik, ke), eb),
        Key.lt_of(k, ik, EQ{})(ec),
        Key.gt_of(k, ik, EQ{})(ec),
        Key.eq_of(k, ik, EQ{})(ec),
        Equal.trans(
          Bool,
          Nat.is_eq(Key.level(k), l),
          Nat.is_eq(Key.level(ik), l),
          True{},
          Equal.cong(List<&2, U32>, Bool, x => Nat.is_eq(Key.level(x), l), k, ik, ke),
          ew
        )
      )
    case GT{}:
      +l2 = Key.gt_of(k, ik, GT{})(ec)
      Mst.has_pick.gt(
        Bound.after(lo, k),
        Key.is_lt(k, ik),
        Key.is_lt(ik, k),
        Shared.List.is_eq(~U32, ~U32.is_eq, ik, k),
        Bound.before(k, hi),
        Shared.List.is_eq(~U32, ~U32.is_eq, iv, v),
        Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, Some{ik}}, prev, k), v),
        Look.has(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)), v),
        Bound.after_trans(lo, ik, k)(ea)(l2),
        Key.lt_of(k, ik, GT{})(ec),
        l2,
        Key.eq_of(k, ik, GT{})(ec)
      )

# the pieces of the items xs of the node of the hash h hold k bound to v
# exactly when k is in their bounds and a read of k in the node finds v
def Mst.has_pick(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -ks: List<&2, Piece>,
  +k: List<&2, U32>,
  +v: List<&2, U32>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Pieces.has(~S, ~fetch, f, s, ks, k, v)
    == Bool.and(
      Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
      Look.has(Mst.look.pick(Mst.pick(xs, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)), v)
    ): Bool
}:
  match xs:
    case Nil{}:
      e =>
        %Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, e): {
          Pieces.has(~S, ~fetch, f, s, _, k, v)
            == Bool.and(
              Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
              Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k), v)
            ): Bool
        }
        %Equal.sym(
          Bool,
          Pieces.has(~S, ~fetch, f, s, Piece.sub(prev, l, lo, hi, []), k, v),
          Bool.or(
            Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k), v)),
            False{}
          ),
          Pieces.has_at(~S, ~fetch, f, s, prev, l, lo, hi, [], k, v)
        ): {
          _
            == Bool.and(
              Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
              Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k), v)
            ): Bool
        }
        Equal.sym(
          Bool,
          Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k), v)),
          Bool.or(
            Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k), v)),
            False{}
          ),
          Shared.Bool.or_false(
            Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k), v))
          )
        )
    case Con{Item{+ik, +iv, +r}, +rest}:
      e => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
          Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          Mst.pieces(rest, l, r, Some{ik}, hi)
        ),
        ks,
        {
          Pieces.has(~S, ~fetch, f, s, ks, k, v)
            == Bool.and(
              Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
              Look.has(
                Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)),
                v
              )
            ): Bool
        },
        +c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{ik}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          ks,
          {
            Pieces.has(~S, ~fetch, f, s, ks, k, v)
              == Bool.and(
                Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                Look.has(
                  Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)),
                  v
                )
              ): Bool
          },
          +ks2 => e3 => e4 =>
            +c1 = Shared.Bool.and_true_left(
              Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
              Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
            )(c)
            +c2 = Shared.Bool.and_true_right(
              Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
              Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
            )(c)
            %e4: {
              Pieces.has(~S, ~fetch, f, s, _, k, v)
                == Bool.and(
                  Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                  Look.has(
                    Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)),
                    v
                  )
                ): Bool
            }
            %Equal.sym(
              Bool,
              Pieces.has(~S, ~fetch, f, s, Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), k, v),
              Bool.or(
                Bool.and(Bool.and(Bound.after(lo, k), Key.is_lt(k, ik)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, Some{ik}}, prev, k), v)),
                Pieces.has(~S, ~fetch, f, s, Piece.Bind{ik, iv} <> ks2, k, v)
              ),
              Pieces.has_at(~S, ~fetch, f, s, prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2, k, v)
            ): {
              _
                == Bool.and(
                  Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                  Look.has(
                    Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)),
                    v
                  )
                ): Bool
            }
            %Equal.sym(
              Bool,
              Pieces.has(~S, ~fetch, f, s, ks2, k, v),
              Bool.and(
                Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)),
                Look.has(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)), v)
              ),
              Mst.has_pick(~S, ~fetch, f, s, h, rest, l, r, Some{ik}, hi, ks2, k, v)(e3)
            ): {
              Bool.or(
                Bool.and(Bool.and(Bound.after(lo, k), Key.is_lt(k, ik)), Look.has(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, Some{ik}}, prev, k), v)),
                Bool.or(Binding.is_eq(Binding{ik, iv}, Binding{k, v}), _)
              )
                == Bool.and(
                  Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                  Look.has(
                    Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)),
                    v
                  )
                ): Bool
            }
            Mst.has_pick.con(
              ~S,
              ~fetch,
              Key.cmp(k, ik),
              f,
              s,
              h,
              ik,
              iv,
              r,
              rest,
              l,
              prev,
              lo,
              hi,
              k,
              v,
              {==},
              Shared.Bool.and_true_left(Bound.after(lo, ik), Bound.before(ik, hi))(c2),
              Shared.Bool.and_true_right(Bound.after(lo, ik), Bound.before(ik, hi))(c2),
              Shared.Bool.and_true_left(
                Nat.is_eq(Key.level(ik), l),
                Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))
              )(c1)
            )
        )(e2)
      )(e)

# the pieces of an opened node hold k bound to v exactly when k is in its
# bounds and a read of its subtree finds v
def Mst.has_open(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -ks: List<&2, Piece>,
  +k: List<&2, U32>,
  +v: List<&2, U32>
) -> {Mst.open(~S, ~fetch, s, h, up, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Pieces.has(~S, ~fetch, q, s, ks, k, v)
    == Bool.and(
      Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
      Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
    ): Bool
}:
  e => Mst.open_cases(
    ~S,
    ~fetch,
    s,
    h,
    up,
    lo,
    hi,
    ks,
    {
      Pieces.has(~S, ~fetch, q, s, ks, k, v)
        == Bool.and(
          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
          Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
        ): Bool
    },
    +l => +left => +xs => ef => eh => en => elt => ee0 => ep =>
      %Equal.sym(Maybe<&2, Node>, Mst.node.in(~S, ~fetch, s, h, Room{up, lo, hi}), Some{Node{l, left, xs}}, en): {
        Pieces.has(~S, ~fetch, q, s, ks, k, v)
          == Bool.and(
            Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
            Look.has(Mst.look.at(h, _, Room{up, lo, hi}, k, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k)), v)
          ): Bool
      }
      Mst.has_pick(~S, ~fetch, q, s, h, xs, l, left, lo, hi, ks, k, v)(ep)
  )(e)

# an or of two ands with one first side is the and of it with the or
def Bool.and_or_left(a: Bool, -b: Bool, -c: Bool) -> {Bool.or(Bool.and(a, b), Bool.and(a, c)) == Bool.and(a, Bool.or(b, c)): Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

# an and whose first side is False is False
def Bool.and_false_left(a: Bool, -b: Bool) -> {a == False{}: Bool} -> {Bool.and(a, b) == False{}: Bool}:
  match a:
    case False{}:
      e => {==}
    case True{}:
      e => Empty.absurd({b == False{}: Bool}, Shared.Bool.true_ne_false(e))

# a listing of a binding of k2 then of bs2 holds k bound to v as its pieces
# do, when bs2 does (ih)
def Mst.lists_bind(
  +p: List<&2, U32>,
  +k2: List<&2, U32>,
  +v2: List<&2, U32>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  -bs2: List<&2, Binding>,
  t: Bool,
  be: Bool,
  -hr: Bool,
  et: {Key.leads(p, k2) == t: Bool},
  +ebe: {Binding.is_eq(Binding{k2, v2}, Binding{k, v}) == be: Bool},
  ih: {List.contains(~Binding, ~Binding.is_eq, bs2, Binding{k, v}) == Bool.and(Key.leads(p, k), hr): Bool}
) -> {
  List.contains(~Binding, ~Binding.is_eq, Shared.Bool.when(List<&2, Binding>, t, u => Binding{k2, v2} <> bs2, u => bs2), Binding{k, v})
    == Bool.and(Key.leads(p, k), Bool.or(be, hr)): Bool
}:
  match t be:
    case True{} True{}:
      +keq = Shared.List.is_eq_sound(
        ~U32,
        ~U32.is_eq,
        ~Shared.U32.laws(),
        k2,
        k
      )(
        Shared.List.all.if_hit(
          Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
          u => Shared.List.is_eq(~U32, ~U32.is_eq, v2, v)
        )(ebe)
      )
      %Equal.sym(Bool, Binding.is_eq(Binding{k2, v2}, Binding{k, v}), True{}, ebe): {
        List.any.if(u => List.contains(~Binding, ~Binding.is_eq, bs2, Binding{k, v}), _) == Bool.and(Key.leads(p, k), True{}): Bool
      }
      %Equal.sym(
        Bool,
        Key.leads(p, k),
        True{},
        Equal.trans(
          Bool,
          Key.leads(p, k),
          Key.leads(p, k2),
          True{},
          Equal.cong(List<&2, U32>, Bool, x => Key.leads(p, x), k, k2, Equal.sym(List<&2, U32>, k2, k, keq)),
          et
        )
      ): {True{} == Bool.and(_, True{}): Bool}
      {==}
    case True{} False{}:
      %Equal.sym(Bool, Binding.is_eq(Binding{k2, v2}, Binding{k, v}), False{}, ebe): {
        List.any.if(u => List.contains(~Binding, ~Binding.is_eq, bs2, Binding{k, v}), _) == Bool.and(Key.leads(p, k), hr): Bool
      }
      ih
    case False{} True{}:
      +keq = Shared.List.is_eq_sound(
        ~U32,
        ~U32.is_eq,
        ~Shared.U32.laws(),
        k2,
        k
      )(
        Shared.List.all.if_hit(
          Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
          u => Shared.List.is_eq(~U32, ~U32.is_eq, v2, v)
        )(ebe)
      )
      +lkf = Equal.trans(
        Bool,
        Key.leads(p, k),
        Key.leads(p, k2),
        False{},
        Equal.cong(List<&2, U32>, Bool, x => Key.leads(p, x), k, k2, Equal.sym(List<&2, U32>, k2, k, keq)),
        et
      )
      %Equal.sym(Bool, Key.leads(p, k), False{}, lkf): {
        List.contains(~Binding, ~Binding.is_eq, bs2, Binding{k, v}) == Bool.and(_, True{}): Bool
      }
      Equal.trans(
        Bool,
        List.contains(~Binding, ~Binding.is_eq, bs2, Binding{k, v}),
        Bool.and(Key.leads(p, k), hr),
        False{},
        ih,
        Bool.and_false_left(Key.leads(p, k), hr)(lkf)
      )
    case False{} False{}:
      ih

# a subtree that a listing skips holds no key under its prefix
def Mst.lists_skip(
  l: Bool,
  i: Bool,
  -z: Bool,
  -h: Bool,
  -m: Bool,
  em: {m == False{}: Bool},
  imp: {l == True{}: Bool} -> {i == True{}: Bool} -> {m == True{}: Bool}
) -> {Bool.and(l, h) == Bool.and(l, Bool.or(Bool.and(i, z), h)): Bool}:
  match l i:
    case False{} y:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      Empty.absurd(
        {Bool.and(True{}, h) == Bool.and(True{}, Bool.or(Bool.and(True{}, z), h)): Bool},
        Shared.Bool.true_ne_false(Equal.trans(Bool, True{}, m, False{}, Equal.sym(Bool, m, True{}, imp({==})({==})), em))
      )

# Mst.lists_has at a subtree, by whether the listing reads it (t)
def Mst.lists_sub(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  t: Bool,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  -bs: List<&2, Binding>,
  +k: List<&2, U32>,
  +v: List<&2, U32>,
  et: {Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)) == t: Bool},
  ihr: @-b: List<&2, Binding> -> {Mst.range.go(~S, ~fetch, 1n+q, s, p, rest) == Some{b}: Maybe<&2, List<&2, Binding>>} -> {
    List.contains(~Binding, ~Binding.is_eq, b, Binding{k, v}) == Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)): Bool
  },
  ihs: @ks: List<&2, Piece> -> @-a: List<&2, Binding> -> {
    Mst.range.go(~S, ~fetch, q, s, p, ks) == Some{a}: Maybe<&2, List<&2, Binding>>
  } -> {List.contains(~Binding, ~Binding.is_eq, a, Binding{k, v}) == Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, q, s, ks, k, v)): Bool}
) -> {
  Shared.Bool.when(
    Maybe<&2, List<&2, Binding>>,
    t,
    u => Maybe.bind(
      &2,
      List<&2, Piece>,
      List<&2, Binding>,
      Mst.open(~S, ~fetch, s, h, up, lo, hi),
      ks => Maybe.bind(
        &2,
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, q, s, p, ks),
        a => Maybe.map(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          b => List.append(&2, Binding, a, b),
          Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
        )
      )
    ),
    u => Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
  )
    == Some{bs}: Maybe<&2, List<&2, Binding>>
} -> {
  List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v})
    == Bool.and(
      Key.leads(p, k),
      Bool.or(
        Bool.and(
          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
          Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
        ),
        Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
      )
    ): Bool
}:
  match t:
    case True{}:
      e => Maybe.bind_cases(
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, up, lo, hi),
        ks => Maybe.bind(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, p, ks),
          a => Maybe.map(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            b => List.append(&2, Binding, a, b),
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
          )
        ),
        bs,
        {
          List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v})
            == Bool.and(
              Key.leads(p, k),
              Bool.or(
                Bool.and(
                  Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                  Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                ),
                Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
              )
            ): Bool
        },
        +ks => +eo => e2 => Maybe.bind_cases(
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, p, ks),
          a => Maybe.map(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            b => List.append(&2, Binding, a, b),
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
          ),
          bs,
          {
            List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v})
              == Bool.and(
                Key.leads(p, k),
                Bool.or(
                  Bool.and(
                    Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                    Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                  ),
                  Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                )
              ): Bool
          },
          +a => ea => e3 => Maybe.map_cases(
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest),
            b => List.append(&2, Binding, a, b),
            bs,
            {
              List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v})
                == Bool.and(
                  Key.leads(p, k),
                  Bool.or(
                    Bool.and(
                      Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                      Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                    ),
                    Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                  )
                ): Bool
            },
            +b => eb => e4 =>
              %e4: {
                List.contains(~Binding, ~Binding.is_eq, _, Binding{k, v})
                  == Bool.and(
                    Key.leads(p, k),
                    Bool.or(
                      Bool.and(
                        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                        Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                      ),
                      Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                    )
                  ): Bool
              }
              %Equal.sym(
                Bool,
                List.contains(~Binding, ~Binding.is_eq, List.append(&2, Binding, a, b), Binding{k, v}),
                Bool.or(List.contains(~Binding, ~Binding.is_eq, a, Binding{k, v}), List.contains(~Binding, ~Binding.is_eq, b, Binding{k, v})),
                Shared.List.contains_append(~Binding, ~Binding.is_eq, a, b, Binding{k, v})
              ): {
                _
                  == Bool.and(
                    Key.leads(p, k),
                    Bool.or(
                      Bool.and(
                        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                        Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                      ),
                      Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                    )
                  ): Bool
              }
              %Equal.sym(
                Bool,
                List.contains(~Binding, ~Binding.is_eq, a, Binding{k, v}),
                Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, q, s, ks, k, v)),
                ihs(ks)(a)(ea)
              ): {
                Bool.or(_, List.contains(~Binding, ~Binding.is_eq, b, Binding{k, v}))
                  == Bool.and(
                    Key.leads(p, k),
                    Bool.or(
                      Bool.and(
                        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                        Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                      ),
                      Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                    )
                  ): Bool
              }
              %Equal.sym(
                Bool,
                Pieces.has(~S, ~fetch, q, s, ks, k, v),
                Bool.and(
                  Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                  Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                ),
                Mst.has_open(~S, ~fetch, q, s, h, up, lo, hi, ks, k, v)(eo)
              ): {
                Bool.or(Bool.and(Key.leads(p, k), _), List.contains(~Binding, ~Binding.is_eq, b, Binding{k, v}))
                  == Bool.and(
                    Key.leads(p, k),
                    Bool.or(
                      Bool.and(
                        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                        Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                      ),
                      Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                    )
                  ): Bool
              }
              %Equal.sym(
                Bool,
                List.contains(~Binding, ~Binding.is_eq, b, Binding{k, v}),
                Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)),
                ihr(b)(eb)
              ): {
                Bool.or(
                  Bool.and(
                    Key.leads(p, k),
                    Bool.and(
                      Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                      Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                    )
                  ),
                  _
                )
                  == Bool.and(
                    Key.leads(p, k),
                    Bool.or(
                      Bool.and(
                        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                        Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                      ),
                      Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
                    )
                  ): Bool
              }
              Bool.and_or_left(
                Key.leads(p, k),
                Bool.and(
                  Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                  Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
                ),
                Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
              )
          )(e3)
        )(e2)
      )(e)
    case False{}:
      e => Equal.trans(
        Bool,
        List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v}),
        Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)),
        Bool.and(
          Key.leads(p, k),
          Bool.or(
            Bool.and(
              Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
              Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v)
            ),
            Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v)
          )
        ),
        ihr(bs)(e),
        Mst.lists_skip(
          Key.leads(p, k),
          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
          Look.has(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k), v),
          Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v),
          Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
          et,
          Bound.meets(p, k, lo, hi)
        )
      )

# a listing of the pieces ps holds k bound to v exactly when k starts with
# the prefix and the pieces hold it
def Mst.lists_has(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +p: List<&2, U32>,
  ps: List<&2, Piece>,
  -bs: List<&2, Binding>,
  +k: List<&2, U32>,
  +v: List<&2, U32>
) -> {Mst.range.go(~S, ~fetch, f, s, p, ps) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> {
  List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v}) == Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, f, s, ps, k, v)): Bool
}:
  match f ps:
    case x Nil{}:
      e =>
        %Shared.Maybe.some_inj(List<&2, Binding>, [], bs, e): {
          List.contains(~Binding, ~Binding.is_eq, _, Binding{k, v}) == Bool.and(Key.leads(p, k), False{}): Bool
        }
        Equal.sym(Bool, Bool.and(Key.leads(p, k), False{}), False{}, Shared.Bool.and_false_right(Key.leads(p, k)))
    case 0n Con{x, rest}:
      e => Empty.absurd(
        {
          List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v}) == Bool.and(Key.leads(p, k), Pieces.has(~S, ~fetch, 0n, s, x <> rest, k, v)): Bool
        },
        Shared.Maybe.none_ne_some(List<&2, Binding>, bs, e)
      )
    case 1n+(+q) Con{Piece.Bind{+k2, +v2}, +rest}:
      e => Maybe.map_cases(
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, 1n+q, s, p, rest),
        +bs2 => Shared.Bool.when(List<&2, Binding>, Key.leads(p, k2), u => Binding{k2, v2} <> bs2, u => bs2),
        bs,
        {
          List.contains(~Binding, ~Binding.is_eq, bs, Binding{k, v})
            == Bool.and(
              Key.leads(p, k),
              Bool.or(Binding.is_eq(Binding{k2, v2}, Binding{k, v}), Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v))
            ): Bool
        },
        +bs2 => e1 => e2 =>
          %e2: {
            List.contains(~Binding, ~Binding.is_eq, _, Binding{k, v})
              == Bool.and(
                Key.leads(p, k),
                Bool.or(Binding.is_eq(Binding{k2, v2}, Binding{k, v}), Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v))
              ): Bool
          }
          Mst.lists_bind(
            p,
            k2,
            v2,
            k,
            v,
            bs2,
            Key.leads(p, k2),
            Binding.is_eq(Binding{k2, v2}, Binding{k, v}),
            Pieces.has(~S, ~fetch, 1n+q, s, rest, k, v),
            {==},
            {==},
            Mst.lists_has(~S, ~fetch, 1n+q, s, p, rest, bs2, k, v)(e1)
          )
      )(e)
    case 1n+(+q) Con{Piece.Sub{+h, +up, +lo, +hi}, +rest}:
      e => Mst.lists_sub(
        ~S,
        ~fetch,
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        q,
        s,
        p,
        h,
        up,
        lo,
        hi,
        rest,
        bs,
        k,
        v,
        {==},
        b => eb => Mst.lists_has(~S, ~fetch, 1n+q, s, p, rest, b, k, v)(eb),
        ks => a => ea => Mst.lists_has(~S, ~fetch, q, s, p, ks, a, k, v)(ea)
      )(e)

# the bindings bs come in the order of their keys, after lo and before hi
def Bindings.within(bs: List<&2, Binding>, lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match bs:
    case Nil{}:
      True{}
    case Con{Binding{+k, v}, rest}:
      Bool.and(Bool.and(Bound.after(lo, k), Bound.before(k, hi)), Bindings.within(rest, Some{k}, hi))

# bindings in order between two bounds are in order
def Bindings.within_sorted(bs: List<&2, Binding>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Bindings.within(bs, lo, hi) == True{}: Bool
} -> {Bindings.sorted(bs) == True{}: Bool}:
  match bs:
    case Nil{}:
      e => {==}
    case Con{a, Nil{}}:
      e => {==}
    case Con{Binding{+ka, +va}, Con{Binding{+kb, +vb}, +rest}}:
      +e =>
        +w = Shared.Bool.and_true_right(
          Bool.and(Bound.after(lo, ka), Bound.before(ka, hi)),
          Bindings.within(Binding{kb, vb} <> rest, Some{ka}, hi)
        )(e)
        Shared.List.all.if_both(
          Key.is_lt(ka, kb),
          u => Bindings.sorted(Binding{kb, vb} <> rest)
        )(
          Shared.Bool.and_true_left(
            Key.is_lt(ka, kb),
            Bound.before(kb, hi)
          )(
            Shared.Bool.and_true_left(
              Bool.and(Key.is_lt(ka, kb), Bound.before(kb, hi)),
              Bindings.within(rest, Some{kb}, hi)
            )(w)
          )
        )(Bindings.within_sorted(Binding{kb, vb} <> rest, Some{ka}, hi)(w))

# bindings after a key a are after a bound below a
def Bindings.within_weak(
  bs: List<&2, Binding>,
  +a: List<&2, U32>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Bindings.within(bs, Some{a}, hi) == True{}: Bool} -> {Bound.after(lo, a) == True{}: Bool} -> {
  Bindings.within(bs, lo, hi) == True{}: Bool
}:
  match bs:
    case Nil{}:
      e => g => {==}
    case Con{Binding{+k, +v}, +rest}:
      +e => g =>
        +x = Shared.Bool.and_true_left(Bool.and(Key.is_lt(a, k), Bound.before(k, hi)), Bindings.within(rest, Some{k}, hi))(e)
        Shared.Bool.and_both(
          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
          Bindings.within(rest, Some{k}, hi)
        )(
          Shared.Bool.and_both(
            Bound.after(lo, k),
            Bound.before(k, hi)
          )(Bound.after_trans(lo, a, k)(g)(Shared.Bool.and_true_left(Key.is_lt(a, k), Bound.before(k, hi))(x)))(
            Shared.Bool.and_true_right(Key.is_lt(a, k), Bound.before(k, hi))(x)
          )
        )(Shared.Bool.and_true_right(Bool.and(Key.is_lt(a, k), Bound.before(k, hi)), Bindings.within(rest, Some{k}, hi))(e))

# bindings before m, the binding of m, then bindings after it, are in order
def Bindings.within_cons(
  a: List<&2, Binding>,
  +m: List<&2, U32>,
  +w: List<&2, U32>,
  +b: List<&2, Binding>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Bindings.within(a, lo, Some{m}) == True{}: Bool} -> {Bool.and(Bound.after(lo, m), Bound.before(m, hi)) == True{}: Bool} -> {
  Bindings.within(b, Some{m}, hi) == True{}: Bool
} -> {Bindings.within(List.append(&2, Binding, a, Binding{m, w} <> b), lo, hi) == True{}: Bool}:
  match a:
    case Nil{}:
      ha => hm => hb => Shared.Bool.and_both(Bool.and(Bound.after(lo, m), Bound.before(m, hi)), Bindings.within(b, Some{m}, hi))(hm)(hb)
    case Con{Binding{+k, +v}, +rest}:
      +ha => +hm => hb =>
        +x = Shared.Bool.and_true_left(Bool.and(Bound.after(lo, k), Key.is_lt(k, m)), Bindings.within(rest, Some{k}, Some{m}))(ha)
        +km = Shared.Bool.and_true_right(Bound.after(lo, k), Key.is_lt(k, m))(x)
        +mh = Shared.Bool.and_true_right(Bound.after(lo, m), Bound.before(m, hi))(hm)
        Shared.Bool.and_both(
          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
          Bindings.within(List.append(&2, Binding, rest, Binding{m, w} <> b), Some{k}, hi)
        )(
          Shared.Bool.and_both(
            Bound.after(lo, k),
            Bound.before(k, hi)
          )(Shared.Bool.and_true_left(Bound.after(lo, k), Key.is_lt(k, m))(x))(Bound.before_trans(k, m, hi)(km)(mh))
        )(
          Bindings.within_cons(
            rest,
            m,
            w,
            b,
            Some{k},
            hi
          )(Shared.Bool.and_true_right(Bool.and(Bound.after(lo, k), Key.is_lt(k, m)), Bindings.within(rest, Some{k}, Some{m}))(ha))(
            Shared.Bool.and_both(Key.is_lt(k, m), Bound.before(m, hi))(km)(mh)
          )(hb)
        )

# bindings before m, then bindings after it, are in order
def Bindings.within_cat(
  a: List<&2, Binding>,
  +m: List<&2, U32>,
  +b: List<&2, Binding>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Bindings.within(a, lo, Some{m}) == True{}: Bool} -> {Bool.and(Bound.after(lo, m), Bound.before(m, hi)) == True{}: Bool} -> {
  Bindings.within(b, Some{m}, hi) == True{}: Bool
} -> {Bindings.within(List.append(&2, Binding, a, b), lo, hi) == True{}: Bool}:
  match a:
    case Nil{}:
      ha => hm => hb => Bindings.within_weak(b, m, lo, hi)(hb)(Shared.Bool.and_true_left(Bound.after(lo, m), Bound.before(m, hi))(hm))
    case Con{Binding{+k, +v}, +rest}:
      +ha => +hm => hb =>
        +x = Shared.Bool.and_true_left(Bool.and(Bound.after(lo, k), Key.is_lt(k, m)), Bindings.within(rest, Some{k}, Some{m}))(ha)
        +km = Shared.Bool.and_true_right(Bound.after(lo, k), Key.is_lt(k, m))(x)
        +mh = Shared.Bool.and_true_right(Bound.after(lo, m), Bound.before(m, hi))(hm)
        Shared.Bool.and_both(
          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
          Bindings.within(List.append(&2, Binding, rest, b), Some{k}, hi)
        )(
          Shared.Bool.and_both(
            Bound.after(lo, k),
            Bound.before(k, hi)
          )(Shared.Bool.and_true_left(Bound.after(lo, k), Key.is_lt(k, m))(x))(Bound.before_trans(k, m, hi)(km)(mh))
        )(
          Bindings.within_cat(
            rest,
            m,
            b,
            Some{k},
            hi
          )(Shared.Bool.and_true_right(Bool.and(Bound.after(lo, k), Key.is_lt(k, m)), Bindings.within(rest, Some{k}, Some{m}))(ha))(
            Shared.Bool.and_both(Key.is_lt(k, m), Bound.before(m, hi))(km)(mh)
          )(hb)
        )

# a listing with no levels left lists nothing
def Mst.range_zero(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +p: List<&2, U32>,
  ps: List<&2, Piece>,
  -bs: List<&2, Binding>
) -> {Mst.range.go(~S, ~fetch, 0n, s, p, ps) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> {bs == []: List<&2, Binding>}:
  match ps:
    case Nil{}:
      e => Equal.sym(List<&2, Binding>, [], bs, Shared.Maybe.some_inj(List<&2, Binding>, [], bs, e))
    case Con{x, rest}:
      e => Empty.absurd({bs == []: List<&2, Binding>}, Shared.Maybe.none_ne_some(List<&2, Binding>, bs, e))

# Mst.range_sub at a subtree, by whether the listing reads it (t)
def Mst.range_sub.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  t: Bool,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +h: Hashes.Hash,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +bs: List<&2, Binding>,
  -P: Type,
  k: @a: List<&2, Binding> -> @b: List<&2, Binding> -> {List.append(&2, Binding, a, b) == bs: List<&2, Binding>} -> {
    Mst.range.go(~S, ~fetch, 1n+q, s, p, rest) == Some{b}: Maybe<&2, List<&2, Binding>>
  } -> {Bindings.within(a, lo, hi) == True{}: Bool} -> P,
  ihc: @ks: List<&2, Piece> -> @a: List<&2, Binding> -> {
    Mst.open(~S, ~fetch, s, h, l, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, q, s, p, ks) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Bindings.within(a, lo, hi) == True{}: Bool}
) -> {
  Shared.Bool.when(
    Maybe<&2, List<&2, Binding>>,
    t,
    u => Maybe.bind(
      &2,
      List<&2, Piece>,
      List<&2, Binding>,
      Mst.open(~S, ~fetch, s, h, l, lo, hi),
      ks => Maybe.bind(
        &2,
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, q, s, p, ks),
        a => Maybe.map(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          b => List.append(&2, Binding, a, b),
          Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
        )
      )
    ),
    u => Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
  )
    == Some{bs}: Maybe<&2, List<&2, Binding>>
} -> P:
  match t:
    case True{}:
      e => Maybe.bind_cases(
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, l, lo, hi),
        ks => Maybe.bind(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, p, ks),
          a => Maybe.map(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            b => List.append(&2, Binding, a, b),
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
          )
        ),
        bs,
        P,
        +ks => eo => e2 => Maybe.bind_cases(
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, p, ks),
          a => Maybe.map(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            b => List.append(&2, Binding, a, b),
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
          ),
          bs,
          P,
          +a => ea => e3 => Maybe.map_cases(
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest),
            b => List.append(&2, Binding, a, b),
            bs,
            P,
            b => eb => e4 => k(a)(b)(e4)(eb)(ihc(ks)(a)(eo)(ea))
          )(e3)
        )(e2)
      )(e)
    case False{}:
      e => k([])(bs)({==})(e)({==})

# a listing of the subtree m, then of the pieces rest, is a listing of m
# (whose bindings are in its bounds, by ihc), then one of rest
def Mst.range_sub(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  m: Maybe<&2, Hashes.Hash>,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +bs: List<&2, Binding>,
  -P: Type,
  k: @a: List<&2, Binding> -> @b: List<&2, Binding> -> {List.append(&2, Binding, a, b) == bs: List<&2, Binding>} -> {
    Mst.range.go(~S, ~fetch, 1n+q, s, p, rest) == Some{b}: Maybe<&2, List<&2, Binding>>
  } -> {Bindings.within(a, lo, hi) == True{}: Bool} -> P,
  ihc: @h: Hashes.Hash -> @ks: List<&2, Piece> -> @a: List<&2, Binding> -> {
    Mst.open(~S, ~fetch, s, h, l, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, q, s, p, ks) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Bindings.within(a, lo, hi) == True{}: Bool}
) -> {Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.sub(m, l, lo, hi, rest)) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> P:
  match m:
    case None{}:
      e => k([])(bs)({==})(e)({==})
    case Some{+h}:
      e => Mst.range_sub.at(
        ~S,
        ~fetch,
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        q,
        s,
        p,
        h,
        l,
        lo,
        hi,
        rest,
        bs,
        P,
        k,
        ks => a => ihc(h)(ks)(a)
      )(e)

# Mst.lists_within at an item of the key ik, by whether the prefix leads it (t)
def Mst.lists_within.bind(
  t: Bool,
  a: List<&2, Binding>,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +b: List<&2, Binding>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  ha: {Bindings.within(a, lo, Some{ik}) == True{}: Bool},
  hm: {Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)) == True{}: Bool},
  hb: {Bindings.within(b, Some{ik}, hi) == True{}: Bool}
) -> {
  Bindings.within(List.append(&2, Binding, a, Shared.Bool.when(List<&2, Binding>, t, u => Binding{ik, iv} <> b, u => b)), lo, hi) == True{}: Bool
}:
  match t:
    case True{}:
      Bindings.within_cons(a, ik, iv, b, lo, hi)(ha)(hm)(hb)
    case False{}:
      Bindings.within_cat(a, ik, b, lo, hi)(ha)(hm)(hb)

# a listing of the pieces of the items xs comes in order, between their bounds
def Mst.lists_within(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +p: List<&2, U32>,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +bs: List<&2, Binding>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Mst.range.go(~S, ~fetch, f, s, p, ks) == Some{bs}: Maybe<&2, List<&2, Binding>>
} -> {Bindings.within(bs, lo, hi) == True{}: Bool}:
  match f:
    case 0n:
      ep => e =>
        %Equal.sym(List<&2, Binding>, bs, [], Mst.range_zero(~S, ~fetch, s, p, ks, bs)(e)): {Bindings.within(_, lo, hi) == True{}: Bool}
        {==}
    case 1n+(+q):
      match xs:
        case Nil{}:
          ep => e => Mst.range_sub(
              ~S,
              ~fetch,
              prev,
              q,
              s,
              p,
              l,
              lo,
              hi,
              [],
              bs,
              {Bindings.within(bs, lo, hi) == True{}: Bool},
              a => b => e4 => eb => wa =>
                %e4: {Bindings.within(_, lo, hi) == True{}: Bool}
                %Shared.Maybe.some_inj(List<&2, Binding>, [], b, eb): {Bindings.within(List.append(&2, Binding, a, _), lo, hi) == True{}: Bool}
                %Equal.sym(List<&2, Binding>, List.append(&2, Binding, a, []), a, Shared.List.append_nil(Binding, a)): {
                  Bindings.within(_, lo, hi) == True{}: Bool
                }
                wa,
              h => ks2 => a => eo => ea => Mst.open_cases(
                ~S,
                ~fetch,
                s,
                h,
                l,
                lo,
                hi,
                ks2,
                {Bindings.within(a, lo, hi) == True{}: Bool},
                +l2 => +left2 => +xs2 => ef => eh => en => elt => ee0 => ep2 => Mst.lists_within(~S, ~fetch, q, s, p, xs2, l2, left2, lo, hi, ks2, a)(ep2)(ea)
              )(eo)
            )(
              Equal.trans(
                Maybe<&2, List<&2, Binding>>,
                Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.sub(prev, l, lo, hi, [])),
                Mst.range.go(~S, ~fetch, 1n+q, s, p, ks),
                Some{bs},
                Equal.cong(
                  List<&2, Piece>,
                  Maybe<&2, List<&2, Binding>>,
                  x => Mst.range.go(~S, ~fetch, 1n+q, s, p, x),
                  Piece.sub(prev, l, lo, hi, []),
                  ks,
                  Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep)
                ),
                e
              )
            )
        case Con{Item{+ik, +iv, +r}, +rest}:
          ep => e => Maybe.when_cases(
            List<&2, Piece>,
            Bool.and(
              Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
              Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
            ),
            u => Maybe.map(
              &2,
              List<&2, Piece>,
              List<&2, Piece>,
              ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
              Mst.pieces(rest, l, r, Some{ik}, hi)
            ),
            ks,
            {Bindings.within(bs, lo, hi) == True{}: Bool},
            +c => e2 => Maybe.map_cases(
              List<&2, Piece>,
              List<&2, Piece>,
              Mst.pieces(rest, l, r, Some{ik}, hi),
              ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
              ks,
              {Bindings.within(bs, lo, hi) == True{}: Bool},
              +ks2 => e3 => e4 =>
                +hm = Shared.Bool.and_true_right(
                  Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
                  Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
                )(c)
                Mst.range_sub(
                  ~S,
                  ~fetch,
                  prev,
                  q,
                  s,
                  p,
                  l,
                  lo,
                  Some{ik},
                  Piece.Bind{ik, iv} <> ks2,
                  bs,
                  {Bindings.within(bs, lo, hi) == True{}: Bool},
                  a => b => e5 => eb => wa => Maybe.map_cases(
                    List<&2, Binding>,
                    List<&2, Binding>,
                    Mst.range.go(~S, ~fetch, 1n+q, s, p, ks2),
                    +b2 => Shared.Bool.when(List<&2, Binding>, Key.leads(p, ik), u => Binding{ik, iv} <> b2, u => b2),
                    b,
                    {Bindings.within(bs, lo, hi) == True{}: Bool},
                    +b2 => eb2 => e6 =>
                      %e5: {Bindings.within(_, lo, hi) == True{}: Bool}
                      %e6: {Bindings.within(List.append(&2, Binding, a, _), lo, hi) == True{}: Bool}
                      Mst.lists_within.bind(
                        Key.leads(p, ik),
                        a,
                        ik,
                        iv,
                        b2,
                        lo,
                        hi,
                        wa,
                        hm,
                        Mst.lists_within(~S, ~fetch, 1n+q, s, p, rest, l, r, Some{ik}, hi, ks2, b2)(e3)(eb2)
                      )
                  )(eb),
                  h => ks3 => a => eo => ea => Mst.open_cases(
                    ~S,
                    ~fetch,
                    s,
                    h,
                    l,
                    lo,
                    Some{ik},
                    ks3,
                    {Bindings.within(a, lo, Some{ik}) == True{}: Bool},
                    +l2 => +left2 => +xs2 => ef => eh => en => elt => ee0 => ep2 => Mst.lists_within(~S, ~fetch, q, s, p, xs2, l2, left2, lo, Some{ik}, ks3, a)(ep2)(ea)
                  )(eo)
                )(Equal.trans(
                  Maybe<&2, List<&2, Binding>>,
                  Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2)),
                  Mst.range.go(~S, ~fetch, 1n+q, s, p, ks),
                  Some{bs},
                  Equal.cong(List<&2, Piece>, Maybe<&2, List<&2, Binding>>, x => Mst.range.go(~S, ~fetch, 1n+q, s, p, x), Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), ks, e4),
                  e
                ))
            )(e2)
          )(ep)

# a listing of a tree comes in the order of its keys
def Mst.lists_sorted(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  h: Maybe<&2, Hashes.Hash>,
  +p: List<&2, U32>,
  +bs: List<&2, Binding>
) -> {Mst.range(~S, ~fetch, s, h, p) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> {Bindings.sorted(bs) == True{}: Bool}:
  match h:
    case None{}:
      e =>
        %Shared.Maybe.some_inj(List<&2, Binding>, [], bs, e): {Bindings.sorted(_) == True{}: Bool}
        {==}
    case Some{+h2}:
      e => Mst.range_sub(
        ~S,
        ~fetch,
        Some{h2},
        63n,
        s,
        p,
        Mst.depth(),
        None{},
        None{},
        [],
        bs,
        {Bindings.sorted(bs) == True{}: Bool},
        +a => b => e4 => eb => wa =>
          %e4: {Bindings.sorted(_) == True{}: Bool}
          %Shared.Maybe.some_inj(List<&2, Binding>, [], b, eb): {Bindings.sorted(List.append(&2, Binding, a, _)) == True{}: Bool}
          %Equal.sym(List<&2, Binding>, List.append(&2, Binding, a, []), a, Shared.List.append_nil(Binding, a)): {
            Bindings.sorted(_) == True{}: Bool
          }
          Bindings.within_sorted(a, None{}, None{})(wa),
        h3 => ks => a => eo => ea => Mst.open_cases(
          ~S,
          ~fetch,
          s,
          h3,
          Mst.depth(),
          None{},
          None{},
          ks,
          {Bindings.within(a, None{}, None{}) == True{}: Bool},
          +l2 => +left2 => +xs2 => ef => eh => en => elt => ee0 => ep => Mst.lists_within(~S, ~fetch, 63n, s, p, xs2, l2, left2, None{}, None{}, ks, a)(ep)(ea)
        )(eo)
      )(e)

# the pieces of a root hold k bound to v exactly when a read of the root
# finds v
def Mst.lists_root(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  h: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>,
  +v: List<&2, U32>
) -> {Pieces.has(~S, ~fetch, Mst.depth(), s, Mst.root(h), k, v) == Look.has(Mst.look(~S, ~fetch, s, h, k), v): Bool}:
  match h:
    case None{}:
      {==}
    case Some{+h2}:
      Equal.sym(
        Bool,
        Look.has(Mst.look(~S, ~fetch, s, Some{h2}, k), v),
        Bool.or(Look.has(Mst.look(~S, ~fetch, s, Some{h2}, k), v), False{}),
        Shared.Bool.or_false(Look.has(Mst.look(~S, ~fetch, s, Some{h2}, k), v))
      )

# One shape
# ---------

# the bindings of the subtree m under the prefix p, in the room of the level
# l between lo and hi, read q levels down: none when a node does not read
def Mst.sub_list(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  q: Nat,
  +s: S,
  +p: List<&2, U32>,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> Maybe<&2, List<&2, Binding>>:
  match m:
    case None{}:
      Some{[]}
    case Some{+h}:
      Shared.Bool.when(
        Maybe<&2, List<&2, Binding>>,
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, s, h, l, lo, hi),
          ks => Mst.range.go(~S, ~fetch, q, s, p, ks)
        ),
        u => Some{[]}
      )

# the bindings of a subtree that a listing reads: those of its node's pieces
def Mst.sub_list_read(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +h: Hashes.Hash,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -ks: List<&2, Piece>,
  -a: List<&2, Binding>,
  et: {Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)) == True{}: Bool},
  eo: {Mst.open(~S, ~fetch, s, h, l, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>},
  ea: {Mst.range.go(~S, ~fetch, q, s, p, ks) == Some{a}: Maybe<&2, List<&2, Binding>>}
) -> {Mst.sub_list(~S, ~fetch, q, s, p, Some{h}, l, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>}:
  %Equal.sym(Bool, Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)), True{}, et): {
    Shared.Bool.when(
      Maybe<&2, List<&2, Binding>>,
      _,
      u => Maybe.bind(
        &2,
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, l, lo, hi),
        ks2 => Mst.range.go(~S, ~fetch, q, s, p, ks2)
      ),
      u => Some{[]}
    )
      == Some{a}: Maybe<&2, List<&2, Binding>>
  }
  %Equal.sym(Maybe<&2, List<&2, Piece>>, Mst.open(~S, ~fetch, s, h, l, lo, hi), Some{ks}, eo): {
    Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, _, ks2 => Mst.range.go(~S, ~fetch, q, s, p, ks2))
      == Some{a}: Maybe<&2, List<&2, Binding>>
  }
  ea

# a subtree that a listing skips lists nothing
def Mst.sub_list_skip(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +h: Hashes.Hash,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  et: {Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)) == False{}: Bool}
) -> {Mst.sub_list(~S, ~fetch, q, s, p, Some{h}, l, lo, hi) == Some{[]}: Maybe<&2, List<&2, Binding>>}:
  %Equal.sym(Bool, Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)), False{}, et): {
    Shared.Bool.when(
      Maybe<&2, List<&2, Binding>>,
      _,
      u => Maybe.bind(
        &2,
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, l, lo, hi),
        ks2 => Mst.range.go(~S, ~fetch, q, s, p, ks2)
      ),
      u => Some{[]}
    )
      == Some{[]}: Maybe<&2, List<&2, Binding>>
  }
  {==}

# Mst.range_list at a subtree, by whether the listing reads it (t)
def Mst.range_list.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  t: Bool,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +h: Hashes.Hash,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +bs: List<&2, Binding>,
  -P: Type,
  k: @a: List<&2, Binding> -> @b: List<&2, Binding> -> {List.append(&2, Binding, a, b) == bs: List<&2, Binding>} -> {
    Mst.range.go(~S, ~fetch, 1n+q, s, p, rest) == Some{b}: Maybe<&2, List<&2, Binding>>
  } -> {Mst.sub_list(~S, ~fetch, q, s, p, Some{h}, l, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>} -> P,
  et: {Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)) == t: Bool}
) -> {
  Shared.Bool.when(
    Maybe<&2, List<&2, Binding>>,
    t,
    u => Maybe.bind(
      &2,
      List<&2, Piece>,
      List<&2, Binding>,
      Mst.open(~S, ~fetch, s, h, l, lo, hi),
      ks => Maybe.bind(
        &2,
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, q, s, p, ks),
        a => Maybe.map(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          b => List.append(&2, Binding, a, b),
          Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
        )
      )
    ),
    u => Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
  )
    == Some{bs}: Maybe<&2, List<&2, Binding>>
} -> P:
  match t:
    case True{}:
      e => Maybe.bind_cases(
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, l, lo, hi),
        ks => Maybe.bind(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, p, ks),
          a => Maybe.map(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            b => List.append(&2, Binding, a, b),
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
          )
        ),
        bs,
        P,
        +ks => eo => e2 => Maybe.bind_cases(
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, p, ks),
          a => Maybe.map(
            &2,
            List<&2, Binding>,
            List<&2, Binding>,
            b => List.append(&2, Binding, a, b),
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
          ),
          bs,
          P,
          +a => ea => e3 => Maybe.map_cases(
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, 1n+q, s, p, rest),
            b => List.append(&2, Binding, a, b),
            bs,
            P,
            b => eb => e4 => k(a)(b)(e4)(eb)(Mst.sub_list_read(~S, ~fetch, q, s, p, h, l, lo, hi, ks, a, et, eo, ea))
          )(e3)
        )(e2)
      )(e)
    case False{}:
      e => k([])(bs)({==})(e)(Mst.sub_list_skip(~S, ~fetch, q, s, p, h, l, lo, hi, et))

# a listing of the subtree m, then of the pieces rest, is the listing of m,
# then one of rest
def Mst.range_list(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  m: Maybe<&2, Hashes.Hash>,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +bs: List<&2, Binding>,
  -P: Type,
  k: @a: List<&2, Binding> -> @b: List<&2, Binding> -> {List.append(&2, Binding, a, b) == bs: List<&2, Binding>} -> {
    Mst.range.go(~S, ~fetch, 1n+q, s, p, rest) == Some{b}: Maybe<&2, List<&2, Binding>>
  } -> {Mst.sub_list(~S, ~fetch, q, s, p, m, l, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>} -> P
) -> {Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.sub(m, l, lo, hi, rest)) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> P:
  match m:
    case None{}:
      e => k([])(bs)({==})(e)({==})
    case Some{+h}:
      e => Mst.range_list.at(
        ~S,
        ~fetch,
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        q,
        s,
        p,
        h,
        l,
        lo,
        hi,
        rest,
        bs,
        P,
        k,
        {==}
      )(e)

# a listing with no levels left has no pieces
def Mst.range_zero_nil(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +p: List<&2, U32>,
  ps: List<&2, Piece>,
  -bs: List<&2, Binding>
) -> {Mst.range.go(~S, ~fetch, 0n, s, p, ps) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> {ps == []: List<&2, Piece>}:
  match ps:
    case Nil{}:
      e => {==}
    case Con{x, rest}:
      e => Empty.absurd({x <> rest == []: List<&2, Piece>}, Shared.Maybe.none_ne_some(List<&2, Binding>, bs, e))

# a subtree, then a piece, is no empty run
def Mst.sub_ne_nil(
  m: Maybe<&2, Hashes.Hash>,
  -l: Nat,
  -lo: Maybe<&2, List<&2, U32>>,
  -hi: Maybe<&2, List<&2, U32>>,
  -x: Piece,
  -r: List<&2, Piece>
) -> {Piece.sub(m, l, lo, hi, x <> r) == []: List<&2, Piece>} -> Empty:
  match m:
    case None{}:
      e => Shared.Bool.false_ne_true(Equal.cong(List<&2, Piece>, Bool, ys => List.is_empty(&2, Piece, ys), x <> r, [], e))
    case Some{h}:
      e => Shared.Bool.false_ne_true(
        Equal.cong(List<&2, Piece>, Bool, ys => List.is_empty(&2, Piece, ys), Piece.Sub{h, l, lo, hi} <> (x <> r), [], e)
      )

# the items that give no piece: none, and no subtree before them
def Mst.pieces_empty(
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{[]}: Maybe<&2, List<&2, Piece>>} -> {Node{l, prev, xs} == Node{l, None{}, []}: Node}:
  match xs:
    case Nil{}:
      match prev:
        case None{}:
          e => {==}
        case Some{h}:
          e => Empty.absurd(
            {Node{l, Some{h}, []} == Node{l, None{}, []}: Node},
            Shared.Bool.false_ne_true(
              Equal.cong(
                List<&2, Piece>,
                Bool,
                ys => List.is_empty(&2, Piece, ys),
                [Piece.Sub{h, l, lo, hi}],
                [],
                Shared.Maybe.some_inj(List<&2, Piece>, [Piece.Sub{h, l, lo, hi}], [], e)
              )
            )
          )
    case Con{Item{+k, +v, +r}, +rest}:
      e => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(k), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, k)))),
          Bool.and(Bound.after(lo, k), Bound.before(k, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{k}, Piece.Bind{k, v} <> ps2),
          Mst.pieces(rest, l, r, Some{k}, hi)
        ),
        [],
        {Node{l, prev, Item{k, v, r} <> rest} == Node{l, None{}, []}: Node},
        c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{k}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{k}, Piece.Bind{k, v} <> ps2),
          [],
          {Node{l, prev, Item{k, v, r} <> rest} == Node{l, None{}, []}: Node},
          ks2 => e3 => e4 => Empty.absurd(
            {Node{l, prev, Item{k, v, r} <> rest} == Node{l, None{}, []}: Node},
            Mst.sub_ne_nil(prev, l, lo, Some{k}, Piece.Bind{k, v}, ks2)(e4)
          )
        )(e2)
      )(e)

# the keys of the bindings bs have levels below n
def Bindings.below(bs: List<&2, Binding>, +n: Nat) -> Bool:
  match bs:
    case Nil{}:
      True{}
    case Con{Binding{k, v}, rest}:
      Bool.and(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))

# bindings below n, then bindings below n, are below n
def Bindings.below_append(a: List<&2, Binding>, +b: List<&2, Binding>, +n: Nat) -> {Bindings.below(a, n) == True{}: Bool} -> {
  Bindings.below(b, n) == True{}: Bool
} -> {Bindings.below(List.append(&2, Binding, a, b), n) == True{}: Bool}:
  match a:
    case Nil{}:
      ha => hb => hb
    case Con{Binding{+k, +v}, +rest}:
      +ha => hb => Shared.Bool.and_both(
        Nat.is_lt(Key.level(k), n),
        Bindings.below(List.append(&2, Binding, rest, b), n)
      )(Shared.Bool.and_true_left(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))(ha))(
        Bindings.below_append(rest, b, n)(Shared.Bool.and_true_right(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))(ha))(hb)
      )

# bindings below n are below any m from n on
def Bindings.below_mono(a: List<&2, Binding>, +n: Nat, +m: Nat) -> {Bindings.below(a, n) == True{}: Bool} -> {
  Nat.is_le(n, m) == True{}: Bool
} -> {Bindings.below(a, m) == True{}: Bool}:
  match a:
    case Nil{}:
      h => g => {==}
    case Con{Binding{+k, +v}, +rest}:
      +h => +g => Shared.Bool.and_both(
        Nat.is_lt(Key.level(k), m),
        Bindings.below(rest, m)
      )(Shared.Nat.lt_le(Key.level(k), n, m)(Shared.Bool.and_true_left(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))(h))(g))(
        Bindings.below_mono(rest, n, m)(Shared.Bool.and_true_right(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))(h))(g)
      )

# the bindings b, with the binding of k first when t holds, are below n
def Bindings.below_when(t: Bool, +k: List<&2, U32>, +v: List<&2, U32>, b: List<&2, Binding>, +n: Nat) -> {
  Nat.is_lt(Key.level(k), n) == True{}: Bool
} -> {Bindings.below(b, n) == True{}: Bool} -> {
  Bindings.below(Shared.Bool.when(List<&2, Binding>, t, u => Binding{k, v} <> b, u => b), n) == True{}: Bool
}:
  match t:
    case True{}:
      hk => hb => Shared.Bool.and_both(Nat.is_lt(Key.level(k), n), Bindings.below(b, n))(hk)(hb)
    case False{}:
      hk => hb => hb

# a key of the bindings bs has the level l
def Bindings.has_level(bs: List<&2, Binding>, +l: Nat) -> Bool:
  match bs:
    case Nil{}:
      False{}
    case Con{Binding{k, v}, rest}:
      Bool.or(Nat.is_eq(Key.level(k), l), Bindings.has_level(rest, l))

# bindings that hold a key of the level l, after others, still do
def Bindings.has_level_right(a: List<&2, Binding>, +b: List<&2, Binding>, +l: Nat) -> {Bindings.has_level(b, l) == True{}: Bool} -> {
  Bindings.has_level(List.append(&2, Binding, a, b), l) == True{}: Bool
}:
  match a:
    case Nil{}:
      h => h
    case Con{Binding{+k, +v}, +rest}:
      h =>
        %Equal.sym(Bool, Bindings.has_level(List.append(&2, Binding, rest, b), l), True{}, Bindings.has_level_right(rest, b, l)(h)): {
          Bool.or(Nat.is_eq(Key.level(k), l), _) == True{}: Bool
        }
        Shared.Bool.or_true_right(Nat.is_eq(Key.level(k), l))

# Bindings.has_level_lt at a binding of k, by whether k has the level l (t)
def Bindings.has_level_lt.at(
  t: Bool,
  +k: List<&2, U32>,
  +l: Nat,
  +n: Nat,
  rest: List<&2, Binding>,
  et: {Nat.is_eq(Key.level(k), l) == t: Bool},
  ih: {Bindings.has_level(rest, l) == True{}: Bool} -> {Nat.is_lt(l, n) == True{}: Bool}
) -> {Bool.and(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n)) == True{}: Bool} -> {
  Bool.or(t, Bindings.has_level(rest, l)) == True{}: Bool
} -> {Nat.is_lt(l, n) == True{}: Bool}:
  match t:
    case True{}:
      hb => hh =>
        %Shared.Nat.is_eq_sound(Key.level(k), l)(et): {Nat.is_lt(_, n) == True{}: Bool}
        Shared.Bool.and_true_left(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))(hb)
    case False{}:
      hb => hh => ih(hh)

# a key of the level l among bindings below n has l below n
def Bindings.has_level_lt(bs: List<&2, Binding>, +l: Nat, +n: Nat) -> {Bindings.below(bs, n) == True{}: Bool} -> {
  Bindings.has_level(bs, l) == True{}: Bool
} -> {Nat.is_lt(l, n) == True{}: Bool}:
  match bs:
    case Nil{}:
      hb => hh => Empty.absurd({Nat.is_lt(l, n) == True{}: Bool}, Shared.Bool.false_ne_true(hh))
    case Con{Binding{+k, +v}, +rest}:
      +hb => hh => Bindings.has_level_lt.at(
        Nat.is_eq(Key.level(k), l),
        k,
        l,
        n,
        rest,
        {==},
        Bindings.has_level_lt(rest, l, n)(Shared.Bool.and_true_right(Nat.is_lt(Key.level(k), n), Bindings.below(rest, n))(hb))
      )(hb)(hh)

# bindings a then the empty rest b are a
def Bindings.cat_nil(+a: List<&2, Binding>, -b: List<&2, Binding>, -c: List<&2, Binding>) -> {
  Some{[]} == Some{b}: Maybe<&2, List<&2, Binding>>
} -> {List.append(&2, Binding, a, b) == c: List<&2, Binding>} -> {a == c: List<&2, Binding>}:
  eb => e => Equal.trans(
    List<&2, Binding>,
    a,
    List.append(&2, Binding, a, b),
    c,
    Equal.trans(
      List<&2, Binding>,
      a,
      List.append(&2, Binding, a, []),
      List.append(&2, Binding, a, b),
      Equal.sym(List<&2, Binding>, List.append(&2, Binding, a, []), a, Shared.List.append_nil(Binding, a)),
      Equal.cong(
        List<&2, Binding>,
        List<&2, Binding>,
        y => List.append(&2, Binding, a, y),
        [],
        b,
        Shared.Maybe.some_inj(List<&2, Binding>, [], b, eb)
      )
    ),
    e
  )

# a < b gives a + 1 <= b
def Nat.lt_le_succ(a: Nat, b: Nat) -> {Nat.is_lt(a, b) == True{}: Bool} -> {Nat.is_le(1n+a, b) == True{}: Bool}:
  match a b:
    case 0n 0n:
      h => Empty.absurd({Nat.is_le(1n, 0n) == True{}: Bool}, Shared.Bool.false_ne_true(h))
    case 0n 1n+q:
      h => Shared.Nat.le_zero(q)
    case 1n+p 0n:
      h => Empty.absurd({Nat.is_le(2n+p, 0n) == True{}: Bool}, Shared.Bool.false_ne_true(h))
    case 1n+p 1n+q:
      h => Nat.lt_le_succ(p, q)(h)

# a <= b and b <= a give a == b
def Nat.lt_succ_eq(+a: Nat, +b: Nat) -> {Nat.is_lt(a, 1n+b) == True{}: Bool} -> {Nat.is_lt(b, 1n+a) == True{}: Bool} -> {a == b: Nat}:
  h => g => Shared.Nat.is_eq_sound(
    a,
    b
  )(
    Equal.trans(
      Bool,
      Nat.is_eq(a, b),
      Bool.and(Nat.is_le(a, b), Nat.is_le(b, a)),
      True{},
      Equal.sym(Bool, Bool.and(Nat.is_le(a, b), Nat.is_le(b, a)), Nat.is_eq(a, b), Shared.Nat.le_both(a, b)),
      Shared.Bool.and_both(Nat.is_le(a, b), Nat.is_le(b, a))(Shared.Nat.lt_succ_le(a, b)(h))(Shared.Nat.lt_succ_le(b, a)(g))
    )
  )

# a key of the level l has a level below l + 1
def Mst.level_lt_succ(+k: List<&2, U32>, +l: Nat) -> {Nat.is_eq(Key.level(k), l) == True{}: Bool} -> {
  Nat.is_lt(Key.level(k), 1n+l) == True{}: Bool
}:
  e =>
    %Equal.sym(Nat, Key.level(k), l, Shared.Nat.is_eq_sound(Key.level(k), l)(e)): {Nat.is_lt(_, 1n+l) == True{}: Bool}
    Shared.Nat.lt_succ(l)

# an or whose first side is True is True
def Bool.or_true_left(a: Bool, -b: Bool) -> {a == True{}: Bool} -> {Bool.or(a, b) == True{}: Bool}:
  match a:
    case True{}:
      e => {==}
    case False{}:
      e => Empty.absurd({b == True{}: Bool}, Shared.Bool.false_ne_true(e))

# an or whose second side is True is True
def Bool.or_true_of(a: Bool, -b: Bool) -> {b == True{}: Bool} -> {Bool.or(a, b) == True{}: Bool}:
  match a:
    case True{}:
      e => {==}
    case False{}:
      e => e

# the bindings of a subtree in the room of the level l have levels below l
def Mst.sub_below(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  q: Nat,
  +s: S,
  +p: List<&2, U32>,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +a: List<&2, Binding>,
  ihn: @xs: List<&2, Item> -> @l2: Nat -> @left: Maybe<&2, Hashes.Hash> -> @ks: List<&2, Piece> -> {
    Mst.pieces(xs, l2, left, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, q, s, p, ks) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Bindings.below(a, 1n+l2) == True{}: Bool}
) -> {Mst.sub_list(~S, ~fetch, q, s, p, m, l, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Bindings.below(a, l) == True{}: Bool}:
  match m:
    case None{}:
      e =>
        %Shared.Maybe.some_inj(List<&2, Binding>, [], a, e): {Bindings.below(_, l) == True{}: Bool}
        {==}
    case Some{+h}:
      e => Shared.Bool.when_cases(
        Maybe<&2, List<&2, Binding>>,
        x => {x == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Bindings.below(a, l) == True{}: Bool},
        Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
        u => Maybe.bind(
          &2,
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, s, h, l, lo, hi),
          ks => Mst.range.go(~S, ~fetch, q, s, p, ks)
        ),
        u => Some{[]},
        et => e2 => Maybe.bind_cases(
          List<&2, Piece>,
          List<&2, Binding>,
          Mst.open(~S, ~fetch, s, h, l, lo, hi),
          ks => Mst.range.go(~S, ~fetch, q, s, p, ks),
          a,
          {Bindings.below(a, l) == True{}: Bool},
          +ks => eo => ea => Mst.open_cases(
            ~S,
            ~fetch,
            s,
            h,
            l,
            lo,
            hi,
            ks,
            {Bindings.below(a, l) == True{}: Bool},
            +l2 => +left => +xs => ef => eh => en => elt => ee0 => ep => Bindings.below_mono(
              a,
              1n+l2,
              l
            )(ihn(xs)(l2)(left)(ks)(ep)(ea))(Nat.lt_le_succ(l2, l)(elt))
          )(eo)
        )(e2),
        et => e2 =>
          %Shared.Maybe.some_inj(List<&2, Binding>, [], a, e2): {Bindings.below(_, l) == True{}: Bool}
          {==}
      )(e)

# a listing of the pieces of a node of the level l has levels up to l
def Mst.lists_below(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +p: List<&2, U32>,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +a: List<&2, Binding>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Mst.range.go(~S, ~fetch, f, s, p, ks) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Bindings.below(a, 1n+l) == True{}: Bool}:
  match f:
    case 0n:
      ep => e =>
        %Equal.sym(List<&2, Binding>, a, [], Mst.range_zero(~S, ~fetch, s, p, ks, a)(e)): {Bindings.below(_, 1n+l) == True{}: Bool}
        {==}
    case 1n+(+q):
      match xs:
        case Nil{}:
          ep => e => Mst.range_list(
            ~S,
            ~fetch,
            prev,
            q,
            s,
            p,
            l,
            lo,
            hi,
            [],
            a,
            {Bindings.below(a, 1n+l) == True{}: Bool},
            +a1 => b => e4 => eb => esl =>
              %Bindings.cat_nil(a1, b, a)(eb)(e4): {Bindings.below(_, 1n+l) == True{}: Bool}
              Bindings.below_mono(
                a1,
                l,
                1n+l
              )(
                Mst.sub_below(
                  ~S,
                  ~fetch,
                  q,
                  s,
                  p,
                  prev,
                  l,
                  lo,
                  hi,
                  a1,
                  xs2 => l2 => left2 => ks2 => ep2 => ea2 => Mst.lists_below(~S, ~fetch, q, s, p, xs2, l2, left2, lo, hi, ks2, a1)(ep2)(ea2)
                )(esl)
              )(Shared.Nat.le_succ(l, l)(Shared.Nat.le_refl(l)))
          )(
            Equal.trans(
              Maybe<&2, List<&2, Binding>>,
              Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.sub(prev, l, lo, hi, [])),
              Mst.range.go(~S, ~fetch, 1n+q, s, p, ks),
              Some{a},
              Equal.cong(
                List<&2, Piece>,
                Maybe<&2, List<&2, Binding>>,
                x => Mst.range.go(~S, ~fetch, 1n+q, s, p, x),
                Piece.sub(prev, l, lo, hi, []),
                ks,
                Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep)
              ),
              e
            )
          )
        case Con{Item{+ik, +iv, +r}, +rest}:
          ep => e => Maybe.when_cases(
            List<&2, Piece>,
            Bool.and(
              Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
              Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
            ),
            u => Maybe.map(
              &2,
              List<&2, Piece>,
              List<&2, Piece>,
              ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
              Mst.pieces(rest, l, r, Some{ik}, hi)
            ),
            ks,
            {Bindings.below(a, 1n+l) == True{}: Bool},
            +c => e2 => Maybe.map_cases(
              List<&2, Piece>,
              List<&2, Piece>,
              Mst.pieces(rest, l, r, Some{ik}, hi),
              ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
              ks,
              {Bindings.below(a, 1n+l) == True{}: Bool},
              +ks2 => e3 => e4 => Mst.range_list(
                ~S,
                ~fetch,
                prev,
                q,
                s,
                p,
                l,
                lo,
                Some{ik},
                Piece.Bind{ik, iv} <> ks2,
                a,
                {Bindings.below(a, 1n+l) == True{}: Bool},
                +c1 => b => e5 => eb => esl => Maybe.map_cases(
                  List<&2, Binding>,
                  List<&2, Binding>,
                  Mst.range.go(~S, ~fetch, 1n+q, s, p, ks2),
                  +b2 => Shared.Bool.when(List<&2, Binding>, Key.leads(p, ik), u => Binding{ik, iv} <> b2, u => b2),
                  b,
                  {Bindings.below(a, 1n+l) == True{}: Bool},
                  +b2 => eb2 => e6 =>
                    %e5: {Bindings.below(_, 1n+l) == True{}: Bool}
                    %e6: {Bindings.below(List.append(&2, Binding, c1, _), 1n+l) == True{}: Bool}
                    Bindings.below_append(
                      c1,
                      Shared.Bool.when(List<&2, Binding>, Key.leads(p, ik), u => Binding{ik, iv} <> b2, u => b2),
                      1n+l
                    )(
                      Bindings.below_mono(
                        c1,
                        l,
                        1n+l
                      )(
                        Mst.sub_below(
                          ~S,
                          ~fetch,
                          q,
                          s,
                          p,
                          prev,
                          l,
                          lo,
                          Some{ik},
                          c1,
                          xs2 => l2 => left2 => ks3 => ep2 => ea2 => Mst.lists_below(~S, ~fetch, q, s, p, xs2, l2, left2, lo, Some{ik}, ks3, c1)(ep2)(ea2)
                        )(esl)
                      )(Shared.Nat.le_succ(l, l)(Shared.Nat.le_refl(l)))
                    )(
                      Bindings.below_when(
                        Key.leads(p, ik),
                        ik,
                        iv,
                        b2,
                        1n+l
                      )(
                        Mst.level_lt_succ(
                          ik,
                          l
                        )(
                          Shared.Bool.and_true_left(
                            Nat.is_eq(Key.level(ik), l),
                            Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))
                          )(
                            Shared.Bool.and_true_left(
                              Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
                              Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
                            )(c)
                          )
                        )
                      )(Mst.lists_below(~S, ~fetch, 1n+q, s, p, rest, l, r, Some{ik}, hi, ks2, b2)(e3)(eb2))
                    )
                )(eb)
              )(
                Equal.trans(
                  Maybe<&2, List<&2, Binding>>,
                  Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2)),
                  Mst.range.go(~S, ~fetch, 1n+q, s, p, ks),
                  Some{a},
                  Equal.cong(
                    List<&2, Piece>,
                    Maybe<&2, List<&2, Binding>>,
                    x => Mst.range.go(~S, ~fetch, 1n+q, s, p, x),
                    Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2),
                    ks,
                    e4
                  ),
                  e
                )
              )
            )(e2)
          )(ep)

# Mst.lists_level at the first item of the key ik, read f levels down
def Mst.lists_level.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +ks2: List<&2, Piece>,
  +a: List<&2, Binding>,
  lvl: {Nat.is_eq(Key.level(ik), l) == True{}: Bool}
) -> {
  Mst.range.go(~S, ~fetch, f, s, [], Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2)) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Bindings.has_level(a, l) == True{}: Bool}:
  match f:
    case 0n:
      e => Empty.absurd(
        {Bindings.has_level(a, l) == True{}: Bool},
        Mst.sub_ne_nil(
          prev,
          l,
          lo,
          Some{ik},
          Piece.Bind{ik, iv},
          ks2
        )(Mst.range_zero_nil(~S, ~fetch, s, [], Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), a)(e))
      )
    case 1n+(+q):
      e => Mst.range_list(
        ~S,
        ~fetch,
        prev,
        q,
        s,
        [],
        l,
        lo,
        Some{ik},
        Piece.Bind{ik, iv} <> ks2,
        a,
        {Bindings.has_level(a, l) == True{}: Bool},
        +c1 => b => e5 => eb => esl => Maybe.map_cases(
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2),
          +b2 => Shared.Bool.when(List<&2, Binding>, Key.leads([], ik), u => Binding{ik, iv} <> b2, u => b2),
          b,
          {Bindings.has_level(a, l) == True{}: Bool},
          +b2 => eb2 => e6 =>
            %e5: {Bindings.has_level(_, l) == True{}: Bool}
            %e6: {Bindings.has_level(List.append(&2, Binding, c1, _), l) == True{}: Bool}
            Bindings.has_level_right(
              c1,
              Binding{ik, iv} <> b2,
              l
            )(Bool.or_true_left(Nat.is_eq(Key.level(ik), l), Bindings.has_level(b2, l))(lvl))
        )(eb)
      )(e)

# a listing of the pieces of a node of the level l with an item, under no
# prefix, holds a key of the level l
def Mst.lists_level(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +a: List<&2, Binding>
) -> {List.is_empty(&2, Item, xs) == False{}: Bool} -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Mst.range.go(~S, ~fetch, f, s, [], ks) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Bindings.has_level(a, l) == True{}: Bool}:
  match xs:
    case Nil{}:
      ee => ep => e => Empty.absurd({Bindings.has_level(a, l) == True{}: Bool}, Shared.Bool.true_ne_false(ee))
    case Con{Item{+ik, +iv, +r}, +rest}:
      ee => ep => e => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
          Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          Mst.pieces(rest, l, r, Some{ik}, hi)
        ),
        ks,
        {Bindings.has_level(a, l) == True{}: Bool},
        +c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{ik}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          ks,
          {Bindings.has_level(a, l) == True{}: Bool},
          +ks2 => e3 => e4 => Mst.lists_level.at(
            ~S,
            ~fetch,
            f,
            s,
            ik,
            iv,
            l,
            prev,
            lo,
            ks2,
            a,
            Shared.Bool.and_true_left(
              Nat.is_eq(Key.level(ik), l),
              Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))
            )(
              Shared.Bool.and_true_left(
                Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
                Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
              )(c)
            )
          )(
            Equal.trans(
              Maybe<&2, List<&2, Binding>>,
              Mst.range.go(~S, ~fetch, f, s, [], Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2)),
              Mst.range.go(~S, ~fetch, f, s, [], ks),
              Some{a},
              Equal.cong(
                List<&2, Piece>,
                Maybe<&2, List<&2, Binding>>,
                x => Mst.range.go(~S, ~fetch, f, s, [], x),
                Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2),
                ks,
                e4
              ),
              e
            )
          )
        )(e2)
      )(ep)

# a key of the level l has no level below l
def Mst.level_clash(+k: List<&2, U32>, +l: Nat) -> {Nat.is_eq(Key.level(k), l) == True{}: Bool} -> {
  Nat.is_lt(Key.level(k), l) == True{}: Bool
} -> Empty:
  e => g => Shared.Bool.true_ne_false(
    Equal.trans(
      Bool,
      True{},
      Nat.is_lt(Key.level(k), l),
      False{},
      Equal.sym(Bool, Nat.is_lt(Key.level(k), l), True{}, g),
      Equal.trans(
        Bool,
        Nat.is_lt(Key.level(k), l),
        Nat.is_lt(l, l),
        False{},
        Equal.cong(Nat, Bool, z => Nat.is_lt(z, l), Key.level(k), l, Shared.Nat.is_eq_sound(Key.level(k), l)(e)),
        Shared.Nat.lt_irrefl(l)
      )
    )
  )

# bindings below the level l hold no key of the level l
def Bindings.level_clash(+a: List<&2, Binding>, +l: Nat) -> {Bindings.below(a, l) == True{}: Bool} -> {
  Bindings.has_level(a, l) == True{}: Bool
} -> Empty:
  hb => hh => Shared.Bool.true_ne_false(
    Equal.trans(Bool, True{}, Nat.is_lt(l, l), False{}, Equal.sym(Bool, Nat.is_lt(l, l), True{}, Bindings.has_level_lt(a, l, l)(hb)(hh)), Shared.Nat.lt_irrefl(l))
  )

# the value of a binding
def Binding.value(b: Binding) -> List<&2, U32>:
  match b:
    case Binding{k, v}:
      v

# a node of the level l, left subtree p, and the binding of k to v, with the
# left subtree and the items of n after it
def Node.under(n: Node, +l: Nat, +p: Maybe<&2, Hashes.Hash>, +k: List<&2, U32>, +v: List<&2, U32>) -> Node:
  match n:
    case Node{x, left, xs}:
      Node{l, p, Item{k, v, left} <> xs}

# two listings of a subtree below the level l, a binding of the level l, and
# more, that are equal, have equal parts
def Bindings.split_eq(
  c1: List<&2, Binding>,
  c2: List<&2, Binding>,
  +x1: Binding,
  +x2: Binding,
  +r1: List<&2, Binding>,
  +r2: List<&2, Binding>,
  +l: Nat,
  -P: Type,
  k: {c1 == c2: List<&2, Binding>} -> {x1 == x2: Binding} -> {r1 == r2: List<&2, Binding>} -> P
) -> {
  List.append(&2, Binding, c1, x1 <> r1) == List.append(&2, Binding, c2, x2 <> r2): List<&2, Binding>
} -> {Bindings.below(c1, l) == True{}: Bool} -> {Bindings.below(c2, l) == True{}: Bool} -> {
  Nat.is_eq(Key.level(Binding.key(x1)), l) == True{}: Bool
} -> {Nat.is_eq(Key.level(Binding.key(x2)), l) == True{}: Bool} -> P:
  match c1 c2:
    case Nil{} Nil{}:
      +e => h1 => h2 => g1 => g2 => k({==})(Shared.List.head_eq(Binding, x1, x2, r1, r2, e))(Shared.List.tail_eq(Binding, x1, x2, r1, r2, e))
    case Nil{} Con{Binding{+ky, +vy}, +cr}:
      e => h1 => h2 => g1 => g2 => Empty.absurd(
        P,
        Mst.level_clash(
          ky,
          l
        )(
          Equal.trans(
            Bool,
            Nat.is_eq(Key.level(ky), l),
            Nat.is_eq(Key.level(Binding.key(x1)), l),
            True{},
            Equal.cong(
              Binding,
              Bool,
              z => Nat.is_eq(Key.level(Binding.key(z)), l),
              Binding{ky, vy},
              x1,
              Equal.sym(
                Binding,
                x1,
                Binding{ky, vy},
                Shared.List.head_eq(Binding, x1, Binding{ky, vy}, r1, List.append(&2, Binding, cr, x2 <> r2), e)
              )
            ),
            g1
          )
        )(Shared.Bool.and_true_left(Nat.is_lt(Key.level(ky), l), Bindings.below(cr, l))(h2))
      )
    case Con{Binding{+ky, +vy}, +cr} Nil{}:
      e => h1 => h2 => g1 => g2 => Empty.absurd(
        P,
        Mst.level_clash(
          ky,
          l
        )(
          Equal.trans(
            Bool,
            Nat.is_eq(Key.level(ky), l),
            Nat.is_eq(Key.level(Binding.key(x2)), l),
            True{},
            Equal.cong(
              Binding,
              Bool,
              z => Nat.is_eq(Key.level(Binding.key(z)), l),
              Binding{ky, vy},
              x2,
              Shared.List.head_eq(Binding, Binding{ky, vy}, x2, List.append(&2, Binding, cr, x1 <> r1), r2, e)
            ),
            g2
          )
        )(Shared.Bool.and_true_left(Nat.is_lt(Key.level(ky), l), Bindings.below(cr, l))(h1))
      )
    case Con{Binding{+ky1, +vy1}, +cr1} Con{Binding{+ky2, +vy2}, +cr2}:
      +e => h1 => h2 => g1 => g2 => Bindings.split_eq(
        cr1,
        cr2,
        x1,
        x2,
        r1,
        r2,
        l,
        P,
        ec => k(
          Shared.List.cons_eq(
            Binding,
            Binding{ky1, vy1},
            Binding{ky2, vy2},
            cr1,
            cr2,
            Shared.List.head_eq(
              Binding,
              Binding{ky1, vy1},
              Binding{ky2, vy2},
              List.append(&2, Binding, cr1, x1 <> r1),
              List.append(&2, Binding, cr2, x2 <> r2),
              e
            ),
            ec
          )
        )
      )(
        Shared.List.tail_eq(
          Binding,
          Binding{ky1, vy1},
          Binding{ky2, vy2},
          List.append(&2, Binding, cr1, x1 <> r1),
          List.append(&2, Binding, cr2, x2 <> r2),
          e
        )
      )(Shared.Bool.and_true_right(Nat.is_lt(Key.level(ky1), l), Bindings.below(cr1, l))(h1))(
        Shared.Bool.and_true_right(Nat.is_lt(Key.level(ky2), l), Bindings.below(cr2, l))(h2)
      )(g1)(g2)

# a key before the empty bound hi of a node meets every listing
def Bound.meets_nil(lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> {Bound.before([], hi) == True{}: Bool} -> {
  Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)) == True{}: Bool
}:
  match lo hi:
    case None{} None{}:
      h => {==}
    case None{} Some{b}:
      h => h
    case Some{+a} None{}:
      h =>
        %Equal.sym(Bool, Key.is_lt(a, []), False{}, Key.lt_nil(a)): {Bool.and(Bool.or(_, Key.leads([], a)), True{}) == True{}: Bool}
        {==}
    case Some{+a} Some{b}:
      h =>
        %Equal.sym(Bool, Key.is_lt(a, []), False{}, Key.lt_nil(a)): {Bool.and(Bool.or(_, Key.leads([], a)), Key.is_lt([], b)) == True{}: Bool}
        h

# no key is before the empty key: before it is the key that has words
def Key.lt_nil_left(k: List<&2, U32>) -> {Key.is_lt([], k) == Bool.not(List.is_empty(&2, U32, k)): Bool}:
  match k:
    case Nil{}:
      {==}
    case Con{x, r}:
      {==}

# a subtree whose bounds hold keys lists the bindings of its node
def Mst.sub_list_on(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  -a: List<&2, Binding>
) -> {Bound.before([], hi) == True{}: Bool} -> {Mst.sub_list(~S, ~fetch, f, s, [], Some{h}, up, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
  Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, up, lo, hi), ks => Mst.range.go(~S, ~fetch, f, s, [], ks))
    == Some{a}: Maybe<&2, List<&2, Binding>>
}:
  hb => e => Equal.trans(
    Maybe<&2, List<&2, Binding>>,
    Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, up, lo, hi), ks => Mst.range.go(~S, ~fetch, f, s, [], ks)),
    Mst.sub_list(~S, ~fetch, f, s, [], Some{h}, up, lo, hi),
    Some{a},
    Equal.cong(
      Bool,
      Maybe<&2, List<&2, Binding>>,
      t => Shared.Bool.when(
        Maybe<&2, List<&2, Binding>>,
        t,
        u => Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, up, lo, hi), ks => Mst.range.go(~S, ~fetch, f, s, [], ks)),
        u => Some{[]}
      ),
      True{},
      Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)),
      Equal.sym(Bool, Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)), True{}, Bound.meets_nil(lo, hi)(hb))
    ),
    e
  )

# a subtree whose bounds hold keys lists a binding
def Mst.canon_sub.one(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +a: List<&2, Binding>,
  hb: {Bound.before([], hi) == True{}: Bool}
) -> {Some{[]} == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
  Mst.sub_list(~S, ~fetch, f, s, [], Some{h}, up, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> Empty:
  e0 => e => Maybe.bind_cases(
    List<&2, Piece>,
    List<&2, Binding>,
    Mst.open(~S, ~fetch, s, h, up, lo, hi),
    ks => Mst.range.go(~S, ~fetch, f, s, [], ks),
    a,
    Empty,
    +ks => eo => ea => Mst.open_cases(
      ~S,
      ~fetch,
      s,
      h,
      up,
      lo,
      hi,
      ks,
      Empty,
      +l2 => +left2 => +xs2 => ef => eh => en => elt => ee => ep => Shared.Bool.false_ne_true(
        Equal.trans(
          Bool,
          False{},
          Bindings.has_level(a, l2),
          True{},
          Equal.cong(List<&2, Binding>, Bool, x => Bindings.has_level(x, l2), [], a, Shared.Maybe.some_inj(List<&2, Binding>, [], a, e0)),
          Mst.lists_level(~S, ~fetch, f, s, xs2, l2, left2, lo, hi, ks, a)(ee)(ep)(ea)
        )
      )
    )(eo)
  )(Mst.sub_list_on(~S, ~fetch, f, s, h, up, lo, hi, a)(hb)(e))

# two subtrees whose bounds hold keys, with nodes whose listings are one
# (ihn: two such nodes of one level are one), are one subtree
def Mst.canon_sub.both(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +h1: Hashes.Hash,
  +h2: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +a: List<&2, Binding>,
  +hb: {Bound.before([], hi) == True{}: Bool},
  ihn: @xs1: List<&2, Item> -> @xs2: List<&2, Item> -> @l: Nat -> @p1: Maybe<&2, Hashes.Hash> -> @p2: Maybe<&2, Hashes.Hash> -> @ks1: List<
    &2,
    Piece> -> @ks2: List<&2, Piece> -> {Bound.before([], hi) == True{}: Bool} -> {
    Mst.pieces(xs1, l, p1, lo, hi) == Some{ks1}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, f, s, [], ks1) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
    Mst.pieces(xs2, l, p2, lo, hi) == Some{ks2}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, f, s, [], ks2) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Node{l, p1, xs1} == Node{l, p2, xs2}: Node}
) -> {Mst.sub_list(~S, ~fetch, f, s, [], Some{h1}, up, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
  Mst.sub_list(~S, ~fetch, f, s, [], Some{h2}, up, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Some{h1} == Some{h2}: Maybe<&2, Hashes.Hash>}:
  e1 => e2 => Maybe.bind_cases(
    List<&2, Piece>,
    List<&2, Binding>,
    Mst.open(~S, ~fetch, s, h1, up, lo, hi),
    ks => Mst.range.go(~S, ~fetch, f, s, [], ks),
    a,
    {Some{h1} == Some{h2}: Maybe<&2, Hashes.Hash>},
    +ks1 => eo1 => +ea1 => Mst.open_cases(
      ~S,
      ~fetch,
      s,
      h1,
      up,
      lo,
      hi,
      ks1,
      {Some{h1} == Some{h2}: Maybe<&2, Hashes.Hash>},
      +l1 => +left1 => +xs1 => ef1 => +eh1 => en1 => elt1 => +ee1 => +ep1 => Maybe.bind_cases(
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h2, up, lo, hi),
        ks => Mst.range.go(~S, ~fetch, f, s, [], ks),
        a,
        {Some{h1} == Some{h2}: Maybe<&2, Hashes.Hash>},
        +ks2 => eo2 => +ea2 => Mst.open_cases(
          ~S,
          ~fetch,
          s,
          h2,
          up,
          lo,
          hi,
          ks2,
          {Some{h1} == Some{h2}: Maybe<&2, Hashes.Hash>},
          +l2 => +left2 => +xs2 => ef2 => +eh2 => en2 => elt2 => +ee2 => +ep2 =>
            +l12 = Nat.lt_succ_eq(
              l1,
              l2
            )(
              Bindings.has_level_lt(
                a,
                l1,
                1n+l2
              )(Mst.lists_below(~S, ~fetch, f, s, [], xs2, l2, left2, lo, hi, ks2, a)(ep2)(ea2))(
                Mst.lists_level(~S, ~fetch, f, s, xs1, l1, left1, lo, hi, ks1, a)(ee1)(ep1)(ea1)
              )
            )(
              Bindings.has_level_lt(
                a,
                l2,
                1n+l1
              )(Mst.lists_below(~S, ~fetch, f, s, [], xs1, l1, left1, lo, hi, ks1, a)(ep1)(ea1))(
                Mst.lists_level(~S, ~fetch, f, s, xs2, l2, left2, lo, hi, ks2, a)(ee2)(ep2)(ea2)
              )
            )
            +nodes = ihn(xs1)(xs2)(l1)(left1)(left2)(ks1)(ks2)(hb)(ep1)(ea1)(
              Equal.trans(
                Maybe<&2, List<&2, Piece>>,
                Mst.pieces(xs2, l1, left2, lo, hi),
                Mst.pieces(xs2, l2, left2, lo, hi),
                Some{ks2},
                Equal.cong(Nat, Maybe<&2, List<&2, Piece>>, x => Mst.pieces(xs2, x, left2, lo, hi), l1, l2, l12),
                ep2
              )
            )(ea2)
            +n12 = Equal.trans(
              Node,
              Node{l1, left1, xs1},
              Node{l1, left2, xs2},
              Node{l2, left2, xs2},
              nodes,
              Equal.cong(Nat, Node, x => Node{x, left2, xs2}, l1, l2, l12)
            )
            Equal.cong(
              Hashes.Hash,
              Maybe<&2, Hashes.Hash>,
              x => Some{x},
              h1,
              h2,
              Equal.trans(
                Hashes.Hash,
                h1,
                Hashes.Sha.hash(Node.code(Node{l1, left1, xs1}, [])),
                h2,
                Equal.sym(Hashes.Hash, Hashes.Sha.hash(Node.code(Node{l1, left1, xs1}, [])), h1, eh1),
                Equal.trans(
                  Hashes.Hash,
                  Hashes.Sha.hash(Node.code(Node{l1, left1, xs1}, [])),
                  Hashes.Sha.hash(Node.code(Node{l2, left2, xs2}, [])),
                  h2,
                  Equal.cong(Node, Hashes.Hash, x => Hashes.Sha.hash(Node.code(x, [])), Node{l1, left1, xs1}, Node{l2, left2, xs2}, n12),
                  eh2
                )
              )
            )
        )(eo2)
      )(Mst.sub_list_on(~S, ~fetch, f, s, h2, up, lo, hi, a)(hb)(e2))
    )(eo1)
  )(Mst.sub_list_on(~S, ~fetch, f, s, h1, up, lo, hi, a)(hb)(e1))

# two subtrees in one room that list the same bindings, under no prefix, are
# one subtree, when two such nodes of one level are one (ihn)
def Mst.canon_sub(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  m1: Maybe<&2, Hashes.Hash>,
  m2: Maybe<&2, Hashes.Hash>,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +a: List<&2, Binding>,
  hn1: {Bool.or(Maybe.is_none(&2, Hashes.Hash, m1), Bound.before([], hi)) == True{}: Bool},
  hn2: {Bool.or(Maybe.is_none(&2, Hashes.Hash, m2), Bound.before([], hi)) == True{}: Bool},
  ihn: @xs1: List<&2, Item> -> @xs2: List<&2, Item> -> @l: Nat -> @p1: Maybe<&2, Hashes.Hash> -> @p2: Maybe<&2, Hashes.Hash> -> @ks1: List<
    &2,
    Piece> -> @ks2: List<&2, Piece> -> {Bound.before([], hi) == True{}: Bool} -> {
    Mst.pieces(xs1, l, p1, lo, hi) == Some{ks1}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, f, s, [], ks1) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
    Mst.pieces(xs2, l, p2, lo, hi) == Some{ks2}: Maybe<&2, List<&2, Piece>>
  } -> {Mst.range.go(~S, ~fetch, f, s, [], ks2) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Node{l, p1, xs1} == Node{l, p2, xs2}: Node}
) -> {Mst.sub_list(~S, ~fetch, f, s, [], m1, up, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
  Mst.sub_list(~S, ~fetch, f, s, [], m2, up, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {m1 == m2: Maybe<&2, Hashes.Hash>}:
  match m1 m2:
    case None{} None{}:
      e1 => e2 => {==}
    case None{} Some{+h2}:
      e1 => e2 => Empty.absurd({None{} == Some{h2}: Maybe<&2, Hashes.Hash>}, Mst.canon_sub.one(~S, ~fetch, f, s, h2, up, lo, hi, a, hn2)(e1)(e2))
    case Some{+h1} None{}:
      e1 => e2 => Empty.absurd({Some{h1} == None{}: Maybe<&2, Hashes.Hash>}, Mst.canon_sub.one(~S, ~fetch, f, s, h1, up, lo, hi, a, hn1)(e2)(e1))
    case Some{+h1} Some{+h2}:
      e1 => e2 => Mst.canon_sub.both(~S, ~fetch, f, s, h1, h2, up, lo, hi, a, hn1, ihn)(e1)(e2)

# a node with no item and a node with an item, of one level and room, list
# different bindings: the second holds a key of its level, the first none
def Mst.canon_clash(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +a: List<&2, Binding>,
  hh: {Bindings.has_level(a, l) == True{}: Bool}
) -> {Mst.pieces([], l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Mst.range.go(~S, ~fetch, 1n+q, s, [], ks) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> Empty:
  ep => e => Mst.range_list(
    ~S,
    ~fetch,
    prev,
    q,
    s,
    [],
    l,
    lo,
    hi,
    [],
    a,
    Empty,
    +a1 => b => e4 => eb => esl => Bindings.level_clash(
      a,
      l
    )(
      Equal.trans(
        Bool,
        Bindings.below(a, l),
        Bindings.below(a1, l),
        True{},
        Equal.cong(List<&2, Binding>, Bool, x => Bindings.below(x, l), a, a1, Equal.sym(List<&2, Binding>, a1, a, Bindings.cat_nil(a1, b, a)(eb)(e4))),
        Mst.sub_below(
          ~S,
          ~fetch,
          q,
          s,
          [],
          prev,
          l,
          lo,
          hi,
          a1,
          xs2 => l2 => left2 => ks2 => ep2 => ea2 => Mst.lists_below(~S, ~fetch, q, s, [], xs2, l2, left2, lo, hi, ks2, a1)(ep2)(ea2)
        )(esl)
      )
    )(hh)
  )(
    Equal.trans(
      Maybe<&2, List<&2, Binding>>,
      Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev, l, lo, hi, [])),
      Mst.range.go(~S, ~fetch, 1n+q, s, [], ks),
      Some{a},
      Equal.cong(
        List<&2, Piece>,
        Maybe<&2, List<&2, Binding>>,
        x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
        Piece.sub(prev, l, lo, hi, []),
        ks,
        Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep)
      ),
      e
    )
  )

# two nodes of one level, in one room, whose pieces list the same bindings
# under no prefix, are one node
def Mst.canon_node(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  xs1: List<&2, Item>,
  +xs2: List<&2, Item>,
  +l: Nat,
  +prev1: Maybe<&2, Hashes.Hash>,
  +prev2: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks1: List<&2, Piece>,
  +ks2: List<&2, Piece>,
  +a: List<&2, Binding>
) -> {Bound.before([], hi) == True{}: Bool} -> {Mst.pieces(xs1, l, prev1, lo, hi) == Some{ks1}: Maybe<&2, List<&2, Piece>>} -> {
  Mst.range.go(~S, ~fetch, f, s, [], ks1) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Mst.pieces(xs2, l, prev2, lo, hi) == Some{ks2}: Maybe<&2, List<&2, Piece>>} -> {
  Mst.range.go(~S, ~fetch, f, s, [], ks2) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Node{l, prev1, xs1} == Node{l, prev2, xs2}: Node}:
  match f:
    case 0n:
      hb => ep1 => e1 => ep2 => e2 => Equal.trans(
        Node,
        Node{l, prev1, xs1},
        Node{l, None{}, []},
        Node{l, prev2, xs2},
        Mst.pieces_empty(
          xs1,
          l,
          prev1,
          lo,
          hi
        )(
          Equal.trans(
            Maybe<&2, List<&2, Piece>>,
            Mst.pieces(xs1, l, prev1, lo, hi),
            Some{ks1},
            Some{[]},
            ep1,
            Equal.cong(List<&2, Piece>, Maybe<&2, List<&2, Piece>>, x => Some{x}, ks1, [], Mst.range_zero_nil(~S, ~fetch, s, [], ks1, a)(e1))
          )
        ),
        Equal.sym(
          Node,
          Node{l, prev2, xs2},
          Node{l, None{}, []},
          Mst.pieces_empty(
            xs2,
            l,
            prev2,
            lo,
            hi
          )(
            Equal.trans(
              Maybe<&2, List<&2, Piece>>,
              Mst.pieces(xs2, l, prev2, lo, hi),
              Some{ks2},
              Some{[]},
              ep2,
              Equal.cong(List<&2, Piece>, Maybe<&2, List<&2, Piece>>, x => Some{x}, ks2, [], Mst.range_zero_nil(~S, ~fetch, s, [], ks2, a)(e2))
            )
          )
        )
      )
    case 1n+(+q):
      match xs1 xs2:
        case Nil{} Nil{}:
          +hb => ep1 => e1 => ep2 => e2 => Mst.range_list(
            ~S,
            ~fetch,
            prev1,
            q,
            s,
            [],
            l,
            lo,
            hi,
            [],
            a,
            {Node{l, prev1, []} == Node{l, prev2, []}: Node},
            +a1 => b1 => e41 => eb1 => esl1 => Mst.range_list(
              ~S,
              ~fetch,
              prev2,
              q,
              s,
              [],
              l,
              lo,
              hi,
              [],
              a,
              {Node{l, prev1, []} == Node{l, prev2, []}: Node},
              +a2 => b2 => e42 => eb2 => esl2 => Equal.cong(
                Maybe<&2, Hashes.Hash>,
                Node,
                x => Node{l, x, []},
                prev1,
                prev2,
                Mst.canon_sub(
                  ~S,
                  ~fetch,
                  q,
                  s,
                  prev1,
                  prev2,
                  l,
                  lo,
                  hi,
                  a,
                  Bool.or_true_of(Maybe.is_none(&2, Hashes.Hash, prev1), Bound.before([], hi))(hb),
                  Bool.or_true_of(Maybe.is_none(&2, Hashes.Hash, prev2), Bound.before([], hi))(hb),
                  ys1 => ys2 => l3 => p1 => p2 => j1 => j2 => hb3 => f1 => g1 => f2 => g2 => Mst.canon_node(
                    ~S,
                    ~fetch,
                    q,
                    s,
                    ys1,
                    ys2,
                    l3,
                    p1,
                    p2,
                    lo,
                    hi,
                    j1,
                    j2,
                    a
                  )(hb3)(f1)(g1)(f2)(g2)
                )(
                  Equal.trans(
                    Maybe<&2, List<&2, Binding>>,
                    Mst.sub_list(~S, ~fetch, q, s, [], prev1, l, lo, hi),
                    Some{a1},
                    Some{a},
                    esl1,
                    Equal.cong(List<&2, Binding>, Maybe<&2, List<&2, Binding>>, x => Some{x}, a1, a, Bindings.cat_nil(a1, b1, a)(eb1)(e41))
                  )
                )(
                  Equal.trans(
                    Maybe<&2, List<&2, Binding>>,
                    Mst.sub_list(~S, ~fetch, q, s, [], prev2, l, lo, hi),
                    Some{a2},
                    Some{a},
                    esl2,
                    Equal.cong(List<&2, Binding>, Maybe<&2, List<&2, Binding>>, x => Some{x}, a2, a, Bindings.cat_nil(a2, b2, a)(eb2)(e42))
                  )
                )
              )
            )(
              Equal.trans(
                Maybe<&2, List<&2, Binding>>,
                Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev2, l, lo, hi, [])),
                Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2),
                Some{a},
                Equal.cong(
                  List<&2, Piece>,
                  Maybe<&2, List<&2, Binding>>,
                  x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
                  Piece.sub(prev2, l, lo, hi, []),
                  ks2,
                  Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev2, l, lo, hi, []), ks2, ep2)
                ),
                e2
              )
            )
          )(
            Equal.trans(
              Maybe<&2, List<&2, Binding>>,
              Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev1, l, lo, hi, [])),
              Mst.range.go(~S, ~fetch, 1n+q, s, [], ks1),
              Some{a},
              Equal.cong(
                List<&2, Piece>,
                Maybe<&2, List<&2, Binding>>,
                x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
                Piece.sub(prev1, l, lo, hi, []),
                ks1,
                Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev1, l, lo, hi, []), ks1, ep1)
              ),
              e1
            )
          )
        case Nil{} Con{Item{+k2, +v2, +r2}, +rest2}:
          hb => ep1 => e1 => ep2 => e2 => Empty.absurd(
            {Node{l, prev1, []} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
            Mst.canon_clash(
              ~S,
              ~fetch,
              q,
              s,
              l,
              prev1,
              lo,
              hi,
              ks1,
              a,
              Mst.lists_level(~S, ~fetch, 1n+q, s, Item{k2, v2, r2} <> rest2, l, prev2, lo, hi, ks2, a)({==})(ep2)(e2)
            )(ep1)(e1)
          )
        case Con{Item{+k1, +v1, +r1}, +rest1} Nil{}:
          hb => ep1 => e1 => ep2 => e2 => Empty.absurd(
            {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, []}: Node},
            Mst.canon_clash(
              ~S,
              ~fetch,
              q,
              s,
              l,
              prev2,
              lo,
              hi,
              ks2,
              a,
              Mst.lists_level(~S, ~fetch, 1n+q, s, Item{k1, v1, r1} <> rest1, l, prev1, lo, hi, ks1, a)({==})(ep1)(e1)
            )(ep2)(e2)
          )
        case Con{Item{+k1, +v1, +r1}, +rest1} Con{Item{+k2, +v2, +r2}, +rest2}:
          +hb => ep1 => e1 => ep2 => e2 => Maybe.when_cases(
            List<&2, Piece>,
            Bool.and(
              Bool.and(Nat.is_eq(Key.level(k1), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Bool.not(List.is_empty(&2, U32, k1)))),
              Bool.and(Bound.after(lo, k1), Bound.before(k1, hi))
            ),
            u => Maybe.map(
              &2,
              List<&2, Piece>,
              List<&2, Piece>,
              ps2 => Piece.sub(prev1, l, lo, Some{k1}, Piece.Bind{k1, v1} <> ps2),
              Mst.pieces(rest1, l, r1, Some{k1}, hi)
            ),
            ks1,
            {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
            +c1 => e21 => Maybe.map_cases(
              List<&2, Piece>,
              List<&2, Piece>,
              Mst.pieces(rest1, l, r1, Some{k1}, hi),
              ps2 => Piece.sub(prev1, l, lo, Some{k1}, Piece.Bind{k1, v1} <> ps2),
              ks1,
              {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
              +ks1b => +e31 => e41 => Maybe.when_cases(
                List<&2, Piece>,
                Bool.and(
                  Bool.and(Nat.is_eq(Key.level(k2), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Bool.not(List.is_empty(&2, U32, k2)))),
                  Bool.and(Bound.after(lo, k2), Bound.before(k2, hi))
                ),
                u => Maybe.map(
                  &2,
                  List<&2, Piece>,
                  List<&2, Piece>,
                  ps2 => Piece.sub(prev2, l, lo, Some{k2}, Piece.Bind{k2, v2} <> ps2),
                  Mst.pieces(rest2, l, r2, Some{k2}, hi)
                ),
                ks2,
                {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                +c2 => e22 => Maybe.map_cases(
                  List<&2, Piece>,
                  List<&2, Piece>,
                  Mst.pieces(rest2, l, r2, Some{k2}, hi),
                  ps2 => Piece.sub(prev2, l, lo, Some{k2}, Piece.Bind{k2, v2} <> ps2),
                  ks2,
                  {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                  +ks2b => +e32 => e42 => Mst.range_list(
                    ~S,
                    ~fetch,
                    prev1,
                    q,
                    s,
                    [],
                    l,
                    lo,
                    Some{k1},
                    Piece.Bind{k1, v1} <> ks1b,
                    a,
                    {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                    +ca => +ba => e51 => eb1 => +esl1 => Maybe.map_cases(
                      List<&2, Binding>,
                      List<&2, Binding>,
                      Mst.range.go(~S, ~fetch, 1n+q, s, [], ks1b),
                      +bb => Shared.Bool.when(List<&2, Binding>, Key.leads([], k1), u => Binding{k1, v1} <> bb, u => bb),
                      ba,
                      {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                      +ba2 => +eb12 => e61 => Mst.range_list(
                        ~S,
                        ~fetch,
                        prev2,
                        q,
                        s,
                        [],
                        l,
                        lo,
                        Some{k2},
                        Piece.Bind{k2, v2} <> ks2b,
                        a,
                        {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                        +cb => +bx => e52 => eb2 => +esl2 => Maybe.map_cases(
                          List<&2, Binding>,
                          List<&2, Binding>,
                          Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2b),
                          +bb => Shared.Bool.when(List<&2, Binding>, Key.leads([], k2), u => Binding{k2, v2} <> bb, u => bb),
                          bx,
                          {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                          +bb2 => +eb22 => e62 => Bindings.split_eq(
                            ca,
                            cb,
                            Binding{k1, v1},
                            Binding{k2, v2},
                            ba2,
                            bb2,
                            l,
                            {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev2, Item{k2, v2, r2} <> rest2}: Node},
                            +ec => +ex => +er =>
                              +kk = Equal.cong(Binding, List<&2, U32>, Binding.key, Binding{k1, v1}, Binding{k2, v2}, ex)
                              +vv = Equal.cong(Binding, List<&2, U32>, Binding.value, Binding{k1, v1}, Binding{k2, v2}, ex)
                              +pp = Mst.canon_sub(
                                ~S,
                                ~fetch,
                                q,
                                s,
                                prev1,
                                prev2,
                                l,
                                lo,
                                Some{k1},
                                ca,
                                Equal.trans(
                                  Bool,
                                  Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Key.is_lt([], k1)),
                                  Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Bool.not(List.is_empty(&2, U32, k1))),
                                  True{},
                                  Equal.cong(
                                    Bool,
                                    Bool,
                                    x => Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), x),
                                    Key.is_lt([], k1),
                                    Bool.not(List.is_empty(&2, U32, k1)),
                                    Key.lt_nil_left(k1)
                                  ),
                                  Shared.Bool.and_true_right(
                                    Nat.is_eq(Key.level(k1), l),
                                    Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Bool.not(List.is_empty(&2, U32, k1)))
                                  )(
                                    Shared.Bool.and_true_left(
                                      Bool.and(
                                        Nat.is_eq(Key.level(k1), l),
                                        Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Bool.not(List.is_empty(&2, U32, k1)))
                                      ),
                                      Bool.and(Bound.after(lo, k1), Bound.before(k1, hi))
                                    )(c1)
                                  )
                                ),
                                Equal.trans(
                                  Bool,
                                  Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Key.is_lt([], k1)),
                                  Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Key.is_lt([], k2)),
                                  True{},
                                  Equal.cong(List<&2, U32>, Bool, x => Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Key.is_lt([], x)), k1, k2, kk),
                                  Equal.trans(
                                    Bool,
                                    Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Key.is_lt([], k2)),
                                    Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Bool.not(List.is_empty(&2, U32, k2))),
                                    True{},
                                    Equal.cong(
                                      Bool,
                                      Bool,
                                      x => Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), x),
                                      Key.is_lt([], k2),
                                      Bool.not(List.is_empty(&2, U32, k2)),
                                      Key.lt_nil_left(k2)
                                    ),
                                    Shared.Bool.and_true_right(
                                      Nat.is_eq(Key.level(k2), l),
                                      Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Bool.not(List.is_empty(&2, U32, k2)))
                                    )(
                                      Shared.Bool.and_true_left(
                                        Bool.and(
                                          Nat.is_eq(Key.level(k2), l),
                                          Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Bool.not(List.is_empty(&2, U32, k2)))
                                        ),
                                        Bool.and(Bound.after(lo, k2), Bound.before(k2, hi))
                                      )(c2)
                                    )
                                  )
                                ),
                                ys1 => ys2 => l3 => p1 => p2 => j1 => j2 => hb3 => f1 => g1 => f2 => g2 => Mst.canon_node(
                                  ~S,
                                  ~fetch,
                                  q,
                                  s,
                                  ys1,
                                  ys2,
                                  l3,
                                  p1,
                                  p2,
                                  lo,
                                  Some{k1},
                                  j1,
                                  j2,
                                  ca
                                )(hb3)(f1)(g1)(f2)(g2)
                              )(esl1)(
                                Equal.trans(
                                  Maybe<&2, List<&2, Binding>>,
                                  Mst.sub_list(~S, ~fetch, q, s, [], prev2, l, lo, Some{k1}),
                                  Mst.sub_list(~S, ~fetch, q, s, [], prev2, l, lo, Some{k2}),
                                  Some{ca},
                                  Equal.cong(
                                    List<&2, U32>,
                                    Maybe<&2, List<&2, Binding>>,
                                    x => Mst.sub_list(~S, ~fetch, q, s, [], prev2, l, lo, Some{x}),
                                    k1,
                                    k2,
                                    kk
                                  ),
                                  Equal.trans(
                                    Maybe<&2, List<&2, Binding>>,
                                    Mst.sub_list(~S, ~fetch, q, s, [], prev2, l, lo, Some{k2}),
                                    Some{cb},
                                    Some{ca},
                                    esl2,
                                    Equal.cong(
                                      List<&2, Binding>,
                                      Maybe<&2, List<&2, Binding>>,
                                      x => Some{x},
                                      cb,
                                      ca,
                                      Equal.sym(List<&2, Binding>, ca, cb, ec)
                                    )
                                  )
                                )
                              )
                              +nr = Mst.canon_node(
                                ~S,
                                ~fetch,
                                1n+q,
                                s,
                                rest1,
                                rest2,
                                l,
                                r1,
                                r2,
                                Some{k1},
                                hi,
                                ks1b,
                                ks2b,
                                ba2
                              )(hb)(e31)(eb12)(
                                Equal.trans(
                                  Maybe<&2, List<&2, Piece>>,
                                  Mst.pieces(rest2, l, r2, Some{k1}, hi),
                                  Mst.pieces(rest2, l, r2, Some{k2}, hi),
                                  Some{ks2b},
                                  Equal.cong(List<&2, U32>, Maybe<&2, List<&2, Piece>>, x => Mst.pieces(rest2, l, r2, Some{x}, hi), k1, k2, kk),
                                  e32
                                )
                              )(
                                Equal.trans(
                                  Maybe<&2, List<&2, Binding>>,
                                  Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2b),
                                  Some{bb2},
                                  Some{ba2},
                                  eb22,
                                  Equal.cong(
                                    List<&2, Binding>,
                                    Maybe<&2, List<&2, Binding>>,
                                    x => Some{x},
                                    bb2,
                                    ba2,
                                    Equal.sym(List<&2, Binding>, ba2, bb2, er)
                                  )
                                )
                              )
                              %pp: {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, _, Item{k2, v2, r2} <> rest2}: Node}
                              %kk: {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev1, Item{_, v2, r2} <> rest2}: Node}
                              %vv: {Node{l, prev1, Item{k1, v1, r1} <> rest1} == Node{l, prev1, Item{k1, _, r2} <> rest2}: Node}
                              Equal.cong(Node, Node, n => Node.under(n, l, prev1, k1, v1), Node{l, r1, rest1}, Node{l, r2, rest2}, nr)
                          )(
                            Equal.trans(
                              List<&2, Binding>,
                              List.append(&2, Binding, ca, Binding{k1, v1} <> ba2),
                              a,
                              List.append(&2, Binding, cb, Binding{k2, v2} <> bb2),
                              Equal.trans(
                                List<&2, Binding>,
                                List.append(&2, Binding, ca, Binding{k1, v1} <> ba2),
                                List.append(&2, Binding, ca, ba),
                                a,
                                Equal.cong(List<&2, Binding>, List<&2, Binding>, x => List.append(&2, Binding, ca, x), Binding{k1, v1} <> ba2, ba, e61),
                                e51
                              ),
                              Equal.sym(
                                List<&2, Binding>,
                                List.append(&2, Binding, cb, Binding{k2, v2} <> bb2),
                                a,
                                Equal.trans(
                                  List<&2, Binding>,
                                  List.append(&2, Binding, cb, Binding{k2, v2} <> bb2),
                                  List.append(&2, Binding, cb, bx),
                                  a,
                                  Equal.cong(List<&2, Binding>, List<&2, Binding>, x => List.append(&2, Binding, cb, x), Binding{k2, v2} <> bb2, bx, e62),
                                  e52
                                )
                              )
                            )
                          )(
                            Mst.sub_below(
                              ~S,
                              ~fetch,
                              q,
                              s,
                              [],
                              prev1,
                              l,
                              lo,
                              Some{k1},
                              ca,
                              xs3 => l3 => left3 => ks3 => ep3 => ea3 => Mst.lists_below(~S, ~fetch, q, s, [], xs3, l3, left3, lo, Some{k1}, ks3, ca)(ep3)(ea3)
                            )(esl1)
                          )(
                            Mst.sub_below(
                              ~S,
                              ~fetch,
                              q,
                              s,
                              [],
                              prev2,
                              l,
                              lo,
                              Some{k2},
                              cb,
                              xs3 => l3 => left3 => ks3 => ep3 => ea3 => Mst.lists_below(~S, ~fetch, q, s, [], xs3, l3, left3, lo, Some{k2}, ks3, cb)(ep3)(ea3)
                            )(esl2)
                          )(
                            Shared.Bool.and_true_left(
                              Nat.is_eq(Key.level(k1), l),
                              Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Bool.not(List.is_empty(&2, U32, k1)))
                            )(
                              Shared.Bool.and_true_left(
                                Bool.and(Nat.is_eq(Key.level(k1), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev1), Bool.not(List.is_empty(&2, U32, k1)))),
                                Bool.and(Bound.after(lo, k1), Bound.before(k1, hi))
                              )(c1)
                            )
                          )(
                            Shared.Bool.and_true_left(
                              Nat.is_eq(Key.level(k2), l),
                              Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Bool.not(List.is_empty(&2, U32, k2)))
                            )(
                              Shared.Bool.and_true_left(
                                Bool.and(Nat.is_eq(Key.level(k2), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev2), Bool.not(List.is_empty(&2, U32, k2)))),
                                Bool.and(Bound.after(lo, k2), Bound.before(k2, hi))
                              )(c2)
                            )
                          )
                        )(eb2)
                      )(
                        Equal.trans(
                          Maybe<&2, List<&2, Binding>>,
                          Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev2, l, lo, Some{k2}, Piece.Bind{k2, v2} <> ks2b)),
                          Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2),
                          Some{a},
                          Equal.cong(
                            List<&2, Piece>,
                            Maybe<&2, List<&2, Binding>>,
                            x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
                            Piece.sub(prev2, l, lo, Some{k2}, Piece.Bind{k2, v2} <> ks2b),
                            ks2,
                            e42
                          ),
                          e2
                        )
                      )
                    )(eb1)
                  )(
                    Equal.trans(
                      Maybe<&2, List<&2, Binding>>,
                      Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev1, l, lo, Some{k1}, Piece.Bind{k1, v1} <> ks1b)),
                      Mst.range.go(~S, ~fetch, 1n+q, s, [], ks1),
                      Some{a},
                      Equal.cong(
                        List<&2, Piece>,
                        Maybe<&2, List<&2, Binding>>,
                        x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
                        Piece.sub(prev1, l, lo, Some{k1}, Piece.Bind{k1, v1} <> ks1b),
                        ks1,
                        e41
                      ),
                      e1
                    )
                  )
                )(e22)
              )(ep2)
            )(e21)
          )(ep1)

# Whole trees
# -----------

# no key under no prefix is before the bound lo: every key may come after it
def Bound.meets_lo_nil(lo: Maybe<&2, List<&2, U32>>) -> {Bound.meets_lo([], lo) == True{}: Bool}:
  match lo:
    case None{}:
      {==}
    case Some{+a}:
      %Equal.sym(Bool, Key.is_lt(a, []), False{}, Key.lt_nil(a)): {Bool.or(_, Key.leads([], a)) == True{}: Bool}
      {==}

# a subtree that a listing under no prefix skips, a listing under any prefix
# skips
def Bound.meets_any(+p: List<&2, U32>, +lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> {
  Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)) == False{}: Bool
} -> {Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)) == False{}: Bool}:
  match hi:
    case None{}:
      e => Empty.absurd(
        {Bool.and(Bound.meets_lo(p, lo), True{}) == False{}: Bool},
        Shared.Bool.true_ne_false(
          Equal.trans(
            Bool,
            True{},
            Bool.and(Bound.meets_lo([], lo), True{}),
            False{},
            Equal.trans(Bool, True{}, Bound.meets_lo([], lo), Bool.and(Bound.meets_lo([], lo), True{}), Equal.sym(Bool, Bound.meets_lo([], lo), True{}, Bound.meets_lo_nil(lo)), Shared.Bool.and_true(Bound.meets_lo([], lo))),
            e
          )
        )
      )
    case Some{b}:
      match b:
        case Nil{}:
          e =>
            %Equal.sym(Bool, Key.is_lt(p, []), False{}, Key.lt_nil(p)): {Bool.and(Bound.meets_lo(p, lo), _) == False{}: Bool}
            Shared.Bool.and_false_right(Bound.meets_lo(p, lo))
        case Con{x, r}:
          e => Empty.absurd(
            {Bool.and(Bound.meets_lo(p, lo), Key.is_lt(p, x <> r)) == False{}: Bool},
            Shared.Bool.true_ne_false(
              Equal.trans(
                Bool,
                True{},
                Bool.and(Bound.meets_lo([], lo), True{}),
                False{},
                Equal.trans(Bool, True{}, Bound.meets_lo([], lo), Bool.and(Bound.meets_lo([], lo), True{}), Equal.sym(Bool, Bound.meets_lo([], lo), True{}, Bound.meets_lo_nil(lo)), Shared.Bool.and_true(Bound.meets_lo([], lo))),
                e
              )
            )
          )

# a map has a value exactly when what it maps has one
def Maybe.map_is_some(-A: Data, -B: Data, -f: A -> B, m: Maybe<&2, A>) -> {
  Maybe.is_some(&2, B, Maybe.map(&2, A, B, f, m)) == Maybe.is_some(&2, A, m): Bool
}:
  match m:
    case None{}:
      {==}
    case Some{a}:
      {==}

# a Maybe that has a value holds one
def Maybe.some_cases(-A: Data, m: Maybe<&2, A>, -P: Type, k: @a: A -> {m == Some{a}: Maybe<&2, A>} -> P) -> {
  Maybe.is_some(&2, A, m) == True{}: Bool
} -> P:
  match m:
    case None{}:
      e => Empty.absurd(P, Shared.Bool.false_ne_true(e))
    case Some{+a}:
      e => k(a)({==})

# Mst.range_some at a subtree that the listing under no prefix reads (t)
def Mst.range_some.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  t: Bool,
  +q: Nat,
  +s: S,
  +p: List<&2, U32>,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +a: List<&2, Binding>,
  et: {Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)) == t: Bool},
  ihr: @b: List<&2, Binding> -> {Mst.range.go(~S, ~fetch, 1n+q, s, [], rest) == Some{b}: Maybe<&2, List<&2, Binding>>} -> {
    Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)) == True{}: Bool
  },
  ihs: @ks: List<&2, Piece> -> @b: List<&2, Binding> -> {Mst.range.go(~S, ~fetch, q, s, [], ks) == Some{b}: Maybe<&2, List<&2, Binding>>} -> {
    Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, q, s, p, ks)) == True{}: Bool
  }
) -> {
  Shared.Bool.when(
    Maybe<&2, List<&2, Binding>>,
    t,
    u => Maybe.bind(
      &2,
      List<&2, Piece>,
      List<&2, Binding>,
      Mst.open(~S, ~fetch, s, h, up, lo, hi),
      ks => Maybe.bind(
        &2,
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, q, s, [], ks),
        a2 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a2, b), Mst.range.go(~S, ~fetch, 1n+q, s, [], rest))
      )
    ),
    u => Mst.range.go(~S, ~fetch, 1n+q, s, [], rest)
  )
    == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.Sub{h, up, lo, hi} <> rest)) == True{}: Bool}:
  match t:
    case True{}:
      e => Maybe.bind_cases(
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, up, lo, hi),
        ks => Maybe.bind(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, [], ks),
          a2 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a2, b), Mst.range.go(~S, ~fetch, 1n+q, s, [], rest))
        ),
        a,
        {Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.Sub{h, up, lo, hi} <> rest)) == True{}: Bool},
        +ks => +eo => e2 => Maybe.bind_cases(
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, [], ks),
          a2 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a2, b), Mst.range.go(~S, ~fetch, 1n+q, s, [], rest)),
          a,
          {Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.Sub{h, up, lo, hi} <> rest)) == True{}: Bool},
          +a2 => ea => e3 => Maybe.map_cases(
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, 1n+q, s, [], rest),
            b => List.append(&2, Binding, a2, b),
            a,
            {Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.Sub{h, up, lo, hi} <> rest)) == True{}: Bool},
            +b => +eb => e4 =>
              +ir = ihr(b)(eb)
              Shared.Bool.when_cases(
              Maybe<&2, List<&2, Binding>>,
              x => {Maybe.is_some(&2, List<&2, Binding>, x) == True{}: Bool},
              Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
              u => Maybe.bind(
                &2,
                List<&2, Piece>,
                List<&2, Binding>,
                Mst.open(~S, ~fetch, s, h, up, lo, hi),
                ks2 => Maybe.bind(
                  &2,
                  List<&2, Binding>,
                  List<&2, Binding>,
                  Mst.range.go(~S, ~fetch, q, s, p, ks2),
                  a3 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, a3, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                )
              ),
              u => Mst.range.go(~S, ~fetch, 1n+q, s, p, rest),
              et2 =>
                %Equal.sym(Maybe<&2, List<&2, Piece>>, Mst.open(~S, ~fetch, s, h, up, lo, hi), Some{ks}, eo): {
                  Maybe.is_some(
                    &2,
                    List<&2, Binding>,
                    Maybe.bind(
                      &2,
                      List<&2, Piece>,
                      List<&2, Binding>,
                      _,
                      ks2 => Maybe.bind(
                        &2,
                        List<&2, Binding>,
                        List<&2, Binding>,
                        Mst.range.go(~S, ~fetch, q, s, p, ks2),
                        a3 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, a3, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                      )
                    )
                  )
                    == True{}: Bool
                }
                Maybe.some_cases(
                  List<&2, Binding>,
                  Mst.range.go(~S, ~fetch, q, s, p, ks),
                  {
                    Maybe.is_some(
                      &2,
                      List<&2, Binding>,
                      Maybe.bind(
                        &2,
                        List<&2, Binding>,
                        List<&2, Binding>,
                        Mst.range.go(~S, ~fetch, q, s, p, ks),
                        a3 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, a3, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                      )
                    )
                      == True{}: Bool
                  },
                  +x => ex =>
                    %Equal.sym(Maybe<&2, List<&2, Binding>>, Mst.range.go(~S, ~fetch, q, s, p, ks), Some{x}, ex): {
                      Maybe.is_some(
                        &2,
                        List<&2, Binding>,
                        Maybe.bind(
                          &2,
                          List<&2, Binding>,
                          List<&2, Binding>,
                          _,
                          a3 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, a3, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                        )
                      )
                        == True{}: Bool
                    }
                    %Equal.sym(
                      Bool,
                      Maybe.is_some(
                        &2,
                        List<&2, Binding>,
                        Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, x, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                      ),
                      Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)),
                      Maybe.map_is_some(List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, x, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                    ): {_ == True{}: Bool}
                    ir
                )(ihs(ks)(a2)(ea)),
              ef2 => ir
            )
          )(e3)
        )(e2)
      )(e)
    case False{}:
      e =>
        %Equal.sym(
          Bool,
          Bool.and(Bound.meets_lo(p, lo), Bound.meets_hi(p, hi)),
          False{},
          Bound.meets_any(p, lo, hi)(et)
        ): {
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Shared.Bool.when(
              Maybe<&2, List<&2, Binding>>,
              _,
              u => Maybe.bind(
                &2,
                List<&2, Piece>,
                List<&2, Binding>,
                Mst.open(~S, ~fetch, s, h, up, lo, hi),
                ks2 => Maybe.bind(
                  &2,
                  List<&2, Binding>,
                  List<&2, Binding>,
                  Mst.range.go(~S, ~fetch, q, s, p, ks2),
                  a3 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b2 => List.append(&2, Binding, a3, b2), Mst.range.go(~S, ~fetch, 1n+q, s, p, rest))
                )
              ),
              u => Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
            )
          )
            == True{}: Bool
        }
        ihr(a)(e)

# a listing under no prefix that reads lets a listing under any prefix read
def Mst.range_some(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  +p: List<&2, U32>,
  ps: List<&2, Piece>,
  +a: List<&2, Binding>
) -> {Mst.range.go(~S, ~fetch, f, s, [], ps) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {
  Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, f, s, p, ps)) == True{}: Bool
}:
  match f ps:
    case x Nil{}:
      e => {==}
    case 0n Con{x, rest}:
      e => Empty.absurd(
        {Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 0n, s, p, x <> rest)) == True{}: Bool},
        Shared.Maybe.none_ne_some(List<&2, Binding>, a, e)
      )
    case 1n+(+q) Con{Piece.Bind{+k, +v}, +rest}:
      e => Maybe.map_cases(
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, 1n+q, s, [], rest),
        +bs => Shared.Bool.when(List<&2, Binding>, Key.leads([], k), u => Binding{k, v} <> bs, u => bs),
        a,
        {Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, Piece.Bind{k, v} <> rest)) == True{}: Bool},
        +b => eb => e2 =>
          %Equal.sym(
            Bool,
            Maybe.is_some(
              &2,
              List<&2, Binding>,
              Maybe.map(
                &2,
                List<&2, Binding>,
                List<&2, Binding>,
                +bs => Shared.Bool.when(List<&2, Binding>, Key.leads(p, k), u => Binding{k, v} <> bs, u => bs),
                Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
              )
            ),
            Maybe.is_some(&2, List<&2, Binding>, Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)),
            Maybe.map_is_some(
              List<&2, Binding>,
              List<&2, Binding>,
              +bs => Shared.Bool.when(List<&2, Binding>, Key.leads(p, k), u => Binding{k, v} <> bs, u => bs),
              Mst.range.go(~S, ~fetch, 1n+q, s, p, rest)
            )
          ): {_ == True{}: Bool}
          Mst.range_some(~S, ~fetch, 1n+q, s, p, rest, b)(eb)
      )(e)
    case 1n+(+q) Con{Piece.Sub{+h, +up, +lo, +hi}, +rest}:
      e => Mst.range_some.at(
        ~S,
        ~fetch,
        Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)),
        q,
        s,
        p,
        h,
        up,
        lo,
        hi,
        rest,
        a,
        {==},
        b => eb => Mst.range_some(~S, ~fetch, 1n+q, s, p, rest, b)(eb),
        ks => b => eb => Mst.range_some(~S, ~fetch, q, s, p, ks, b)(eb)
      )(e)

# the subtrees of the pieces ps whose bounds hold k read k finally, f levels
# down
def Pieces.final(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +k: List<&2, U32>
) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{Piece.Bind{k2, v2}, rest}:
      Pieces.final(~S, ~fetch, f, s, rest, k)
    case Con{Piece.Sub{h, up, +lo, +hi}, rest}:
      Bool.and(
        Bool.or(
          Bool.not(Bool.and(Bound.after(lo, k), Bound.before(k, hi))),
          Look.is_final(Mst.look.go(~S, ~fetch, f, s, Room{up, lo, hi}, Some{h}, k))
        ),
        Pieces.final(~S, ~fetch, f, s, rest, k)
      )

# a not-or whose test holds is its second side
def Bool.or_not_true(i: Bool, -x: Bool) -> {Bool.or(Bool.not(i), x) == True{}: Bool} -> {i == True{}: Bool} -> {x == True{}: Bool}:
  match i:
    case True{}:
      h => e => h
    case False{}:
      h => e => Empty.absurd({x == True{}: Bool}, Shared.Bool.false_ne_true(e))

# a not-or holds when its second side follows from its test
def Bool.or_not_of(i: Bool, -x: Bool) -> ({i == True{}: Bool} -> {x == True{}: Bool}) -> {Bool.or(Bool.not(i), x) == True{}: Bool}:
  match i:
    case True{}:
      g => g({==})
    case False{}:
      g => {==}

# a subtree whose bounds hold k, of pieces that read k finally, reads it
# finally
def Mst.final_at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.final(~S, ~fetch, f, s, Piece.sub(m, l, lo, hi, rest), k) == True{}: Bool} -> {
  Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool
} -> {Look.is_final(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, m, k)) == True{}: Bool}:
  match m:
    case None{}:
      h => i =>
        %Equal.sym(Look, Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, None{}, k), Look.Absent{}, Mst.look_none(~S, ~fetch, f, s, Room{l, lo, hi}, k)): {
          Look.is_final(_) == True{}: Bool
        }
        {==}
    case Some{+h2}:
      h => i => Bool.or_not_true(
        Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
        Look.is_final(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, Some{h2}, k))
      )(
        Shared.Bool.and_true_left(
          Bool.or(
            Bool.not(Bool.and(Bound.after(lo, k), Bound.before(k, hi))),
            Look.is_final(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, Some{h2}, k))
          ),
          Pieces.final(~S, ~fetch, f, s, rest, k)
        )(h)
      )(i)

# the pieces after a subtree read k finally when all do
def Mst.final_rest(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.final(~S, ~fetch, f, s, Piece.sub(m, l, lo, hi, rest), k) == True{}: Bool} -> {
  Pieces.final(~S, ~fetch, f, s, rest, k) == True{}: Bool
}:
  match m:
    case None{}:
      h => h
    case Some{+h2}:
      h => Shared.Bool.and_true_right(
        Bool.or(
          Bool.not(Bool.and(Bound.after(lo, k), Bound.before(k, hi))),
          Look.is_final(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, Some{h2}, k))
        ),
        Pieces.final(~S, ~fetch, f, s, rest, k)
      )(h)

# Mst.final_pick at an item of the key ik, whose comparison with k is c
def Mst.final_pick.con(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks2: List<&2, Piece>,
  +k: List<&2, U32>,
  +ec: {Key.cmp(k, ik) == c: Cmp},
  hf: {Pieces.final(~S, ~fetch, f, s, Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), k) == True{}: Bool},
  +hin: {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool},
  ew: {Nat.is_eq(Key.level(ik), l) == True{}: Bool},
  ih: {Pieces.final(~S, ~fetch, f, s, ks2, k) == True{}: Bool} -> {Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)) == True{}: Bool} -> {
    Look.is_final(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))) == True{}: Bool
  }
) -> {
  Look.is_final(
    Mst.look.pick(
      Shared.Bool.when(
        Pick,
        Cmp.is_lt(c),
        u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
        u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k))
      ),
      h,
      l,
      k,
      m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)
    )
  )
    == True{}: Bool
}:
  match c:
    case LT{}:
      Mst.final_at(
        ~S,
        ~fetch,
        f,
        s,
        prev,
        l,
        lo,
        Some{ik},
        Piece.Bind{ik, iv} <> ks2,
        k
      )(hf)(
        Shared.Bool.and_both(Bound.after(lo, k), Key.is_lt(k, ik))(Shared.Bool.and_true_left(Bound.after(lo, k), Bound.before(k, hi))(hin))(
          Key.lt_of(k, ik, LT{})(ec)
        )
      )
    case EQ{}:
      %Equal.sym(
        Bool,
        Nat.is_eq(Key.level(k), l),
        True{},
        Equal.trans(
          Bool,
          Nat.is_eq(Key.level(k), l),
          Nat.is_eq(Key.level(ik), l),
          True{},
          Equal.cong(List<&2, U32>, Bool, x => Nat.is_eq(Key.level(x), l), k, ik, Key.cmp_eq(k, ik)(ec)),
          ew
        )
      ): {Look.is_final(Shared.Bool.when(Look, _, u => Look.Found{iv}, u => Look.Missing{h})) == True{}: Bool}
      {==}
    case GT{}:
      ih(Mst.final_rest(~S, ~fetch, f, s, prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2, k)(hf))(
        Shared.Bool.and_both(Key.is_lt(ik, k), Bound.before(k, hi))(Key.gt_of(k, ik, GT{})(ec))(
          Shared.Bool.and_true_right(Bound.after(lo, k), Bound.before(k, hi))(hin)
        )
      )

# a read of k in a node, between the bounds of its items, is final when its
# pieces read k finally
def Mst.final_pick(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {Pieces.final(~S, ~fetch, f, s, ks, k) == True{}: Bool} -> {
  Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool
} -> {
  Look.is_final(Mst.look.pick(Mst.pick(xs, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))) == True{}: Bool
}:
  match xs:
    case Nil{}:
      ep => hf => hin => Mst.final_at(
        ~S,
        ~fetch,
        f,
        s,
        prev,
        l,
        lo,
        hi,
        [],
        k
      )(
        Equal.trans(
          Bool,
          Pieces.final(~S, ~fetch, f, s, Piece.sub(prev, l, lo, hi, []), k),
          Pieces.final(~S, ~fetch, f, s, ks, k),
          True{},
          Equal.cong(
            List<&2, Piece>,
            Bool,
            x => Pieces.final(~S, ~fetch, f, s, x, k),
            Piece.sub(prev, l, lo, hi, []),
            ks,
            Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep)
          ),
          hf
        )
      )(hin)
    case Con{Item{+ik, +iv, +r}, +rest}:
      ep => hf => hin => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
          Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          Mst.pieces(rest, l, r, Some{ik}, hi)
        ),
        ks,
        {
          Look.is_final(
            Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))
          )
            == True{}: Bool
        },
        +c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{ik}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          ks,
          {
            Look.is_final(
              Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))
            )
              == True{}: Bool
          },
          +ks2 => e3 => e4 => Mst.final_pick.con(
            ~S,
            ~fetch,
            Key.cmp(k, ik),
            f,
            s,
            h,
            ik,
            iv,
            r,
            rest,
            l,
            prev,
            lo,
            hi,
            ks2,
            k,
            {==},
            Equal.trans(
              Bool,
              Pieces.final(~S, ~fetch, f, s, Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), k),
              Pieces.final(~S, ~fetch, f, s, ks, k),
              True{},
              Equal.cong(List<&2, Piece>, Bool, x => Pieces.final(~S, ~fetch, f, s, x, k), Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), ks, e4),
              hf
            ),
            hin,
            Shared.Bool.and_true_left(
              Nat.is_eq(Key.level(ik), l),
              Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))
            )(
              Shared.Bool.and_true_left(
                Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
                Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
              )(c)
            ),
            hf3 => hin3 => Mst.final_pick(~S, ~fetch, f, s, h, rest, l, r, Some{ik}, hi, ks2, k)(e3)(hf3)(hin3)
          )
        )(e2)
      )(ep)

# a read of k in an opened node, between its bounds, is final when its pieces
# read k finally
def Mst.final_open(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Mst.open(~S, ~fetch, s, h, up, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {Pieces.final(~S, ~fetch, q, s, ks, k) == True{}: Bool} -> {
  Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool
} -> {Look.is_final(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k)) == True{}: Bool}:
  eo => hf => hin => Mst.open_cases(
    ~S,
    ~fetch,
    s,
    h,
    up,
    lo,
    hi,
    ks,
    {Look.is_final(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k)) == True{}: Bool},
    +l => +left => +xs => ef => eh => en => elt => ee => ep =>
      %Equal.sym(Maybe<&2, Node>, Mst.node.in(~S, ~fetch, s, h, Room{up, lo, hi}), Some{Node{l, left, xs}}, en): {
        Look.is_final(Mst.look.at(h, _, Room{up, lo, hi}, k, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k))) == True{}: Bool
      }
      Mst.final_pick(~S, ~fetch, q, s, h, xs, l, left, lo, hi, ks, k)(ep)(hf)(hin)
  )(eo)

# a subtree that a listing under no prefix skips holds no key
def Bound.not_in(+lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>, -x: Bool) -> {
  Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)) == False{}: Bool
} -> {Bool.or(Bool.not(Bool.and(Bound.after(lo, k), Bound.before(k, hi))), x) == True{}: Bool}:
  match hi:
    case None{}:
      e => Empty.absurd(
        {Bool.or(Bool.not(Bool.and(Bound.after(lo, k), True{})), x) == True{}: Bool},
        Shared.Bool.true_ne_false(
          Equal.trans(
            Bool,
            True{},
            Bool.and(Bound.meets_lo([], lo), True{}),
            False{},
            Equal.trans(Bool, True{}, Bound.meets_lo([], lo), Bool.and(Bound.meets_lo([], lo), True{}), Equal.sym(Bool, Bound.meets_lo([], lo), True{}, Bound.meets_lo_nil(lo)), Shared.Bool.and_true(Bound.meets_lo([], lo))),
            e
          )
        )
      )
    case Some{b}:
      match b:
        case Nil{}:
          e =>
            %Equal.sym(Bool, Key.is_lt(k, []), False{}, Key.lt_nil(k)): {Bool.or(Bool.not(Bool.and(Bound.after(lo, k), _)), x) == True{}: Bool}
            %Equal.sym(Bool, Bool.and(Bound.after(lo, k), False{}), False{}, Shared.Bool.and_false_right(Bound.after(lo, k))): {
              Bool.or(Bool.not(_), x) == True{}: Bool
            }
            {==}
        case Con{y, r}:
          e => Empty.absurd(
            {Bool.or(Bool.not(Bool.and(Bound.after(lo, k), Key.is_lt(k, y <> r))), x) == True{}: Bool},
            Shared.Bool.true_ne_false(
              Equal.trans(
                Bool,
                True{},
                Bool.and(Bound.meets_lo([], lo), True{}),
                False{},
                Equal.trans(Bool, True{}, Bound.meets_lo([], lo), Bool.and(Bound.meets_lo([], lo), True{}), Equal.sym(Bool, Bound.meets_lo([], lo), True{}, Bound.meets_lo_nil(lo)), Shared.Bool.and_true(Bound.meets_lo([], lo))),
                e
              )
            )
          )

# Mst.final_list at a subtree, by whether the listing reads it (t)
def Mst.final_list.at(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  t: Bool,
  +q: Nat,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +a: List<&2, Binding>,
  +k: List<&2, U32>,
  et: {Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)) == t: Bool},
  ihr: @b: List<&2, Binding> -> {Mst.range.go(~S, ~fetch, 1n+q, s, [], rest) == Some{b}: Maybe<&2, List<&2, Binding>>} -> {
    Pieces.final(~S, ~fetch, 1n+q, s, rest, k) == True{}: Bool
  },
  ihs: @ks: List<&2, Piece> -> @b: List<&2, Binding> -> {Mst.range.go(~S, ~fetch, q, s, [], ks) == Some{b}: Maybe<&2, List<&2, Binding>>} -> {
    Pieces.final(~S, ~fetch, q, s, ks, k) == True{}: Bool
  }
) -> {
  Shared.Bool.when(
    Maybe<&2, List<&2, Binding>>,
    t,
    u => Maybe.bind(
      &2,
      List<&2, Piece>,
      List<&2, Binding>,
      Mst.open(~S, ~fetch, s, h, up, lo, hi),
      ks => Maybe.bind(
        &2,
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, q, s, [], ks),
        a2 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a2, b), Mst.range.go(~S, ~fetch, 1n+q, s, [], rest))
      )
    ),
    u => Mst.range.go(~S, ~fetch, 1n+q, s, [], rest)
  )
    == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Pieces.final(~S, ~fetch, 1n+q, s, Piece.Sub{h, up, lo, hi} <> rest, k) == True{}: Bool}:
  match t:
    case True{}:
      e => Maybe.bind_cases(
        List<&2, Piece>,
        List<&2, Binding>,
        Mst.open(~S, ~fetch, s, h, up, lo, hi),
        ks => Maybe.bind(
          &2,
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, [], ks),
          a2 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a2, b), Mst.range.go(~S, ~fetch, 1n+q, s, [], rest))
        ),
        a,
        {Pieces.final(~S, ~fetch, 1n+q, s, Piece.Sub{h, up, lo, hi} <> rest, k) == True{}: Bool},
        +ks => eo => e2 => Maybe.bind_cases(
          List<&2, Binding>,
          List<&2, Binding>,
          Mst.range.go(~S, ~fetch, q, s, [], ks),
          a2 => Maybe.map(&2, List<&2, Binding>, List<&2, Binding>, b => List.append(&2, Binding, a2, b), Mst.range.go(~S, ~fetch, 1n+q, s, [], rest)),
          a,
          {Pieces.final(~S, ~fetch, 1n+q, s, Piece.Sub{h, up, lo, hi} <> rest, k) == True{}: Bool},
          +a2 => ea => e3 => Maybe.map_cases(
            List<&2, Binding>,
            List<&2, Binding>,
            Mst.range.go(~S, ~fetch, 1n+q, s, [], rest),
            b => List.append(&2, Binding, a2, b),
            a,
            {Pieces.final(~S, ~fetch, 1n+q, s, Piece.Sub{h, up, lo, hi} <> rest, k) == True{}: Bool},
            b => eb => e4 => Shared.Bool.and_both(
              Bool.or(
                Bool.not(Bool.and(Bound.after(lo, k), Bound.before(k, hi))),
                Look.is_final(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k))
              ),
              Pieces.final(~S, ~fetch, 1n+q, s, rest, k)
            )(
              Bool.or_not_of(
                Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                Look.is_final(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k))
              )(hin => Mst.final_open(~S, ~fetch, q, s, h, up, lo, hi, ks, k)(eo)(ihs(ks)(a2)(ea))(hin))
            )(ihr(b)(eb))
          )(e3)
        )(e2)
      )(e)
    case False{}:
      e => Shared.Bool.and_both(
        Bool.or(
          Bool.not(Bool.and(Bound.after(lo, k), Bound.before(k, hi))),
          Look.is_final(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k))
        ),
        Pieces.final(~S, ~fetch, 1n+q, s, rest, k)
      )(Bound.not_in(lo, hi, k, Look.is_final(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k)))(et))(ihr(a)(e))

# the pieces of a listing under no prefix that reads read every key finally
def Mst.final_list(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +a: List<&2, Binding>,
  +k: List<&2, U32>
) -> {Mst.range.go(~S, ~fetch, f, s, [], ps) == Some{a}: Maybe<&2, List<&2, Binding>>} -> {Pieces.final(~S, ~fetch, f, s, ps, k) == True{}: Bool}:
  match f ps:
    case x Nil{}:
      e => {==}
    case 0n Con{x, rest}:
      e => Empty.absurd({Pieces.final(~S, ~fetch, 0n, s, x <> rest, k) == True{}: Bool}, Shared.Maybe.none_ne_some(List<&2, Binding>, a, e))
    case 1n+(+q) Con{Piece.Bind{+k2, +v2}, +rest}:
      e => Maybe.map_cases(
        List<&2, Binding>,
        List<&2, Binding>,
        Mst.range.go(~S, ~fetch, 1n+q, s, [], rest),
        +bs => Shared.Bool.when(List<&2, Binding>, Key.leads([], k2), u => Binding{k2, v2} <> bs, u => bs),
        a,
        {Pieces.final(~S, ~fetch, 1n+q, s, rest, k) == True{}: Bool},
        +b => eb => e2 => Mst.final_list(~S, ~fetch, 1n+q, s, rest, b, k)(eb)
      )(e)
    case 1n+(+q) Con{Piece.Sub{+h, +up, +lo, +hi}, +rest}:
      e => Mst.final_list.at(
        ~S,
        ~fetch,
        Bool.and(Bound.meets_lo([], lo), Bound.meets_hi([], hi)),
        q,
        s,
        h,
        up,
        lo,
        hi,
        rest,
        a,
        k,
        {==},
        b => eb => Mst.final_list(~S, ~fetch, 1n+q, s, rest, b, k)(eb),
        ks => b => eb => Mst.final_list(~S, ~fetch, q, s, ks, b, k)(eb)
      )(e)

# a read of a tree that lists whole is final
def Mst.final_root(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  h: Maybe<&2, Hashes.Hash>,
  +k: List<&2, U32>
) -> {Pieces.final(~S, ~fetch, Mst.depth(), s, Mst.root(h), k) == True{}: Bool} -> {
  Look.is_final(Mst.look(~S, ~fetch, s, h, k)) == True{}: Bool
}:
  match h:
    case None{}:
      hf => {==}
    case Some{+h2}:
      hf => Shared.Bool.and_true_left(Look.is_final(Mst.look(~S, ~fetch, s, Some{h2}, k)), True{})(hf)

# Differences of whole trees
# --------------------------

# each subtree of the pieces ps has keys in its bounds and lists whole, q
# levels down
def Pieces.ok(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +q: Nat, +s: S, ps: List<&2, Piece>) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{Piece.Bind{k, v}, rest}:
      Pieces.ok(~S, ~fetch, q, s, rest)
    case Con{Piece.Sub{h, up, +lo, +hi}, rest}:
      Bool.and(
        Bool.and(
          Bound.before([], hi),
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
          )
        ),
        Pieces.ok(~S, ~fetch, q, s, rest)
      )

# both sides of each of the runs ps are ok
def Runs.ok(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +q: Nat, +s: S, ps: List<&2, Runs>) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{Runs{a, b}, rest}:
      Bool.and(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))

# the pieces ps, then the pieces acc, are ok when both are
def Pieces.ok_append(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +acc: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, ps) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, acc) == True{}: Bool} -> {
  Pieces.ok(~S, ~fetch, q, s, List.append(&2, Piece, ps, acc)) == True{}: Bool
}:
  match ps:
    case Nil{}:
      h => g => g
    case Con{Piece.Bind{k, v}, +rest}:
      h => g => Pieces.ok_append(~S, ~fetch, q, s, rest, acc)(h)(g)
    case Con{Piece.Sub{+h2, +up, +lo, +hi}, +rest}:
      +h => g => Shared.Bool.and_both(
        Bool.and(
          Bound.before([], hi),
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h2, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
          )
        ),
        Pieces.ok(~S, ~fetch, q, s, List.append(&2, Piece, rest, acc))
      )(
        Shared.Bool.and_true_left(
          Bool.and(
            Bound.before([], hi),
            Maybe.is_some(
              &2,
              List<&2, Binding>,
              Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h2, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
            )
          ),
          Pieces.ok(~S, ~fetch, q, s, rest)
        )(h)
      )(
        Pieces.ok_append(
          ~S,
          ~fetch,
          q,
          s,
          rest,
          acc
        )(
          Shared.Bool.and_true_right(
            Bool.and(
              Bound.before([], hi),
              Maybe.is_some(
                &2,
                List<&2, Binding>,
                Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h2, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
              )
            ),
            Pieces.ok(~S, ~fetch, q, s, rest)
          )(h)
        )(g)
      )

# the piece x before ok pieces is ok when x before others is
def Pieces.ok_move(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  x: Piece,
  -r: List<&2, Piece>,
  +acc: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, x <> r) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, acc) == True{}: Bool} -> {
  Pieces.ok(~S, ~fetch, q, s, x <> acc) == True{}: Bool
}:
  match x:
    case Piece.Bind{k, v}:
      h => g => g
    case Piece.Sub{+h2, +up, +lo, +hi}:
      h => g => Shared.Bool.and_both(
        Bool.and(
          Bound.before([], hi),
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h2, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
          )
        ),
        Pieces.ok(~S, ~fetch, q, s, acc)
      )(
        Shared.Bool.and_true_left(
          Bool.and(
            Bound.before([], hi),
            Maybe.is_some(
              &2,
              List<&2, Binding>,
              Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h2, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
            )
          ),
          Pieces.ok(~S, ~fetch, q, s, r)
        )(h)
      )(g)

# the pieces after an ok piece are ok
def Pieces.ok_tail(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  x: Piece,
  +r: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, x <> r) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, r) == True{}: Bool}:
  match x:
    case Piece.Bind{k, v}:
      h => h
    case Piece.Sub{+h2, +up, +lo, +hi}:
      h => Shared.Bool.and_true_right(
        Bool.and(
          Bound.before([], hi),
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h2, up, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
          )
        ),
        Pieces.ok(~S, ~fetch, q, s, r)
      )(h)

# ok pieces read back to front, after ok pieces acc, are ok
def Pieces.ok_reverse(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +acc: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, ps) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, acc) == True{}: Bool} -> {
  Pieces.ok(~S, ~fetch, q, s, List.reverse.go(&2, Piece, ps, acc)) == True{}: Bool
}:
  match ps:
    case Nil{}:
      h => g => g
    case Con{+x, +rest}:
      +h => g => Pieces.ok_reverse(
        ~S,
        ~fetch,
        q,
        s,
        rest,
        x <> acc
      )(Pieces.ok_tail(~S, ~fetch, q, s, x, rest)(h))(Pieces.ok_move(~S, ~fetch, q, s, x, rest, acc)(h)(g))

# the runs of the round r with the run p first
def Round.pairs_cons(p: Runs, r: Round) -> {Round.pairs(Round.cons(p, r)) == p <> Round.pairs(r): List<&2, Runs>}:
  match r:
    case Round{ks, ps}:
      {==}

# the runs of a round with a differing key are its runs
def Round.pairs_differs(k: List<&2, U32>, v1: List<&2, U32>, v2: List<&2, U32>, r: Round) -> {
  Round.pairs(Round.differs(k, v1, v2, r)) == Round.pairs(r): List<&2, Runs>
}:
  match r:
    case Round{ks, ps}:
      {==}

# the runs of two rounds, one after the other
def Round.pairs_append(a: Round, b: Round) -> {
  Round.pairs(Round.append(a, b)) == List.append(&2, Runs, Round.pairs(a), Round.pairs(b)): List<&2, Runs>
}:
  match a b:
    case Round{k1, p1} Round{k2, p2}:
      {==}

# ok runs, then ok runs, are ok
def Runs.ok_append(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  ps: List<&2, Runs>,
  +acc: List<&2, Runs>
) -> {Runs.ok(~S, ~fetch, q, s, ps) == True{}: Bool} -> {Runs.ok(~S, ~fetch, q, s, acc) == True{}: Bool} -> {
  Runs.ok(~S, ~fetch, q, s, List.append(&2, Runs, ps, acc)) == True{}: Bool
}:
  match ps:
    case Nil{}:
      h => g => g
    case Con{Runs{+a, +b}, +rest}:
      +h => g => Shared.Bool.and_both(
        Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)),
        Runs.ok(~S, ~fetch, q, s, List.append(&2, Runs, rest, acc))
      )(
        Shared.Bool.and_true_left(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))(h)
      )(
        Runs.ok_append(
          ~S,
          ~fetch,
          q,
          s,
          rest,
          acc
        )(Shared.Bool.and_true_right(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))(h))(g)
      )

# a run cut out of two ok sides, read back to front, is ok
def Runs.ok_emit(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +sa: List<&2, Piece>,
  +sb: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, sa) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, sb) == True{}: Bool} -> {
  Bool.and(Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sa)), Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sb))) == True{}: Bool
}:
  ha => hb => Shared.Bool.and_both(
    Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sa)),
    Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sb))
  )(Pieces.ok_reverse(~S, ~fetch, q, s, sa, [])(ha)({==}))(Pieces.ok_reverse(~S, ~fetch, q, s, sb, [])(hb)({==}))

# the runs that a cut of ok pieces gives are ok
def Mst.cut_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  as: List<&2, Piece>,
  bs: List<&2, Piece>,
  +sa: List<&2, Piece>,
  +sb: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, as) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, bs) == True{}: Bool} -> {
  Pieces.ok(~S, ~fetch, q, s, sa) == True{}: Bool
} -> {Pieces.ok(~S, ~fetch, q, s, sb) == True{}: Bool} -> {Runs.ok(~S, ~fetch, q, s, Round.pairs(Mst.cut(as, bs, sa, sb))) == True{}: Bool}:
  match as bs:
    case Nil{} Nil{}:
      ha => hb => hsa => hsb => Shared.Bool.and_both(
        Bool.and(Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sa)), Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sb))),
        True{}
      )(Runs.ok_emit(~S, ~fetch, q, s, sa, sb)(hsa)(hsb))({==})
    case Nil{} Con{+y, +rb}:
      ha => +hb => hsa => hsb => Mst.cut_ok(
        ~S,
        ~fetch,
        q,
        s,
        [],
        rb,
        sa,
        y <> sb
      )(ha)(Pieces.ok_tail(~S, ~fetch, q, s, y, rb)(hb))(hsa)(Pieces.ok_move(~S, ~fetch, q, s, y, rb, sb)(hb)(hsb))
    case Con{+x, +ra} Nil{}:
      +ha => hb => hsa => hsb => Mst.cut_ok(
        ~S,
        ~fetch,
        q,
        s,
        ra,
        [],
        x <> sa,
        sb
      )(Pieces.ok_tail(~S, ~fetch, q, s, x, ra)(ha))(hb)(Pieces.ok_move(~S, ~fetch, q, s, x, ra, sa)(ha)(hsa))(hsb)
    case Con{Piece.Sub{+h, +u, +lo, +hi}, +ra} Con{+y, +rb}:
      +ha => hb => hsa => hsb => Mst.cut_ok(
        ~S,
        ~fetch,
        q,
        s,
        ra,
        y <> rb,
        Piece.Sub{h, u, lo, hi} <> sa,
        sb
      )(Pieces.ok_tail(~S, ~fetch, q, s, Piece.Sub{h, u, lo, hi}, ra)(ha))(hb)(
        Pieces.ok_move(~S, ~fetch, q, s, Piece.Sub{h, u, lo, hi}, ra, sa)(ha)(hsa)
      )(hsb)
    case Con{Piece.Bind{+k1, +v1}, +ra} Con{Piece.Sub{+h, +u, +lo, +hi}, +rb}:
      ha => +hb => hsa => hsb => Mst.cut_ok(
        ~S,
        ~fetch,
        q,
        s,
        Piece.Bind{k1, v1} <> ra,
        rb,
        sa,
        Piece.Sub{h, u, lo, hi} <> sb
      )(ha)(Pieces.ok_tail(~S, ~fetch, q, s, Piece.Sub{h, u, lo, hi}, rb)(hb))(hsa)(
        Pieces.ok_move(~S, ~fetch, q, s, Piece.Sub{h, u, lo, hi}, rb, sb)(hb)(hsb)
      )
    case Con{Piece.Bind{+k1, +v1}, +ra} Con{Piece.Bind{+k2, +v2}, +rb}:
      +ha => +hb => +hsa => +hsb => Shared.Bool.when_cases(
        Round,
        x => {Runs.ok(~S, ~fetch, q, s, Round.pairs(x)) == True{}: Bool},
        Cmp.is_lt(Key.cmp(k1, k2)),
        w => Mst.cut(ra, Piece.Bind{k2, v2} <> rb, Piece.Bind{k1, v1} <> sa, sb),
        w => Shared.Bool.when(
          Round,
          Cmp.is_eq(Key.cmp(k1, k2)),
          w2 => Round.cons(Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)}, Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], []))),
          w2 => Mst.cut(Piece.Bind{k1, v1} <> ra, rb, sa, Piece.Bind{k2, v2} <> sb)
        ),
        e1 => Mst.cut_ok(~S, ~fetch, q, s, ra, Piece.Bind{k2, v2} <> rb, Piece.Bind{k1, v1} <> sa, sb)(ha)(hb)(hsa)(hsb),
        e1 => Shared.Bool.when_cases(
          Round,
          x => {Runs.ok(~S, ~fetch, q, s, Round.pairs(x)) == True{}: Bool},
          Cmp.is_eq(Key.cmp(k1, k2)),
          w2 => Round.cons(Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)}, Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], []))),
          w2 => Mst.cut(Piece.Bind{k1, v1} <> ra, rb, sa, Piece.Bind{k2, v2} <> sb),
          e2 =>
            %Equal.sym(
              List<&2, Runs>,
              Round.pairs(Round.cons(Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)}, Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], [])))),
              Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)} <> Round.pairs(Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], []))),
              Round.pairs_cons(Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)}, Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], [])))
            ): {Runs.ok(~S, ~fetch, q, s, _) == True{}: Bool}
            %Equal.sym(
              List<&2, Runs>,
              Round.pairs(Round.differs(k1, v1, v2, Mst.cut(ra, rb, [], []))),
              Round.pairs(Mst.cut(ra, rb, [], [])),
              Round.pairs_differs(k1, v1, v2, Mst.cut(ra, rb, [], []))
            ): {Runs.ok(~S, ~fetch, q, s, Runs{List.reverse(&2, Piece, sa), List.reverse(&2, Piece, sb)} <> _) == True{}: Bool}
            Shared.Bool.and_both(
              Bool.and(Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sa)), Pieces.ok(~S, ~fetch, q, s, List.reverse(&2, Piece, sb))),
              Runs.ok(~S, ~fetch, q, s, Round.pairs(Mst.cut(ra, rb, [], [])))
            )(Runs.ok_emit(~S, ~fetch, q, s, sa, sb)(hsa)(hsb))(Mst.cut_ok(~S, ~fetch, q, s, ra, rb, [], [])(ha)(hb)({==})({==})),
          e2 => Mst.cut_ok(~S, ~fetch, q, s, Piece.Bind{k1, v1} <> ra, rb, sa, Piece.Bind{k2, v2} <> sb)(ha)(hb)(hsa)(hsb)
        )
      )

# both sides of the run r are ok
def Runs.ok1(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +q: Nat, +s: S, r: Runs) -> Bool:
  match r:
    case Runs{a, b}:
      Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b))

# a trim of ok pieces leaves ok pieces
def Mst.trim_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  as: List<&2, Piece>,
  bs: List<&2, Piece>
) -> {Pieces.ok(~S, ~fetch, q, s, as) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, bs) == True{}: Bool} -> {
  Runs.ok1(~S, ~fetch, q, s, Mst.trim(as, bs)) == True{}: Bool
}:
  match as bs:
    case Con{+x, +ra} Con{+y, +rb}:
      +ha => +hb => Shared.Bool.when_cases(
        Runs,
        r => {Runs.ok1(~S, ~fetch, q, s, r) == True{}: Bool},
        Piece.same(x, y),
        u => Mst.trim(ra, rb),
        u => Runs{x <> ra, y <> rb},
        e => Mst.trim_ok(~S, ~fetch, q, s, ra, rb)(Pieces.ok_tail(~S, ~fetch, q, s, x, ra)(ha))(Pieces.ok_tail(~S, ~fetch, q, s, y, rb)(hb)),
        e => Shared.Bool.and_both(Pieces.ok(~S, ~fetch, q, s, x <> ra), Pieces.ok(~S, ~fetch, q, s, y <> rb))(ha)(hb)
      )
    case Nil{} ys:
      ha => hb => Shared.Bool.and_both(True{}, Pieces.ok(~S, ~fetch, q, s, ys))({==})(hb)
    case Con{+x, +ra} Nil{}:
      ha => hb => Shared.Bool.and_both(Pieces.ok(~S, ~fetch, q, s, x <> ra), True{})(ha)({==})

# a trimmed run trims to ok sides
def Runs.trim_front_ok(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +q: Nat, +s: S, r: Runs) -> {
  Runs.ok1(~S, ~fetch, q, s, r) == True{}: Bool
} -> {Runs.ok1(~S, ~fetch, q, s, Runs.trim_front(r)) == True{}: Bool}:
  match r:
    case Runs{+a, +b}:
      +h => Mst.trim_ok(
        ~S,
        ~fetch,
        q,
        s,
        a,
        b
      )(Shared.Bool.and_true_left(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b))(h))(
        Shared.Bool.and_true_right(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b))(h)
      )

# a run read back to front has ok sides
def Runs.reverse_ok(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +q: Nat, +s: S, r: Runs) -> {
  Runs.ok1(~S, ~fetch, q, s, r) == True{}: Bool
} -> {Runs.ok1(~S, ~fetch, q, s, Runs.reverse(r)) == True{}: Bool}:
  match r:
    case Runs{+a, +b}:
      +h => Runs.ok_emit(
        ~S,
        ~fetch,
        q,
        s,
        a,
        b
      )(Shared.Bool.and_true_left(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b))(h))(
        Shared.Bool.and_true_right(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b))(h)
      )

# a run trimmed at both ends has ok sides
def Runs.trim_ok(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +q: Nat, +s: S, +r: Runs) -> {
  Runs.ok1(~S, ~fetch, q, s, r) == True{}: Bool
} -> {Runs.ok1(~S, ~fetch, q, s, Runs.trim(r)) == True{}: Bool}:
  h => Runs.reverse_ok(
    ~S,
    ~fetch,
    q,
    s,
    Runs.trim_front(Runs.reverse(Runs.trim_front(r)))
  )(
    Runs.trim_front_ok(
      ~S,
      ~fetch,
      q,
      s,
      Runs.reverse(Runs.trim_front(r))
    )(Runs.reverse_ok(~S, ~fetch, q, s, Runs.trim_front(r))(Runs.trim_front_ok(~S, ~fetch, q, s, r)(h)))
  )

# a subtree whose bounds hold keys and which lists whole, before ok pieces,
# gives ok pieces
def Pieces.ok_sub(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +a: List<&2, Binding>
) -> {Bool.or(Maybe.is_none(&2, Hashes.Hash, m), Bound.before([], hi)) == True{}: Bool} -> {
  Mst.sub_list(~S, ~fetch, q, s, [], m, l, lo, hi) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Pieces.ok(~S, ~fetch, q, s, rest) == True{}: Bool} -> {Pieces.ok(~S, ~fetch, q, s, Piece.sub(m, l, lo, hi, rest)) == True{}: Bool}:
  match m:
    case None{}:
      hn => esl => hr => hr
    case Some{+h}:
      +hn => esl => hr => Shared.Bool.and_both(
        Bool.and(
          Bound.before([], hi),
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, l, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
          )
        ),
        Pieces.ok(~S, ~fetch, q, s, rest)
      )(
        Shared.Bool.and_both(
          Bound.before([], hi),
          Maybe.is_some(
            &2,
            List<&2, Binding>,
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, l, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks))
          )
        )(hn)(
          Equal.cong(
            Maybe<&2, List<&2, Binding>>,
            Bool,
            x => Maybe.is_some(&2, List<&2, Binding>, x),
            Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, l, lo, hi), ks => Mst.range.go(~S, ~fetch, q, s, [], ks)),
            Some{a},
            Mst.sub_list_on(~S, ~fetch, q, s, h, l, lo, hi, a)(hn)(esl)
          )
        )
      )(hr)

# the pieces of a node whose upper bound holds keys, when a listing of them
# reads, are ok one level down
def Mst.pieces_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +a: List<&2, Binding>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {Bound.before([], hi) == True{}: Bool} -> {
  Mst.range.go(~S, ~fetch, 1n+q, s, [], ks) == Some{a}: Maybe<&2, List<&2, Binding>>
} -> {Pieces.ok(~S, ~fetch, q, s, ks) == True{}: Bool}:
  match xs:
    case Nil{}:
      +ep => +hb => e => Mst.range_list(
        ~S,
        ~fetch,
        prev,
        q,
        s,
        [],
        l,
        lo,
        hi,
        [],
        a,
        {Pieces.ok(~S, ~fetch, q, s, ks) == True{}: Bool},
        +a1 => b => e4 => eb => esl =>
          %Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep): {Pieces.ok(~S, ~fetch, q, s, _) == True{}: Bool}
          Pieces.ok_sub(~S, ~fetch, q, s, prev, l, lo, hi, [], a1)(Bool.or_true_of(Maybe.is_none(&2, Hashes.Hash, prev), Bound.before([], hi))(hb))(esl)({==})
      )(
        Equal.trans(
          Maybe<&2, List<&2, Binding>>,
          Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev, l, lo, hi, [])),
          Mst.range.go(~S, ~fetch, 1n+q, s, [], ks),
          Some{a},
          Equal.cong(
            List<&2, Piece>,
            Maybe<&2, List<&2, Binding>>,
            x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
            Piece.sub(prev, l, lo, hi, []),
            ks,
            Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep)
          ),
          e
        )
      )
    case Con{Item{+ik, +iv, +r}, +rest}:
      ep => +hb => e => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
          Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          Mst.pieces(rest, l, r, Some{ik}, hi)
        ),
        ks,
        {Pieces.ok(~S, ~fetch, q, s, ks) == True{}: Bool},
        +c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{ik}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          ks,
          {Pieces.ok(~S, ~fetch, q, s, ks) == True{}: Bool},
          +ks2 => +e3 => +e4 => Mst.range_list(
            ~S,
            ~fetch,
            prev,
            q,
            s,
            [],
            l,
            lo,
            Some{ik},
            Piece.Bind{ik, iv} <> ks2,
            a,
            {Pieces.ok(~S, ~fetch, q, s, ks) == True{}: Bool},
            +c1 => b => e5 => eb => esl => Maybe.map_cases(
              List<&2, Binding>,
              List<&2, Binding>,
              Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2),
              +bb => Shared.Bool.when(List<&2, Binding>, Key.leads([], ik), u => Binding{ik, iv} <> bb, u => bb),
              b,
              {Pieces.ok(~S, ~fetch, q, s, ks) == True{}: Bool},
              +b2 => eb2 => e6 =>
                %e4: {Pieces.ok(~S, ~fetch, q, s, _) == True{}: Bool}
                Pieces.ok_sub(
                  ~S,
                  ~fetch,
                  q,
                  s,
                  prev,
                  l,
                  lo,
                  Some{ik},
                  Piece.Bind{ik, iv} <> ks2,
                  c1
                )(
                  Equal.trans(
                    Bool,
                    Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Key.is_lt([], ik)),
                    Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik))),
                    True{},
                    Equal.cong(Bool, Bool, x => Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), x), Key.is_lt([], ik), Bool.not(List.is_empty(&2, U32, ik)), Key.lt_nil_left(ik)),
                    Shared.Bool.and_true_right(
                      Nat.is_eq(Key.level(ik), l),
                      Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))
                    )(
                      Shared.Bool.and_true_left(
                        Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
                        Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
                      )(c)
                    )
                  )
                )(esl)(Mst.pieces_ok(~S, ~fetch, q, s, rest, l, r, Some{ik}, hi, ks2, b2)(e3)(hb)(eb2))
            )(eb)
          )(
            Equal.trans(
              Maybe<&2, List<&2, Binding>>,
              Mst.range.go(~S, ~fetch, 1n+q, s, [], Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2)),
              Mst.range.go(~S, ~fetch, 1n+q, s, [], ks),
              Some{a},
              Equal.cong(
                List<&2, Piece>,
                Maybe<&2, List<&2, Binding>>,
                x => Mst.range.go(~S, ~fetch, 1n+q, s, [], x),
                Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2),
                ks,
                e4
              ),
              e
            )
          )
        )(e2)
      )(ep)

# ok pieces open, one level, to ok pieces
def Mst.open_all_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  ps: List<&2, Piece>,
  -P: Type,
  k: @ps2: List<&2, Piece> -> {Mst.open.all(~S, ~fetch, s, ps) == Some{ps2}: Maybe<&2, List<&2, Piece>>} -> {
    Pieces.ok(~S, ~fetch, q, s, ps2) == True{}: Bool
  } -> P
) -> {Pieces.ok(~S, ~fetch, 1n+q, s, ps) == True{}: Bool} -> P:
  match ps:
    case Nil{}:
      h => k([])({==})({==})
    case Con{Piece.Bind{+k1, +v1}, +rest}:
      h => Mst.open_all_ok(
        ~S,
        ~fetch,
        q,
        s,
        rest,
        P,
        +r2 => er => gr => k(Piece.Bind{k1, v1} <> r2)(
          Equal.cong(
            Maybe<&2, List<&2, Piece>>,
            Maybe<&2, List<&2, Piece>>,
            x => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, r => Piece.Bind{k1, v1} <> r, x),
            Mst.open.all(~S, ~fetch, s, rest),
            Some{r2},
            er
          )
        )(gr)
      )(h)
    case Con{Piece.Sub{+h, +u, +lo, +hi}, +rest}:
      +hh =>
        +hc = Shared.Bool.and_true_left(
          Bool.and(
            Bound.before([], hi),
            Maybe.is_some(
              &2,
              List<&2, Binding>,
              Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks => Mst.range.go(~S, ~fetch, 1n+q, s, [], ks))
            )
          ),
          Pieces.ok(~S, ~fetch, 1n+q, s, rest)
        )(hh)
        Maybe.some_cases(
          List<&2, Binding>,
          Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks => Mst.range.go(~S, ~fetch, 1n+q, s, [], ks)),
          P,
          +x => ex => Maybe.bind_cases(
            List<&2, Piece>,
            List<&2, Binding>,
            Mst.open(~S, ~fetch, s, h, u, lo, hi),
            ks => Mst.range.go(~S, ~fetch, 1n+q, s, [], ks),
            x,
            P,
            +ks => +eo => ea => Mst.open_cases(
              ~S,
              ~fetch,
              s,
              h,
              u,
              lo,
              hi,
              ks,
              P,
              +l2 => +left2 => +xs2 => ef => eh => en => elt => ee => ep =>
                +oks = Mst.pieces_ok(
                  ~S,
                  ~fetch,
                  q,
                  s,
                  xs2,
                  l2,
                  left2,
                  lo,
                  hi,
                  ks,
                  x
                )(ep)(Shared.Bool.and_true_left(Bound.before([], hi), Maybe.is_some(&2, List<&2, Binding>, Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks2 => Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2))))(hc))(ea)
                Mst.open_all_ok(
                  ~S,
                  ~fetch,
                  q,
                  s,
                  rest,
                  P,
                  +r2 => er => gr => k(List.append(&2, Piece, ks, r2))(
                    Equal.trans(
                      Maybe<&2, List<&2, Piece>>,
                      Mst.open.all(~S, ~fetch, s, Piece.Sub{h, u, lo, hi} <> rest),
                      Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, ks, b), Mst.open.all(~S, ~fetch, s, rest)),
                      Some{List.append(&2, Piece, ks, r2)},
                      Equal.cong(
                        Maybe<&2, List<&2, Piece>>,
                        Maybe<&2, List<&2, Piece>>,
                        y => Maybe.bind(
                          &2,
                          List<&2, Piece>,
                          List<&2, Piece>,
                          y,
                          a => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, a, b), Mst.open.all(~S, ~fetch, s, rest))
                        ),
                        Mst.open(~S, ~fetch, s, h, u, lo, hi),
                        Some{ks},
                        eo
                      ),
                      Equal.cong(
                        Maybe<&2, List<&2, Piece>>,
                        Maybe<&2, List<&2, Piece>>,
                        y => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, ks, b), y),
                        Mst.open.all(~S, ~fetch, s, rest),
                        Some{r2},
                        er
                      )
                    )
                  )(Pieces.ok_append(~S, ~fetch, q, s, ks, r2)(oks)(gr))
                )(
                  Shared.Bool.and_true_right(
                    Bool.and(
                      Bound.before([], hi),
                      Maybe.is_some(
                        &2,
                        List<&2, Binding>,
                        Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks2 => Mst.range.go(~S, ~fetch, 1n+q, s, [], ks2))
                      )
                    ),
                    Pieces.ok(~S, ~fetch, 1n+q, s, rest)
                  )(hh)
                )
            )(eo)
          )(ex)
        )(
          Shared.Bool.and_true_right(
            Bound.before([], hi),
            Maybe.is_some(
              &2,
              List<&2, Binding>,
              Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks => Mst.range.go(~S, ~fetch, 1n+q, s, [], ks))
            )
          )(hc)
        )

# the items of a node
def Node.items(n: Node) -> List<&2, Item>:
  match n:
    case Node{l, left, xs}:
      xs

# an empty list is the empty list
def List.empty_nil(-A: Data, xs: List<&2, A>) -> {List.is_empty(&2, A, xs) == True{}: Bool} -> {xs == []: List<&2, A>}:
  match xs:
    case Nil{}:
      x => {==}
    case Con{head, tail}:
      x => Empty.absurd({head <> tail == [] : List<&2, A>}, {(%x : {\{False: Unit; \{True: Empty; \{}}} : Bool -> Type}(_); Unit{}) : Empty})

# what the runs of the next round must be, q levels down: none when no level
# is left, else ok
def Runs.next(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, q: Nat, +s: S, ps: List<&2, Runs>) -> Bool:
  match q:
    case 0n:
      List.is_empty(&2, Runs, ps)
    case 1n+p:
      Runs.ok(~S, ~fetch, p, s, ps)

# no run is a next round
def Runs.next_nil(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, q: Nat, +s: S) -> {
  Runs.next(~S, ~fetch, q, s, []) == True{}: Bool
}:
  match q:
    case 0n:
      {==}
    case 1n+p:
      {==}

# two next rounds, one after the other, are a next round
def Runs.next_append(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  q: Nat,
  +s: S,
  ps: List<&2, Runs>,
  +acc: List<&2, Runs>
) -> {Runs.next(~S, ~fetch, q, s, ps) == True{}: Bool} -> {Runs.next(~S, ~fetch, q, s, acc) == True{}: Bool} -> {
  Runs.next(~S, ~fetch, q, s, List.append(&2, Runs, ps, acc)) == True{}: Bool
}:
  match q:
    case 0n:
      match ps:
        case Nil{}:
          h => g => g
        case Con{x, r}:
          h => g => Empty.absurd({List.is_empty(&2, Runs, x <> List.append(&2, Runs, r, acc)) == True{}: Bool}, Shared.Bool.false_ne_true(h))
    case 1n+(+p):
      h => g => Runs.ok_append(~S, ~fetch, p, s, ps, acc)(h)(g)

# a step that read and gave a next round
def Step.good(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, q: Nat, +s: S, m: Maybe<&2, Round>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{r}:
      Runs.next(~S, ~fetch, q, s, Round.pairs(r))

# pieces ok with no level left hold no subtree: a node has an item, so its
# listing needs a level
def Mst.no_sub(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +s: S, ps: List<&2, Piece>) -> {
  Pieces.ok(~S, ~fetch, 0n, s, ps) == True{}: Bool
} -> {Pieces.has_sub(ps) == False{}: Bool}:
  match ps:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{k, v}, rest}:
      h => Mst.no_sub(~S, ~fetch, s, rest)(h)
    case Con{Piece.Sub{+h, +u, +lo, +hi}, rest}:
      hh => Empty.absurd(
        {True{} == False{}: Bool},
        Maybe.some_cases(
          List<&2, Binding>,
          Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks => Mst.range.go(~S, ~fetch, 0n, s, [], ks)),
          Empty,
          +x => ex => Maybe.bind_cases(
            List<&2, Piece>,
            List<&2, Binding>,
            Mst.open(~S, ~fetch, s, h, u, lo, hi),
            ks => Mst.range.go(~S, ~fetch, 0n, s, [], ks),
            x,
            Empty,
            +ks => eo => ea => Mst.open_cases(
              ~S,
              ~fetch,
              s,
              h,
              u,
              lo,
              hi,
              ks,
              Empty,
              +l2 => +left2 => +xs2 => ef => eh => en => elt => ee => ep => Shared.Bool.true_ne_false(
                Equal.trans(
                  Bool,
                  True{},
                  List.is_empty(&2, Item, xs2),
                  False{},
                  Equal.cong(
                    Node,
                    Bool,
                    n => List.is_empty(&2, Item, Node.items(n)),
                    Node{l2, None{}, []},
                    Node{l2, left2, xs2},
                    Equal.sym(
                      Node,
                      Node{l2, left2, xs2},
                      Node{l2, None{}, []},
                      Mst.pieces_empty(
                        xs2,
                        l2,
                        left2,
                        lo,
                        hi
                      )(
                        Equal.trans(
                          Maybe<&2, List<&2, Piece>>,
                          Mst.pieces(xs2, l2, left2, lo, hi),
                          Some{ks},
                          Some{[]},
                          ep,
                          Equal.cong(List<&2, Piece>, Maybe<&2, List<&2, Piece>>, y => Some{y}, ks, [], Mst.range_zero_nil(~S, ~fetch, s, [], ks, x)(ea))
                        )
                      )
                    )
                  ),
                  ee
                )
              )
            )(eo)
          )(ex)
        )(
          Shared.Bool.and_true_right(
            Bound.before([], hi),
            Maybe.is_some(
              &2,
              List<&2, Binding>,
              Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks => Mst.range.go(~S, ~fetch, 0n, s, [], ks))
            )
          )(
            Shared.Bool.and_true_left(
              Bool.and(
                Bound.before([], hi),
                Maybe.is_some(
                  &2,
                  List<&2, Binding>,
                  Maybe.bind(&2, List<&2, Piece>, List<&2, Binding>, Mst.open(~S, ~fetch, s, h, u, lo, hi), ks => Mst.range.go(~S, ~fetch, 0n, s, [], ks))
                )
              ),
              Pieces.ok(~S, ~fetch, 0n, s, rest)
            )(hh)
          )
        )
      )

# an or of two False sides is not True
def Bool.or_false_both(a: Bool, -b: Bool) -> {a == False{}: Bool} -> {b == False{}: Bool} -> {Bool.or(a, b) == True{}: Bool} -> Empty:
  match a:
    case True{}:
      ea => eb => e => Shared.Bool.true_ne_false(ea)
    case False{}:
      ea => eb => e => Shared.Bool.true_ne_false(Equal.trans(Bool, True{}, b, False{}, Equal.sym(Bool, b, True{}, e), eb))

# a step of a run with ok sides reads and gives a next round
def Mst.step_at_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  q: Nat,
  +s: S,
  p: Runs
) -> {Runs.ok1(~S, ~fetch, q, s, p) == True{}: Bool} -> {Step.good(~S, ~fetch, q, s, Mst.step.at(~S, ~fetch, s, p)) == True{}: Bool}:
  match q:
    case 0n:
      match p:
        case Runs{+a, +b}:
          +h => Shared.Bool.when_cases(
            Maybe<&2, Round>,
            x => {Step.good(~S, ~fetch, 0n, s, x) == True{}: Bool},
            Bool.or(Pieces.has_sub(a), Pieces.has_sub(b)),
            u => Maybe.bind(
              &2,
              List<&2, Piece>,
              Round,
              Mst.open.all(~S, ~fetch, s, a),
              a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, s, b))
            ),
            u => Some{Round{Pieces.keys(a, Pieces.keys(b, [])), []}},
            e => Empty.absurd(
              {
                Step.good(
                  ~S,
                  ~fetch,
                  0n,
                  s,
                  Maybe.bind(
                    &2,
                    List<&2, Piece>,
                    Round,
                    Mst.open.all(~S, ~fetch, s, a),
                    a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, s, b))
                  )
                )
                  == True{}: Bool
              },
              Bool.or_false_both(
                Pieces.has_sub(a),
                Pieces.has_sub(b)
              )(Mst.no_sub(~S, ~fetch, s, a)(Shared.Bool.and_true_left(Pieces.ok(~S, ~fetch, 0n, s, a), Pieces.ok(~S, ~fetch, 0n, s, b))(h)))(
                Mst.no_sub(~S, ~fetch, s, b)(Shared.Bool.and_true_right(Pieces.ok(~S, ~fetch, 0n, s, a), Pieces.ok(~S, ~fetch, 0n, s, b))(h))
              )(e)
            ),
            e => {==}
          )
    case 1n+(+q2):
      match p:
        case Runs{+a, +b}:
          +h => Shared.Bool.when_cases(
            Maybe<&2, Round>,
            x => {Step.good(~S, ~fetch, 1n+q2, s, x) == True{}: Bool},
            Bool.or(Pieces.has_sub(a), Pieces.has_sub(b)),
            u => Maybe.bind(
              &2,
              List<&2, Piece>,
              Round,
              Mst.open.all(~S, ~fetch, s, a),
              a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, s, b))
            ),
            u => Some{Round{Pieces.keys(a, Pieces.keys(b, [])), []}},
            e => Mst.open_all_ok(
              ~S,
              ~fetch,
              q2,
              s,
              a,
              {
                Step.good(
                  ~S,
                  ~fetch,
                  1n+q2,
                  s,
                  Maybe.bind(
                    &2,
                    List<&2, Piece>,
                    Round,
                    Mst.open.all(~S, ~fetch, s, a),
                    a2 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a2, b2}]}, Mst.open.all(~S, ~fetch, s, b))
                  )
                )
                  == True{}: Bool
              },
              +a2 => ea => ga => Mst.open_all_ok(
                ~S,
                ~fetch,
                q2,
                s,
                b,
                {
                  Step.good(
                    ~S,
                    ~fetch,
                    1n+q2,
                    s,
                    Maybe.bind(
                      &2,
                      List<&2, Piece>,
                      Round,
                      Mst.open.all(~S, ~fetch, s, a),
                      a3 => Maybe.map(&2, List<&2, Piece>, Round, b2 => Round{[], [Runs{a3, b2}]}, Mst.open.all(~S, ~fetch, s, b))
                    )
                  )
                    == True{}: Bool
                },
                +b2 => eb => gb =>
                  %Equal.sym(Maybe<&2, List<&2, Piece>>, Mst.open.all(~S, ~fetch, s, a), Some{a2}, ea): {
                    Step.good(
                      ~S,
                      ~fetch,
                      1n+q2,
                      s,
                      Maybe.bind(
                        &2,
                        List<&2, Piece>,
                        Round,
                        _,
                        a3 => Maybe.map(&2, List<&2, Piece>, Round, b3 => Round{[], [Runs{a3, b3}]}, Mst.open.all(~S, ~fetch, s, b))
                      )
                    )
                      == True{}: Bool
                  }
                  %Equal.sym(Maybe<&2, List<&2, Piece>>, Mst.open.all(~S, ~fetch, s, b), Some{b2}, eb): {
                    Step.good(~S, ~fetch, 1n+q2, s, Maybe.map(&2, List<&2, Piece>, Round, b3 => Round{[], [Runs{a2, b3}]}, _)) == True{}: Bool
                  }
                  Shared.Bool.and_both(
                    Bool.and(Pieces.ok(~S, ~fetch, q2, s, a2), Pieces.ok(~S, ~fetch, q2, s, b2)),
                    True{}
                  )(Shared.Bool.and_both(Pieces.ok(~S, ~fetch, q2, s, a2), Pieces.ok(~S, ~fetch, q2, s, b2))(ga)(gb))({==})
              )(Shared.Bool.and_true_right(Pieces.ok(~S, ~fetch, 1n+q2, s, a), Pieces.ok(~S, ~fetch, 1n+q2, s, b))(h))
            )(Shared.Bool.and_true_left(Pieces.ok(~S, ~fetch, 1n+q2, s, a), Pieces.ok(~S, ~fetch, 1n+q2, s, b))(h)),
            e => {==}
          )

# two good steps, one after the other, are a good step
def Step.good_bind(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  m1: Maybe<&2, Round>,
  m2: Maybe<&2, Round>
) -> {Step.good(~S, ~fetch, q, s, m1) == True{}: Bool} -> {Step.good(~S, ~fetch, q, s, m2) == True{}: Bool} -> {
  Step.good(~S, ~fetch, q, s, Maybe.bind(&2, Round, Round, m1, a => Maybe.map(&2, Round, Round, b => Round.append(a, b), m2))) == True{}: Bool
}:
  match m1 m2:
    case None{} y:
      h => g => Empty.absurd(
        {Step.good(~S, ~fetch, q, s, None{}) == True{}: Bool},
        Shared.Bool.false_ne_true(h)
      )
    case Some{r1} None{}:
      h => g => Empty.absurd(
        {Step.good(~S, ~fetch, q, s, None{}) == True{}: Bool},
        Shared.Bool.false_ne_true(g)
      )
    case Some{+r1} Some{+r2}:
      h => g =>
        %Equal.sym(
          List<&2, Runs>,
          Round.pairs(Round.append(r1, r2)),
          List.append(&2, Runs, Round.pairs(r1), Round.pairs(r2)),
          Round.pairs_append(r1, r2)
        ): {Runs.next(~S, ~fetch, q, s, _) == True{}: Bool}
        Runs.next_append(~S, ~fetch, q, s, Round.pairs(r1), Round.pairs(r2))(h)(g)

# a step of ok runs reads and gives a next round
def Mst.step_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  ps: List<&2, Runs>
) -> {Runs.ok(~S, ~fetch, q, s, ps) == True{}: Bool} -> {Step.good(~S, ~fetch, q, s, Mst.step(~S, ~fetch, s, ps)) == True{}: Bool}:
  match ps:
    case Nil{}:
      h => Runs.next_nil(~S, ~fetch, q, s)
    case Con{Runs{+a, +b}, +rest}:
      +h => Step.good_bind(
        ~S,
        ~fetch,
        q,
        s,
        Mst.step.at(~S, ~fetch, s, Runs.trim(Runs{a, b})),
        Mst.step(~S, ~fetch, s, rest)
      )(
        Mst.step_at_ok(
          ~S,
          ~fetch,
          q,
          s,
          Runs.trim(Runs{a, b})
        )(
          Runs.trim_ok(
            ~S,
            ~fetch,
            q,
            s,
            Runs{a, b}
          )(Shared.Bool.and_true_left(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))(h))
        )
      )(
        Mst.step_ok(
          ~S,
          ~fetch,
          q,
          s,
          rest
        )(Shared.Bool.and_true_right(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))(h))
      )

# a bind of a good step whose next rounds read, reads
def Step.bind_good(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  q: Nat,
  +s: S,
  m: Maybe<&2, Round>,
  -f: Round -> Maybe<&2, List<&2, List<&2, U32>>>,
  hg: {Step.good(~S, ~fetch, q, s, m) == True{}: Bool},
  hf: @r: Round -> {Runs.next(~S, ~fetch, q, s, Round.pairs(r)) == True{}: Bool} -> {
    Maybe.is_some(&2, List<&2, List<&2, U32>>, f(r)) == True{}: Bool
  }
) -> {Maybe.is_some(&2, List<&2, List<&2, U32>>, Maybe.bind(&2, Round, List<&2, List<&2, U32>>, m, f)) == True{}: Bool}:
  match m:
    case None{}:
      Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(hg))
    case Some{+r}:
      hf(r)(hg)

# a bind of a value whose every next reads, reads
def Maybe.bind_some(
  -A: Data,
  -B: Data,
  m: Maybe<&2, A>,
  -f: A -> Maybe<&2, B>,
  h1: {Maybe.is_some(&2, A, m) == True{}: Bool},
  h2: @x: A -> {Maybe.is_some(&2, B, f(x)) == True{}: Bool}
) -> {Maybe.is_some(&2, B, Maybe.bind(&2, A, B, m, f)) == True{}: Bool}:
  match m:
    case None{}:
      Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(h1))
    case Some{+x}:
      h2(x)

# a difference of ok runs reads, when its next round (ihn) and its other runs
# (ihr) read
def Mst.diff_some.con(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +a: List<&2, Piece>,
  +b: List<&2, Piece>,
  +rest: List<&2, Runs>,
  +h: {Runs.ok(~S, ~fetch, q, s, Runs{a, b} <> rest) == True{}: Bool},
  ihr: {Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, 1n+q, s, rest)) == True{}: Bool},
  ihn: @ps: List<&2, Runs> -> {Runs.next(~S, ~fetch, q, s, ps) == True{}: Bool} -> {
    Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, q, s, ps)) == True{}: Bool
  }
) -> {Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, 1n+q, s, Runs{a, b} <> rest)) == True{}: Bool}:
  Step.bind_good(
    ~S,
    ~fetch,
    q,
    s,
    Mst.step(~S, ~fetch, s, Round.pairs(Mst.cut(a, b, [], []))),
    +r => Maybe.bind(
      &2,
      List<&2, List<&2, U32>>,
      List<&2, List<&2, U32>>,
      Mst.diff.go(~S, ~fetch, q, s, Round.pairs(r)),
      k3 => Maybe.map(
        &2,
        List<&2, List<&2, U32>>,
        List<&2, List<&2, U32>>,
        k4 => List.append(
          &2,
          List<&2, U32>,
          Round.keys(Mst.cut(a, b, [], [])),
          List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
        ),
        Mst.diff.go(~S, ~fetch, 1n+q, s, rest)
      )
    ),
    Mst.step_ok(
      ~S,
      ~fetch,
      q,
      s,
      Round.pairs(Mst.cut(a, b, [], []))
    )(
      Mst.cut_ok(
        ~S,
        ~fetch,
        q,
        s,
        a,
        b,
        [],
        []
      )(
        Shared.Bool.and_true_left(
          Pieces.ok(~S, ~fetch, q, s, a),
          Pieces.ok(~S, ~fetch, q, s, b)
        )(
          Shared.Bool.and_true_left(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))(h)
        )
      )(
        Shared.Bool.and_true_right(
          Pieces.ok(~S, ~fetch, q, s, a),
          Pieces.ok(~S, ~fetch, q, s, b)
        )(
          Shared.Bool.and_true_left(Bool.and(Pieces.ok(~S, ~fetch, q, s, a), Pieces.ok(~S, ~fetch, q, s, b)), Runs.ok(~S, ~fetch, q, s, rest))(h)
        )
      )({==})({==})
    ),
    +r => hn => Maybe.bind_some(
      List<&2, List<&2, U32>>,
      List<&2, List<&2, U32>>,
      Mst.diff.go(~S, ~fetch, q, s, Round.pairs(r)),
      k3 => Maybe.map(
        &2,
        List<&2, List<&2, U32>>,
        List<&2, List<&2, U32>>,
        k4 => List.append(
          &2,
          List<&2, U32>,
          Round.keys(Mst.cut(a, b, [], [])),
          List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, k3, k4))
        ),
        Mst.diff.go(~S, ~fetch, 1n+q, s, rest)
      ),
      ihn(Round.pairs(r))(hn),
      x => Equal.trans(
        Bool,
        Maybe.is_some(
          &2,
          List<&2, List<&2, U32>>,
          Maybe.map(
            &2,
            List<&2, List<&2, U32>>,
            List<&2, List<&2, U32>>,
            k4 => List.append(
              &2,
              List<&2, U32>,
              Round.keys(Mst.cut(a, b, [], [])),
              List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, x, k4))
            ),
            Mst.diff.go(~S, ~fetch, 1n+q, s, rest)
          )
        ),
        Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, 1n+q, s, rest)),
        True{},
        Maybe.map_is_some(
          List<&2, List<&2, U32>>,
          List<&2, List<&2, U32>>,
          k4 => List.append(
            &2,
            List<&2, U32>,
            Round.keys(Mst.cut(a, b, [], [])),
            List.append(&2, List<&2, U32>, Round.keys(r), List.append(&2, List<&2, U32>, x, k4))
          ),
          Mst.diff.go(~S, ~fetch, 1n+q, s, rest)
        ),
        ihr
      )
    )
  )

# a difference of ok runs reads, while levels are left
def Mst.diff_some(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, q: Nat, +s: S, runs: List<&2, Runs>) -> {
  Runs.ok(~S, ~fetch, q, s, runs) == True{}: Bool
} -> {Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, 1n+q, s, runs)) == True{}: Bool}:
  match q:
    case 0n:
      match runs:
        case Nil{}:
          h => {==}
        case Con{Runs{+a, +b}, +rest}:
          +h => Mst.diff_some.con(
            ~S,
            ~fetch,
            0n,
            s,
            a,
            b,
            rest,
            h,
            Mst.diff_some(
              ~S,
              ~fetch,
              0n,
              s,
              rest
            )(Shared.Bool.and_true_right(Bool.and(Pieces.ok(~S, ~fetch, 0n, s, a), Pieces.ok(~S, ~fetch, 0n, s, b)), Runs.ok(~S, ~fetch, 0n, s, rest))(h)),
            ps => hn =>
              %Equal.sym(List<&2, Runs>, ps, [], List.empty_nil(Runs, ps)(hn)): {
                Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff.go(~S, ~fetch, 0n, s, _)) == True{}: Bool
              }
              {==}
          )
    case 1n+(+q2):
      match runs:
        case Nil{}:
          h => {==}
        case Con{Runs{+a, +b}, +rest}:
          +h => Mst.diff_some.con(
            ~S,
            ~fetch,
            1n+q2,
            s,
            a,
            b,
            rest,
            h,
            Mst.diff_some(
              ~S,
              ~fetch,
              1n+q2,
              s,
              rest
            )(Shared.Bool.and_true_right(Bool.and(Pieces.ok(~S, ~fetch, 1n+q2, s, a), Pieces.ok(~S, ~fetch, 1n+q2, s, b)), Runs.ok(~S, ~fetch, 1n+q2, s, rest))(h)),
            ps => hn => Mst.diff_some(~S, ~fetch, q2, s, ps)(hn)
          )

# the root of a tree that lists whole is ok
def Mst.root_ok(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  h: Maybe<&2, Hashes.Hash>,
  +bs: List<&2, Binding>
) -> {Mst.range(~S, ~fetch, s, h, []) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> {Pieces.ok(~S, ~fetch, 63n, s, Mst.root(h)) == True{}: Bool}:
  match h:
    case None{}:
      e => {==}
    case Some{+h1}:
      e => Mst.range_list(
        ~S,
        ~fetch,
        Some{h1},
        63n,
        s,
        [],
        Mst.depth(),
        None{},
        None{},
        [],
        bs,
        {Pieces.ok(~S, ~fetch, 63n, s, Mst.root(Some{h1})) == True{}: Bool},
        +a1 => b => e4 => eb => esl => Pieces.ok_sub(~S, ~fetch, 63n, s, Some{h1}, Mst.depth(), None{}, None{}, [], a1)({==})(esl)({==})
      )(e)

# a difference of two trees that list whole reads
def Mst.diff_whole(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Maybe<&2, Hashes.Hash>,
  +h2: Maybe<&2, Hashes.Hash>,
  +bs: List<&2, Binding>,
  +bs2: List<&2, Binding>
) -> {Mst.range(~S, ~fetch, s, h, []) == Some{bs}: Maybe<&2, List<&2, Binding>>} -> {
  Mst.range(~S, ~fetch, s, h2, []) == Some{bs2}: Maybe<&2, List<&2, Binding>>
} -> {Maybe.is_some(&2, List<&2, List<&2, U32>>, Mst.diff(~S, ~fetch, s, h, h2)) == True{}: Bool}:
  e1 => e2 => Mst.diff_some(
    ~S,
    ~fetch,
    63n,
    s,
    [Runs{Mst.root(h), Mst.root(h2)}]
  )(
    Shared.Bool.and_both(
      Bool.and(Pieces.ok(~S, ~fetch, 63n, s, Mst.root(h)), Pieces.ok(~S, ~fetch, 63n, s, Mst.root(h2))),
      True{}
    )(
      Shared.Bool.and_both(Pieces.ok(~S, ~fetch, 63n, s, Mst.root(h)), Pieces.ok(~S, ~fetch, 63n, s, Mst.root(h2)))(Mst.root_ok(~S, ~fetch, s, h, bs)(e1))(
        Mst.root_ok(~S, ~fetch, s, h2, bs2)(e2)
      )
    )({==})
  )

# Differences
# -----------

# the key a is not after the key b
def Key.le(a: List<&2, U32>, b: List<&2, U32>) -> Bool:
  Bool.not(Key.is_lt(b, a))

# Key.cmp, by its three cases
def Key.cases.at(
  c: Cmp,
  -a: List<&2, U32>,
  -b: List<&2, U32>,
  -P: Type,
  e: {Key.cmp(a, b) == c: Cmp},
  kl: {Key.cmp(a, b) == LT{}: Cmp} -> P,
  ke: {Key.cmp(a, b) == EQ{}: Cmp} -> P,
  kg: {Key.cmp(a, b) == GT{}: Cmp} -> P
) -> P:
  match c:
    case LT{}:
      kl(e)
    case EQ{}:
      ke(e)
    case GT{}:
      kg(e)

# a key is not before itself
def Key.lt_irrefl(+a: List<&2, U32>) -> {Key.is_lt(a, a) == False{}: Bool}:
  %Equal.sym(Bool, Key.is_lt(a, a), Cmp.is_lt(Key.cmp(a, a)), Key.is_lt_cmp(a, a)): {_ == False{}: Bool}
  %Equal.sym(Cmp, Key.cmp(a, a), EQ{}, Key.cmp_refl(a)): {Cmp.is_lt(_) == False{}: Bool}
  {==}

# a key before b is not after it
def Key.lt_asym(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.is_lt(a, b) == True{}: Bool} -> {Key.is_lt(b, a) == False{}: Bool}:
  h =>
    %Equal.sym(Bool, Key.is_lt(b, a), Cmp.is_lt(Key.cmp(b, a)), Key.is_lt_cmp(b, a)): {_ == False{}: Bool}
    %Equal.sym(Cmp, Key.cmp(b, a), Cmp.flip(Key.cmp(a, b)), Key.cmp_flip(a, b)): {Cmp.is_lt(_) == False{}: Bool}
    %Equal.sym(
      Cmp,
      Key.cmp(a, b),
      LT{},
      Cmp.lt_true(Key.cmp(a, b))(Equal.trans(Bool, Cmp.is_lt(Key.cmp(a, b)), Key.is_lt(a, b), True{}, Equal.sym(Bool, Key.is_lt(a, b), Cmp.is_lt(Key.cmp(a, b)), Key.is_lt_cmp(a, b)), h))
    ): {Cmp.is_lt(Cmp.flip(_)) == False{}: Bool}
    {==}

# a key before b has other words than b
def Key.lt_ne(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.is_lt(a, b) == True{}: Bool} -> {
  Shared.List.is_eq(~U32, ~U32.is_eq, a, b) == False{}: Bool
}:
  h =>
    %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, a, b), Cmp.is_eq(Key.cmp(a, b)), Key.is_eq_cmp(a, b)): {_ == False{}: Bool}
    %Equal.sym(
      Cmp,
      Key.cmp(a, b),
      LT{},
      Cmp.lt_true(Key.cmp(a, b))(Equal.trans(Bool, Cmp.is_lt(Key.cmp(a, b)), Key.is_lt(a, b), True{}, Equal.sym(Bool, Key.is_lt(a, b), Cmp.is_lt(Key.cmp(a, b)), Key.is_lt_cmp(a, b)), h))
    ): {Cmp.is_eq(_) == False{}: Bool}
    {==}

# a <= b and b < c give a < c
def Key.le_lt(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {Key.le(a, b) == True{}: Bool} -> {Key.is_lt(b, c) == True{}: Bool} -> {
  Key.is_lt(a, c) == True{}: Bool
}:
  +h => +g => Key.cases.at(
    Key.cmp(a, b),
    a,
    b,
    {Key.is_lt(a, c) == True{}: Bool},
    {==},
    el => Key.lt_trans(a, b, c)(Equal.trans(Bool, Key.is_lt(a, b), Cmp.is_lt(Key.cmp(a, b)), True{}, Key.is_lt_cmp(a, b), Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(a, b), LT{}, el)))(g),
    ee =>
      %Equal.sym(List<&2, U32>, a, b, Key.cmp_eq(a, b)(ee)): {Key.is_lt(_, c) == True{}: Bool}
      g,
    eg => Empty.absurd(
      {Key.is_lt(a, c) == True{}: Bool},
      Shared.Bool.true_ne_false(
        Equal.trans(
          Bool,
          True{},
          Bool.not(Key.is_lt(b, a)),
          False{},
          Equal.sym(Bool, Bool.not(Key.is_lt(b, a)), True{}, h),
          Equal.cong(
            Bool,
            Bool,
            Bool.not,
            Key.is_lt(b, a),
            True{},
            Equal.trans(
              Bool,
              Key.is_lt(b, a),
              Cmp.is_lt(Key.cmp(b, a)),
              True{},
              Key.is_lt_cmp(b, a),
              Equal.trans(
                Bool,
                Cmp.is_lt(Key.cmp(b, a)),
                Cmp.is_lt(Cmp.flip(Key.cmp(a, b))),
                True{},
                Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(b, a), Cmp.flip(Key.cmp(a, b)), Key.cmp_flip(a, b)),
                Equal.cong(Cmp, Bool, x => Cmp.is_lt(Cmp.flip(x)), Key.cmp(a, b), GT{}, eg)
              )
            )
          )
        )
      )
    )
  )

# a < b and b <= c give a < c
def Key.lt_le(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {Key.is_lt(a, b) == True{}: Bool} -> {Key.le(b, c) == True{}: Bool} -> {
  Key.is_lt(a, c) == True{}: Bool
}:
  +h => +g => Key.cases.at(
    Key.cmp(b, c),
    b,
    c,
    {Key.is_lt(a, c) == True{}: Bool},
    {==},
    el => Key.lt_trans(a, b, c)(h)(Equal.trans(Bool, Key.is_lt(b, c), Cmp.is_lt(Key.cmp(b, c)), True{}, Key.is_lt_cmp(b, c), Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(b, c), LT{}, el))),
    ee =>
      %Key.cmp_eq(b, c)(ee): {Key.is_lt(a, _) == True{}: Bool}
      h,
    eg => Empty.absurd(
      {Key.is_lt(a, c) == True{}: Bool},
      Shared.Bool.true_ne_false(
        Equal.trans(
          Bool,
          True{},
          Bool.not(Key.is_lt(c, b)),
          False{},
          Equal.sym(Bool, Bool.not(Key.is_lt(c, b)), True{}, g),
          Equal.cong(
            Bool,
            Bool,
            Bool.not,
            Key.is_lt(c, b),
            True{},
            Equal.trans(
              Bool,
              Key.is_lt(c, b),
              Cmp.is_lt(Key.cmp(c, b)),
              True{},
              Key.is_lt_cmp(c, b),
              Equal.trans(
                Bool,
                Cmp.is_lt(Key.cmp(c, b)),
                Cmp.is_lt(Cmp.flip(Key.cmp(b, c))),
                True{},
                Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(c, b), Cmp.flip(Key.cmp(b, c)), Key.cmp_flip(b, c)),
                Equal.cong(Cmp, Bool, x => Cmp.is_lt(Cmp.flip(x)), Key.cmp(b, c), GT{}, eg)
              )
            )
          )
        )
      )
    )
  )

# a key is not after itself
def Key.le_refl(+a: List<&2, U32>) -> {Key.le(a, a) == True{}: Bool}:
  %Equal.sym(Bool, Key.is_lt(a, a), False{}, Key.lt_irrefl(a)): {Bool.not(_) == True{}: Bool}
  {==}

# a key before b is not after b
def Key.lt_le_of(+a: List<&2, U32>, +b: List<&2, U32>) -> {Key.is_lt(a, b) == True{}: Bool} -> {Key.le(a, b) == True{}: Bool}:
  h =>
    %Equal.sym(Bool, Key.is_lt(b, a), False{}, Key.lt_asym(a, b)(h)): {Bool.not(_) == True{}: Bool}
    {==}

# a <= b and b <= c give a <= c
def Key.le_trans(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {Key.le(a, b) == True{}: Bool} -> {Key.le(b, c) == True{}: Bool} -> {
  Key.le(a, c) == True{}: Bool
}:
  +h => +g => Key.cases.at(
    Key.cmp(c, a),
    c,
    a,
    {Key.le(a, c) == True{}: Bool},
    {==},
    el => Empty.absurd(
      {Key.le(a, c) == True{}: Bool},
      Shared.Bool.true_ne_false(
        Equal.trans(
          Bool,
          True{},
          Key.is_lt(c, b),
          False{},
          Equal.sym(
            Bool,
            Key.is_lt(c, b),
            True{},
            Key.lt_le(c, a, b)(Equal.trans(Bool, Key.is_lt(c, a), Cmp.is_lt(Key.cmp(c, a)), True{}, Key.is_lt_cmp(c, a), Equal.cong(Cmp, Bool, Cmp.is_lt, Key.cmp(c, a), LT{}, el)))(h)
          ),
          Shared.Bool.not_true(Key.is_lt(c, b))(g)
        )
      )
    ),
    ee =>
      %Equal.sym(Bool, Key.is_lt(c, a), Cmp.is_lt(Key.cmp(c, a)), Key.is_lt_cmp(c, a)): {Bool.not(_) == True{}: Bool}
      %Equal.sym(Cmp, Key.cmp(c, a), EQ{}, ee): {Bool.not(Cmp.is_lt(_)) == True{}: Bool}
      {==},
    eg =>
      %Equal.sym(Bool, Key.is_lt(c, a), Cmp.is_lt(Key.cmp(c, a)), Key.is_lt_cmp(c, a)): {Bool.not(_) == True{}: Bool}
      %Equal.sym(Cmp, Key.cmp(c, a), GT{}, eg): {Bool.not(Cmp.is_lt(_)) == True{}: Bool}
      {==}
  )

# the key k comes no later than the bound lo, which a subtree after k starts
# at (none: no bound, so no subtree is after k)
def Bound.at_most(k: List<&2, U32>, lo: Maybe<&2, List<&2, U32>>) -> Bool:
  match lo:
    case None{}:
      False{}
    case Some{a}:
      Key.le(k, a)

# the bound hi, which a subtree before k ends at, comes no later than k
def Bound.at_least(hi: Maybe<&2, List<&2, U32>>, k: List<&2, U32>) -> Bool:
  match hi:
    case None{}:
      False{}
    case Some{b}:
      Key.le(b, k)

# a subtree that ends at hi is before one that starts at lo
def Bound.ends_before(hi: Maybe<&2, List<&2, U32>>, lo: Maybe<&2, List<&2, U32>>) -> Bool:
  match hi lo:
    case Some{b} Some{a}:
      Key.le(b, a)
    case x y:
      False{}

# each key of the piece x comes before each key of the piece y
def Piece.before(x: Piece, y: Piece) -> Bool:
  match x y:
    case Piece.Bind{k1, v1} Piece.Bind{k2, v2}:
      Key.is_lt(k1, k2)
    case Piece.Bind{k, v} Piece.Sub{h, u, lo, hi}:
      Bound.at_most(k, lo)
    case Piece.Sub{h, u, lo, hi} Piece.Bind{k, v}:
      Bound.at_least(hi, k)
    case Piece.Sub{h1, u1, lo1, hi1} Piece.Sub{h2, u2, lo2, hi2}:
      Bound.ends_before(hi1, lo2)

# the piece x may hold the key k: a binding of k, or a subtree whose bounds
# hold k
def Piece.covers(x: Piece, +k: List<&2, U32>) -> Bool:
  match x:
    case Piece.Bind{k2, v}:
      Shared.List.is_eq(~U32, ~U32.is_eq, k2, k)
    case Piece.Sub{h, u, +lo, +hi}:
      Bool.and(Bound.after(lo, k), Bound.before(k, hi))

# a piece of the pieces ps may hold k
def Pieces.covers(ps: List<&2, Piece>, +k: List<&2, U32>) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{+x, rest}:
      Bool.or(Piece.covers(x, k), Pieces.covers(rest, k))

# the value of k that the piece x gives, read f levels down
def Piece.value(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +f: Nat, +s: S, x: Piece, +k: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  match x:
    case Piece.Bind{k2, v}:
      Some{v}
    case Piece.Sub{h, u, lo, hi}:
      Look.value(Mst.look.go(~S, ~fetch, f, s, Room{u, lo, hi}, Some{h}, k))

# the value of k that the first piece of ps that may hold it gives (none: no
# piece may hold it)
def Pieces.value(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +k: List<&2, U32>
) -> Maybe<&2, List<&2, U32>>:
  match ps:
    case Nil{}:
      None{}
    case Con{+x, rest}:
      Shared.Bool.when(
        Maybe<&2, List<&2, U32>>,
        Piece.covers(x, k),
        u => Piece.value(~S, ~fetch, f, s, x, k),
        u => Pieces.value(~S, ~fetch, f, s, rest, k)
      )

# each piece of ps comes after the piece x
def Pieces.after_all(+x: Piece, ps: List<&2, Piece>) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{y, rest}:
      Bool.and(Piece.before(x, y), Pieces.after_all(x, rest))

# the pieces ps come in the order of their keys, each after the ones before
def Pieces.sorted(ps: List<&2, Piece>) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{+x, +rest}:
      Bool.and(Pieces.after_all(x, rest), Pieces.sorted(rest))

# the first side of a False or is False
def Bool.or_false_l(a: Bool, -b: Bool) -> {Bool.or(a, b) == False{}: Bool} -> {a == False{}: Bool}:
  match a:
    case True{}:
      h => h
    case False{}:
      h => {==}

# the second side of a False or is False
def Bool.or_false_r(a: Bool, -b: Bool) -> {Bool.or(a, b) == False{}: Bool} -> {b == False{}: Bool}:
  match a:
    case True{}:
      h => Empty.absurd({b == False{}: Bool}, Shared.Bool.true_ne_false(h))
    case False{}:
      h => h

# pieces that may not hold k give no value of it
def Pieces.value_none(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.covers(ps, k) == False{}: Bool} -> {Pieces.value(~S, ~fetch, f, s, ps, k) == None{}: Maybe<&2, List<&2, U32>>}:
  match ps:
    case Nil{}:
      h => {==}
    case Con{+x, +rest}:
      +h =>
        %Equal.sym(Bool, Piece.covers(x, k), False{}, Bool.or_false_l(Piece.covers(x, k), Pieces.covers(rest, k))(h)): {
          Shared.Bool.when(
            Maybe<&2, List<&2, U32>>,
            _,
            u => Piece.value(~S, ~fetch, f, s, x, k),
            u => Pieces.value(~S, ~fetch, f, s, rest, k)
          )
            == None{}: Maybe<&2, List<&2, U32>>
        }
        Pieces.value_none(~S, ~fetch, f, s, rest, k)(Bool.or_false_r(Piece.covers(x, k), Pieces.covers(rest, k))(h))

# pieces that may not hold k, then others: the others give its value
def Pieces.value_right(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +qs: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.covers(ps, k) == False{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, ps, qs), k) == Pieces.value(~S, ~fetch, f, s, qs, k): Maybe<&2, List<&2, U32>>
}:
  match ps:
    case Nil{}:
      h => {==}
    case Con{+x, +rest}:
      +h =>
        %Equal.sym(Bool, Piece.covers(x, k), False{}, Bool.or_false_l(Piece.covers(x, k), Pieces.covers(rest, k))(h)): {
          Shared.Bool.when(
            Maybe<&2, List<&2, U32>>,
            _,
            u => Piece.value(~S, ~fetch, f, s, x, k),
            u => Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, rest, qs), k)
          )
            == Pieces.value(~S, ~fetch, f, s, qs, k): Maybe<&2, List<&2, U32>>
        }
        Pieces.value_right(~S, ~fetch, f, s, rest, qs, k)(Bool.or_false_r(Piece.covers(x, k), Pieces.covers(rest, k))(h))

# pieces, then others that may not hold k: the first give its value
def Pieces.value_left(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +qs: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.covers(qs, k) == False{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, ps, qs), k) == Pieces.value(~S, ~fetch, f, s, ps, k): Maybe<&2, List<&2, U32>>
}:
  match ps:
    case Nil{}:
      h => Pieces.value_none(~S, ~fetch, f, s, qs, k)(h)
    case Con{+x, +rest}:
      h => Equal.cong(
        Maybe<&2, List<&2, U32>>,
        Maybe<&2, List<&2, U32>>,
        z => Shared.Bool.when(Maybe<&2, List<&2, U32>>, Piece.covers(x, k), u => Piece.value(~S, ~fetch, f, s, x, k), u => z),
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, rest, qs), k),
        Pieces.value(~S, ~fetch, f, s, rest, k),
        Pieces.value_left(~S, ~fetch, f, s, rest, qs, k)(h)
      )

# a Bool, by its two cases
def Bool.cases(b: Bool, -P: Type, kt: {b == True{}: Bool} -> P, kf: {b == False{}: Bool} -> P) -> P:
  match b:
    case True{}:
      kt({==})
    case False{}:
      kf({==})

# a Bool that is not True is False
def Bool.false_of(b: Bool, no: {b == True{}: Bool} -> Empty) -> {b == False{}: Bool}:
  match b:
    case True{}:
      Empty.absurd({True{} == False{}: Bool}, no({==}))
    case False{}:
      {==}

# Piece.disjoint for a binding x, by the lower bound lo of the subtree y
def Piece.disjoint.bs(+k: List<&2, U32>, lo: Maybe<&2, List<&2, U32>>, -hi: Maybe<&2, List<&2, U32>>, +key: List<&2, U32>) -> {
  Bound.at_most(k, lo) == True{}: Bool
} -> {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool} -> {Shared.List.is_eq(~U32, ~U32.is_eq, k, key) == False{}: Bool}:
  match lo:
    case None{}:
      hb => hc => Empty.absurd({Shared.List.is_eq(~U32, ~U32.is_eq, k, key) == False{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+a}:
      hb => hc => Key.lt_ne(k, key)(Key.le_lt(k, a, key)(hb)(Shared.Bool.and_true_left(Key.is_lt(a, key), Bound.before(key, hi))(hc)))

# Piece.disjoint for a subtree x before a binding, by the upper bound hi of x
def Piece.disjoint.sb(+lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>, +key: List<&2, U32>) -> {
  Bound.at_least(hi, k) == True{}: Bool
} -> {Shared.List.is_eq(~U32, ~U32.is_eq, k, key) == True{}: Bool} -> {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == False{}: Bool}:
  match hi:
    case None{}:
      hb => hc => Empty.absurd({Bool.and(Bound.after(lo, key), True{}) == False{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+b}:
      hb => hc =>
        %Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), k, key)(hc): {Bool.and(Bound.after(lo, _), Key.is_lt(_, b)) == False{}: Bool}
        %Equal.sym(Bool, Key.is_lt(k, b), False{}, Shared.Bool.not_true(Key.is_lt(k, b))(hb)): {Bool.and(Bound.after(lo, k), _) == False{}: Bool}
        Shared.Bool.and_false_right(Bound.after(lo, k))

# Piece.disjoint for two subtrees, by the upper bound of x and the lower one
# of y
def Piece.disjoint.ss(
  +lo1: Maybe<&2, List<&2, U32>>,
  hi1: Maybe<&2, List<&2, U32>>,
  lo2: Maybe<&2, List<&2, U32>>,
  -hi2: Maybe<&2, List<&2, U32>>,
  +key: List<&2, U32>
) -> {Bound.ends_before(hi1, lo2) == True{}: Bool} -> {Bool.and(Bound.after(lo2, key), Bound.before(key, hi2)) == True{}: Bool} -> {
  Bool.and(Bound.after(lo1, key), Bound.before(key, hi1)) == False{}: Bool
}:
  match hi1 lo2:
    case Some{+b} Some{+a}:
      hb => hc =>
        %Equal.sym(
          Bool,
          Key.is_lt(key, b),
          False{},
          Key.lt_asym(b, key)(Key.le_lt(b, a, key)(hb)(Shared.Bool.and_true_left(Key.is_lt(a, key), Bound.before(key, hi2))(hc)))
        ): {Bool.and(Bound.after(lo1, key), _) == False{}: Bool}
        Shared.Bool.and_false_right(Bound.after(lo1, key))
    case None{} y:
      hb => hc => Empty.absurd({Bool.and(Bound.after(lo1, key), True{}) == False{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+b} None{}:
      hb => hc => Empty.absurd({Bool.and(Bound.after(lo1, key), Key.is_lt(key, b)) == False{}: Bool}, Shared.Bool.false_ne_true(hb))

# a key that a piece y may hold, the piece x before y may not hold
def Piece.disjoint(x: Piece, y: Piece, +key: List<&2, U32>) -> {Piece.before(x, y) == True{}: Bool} -> {Piece.covers(y, key) == True{}: Bool} -> {
  Piece.covers(x, key) == False{}: Bool
}:
  match x y:
    case Piece.Bind{+k1, v1} Piece.Bind{+k2, v2}:
      hb => hc =>
        %Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), k2, key)(hc): {Shared.List.is_eq(~U32, ~U32.is_eq, k1, _) == False{}: Bool}
        Key.lt_ne(k1, k2)(hb)
    case Piece.Bind{+k, v} Piece.Sub{h, u, lo, hi}:
      hb => hc => Piece.disjoint.bs(k, lo, hi, key)(hb)(hc)
    case Piece.Sub{h, u, lo, hi} Piece.Bind{+k, v}:
      hb => hc => Piece.disjoint.sb(lo, hi, k, key)(hb)(hc)
    case Piece.Sub{h1, u1, lo1, hi1} Piece.Sub{h2, u2, lo2, hi2}:
      hb => hc => Piece.disjoint.ss(lo1, hi1, lo2, hi2, key)(hb)(hc)

# Piece.below_bind for a subtree, by its upper bound hi
def Piece.below_bind.s(+lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>, +k1: List<&2, U32>, +key: List<&2, U32>) -> {
  Bound.at_least(hi, k1) == True{}: Bool
} -> {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool} -> {Key.is_lt(key, k1) == True{}: Bool}:
  match hi:
    case None{}:
      hb => hc => Empty.absurd({Key.is_lt(key, k1) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+b}:
      hb => hc => Key.lt_le(key, b, k1)(Shared.Bool.and_true_right(Bound.after(lo, key), Key.is_lt(key, b))(hc))(hb)

# a key that a piece before the binding of k1 may hold is before k1
def Piece.below_bind(x: Piece, +k1: List<&2, U32>, -v1: List<&2, U32>, +key: List<&2, U32>) -> {
  Piece.before(x, Piece.Bind{k1, v1}) == True{}: Bool
} -> {Piece.covers(x, key) == True{}: Bool} -> {Key.is_lt(key, k1) == True{}: Bool}:
  match x:
    case Piece.Bind{+k, v}:
      hb => hc =>
        %Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), k, key)(hc): {Key.is_lt(_, k1) == True{}: Bool}
        hb
    case Piece.Sub{h, u, lo, hi}:
      hb => hc => Piece.below_bind.s(lo, hi, k1, key)(hb)(hc)

# Piece.above_bind for a subtree, by its lower bound lo
def Piece.above_bind.s(lo: Maybe<&2, List<&2, U32>>, -hi: Maybe<&2, List<&2, U32>>, +k1: List<&2, U32>, +key: List<&2, U32>) -> {
  Bound.at_most(k1, lo) == True{}: Bool
} -> {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool} -> {Key.is_lt(k1, key) == True{}: Bool}:
  match lo:
    case None{}:
      hb => hc => Empty.absurd({Key.is_lt(k1, key) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+a}:
      hb => hc => Key.le_lt(k1, a, key)(hb)(Shared.Bool.and_true_left(Key.is_lt(a, key), Bound.before(key, hi))(hc))

# a key that a piece after the binding of k1 may hold is after k1
def Piece.above_bind(+k1: List<&2, U32>, -v1: List<&2, U32>, y: Piece, +key: List<&2, U32>) -> {
  Piece.before(Piece.Bind{k1, v1}, y) == True{}: Bool
} -> {Piece.covers(y, key) == True{}: Bool} -> {Key.is_lt(k1, key) == True{}: Bool}:
  match y:
    case Piece.Bind{+k, v}:
      hb => hc =>
        %Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), k, key)(hc): {Key.is_lt(k1, _) == True{}: Bool}
        hb
    case Piece.Sub{h, u, lo, hi}:
      hb => hc => Piece.above_bind.s(lo, hi, k1, key)(hb)(hc)

# pieces after a piece that may hold k may not hold it
def Pieces.after_all_miss(+x: Piece, ps: List<&2, Piece>, +key: List<&2, U32>) -> {Piece.covers(x, key) == True{}: Bool} -> {
  Pieces.after_all(x, ps) == True{}: Bool
} -> {Pieces.covers(ps, key) == False{}: Bool}:
  match ps:
    case Nil{}:
      hx => ha => {==}
    case Con{+y, +rest}:
      +hx => +ha =>
        %Equal.sym(
          Bool,
          Piece.covers(y, key),
          False{},
          Bool.false_of(
            Piece.covers(y, key),
            cy => Shared.Bool.true_ne_false(
              Equal.trans(
                Bool,
                True{},
                Piece.covers(x, key),
                False{},
                Equal.sym(Bool, Piece.covers(x, key), True{}, hx),
                Piece.disjoint(x, y, key)(Shared.Bool.and_true_left(Piece.before(x, y), Pieces.after_all(x, rest))(ha))(cy)
              )
            )
          )
        ): {Bool.or(_, Pieces.covers(rest, key)) == False{}: Bool}
        Pieces.after_all_miss(x, rest, key)(hx)(Shared.Bool.and_true_right(Piece.before(x, y), Pieces.after_all(x, rest))(ha))

# each piece of xs comes before each piece of ys
def Pieces.before_all(xs: List<&2, Piece>, +ys: List<&2, Piece>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+x, rest}:
      Bool.and(Pieces.after_all(x, ys), Pieces.before_all(rest, ys))

# pieces after others may not hold a key that the others may hold
def Pieces.before_miss(xs: List<&2, Piece>, +ys: List<&2, Piece>, +key: List<&2, U32>) -> {Pieces.before_all(xs, ys) == True{}: Bool} -> {
  Pieces.covers(xs, key) == True{}: Bool
} -> {Pieces.covers(ys, key) == False{}: Bool}:
  match xs:
    case Nil{}:
      hb => hc => Empty.absurd({Pieces.covers(ys, key) == False{}: Bool}, Shared.Bool.false_ne_true(hc))
    case Con{+x, +rest}:
      +hb => hc => Bool.cases(
        Piece.covers(x, key),
        {Pieces.covers(ys, key) == False{}: Bool},
        cx => Pieces.after_all_miss(x, ys, key)(cx)(Shared.Bool.and_true_left(Pieces.after_all(x, ys), Pieces.before_all(rest, ys))(hb)),
        cx => Pieces.before_miss(
          rest,
          ys,
          key
        )(Shared.Bool.and_true_right(Pieces.after_all(x, ys), Pieces.before_all(rest, ys))(hb))(
          Equal.trans(
            Bool,
            Pieces.covers(rest, key),
            Bool.or(Piece.covers(x, key), Pieces.covers(rest, key)),
            True{},
            Equal.cong(Bool, Bool, t => Bool.or(t, Pieces.covers(rest, key)), False{}, Piece.covers(x, key), Equal.sym(Bool, Piece.covers(x, key), False{}, cx)),
            hc
          )
        )
      )

# pieces before others may not hold a key that the others may hold
def Pieces.after_miss(+xs: List<&2, Piece>, +ys: List<&2, Piece>, +key: List<&2, U32>) -> {Pieces.before_all(xs, ys) == True{}: Bool} -> {
  Pieces.covers(ys, key) == True{}: Bool
} -> {Pieces.covers(xs, key) == False{}: Bool}:
  +hb => +hc => Bool.false_of(
    Pieces.covers(xs, key),
    cx => Shared.Bool.true_ne_false(
      Equal.trans(Bool, True{}, Pieces.covers(ys, key), False{}, Equal.sym(Bool, Pieces.covers(ys, key), True{}, hc), Pieces.before_miss(xs, ys, key)(hb)(cx))
    )
  )

# each piece after all of a, then all of b, is after all of a
def Pieces.after_all_left(+x: Piece, a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  Pieces.after_all(x, List.append(&2, Piece, a, b)) == True{}: Bool
} -> {Pieces.after_all(x, a) == True{}: Bool}:
  match a:
    case Nil{}:
      h => {==}
    case Con{+y, +rest}:
      +h => Shared.Bool.and_both(
        Piece.before(x, y),
        Pieces.after_all(x, rest)
      )(Shared.Bool.and_true_left(Piece.before(x, y), Pieces.after_all(x, List.append(&2, Piece, rest, b)))(h))(
        Pieces.after_all_left(x, rest, b)(Shared.Bool.and_true_right(Piece.before(x, y), Pieces.after_all(x, List.append(&2, Piece, rest, b)))(h))
      )

# each piece after all of a, then all of b, is after all of b
def Pieces.after_all_right(+x: Piece, a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  Pieces.after_all(x, List.append(&2, Piece, a, b)) == True{}: Bool
} -> {Pieces.after_all(x, b) == True{}: Bool}:
  match a:
    case Nil{}:
      h => h
    case Con{+y, +rest}:
      h => Pieces.after_all_right(x, rest, b)(Shared.Bool.and_true_right(Piece.before(x, y), Pieces.after_all(x, List.append(&2, Piece, rest, b)))(h))

# a sorted run of a, then b: a is sorted
def Pieces.sorted_left(a: List<&2, Piece>, +b: List<&2, Piece>) -> {Pieces.sorted(List.append(&2, Piece, a, b)) == True{}: Bool} -> {
  Pieces.sorted(a) == True{}: Bool
}:
  match a:
    case Nil{}:
      h => {==}
    case Con{+x, +rest}:
      +h => Shared.Bool.and_both(
        Pieces.after_all(x, rest),
        Pieces.sorted(rest)
      )(
        Pieces.after_all_left(
          x,
          rest,
          b
        )(Shared.Bool.and_true_left(Pieces.after_all(x, List.append(&2, Piece, rest, b)), Pieces.sorted(List.append(&2, Piece, rest, b)))(h))
      )(
        Pieces.sorted_left(
          rest,
          b
        )(Shared.Bool.and_true_right(Pieces.after_all(x, List.append(&2, Piece, rest, b)), Pieces.sorted(List.append(&2, Piece, rest, b)))(h))
      )

# a sorted run of a, then b: b is sorted
def Pieces.sorted_right(a: List<&2, Piece>, +b: List<&2, Piece>) -> {Pieces.sorted(List.append(&2, Piece, a, b)) == True{}: Bool} -> {
  Pieces.sorted(b) == True{}: Bool
}:
  match a:
    case Nil{}:
      h => h
    case Con{+x, +rest}:
      h => Pieces.sorted_right(
        rest,
        b
      )(Shared.Bool.and_true_right(Pieces.after_all(x, List.append(&2, Piece, rest, b)), Pieces.sorted(List.append(&2, Piece, rest, b)))(h))

# a sorted run of a, then b: a is before b
def Pieces.sorted_split(a: List<&2, Piece>, +b: List<&2, Piece>) -> {Pieces.sorted(List.append(&2, Piece, a, b)) == True{}: Bool} -> {
  Pieces.before_all(a, b) == True{}: Bool
}:
  match a:
    case Nil{}:
      h => {==}
    case Con{+x, +rest}:
      +h => Shared.Bool.and_both(
        Pieces.after_all(x, b),
        Pieces.before_all(rest, b)
      )(
        Pieces.after_all_right(
          x,
          rest,
          b
        )(Shared.Bool.and_true_left(Pieces.after_all(x, List.append(&2, Piece, rest, b)), Pieces.sorted(List.append(&2, Piece, rest, b)))(h))
      )(
        Pieces.sorted_split(
          rest,
          b
        )(Shared.Bool.and_true_right(Pieces.after_all(x, List.append(&2, Piece, rest, b)), Pieces.sorted(List.append(&2, Piece, rest, b)))(h))
      )

# a key that pieces before the binding of k1 may hold is before k1
def Pieces.below_all(xs: List<&2, Piece>, +k1: List<&2, U32>, +v1: List<&2, U32>, +ys: List<&2, Piece>, +key: List<&2, U32>) -> {
  Pieces.before_all(xs, Piece.Bind{k1, v1} <> ys) == True{}: Bool
} -> {Pieces.covers(xs, key) == True{}: Bool} -> {Key.is_lt(key, k1) == True{}: Bool}:
  match xs:
    case Nil{}:
      hb => hc => Empty.absurd({Key.is_lt(key, k1) == True{}: Bool}, Shared.Bool.false_ne_true(hc))
    case Con{+x, +rest}:
      +hb => hc => Bool.cases(
        Piece.covers(x, key),
        {Key.is_lt(key, k1) == True{}: Bool},
        cx => Piece.below_bind(
          x,
          k1,
          v1,
          key
        )(
          Shared.Bool.and_true_left(
            Piece.before(x, Piece.Bind{k1, v1}),
            Pieces.after_all(x, ys)
          )(Shared.Bool.and_true_left(Pieces.after_all(x, Piece.Bind{k1, v1} <> ys), Pieces.before_all(rest, Piece.Bind{k1, v1} <> ys))(hb))
        )(cx),
        cx => Pieces.below_all(
          rest,
          k1,
          v1,
          ys,
          key
        )(Shared.Bool.and_true_right(Pieces.after_all(x, Piece.Bind{k1, v1} <> ys), Pieces.before_all(rest, Piece.Bind{k1, v1} <> ys))(hb))(
          Equal.trans(
            Bool,
            Pieces.covers(rest, key),
            Bool.or(Piece.covers(x, key), Pieces.covers(rest, key)),
            True{},
            Equal.cong(Bool, Bool, t => Bool.or(t, Pieces.covers(rest, key)), False{}, Piece.covers(x, key), Equal.sym(Bool, Piece.covers(x, key), False{}, cx)),
            hc
          )
        )
      )

# a key that pieces after the binding of k1 may hold is after k1
def Pieces.above_all(+k1: List<&2, U32>, +v1: List<&2, U32>, ys: List<&2, Piece>, +key: List<&2, U32>) -> {
  Pieces.after_all(Piece.Bind{k1, v1}, ys) == True{}: Bool
} -> {Pieces.covers(ys, key) == True{}: Bool} -> {Key.is_lt(k1, key) == True{}: Bool}:
  match ys:
    case Nil{}:
      hb => hc => Empty.absurd({Key.is_lt(k1, key) == True{}: Bool}, Shared.Bool.false_ne_true(hc))
    case Con{+y, +rest}:
      +hb => hc => Bool.cases(
        Piece.covers(y, key),
        {Key.is_lt(k1, key) == True{}: Bool},
        cy => Piece.above_bind(k1, v1, y, key)(Shared.Bool.and_true_left(Piece.before(Piece.Bind{k1, v1}, y), Pieces.after_all(Piece.Bind{k1, v1}, rest))(hb))(cy),
        cy => Pieces.above_all(
          k1,
          v1,
          rest,
          key
        )(Shared.Bool.and_true_right(Piece.before(Piece.Bind{k1, v1}, y), Pieces.after_all(Piece.Bind{k1, v1}, rest))(hb))(
          Equal.trans(
            Bool,
            Pieces.covers(rest, key),
            Bool.or(Piece.covers(y, key), Pieces.covers(rest, key)),
            True{},
            Equal.cong(Bool, Bool, t => Bool.or(t, Pieces.covers(rest, key)), False{}, Piece.covers(y, key), Equal.sym(Bool, Piece.covers(y, key), False{}, cy)),
            hc
          )
        )
      )

# the lower bound lo is not after the lower bound lo2
def Bound.lo_le(lo: Maybe<&2, List<&2, U32>>, lo2: Maybe<&2, List<&2, U32>>) -> Bool:
  match lo lo2:
    case None{} y:
      True{}
    case Some{a} None{}:
      False{}
    case Some{a} Some{c}:
      Key.le(a, c)

# the upper bound hi2 is not after the upper bound hi
def Bound.hi_le(hi2: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match hi2 hi:
    case x None{}:
      True{}
    case None{} Some{b}:
      False{}
    case Some{c} Some{b}:
      Key.le(c, b)

# the piece x lies between lo and hi
def Piece.inside(x: Piece, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match x:
    case Piece.Bind{+k, v}:
      Bool.and(Bound.after(lo, k), Bound.before(k, hi))
    case Piece.Sub{h, u, lo2, hi2}:
      Bool.and(Bound.lo_le(lo, lo2), Bound.hi_le(hi2, hi))

# the pieces ps lie between lo and hi
def Pieces.inside(ps: List<&2, Piece>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{x, rest}:
      Bool.and(Piece.inside(x, lo, hi), Pieces.inside(rest, lo, hi))

# a lower bound is not after itself
def Bound.lo_le_refl(lo: Maybe<&2, List<&2, U32>>) -> {Bound.lo_le(lo, lo) == True{}: Bool}:
  match lo:
    case None{}:
      {==}
    case Some{+a}:
      Key.le_refl(a)

# Piece.refine_left for two bindings, by the upper bound hi
def Piece.refine_left.bb(+kw: List<&2, U32>, +k: List<&2, U32>, +lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>) -> {
  Bool.and(Bound.after(lo, kw), Bound.before(kw, hi)) == True{}: Bool
} -> {Bound.at_least(hi, k) == True{}: Bool} -> {Key.is_lt(kw, k) == True{}: Bool}:
  match hi:
    case None{}:
      hin => hb => Empty.absurd({Key.is_lt(kw, k) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+b}:
      hin => hb => Key.lt_le(kw, b, k)(Shared.Bool.and_true_right(Bound.after(lo, kw), Key.is_lt(kw, b))(hin))(hb)

# Piece.refine_left for a binding before a subtree, by the bounds
def Piece.refine_left.bs(+kw: List<&2, U32>, +lo: Maybe<&2, List<&2, U32>>, hi: Maybe<&2, List<&2, U32>>, lo3: Maybe<&2, List<&2, U32>>) -> {
  Bool.and(Bound.after(lo, kw), Bound.before(kw, hi)) == True{}: Bool
} -> {Bound.ends_before(hi, lo3) == True{}: Bool} -> {Bound.at_most(kw, lo3) == True{}: Bool}:
  match hi lo3:
    case Some{+b} Some{+a}:
      hin => hb => Key.lt_le_of(kw, a)(Key.lt_le(kw, b, a)(Shared.Bool.and_true_right(Bound.after(lo, kw), Key.is_lt(kw, b))(hin))(hb))
    case None{} z:
      hin => hb => Empty.absurd({Bound.at_most(kw, z) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{b} None{}:
      hin => hb => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(hb))

# Piece.refine_left for a subtree before a binding, by the bounds
def Piece.refine_left.sb(
  +lo: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  hi2: Maybe<&2, List<&2, U32>>,
  hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> {Bool.and(Bound.lo_le(lo, lo2), Bound.hi_le(hi2, hi)) == True{}: Bool} -> {Bound.at_least(hi, k) == True{}: Bool} -> {
  Bound.at_least(hi2, k) == True{}: Bool
}:
  match hi2 hi:
    case Some{+c} Some{+b}:
      hin => hb => Key.le_trans(c, b, k)(Shared.Bool.and_true_right(Bound.lo_le(lo, lo2), Key.le(c, b))(hin))(hb)
    case x None{}:
      hin => hb => Empty.absurd({Bound.at_least(x, k) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case None{} Some{b}:
      hin => hb => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(Shared.Bool.and_true_right(Bound.lo_le(lo, lo2), False{})(hin)))

# Piece.refine_left for two subtrees, by the bounds
def Piece.refine_left.ss(
  +lo: Maybe<&2, List<&2, U32>>,
  +lo2: Maybe<&2, List<&2, U32>>,
  hi2: Maybe<&2, List<&2, U32>>,
  hi: Maybe<&2, List<&2, U32>>,
  lo3: Maybe<&2, List<&2, U32>>
) -> {Bool.and(Bound.lo_le(lo, lo2), Bound.hi_le(hi2, hi)) == True{}: Bool} -> {Bound.ends_before(hi, lo3) == True{}: Bool} -> {
  Bound.ends_before(hi2, lo3) == True{}: Bool
}:
  match hi2 hi lo3:
    case Some{+c} Some{+b} Some{+a}:
      hin => hb => Key.le_trans(c, b, a)(Shared.Bool.and_true_right(Bound.lo_le(lo, lo2), Key.le(c, b))(hin))(hb)
    case x None{} z:
      hin => hb => Empty.absurd({Bound.ends_before(x, z) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case x Some{b} None{}:
      hin => hb => Empty.absurd({Bound.ends_before(x, None{}) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case None{} Some{b} Some{a}:
      hin => hb => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(Shared.Bool.and_true_right(Bound.lo_le(lo, lo2), False{})(hin)))

# a piece between lo and hi comes before what the subtree of lo and hi comes
# before
def Piece.refine_left(w: Piece, y: Piece, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, -h: Hashes.Hash, -u: Nat) -> {
  Piece.inside(w, lo, hi) == True{}: Bool
} -> {Piece.before(Piece.Sub{h, u, lo, hi}, y) == True{}: Bool} -> {Piece.before(w, y) == True{}: Bool}:
  match w y:
    case Piece.Bind{+kw, vw} Piece.Bind{+k, v}:
      Piece.refine_left.bb(kw, k, lo, hi)
    case Piece.Bind{+kw, vw} Piece.Sub{h3, u3, lo3, hi3}:
      Piece.refine_left.bs(kw, lo, hi, lo3)
    case Piece.Sub{h2, u2, lo2, hi2} Piece.Bind{+k, v}:
      Piece.refine_left.sb(lo, lo2, hi2, hi, k)
    case Piece.Sub{h2, u2, lo2, hi2} Piece.Sub{h3, u3, lo3, hi3}:
      Piece.refine_left.ss(lo, lo2, hi2, hi, lo3)

# Piece.refine_right for a binding before a subtree, by the bounds
def Piece.refine_right.bb(+kw: List<&2, U32>, lo: Maybe<&2, List<&2, U32>>, -hi: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>) -> {
  Bound.at_most(kw, lo) == True{}: Bool
} -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool} -> {Key.is_lt(kw, k) == True{}: Bool}:
  match lo:
    case None{}:
      hb => hin => Empty.absurd({Key.is_lt(kw, k) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{+a}:
      hb => hin => Key.le_lt(kw, a, k)(hb)(Shared.Bool.and_true_left(Key.is_lt(a, k), Bound.before(k, hi))(hin))

# Piece.refine_right for a binding before a subtree, then a subtree in it
def Piece.refine_right.bs(+kw: List<&2, U32>, lo: Maybe<&2, List<&2, U32>>, -hi: Maybe<&2, List<&2, U32>>, lo2: Maybe<&2, List<&2, U32>>, -hi2: Maybe<&2, List<&2, U32>>) -> {
  Bound.at_most(kw, lo) == True{}: Bool
} -> {Bool.and(Bound.lo_le(lo, lo2), Bound.hi_le(hi2, hi)) == True{}: Bool} -> {Bound.at_most(kw, lo2) == True{}: Bool}:
  match lo lo2:
    case Some{+a} Some{+c}:
      hb => hin => Key.le_trans(kw, a, c)(hb)(Shared.Bool.and_true_left(Key.le(a, c), Bound.hi_le(hi2, hi))(hin))
    case None{} z:
      hb => hin => Empty.absurd({Bound.at_most(kw, z) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{a} None{}:
      hb => hin => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(Shared.Bool.and_true_left(False{}, Bound.hi_le(hi2, hi))(hin)))

# Piece.refine_right for a subtree before a subtree, then a binding in it
def Piece.refine_right.sb(hi1: Maybe<&2, List<&2, U32>>, lo: Maybe<&2, List<&2, U32>>, -hi: Maybe<&2, List<&2, U32>>, +k: List<&2, U32>) -> {
  Bound.ends_before(hi1, lo) == True{}: Bool
} -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool} -> {Bound.at_least(hi1, k) == True{}: Bool}:
  match hi1 lo:
    case Some{+b} Some{+a}:
      hb => hin => Key.lt_le_of(b, k)(Key.le_lt(b, a, k)(hb)(Shared.Bool.and_true_left(Key.is_lt(a, k), Bound.before(k, hi))(hin)))
    case None{} z:
      hb => hin => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{b} None{}:
      hb => hin => Empty.absurd({Key.le(b, k) == True{}: Bool}, Shared.Bool.false_ne_true(hb))

# Piece.refine_right for a subtree before a subtree, then a subtree in it
def Piece.refine_right.ss(
  hi1: Maybe<&2, List<&2, U32>>,
  lo: Maybe<&2, List<&2, U32>>,
  -hi: Maybe<&2, List<&2, U32>>,
  lo2: Maybe<&2, List<&2, U32>>,
  -hi2: Maybe<&2, List<&2, U32>>
) -> {Bound.ends_before(hi1, lo) == True{}: Bool} -> {Bool.and(Bound.lo_le(lo, lo2), Bound.hi_le(hi2, hi)) == True{}: Bool} -> {
  Bound.ends_before(hi1, lo2) == True{}: Bool
}:
  match hi1 lo lo2:
    case Some{+b} Some{+a} Some{+c}:
      hb => hin => Key.le_trans(b, a, c)(hb)(Shared.Bool.and_true_left(Key.le(a, c), Bound.hi_le(hi2, hi))(hin))
    case None{} y z:
      hb => hin => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{b} None{} z:
      hb => hin => Empty.absurd({Bound.ends_before(Some{b}, z) == True{}: Bool}, Shared.Bool.false_ne_true(hb))
    case Some{b} Some{a} None{}:
      hb => hin => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(Shared.Bool.and_true_left(False{}, Bound.hi_le(hi2, hi))(hin)))

# a piece before the subtree of lo and hi comes before each piece between lo
# and hi
def Piece.refine_right(w: Piece, z: Piece, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, -h: Hashes.Hash, -u: Nat) -> {
  Piece.before(w, Piece.Sub{h, u, lo, hi}) == True{}: Bool
} -> {Piece.inside(z, lo, hi) == True{}: Bool} -> {Piece.before(w, z) == True{}: Bool}:
  match w z:
    case Piece.Bind{+kw, vw} Piece.Bind{+k, v}:
      Piece.refine_right.bb(kw, lo, hi, k)
    case Piece.Bind{+kw, vw} Piece.Sub{h2, u2, lo2, hi2}:
      Piece.refine_right.bs(kw, lo, hi, lo2, hi2)
    case Piece.Sub{h1, u1, lo1, hi1} Piece.Bind{+k, v}:
      Piece.refine_right.sb(hi1, lo, hi, k)
    case Piece.Sub{h1, u1, lo1, hi1} Piece.Sub{h2, u2, lo2, hi2}:
      Piece.refine_right.ss(hi1, lo, hi, lo2, hi2)

# pieces after x, then others after x, are all after x
def Pieces.after_all_append(+x: Piece, a: List<&2, Piece>, +b: List<&2, Piece>) -> {Pieces.after_all(x, a) == True{}: Bool} -> {
  Pieces.after_all(x, b) == True{}: Bool
} -> {Pieces.after_all(x, List.append(&2, Piece, a, b)) == True{}: Bool}:
  match a:
    case Nil{}:
      ha => hb => hb
    case Con{+y, +rest}:
      +ha => hb => Shared.Bool.and_both(
        Piece.before(x, y),
        Pieces.after_all(x, List.append(&2, Piece, rest, b))
      )(Shared.Bool.and_true_left(Piece.before(x, y), Pieces.after_all(x, rest))(ha))(
        Pieces.after_all_append(x, rest, b)(Shared.Bool.and_true_right(Piece.before(x, y), Pieces.after_all(x, rest))(ha))(hb)
      )

# sorted pieces, then sorted pieces after them, are sorted
def Pieces.sorted_append(a: List<&2, Piece>, +b: List<&2, Piece>) -> {Pieces.sorted(a) == True{}: Bool} -> {Pieces.sorted(b) == True{}: Bool} -> {
  Pieces.before_all(a, b) == True{}: Bool
} -> {Pieces.sorted(List.append(&2, Piece, a, b)) == True{}: Bool}:
  match a:
    case Nil{}:
      ha => hb => hab => hb
    case Con{+x, +rest}:
      +ha => hb => +hab => Shared.Bool.and_both(
        Pieces.after_all(x, List.append(&2, Piece, rest, b)),
        Pieces.sorted(List.append(&2, Piece, rest, b))
      )(
        Pieces.after_all_append(
          x,
          rest,
          b
        )(Shared.Bool.and_true_left(Pieces.after_all(x, rest), Pieces.sorted(rest))(ha))(
          Shared.Bool.and_true_left(Pieces.after_all(x, b), Pieces.before_all(rest, b))(hab)
        )
      )(
        Pieces.sorted_append(
          rest,
          b
        )(Shared.Bool.and_true_right(Pieces.after_all(x, rest), Pieces.sorted(rest))(ha))(hb)(
          Shared.Bool.and_true_right(Pieces.after_all(x, b), Pieces.before_all(rest, b))(hab)
        )
      )

# a piece between lo and hi comes before what the subtree of lo and hi
# comes before
def Pieces.refine_left_list(+w: Piece, ys: List<&2, Piece>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, +h: Hashes.Hash, +u: Nat) -> {
  Piece.inside(w, lo, hi) == True{}: Bool
} -> {Pieces.after_all(Piece.Sub{h, u, lo, hi}, ys) == True{}: Bool} -> {Pieces.after_all(w, ys) == True{}: Bool}:
  match ys:
    case Nil{}:
      hi2 => ha => {==}
    case Con{+y, +rest}:
      +hi2 => +ha => Shared.Bool.and_both(
        Piece.before(w, y),
        Pieces.after_all(w, rest)
      )(
        Piece.refine_left(
          w,
          y,
          lo,
          hi,
          h,
          u
        )(hi2)(Shared.Bool.and_true_left(Piece.before(Piece.Sub{h, u, lo, hi}, y), Pieces.after_all(Piece.Sub{h, u, lo, hi}, rest))(ha))
      )(
        Pieces.refine_left_list(
          w,
          rest,
          lo,
          hi,
          h,
          u
        )(hi2)(Shared.Bool.and_true_right(Piece.before(Piece.Sub{h, u, lo, hi}, y), Pieces.after_all(Piece.Sub{h, u, lo, hi}, rest))(ha))
      )

# pieces between lo and hi come before what the subtree of lo and hi comes
# before
def Pieces.refine_left_all(ws: List<&2, Piece>, +ys: List<&2, Piece>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, +h: Hashes.Hash, +u: Nat) -> {
  Pieces.inside(ws, lo, hi) == True{}: Bool
} -> {Pieces.after_all(Piece.Sub{h, u, lo, hi}, ys) == True{}: Bool} -> {Pieces.before_all(ws, ys) == True{}: Bool}:
  match ws:
    case Nil{}:
      hi2 => ha => {==}
    case Con{+w, +rest}:
      +hi2 => +ha => Shared.Bool.and_both(
        Pieces.after_all(w, ys),
        Pieces.before_all(rest, ys)
      )(Pieces.refine_left_list(w, ys, lo, hi, h, u)(Shared.Bool.and_true_left(Piece.inside(w, lo, hi), Pieces.inside(rest, lo, hi))(hi2))(ha))(
        Pieces.refine_left_all(rest, ys, lo, hi, h, u)(Shared.Bool.and_true_right(Piece.inside(w, lo, hi), Pieces.inside(rest, lo, hi))(hi2))(ha)
      )

# a piece before the subtree of lo and hi comes before each piece between
# lo and hi
def Pieces.refine_right_all(+w: Piece, zs: List<&2, Piece>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, +h: Hashes.Hash, +u: Nat) -> {
  Piece.before(w, Piece.Sub{h, u, lo, hi}) == True{}: Bool
} -> {Pieces.inside(zs, lo, hi) == True{}: Bool} -> {Pieces.after_all(w, zs) == True{}: Bool}:
  match zs:
    case Nil{}:
      hb => hi2 => {==}
    case Con{+z, +rest}:
      +hb => +hi2 => Shared.Bool.and_both(
        Piece.before(w, z),
        Pieces.after_all(w, rest)
      )(Piece.refine_right(w, z, lo, hi, h, u)(hb)(Shared.Bool.and_true_left(Piece.inside(z, lo, hi), Pieces.inside(rest, lo, hi))(hi2)))(
        Pieces.refine_right_all(w, rest, lo, hi, h, u)(hb)(Shared.Bool.and_true_right(Piece.inside(z, lo, hi), Pieces.inside(rest, lo, hi))(hi2))
      )

# Piece.inside_covers for a subtree, by the bounds
def Piece.inside_covers.s(
  lo: Maybe<&2, List<&2, U32>>,
  lo2: Maybe<&2, List<&2, U32>>,
  hi2: Maybe<&2, List<&2, U32>>,
  hi: Maybe<&2, List<&2, U32>>,
  +key: List<&2, U32>
) -> {Bool.and(Bound.lo_le(lo, lo2), Bound.hi_le(hi2, hi)) == True{}: Bool} -> {Bool.and(Bound.after(lo2, key), Bound.before(key, hi2)) == True{}: Bool} -> {
  Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool
}:
  match lo lo2 hi2 hi:
    case None{} x y None{}:
      hin => hc => {==}
    case None{} x Some{+c} Some{+b}:
      hin => hc => Key.lt_le(key, c, b)(Shared.Bool.and_true_right(Bound.after(x, key), Key.is_lt(key, c))(hc))(Shared.Bool.and_true_right(True{}, Key.le(c, b))(hin))
    case Some{+a} Some{+d} y None{}:
      hin => hc => Shared.Bool.and_both(Key.is_lt(a, key), True{})(
        Key.le_lt(a, d, key)(Shared.Bool.and_true_left(Key.le(a, d), True{})(hin))(Shared.Bool.and_true_left(Key.is_lt(d, key), Bound.before(key, y))(hc))
      )({==})
    case Some{+a} Some{+d} Some{+c} Some{+b}:
      +hin => +hc => Shared.Bool.and_both(
        Key.is_lt(a, key),
        Key.is_lt(key, b)
      )(Key.le_lt(a, d, key)(Shared.Bool.and_true_left(Key.le(a, d), Key.le(c, b))(hin))(Shared.Bool.and_true_left(Key.is_lt(d, key), Key.is_lt(key, c))(hc)))(
        Key.lt_le(key, c, b)(Shared.Bool.and_true_right(Key.is_lt(d, key), Key.is_lt(key, c))(hc))(Shared.Bool.and_true_right(Key.le(a, d), Key.le(c, b))(hin))
      )
    case x y None{} Some{b}:
      hin => hc => Empty.absurd(
        {Bool.and(Bound.after(x, key), Key.is_lt(key, b)) == True{}: Bool},
        Shared.Bool.false_ne_true(Shared.Bool.and_true_right(Bound.lo_le(x, y), False{})(hin))
      )
    case Some{a} None{} y z:
      hin => hc => Empty.absurd(
        {Bool.and(Key.is_lt(a, key), Bound.before(key, z)) == True{}: Bool},
        Shared.Bool.false_ne_true(Shared.Bool.and_true_left(False{}, Bound.hi_le(y, z))(hin))
      )

# a key that a piece between lo and hi may hold is between lo and hi
def Piece.inside_covers(x: Piece, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, +key: List<&2, U32>) -> {
  Piece.inside(x, lo, hi) == True{}: Bool
} -> {Piece.covers(x, key) == True{}: Bool} -> {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool}:
  match x:
    case Piece.Bind{+k, v}:
      hin => hc =>
        %Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), k, key)(hc): {Bool.and(Bound.after(lo, _), Bound.before(_, hi)) == True{}: Bool}
        hin
    case Piece.Sub{h, u, lo2, hi2}:
      hin => hc => Piece.inside_covers.s(lo, lo2, hi2, hi, key)(hin)(hc)

# a key that pieces between lo and hi may hold is between lo and hi
def Pieces.inside_covers(ps: List<&2, Piece>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>, +key: List<&2, U32>) -> {
  Pieces.inside(ps, lo, hi) == True{}: Bool
} -> {Pieces.covers(ps, key) == True{}: Bool} -> {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool}:
  match ps:
    case Nil{}:
      hin => hc => Empty.absurd({Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool}, Shared.Bool.false_ne_true(hc))
    case Con{+x, +rest}:
      +hin => hc => Bool.cases(
        Piece.covers(x, key),
        {Bool.and(Bound.after(lo, key), Bound.before(key, hi)) == True{}: Bool},
        cx => Piece.inside_covers(x, lo, hi, key)(Shared.Bool.and_true_left(Piece.inside(x, lo, hi), Pieces.inside(rest, lo, hi))(hin))(cx),
        cx => Pieces.inside_covers(
          rest,
          lo,
          hi,
          key
        )(Shared.Bool.and_true_right(Piece.inside(x, lo, hi), Pieces.inside(rest, lo, hi))(hin))(
          Equal.trans(
            Bool,
            Pieces.covers(rest, key),
            Bool.or(Piece.covers(x, key), Pieces.covers(rest, key)),
            True{},
            Equal.cong(Bool, Bool, t => Bool.or(t, Pieces.covers(rest, key)), False{}, Piece.covers(x, key), Equal.sym(Bool, Piece.covers(x, key), False{}, cx)),
            hc
          )
        )
      )

# an upper bound is not after itself
def Bound.hi_le_refl(hi: Maybe<&2, List<&2, U32>>) -> {Bound.hi_le(hi, hi) == True{}: Bool}:
  match hi:
    case None{}:
      {==}
    case Some{+b}:
      Key.le_refl(b)

# a key before hi, as an upper bound, is not after hi
def Bound.hi_le_of(+ik: List<&2, U32>, hi: Maybe<&2, List<&2, U32>>) -> {Bound.before(ik, hi) == True{}: Bool} -> {Bound.hi_le(Some{ik}, hi) == True{}: Bool}:
  match hi:
    case None{}:
      h => {==}
    case Some{+b}:
      h => Key.lt_le_of(ik, b)(h)

# a lower bound after ik is after any bound before ik
def Bound.lo_le_widen(lo: Maybe<&2, List<&2, U32>>, +ik: List<&2, U32>, lo2: Maybe<&2, List<&2, U32>>) -> {
  Bound.lo_le(Some{ik}, lo2) == True{}: Bool
} -> {Bound.after(lo, ik) == True{}: Bool} -> {Bound.lo_le(lo, lo2) == True{}: Bool}:
  match lo lo2:
    case None{} y:
      h => g => {==}
    case Some{a} None{}:
      h => g => Empty.absurd({False{} == True{}: Bool}, Shared.Bool.false_ne_true(h))
    case Some{+a} Some{+c}:
      h => g => Key.lt_le_of(a, c)(Key.lt_le(a, ik, c)(g)(h))

# a piece after ik and before hi lies between any bound before ik and hi
def Piece.inside_widen(x: Piece, +ik: List<&2, U32>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Piece.inside(x, Some{ik}, hi) == True{}: Bool
} -> {Bound.after(lo, ik) == True{}: Bool} -> {Piece.inside(x, lo, hi) == True{}: Bool}:
  match x:
    case Piece.Bind{+k, v}:
      +h => g => Shared.Bool.and_both(
        Bound.after(lo, k),
        Bound.before(k, hi)
      )(Bound.after_trans(lo, ik, k)(g)(Shared.Bool.and_true_left(Key.is_lt(ik, k), Bound.before(k, hi))(h)))(
        Shared.Bool.and_true_right(Key.is_lt(ik, k), Bound.before(k, hi))(h)
      )
    case Piece.Sub{h2, u, +lo2, +hi2}:
      +h => g => Shared.Bool.and_both(
        Bound.lo_le(lo, lo2),
        Bound.hi_le(hi2, hi)
      )(Bound.lo_le_widen(lo, ik, lo2)(Shared.Bool.and_true_left(Bound.lo_le(Some{ik}, lo2), Bound.hi_le(hi2, hi))(h))(g))(
        Shared.Bool.and_true_right(Bound.lo_le(Some{ik}, lo2), Bound.hi_le(hi2, hi))(h)
      )

# pieces after ik and before hi lie between any bound before ik and hi
def Pieces.inside_widen(ps: List<&2, Piece>, +ik: List<&2, U32>, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Pieces.inside(ps, Some{ik}, hi) == True{}: Bool
} -> {Bound.after(lo, ik) == True{}: Bool} -> {Pieces.inside(ps, lo, hi) == True{}: Bool}:
  match ps:
    case Nil{}:
      h => g => {==}
    case Con{+x, +rest}:
      +h => +g => Shared.Bool.and_both(
        Piece.inside(x, lo, hi),
        Pieces.inside(rest, lo, hi)
      )(Piece.inside_widen(x, ik, lo, hi)(Shared.Bool.and_true_left(Piece.inside(x, Some{ik}, hi), Pieces.inside(rest, Some{ik}, hi))(h))(g))(
        Pieces.inside_widen(rest, ik, lo, hi)(Shared.Bool.and_true_right(Piece.inside(x, Some{ik}, hi), Pieces.inside(rest, Some{ik}, hi))(h))(g)
      )

# a lower bound after ik is what the binding of ik ends before
def Bound.at_most_of(+ik: List<&2, U32>, lo2: Maybe<&2, List<&2, U32>>) -> {Bound.lo_le(Some{ik}, lo2) == True{}: Bool} -> {
  Bound.at_most(ik, lo2) == True{}: Bool
}:
  match lo2:
    case None{}:
      h => h
    case Some{c}:
      h => h

# a lower bound after ik is what a subtree that ends at ik ends before
def Bound.ends_before_of(+ik: List<&2, U32>, lo2: Maybe<&2, List<&2, U32>>) -> {Bound.lo_le(Some{ik}, lo2) == True{}: Bool} -> {
  Bound.ends_before(Some{ik}, lo2) == True{}: Bool
}:
  match lo2:
    case None{}:
      h => h
    case Some{c}:
      h => h

# pieces after ik come after the binding of ik
def Pieces.after_inside_bind(+ik: List<&2, U32>, +iv: List<&2, U32>, ys: List<&2, Piece>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Pieces.inside(ys, Some{ik}, hi) == True{}: Bool
} -> {Pieces.after_all(Piece.Bind{ik, iv}, ys) == True{}: Bool}:
  match ys:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{+k, +v}, +rest}:
      +h => Shared.Bool.and_both(
        Key.is_lt(ik, k),
        Pieces.after_all(Piece.Bind{ik, iv}, rest)
      )(Shared.Bool.and_true_left(Key.is_lt(ik, k), Bound.before(k, hi))(Shared.Bool.and_true_left(Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)), Pieces.inside(rest, Some{ik}, hi))(h)))(
        Pieces.after_inside_bind(ik, iv, rest, hi)(Shared.Bool.and_true_right(Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)), Pieces.inside(rest, Some{ik}, hi))(h))
      )
    case Con{Piece.Sub{+h2, +u, +lo2, +hi2}, +rest}:
      +h => Shared.Bool.and_both(
        Bound.at_most(ik, lo2),
        Pieces.after_all(Piece.Bind{ik, iv}, rest)
      )(
        Bound.at_most_of(
          ik,
          lo2
        )(
          Shared.Bool.and_true_left(
            Bound.lo_le(Some{ik}, lo2),
            Bound.hi_le(hi2, hi)
          )(Shared.Bool.and_true_left(Bool.and(Bound.lo_le(Some{ik}, lo2), Bound.hi_le(hi2, hi)), Pieces.inside(rest, Some{ik}, hi))(h))
        )
      )(
        Pieces.after_inside_bind(
          ik,
          iv,
          rest,
          hi
        )(Shared.Bool.and_true_right(Bool.and(Bound.lo_le(Some{ik}, lo2), Bound.hi_le(hi2, hi)), Pieces.inside(rest, Some{ik}, hi))(h))
      )

# pieces after ik come after a subtree that ends at ik
def Pieces.after_inside_sub(
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +ik: List<&2, U32>,
  ys: List<&2, Piece>,
  +hi: Maybe<&2, List<&2, U32>>
) -> {Pieces.inside(ys, Some{ik}, hi) == True{}: Bool} -> {Pieces.after_all(Piece.Sub{h, u, lo, Some{ik}}, ys) == True{}: Bool}:
  match ys:
    case Nil{}:
      g => {==}
    case Con{Piece.Bind{+k, +v}, +rest}:
      +g => Shared.Bool.and_both(
        Key.le(ik, k),
        Pieces.after_all(Piece.Sub{h, u, lo, Some{ik}}, rest)
      )(
        Key.lt_le_of(
          ik,
          k
        )(Shared.Bool.and_true_left(Key.is_lt(ik, k), Bound.before(k, hi))(Shared.Bool.and_true_left(Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)), Pieces.inside(rest, Some{ik}, hi))(g)))
      )(
        Pieces.after_inside_sub(
          h,
          u,
          lo,
          ik,
          rest,
          hi
        )(Shared.Bool.and_true_right(Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)), Pieces.inside(rest, Some{ik}, hi))(g))
      )
    case Con{Piece.Sub{+h2, +u2, +lo2, +hi2}, +rest}:
      +g => Shared.Bool.and_both(
        Bound.ends_before(Some{ik}, lo2),
        Pieces.after_all(Piece.Sub{h, u, lo, Some{ik}}, rest)
      )(
        Bound.ends_before_of(
          ik,
          lo2
        )(
          Shared.Bool.and_true_left(
            Bound.lo_le(Some{ik}, lo2),
            Bound.hi_le(hi2, hi)
          )(Shared.Bool.and_true_left(Bool.and(Bound.lo_le(Some{ik}, lo2), Bound.hi_le(hi2, hi)), Pieces.inside(rest, Some{ik}, hi))(g))
        )
      )(
        Pieces.after_inside_sub(
          h,
          u,
          lo,
          ik,
          rest,
          hi
        )(Shared.Bool.and_true_right(Bool.and(Bound.lo_le(Some{ik}, lo2), Bound.hi_le(hi2, hi)), Pieces.inside(rest, Some{ik}, hi))(g))
      )

# Mst.pieces_sorted at the subtree prev before the item of the key ik
def Mst.pieces_sorted.con(
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +ks2: List<&2, Piece>,
  hs: {Pieces.sorted(Piece.Bind{ik, iv} <> ks2) == True{}: Bool},
  hin: {Pieces.inside(Piece.Bind{ik, iv} <> ks2, lo, hi) == True{}: Bool},
  ins2: {Pieces.inside(ks2, Some{ik}, hi) == True{}: Bool},
  bh: {Bound.before(ik, hi) == True{}: Bool}
) -> {
  Bool.and(
    Pieces.sorted(Piece.sub(m, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2)),
    Pieces.inside(Piece.sub(m, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), lo, hi)
  )
    == True{}: Bool
}:
  match m:
    case None{}:
      Shared.Bool.and_both(Pieces.sorted(Piece.Bind{ik, iv} <> ks2), Pieces.inside(Piece.Bind{ik, iv} <> ks2, lo, hi))(hs)(hin)
    case Some{+h}:
      Shared.Bool.and_both(
        Pieces.sorted(Piece.Sub{h, l, lo, Some{ik}} <> (Piece.Bind{ik, iv} <> ks2)),
        Pieces.inside(Piece.Sub{h, l, lo, Some{ik}} <> (Piece.Bind{ik, iv} <> ks2), lo, hi)
      )(
        Shared.Bool.and_both(
          Pieces.after_all(Piece.Sub{h, l, lo, Some{ik}}, Piece.Bind{ik, iv} <> ks2),
          Pieces.sorted(Piece.Bind{ik, iv} <> ks2)
        )(Shared.Bool.and_both(Key.le(ik, ik), Pieces.after_all(Piece.Sub{h, l, lo, Some{ik}}, ks2))(Key.le_refl(ik))(Pieces.after_inside_sub(h, l, lo, ik, ks2, hi)(ins2)))(
          hs
        )
      )(
        Shared.Bool.and_both(
          Piece.inside(Piece.Sub{h, l, lo, Some{ik}}, lo, hi),
          Pieces.inside(Piece.Bind{ik, iv} <> ks2, lo, hi)
        )(Shared.Bool.and_both(Bound.lo_le(lo, lo), Bound.hi_le(Some{ik}, hi))(Bound.lo_le_refl(lo))(Bound.hi_le_of(ik, hi)(bh)))(hin)
      )

# Mst.pieces_sorted with no item: at most the subtree before
def Mst.pieces_sorted.nil(m: Maybe<&2, Hashes.Hash>, +l: Nat, +lo: Maybe<&2, List<&2, U32>>, +hi: Maybe<&2, List<&2, U32>>) -> {
  Bool.and(Pieces.sorted(Piece.sub(m, l, lo, hi, [])), Pieces.inside(Piece.sub(m, l, lo, hi, []), lo, hi)) == True{}: Bool
}:
  match m:
    case None{}:
      {==}
    case Some{+h}:
      Shared.Bool.and_both(
        Pieces.sorted([Piece.Sub{h, l, lo, hi}]),
        Pieces.inside([Piece.Sub{h, l, lo, hi}], lo, hi)
      )({==})(
        Shared.Bool.and_both(Piece.inside(Piece.Sub{h, l, lo, hi}, lo, hi), True{})(
          Shared.Bool.and_both(Bound.lo_le(lo, lo), Bound.hi_le(hi, hi))(Bound.lo_le_refl(lo))(Bound.hi_le_refl(hi))
        )({==})
      )

# the pieces of a node's items are sorted and lie in its bounds
def Mst.pieces_sorted(
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Bool.and(Pieces.sorted(ks), Pieces.inside(ks, lo, hi)) == True{}: Bool
}:
  match xs:
    case Nil{}:
      ep =>
        %Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep): {
          Bool.and(Pieces.sorted(_), Pieces.inside(_, lo, hi)) == True{}: Bool
        }
        Mst.pieces_sorted.nil(prev, l, lo, hi)
    case Con{Item{+ik, +iv, +r}, +rest}:
      ep => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
          Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          Mst.pieces(rest, l, r, Some{ik}, hi)
        ),
        ks,
        {Bool.and(Pieces.sorted(ks), Pieces.inside(ks, lo, hi)) == True{}: Bool},
        +c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{ik}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          ks,
          {Bool.and(Pieces.sorted(ks), Pieces.inside(ks, lo, hi)) == True{}: Bool},
          +ks2 => e3 => e4 =>
            +ih = Mst.pieces_sorted(rest, l, r, Some{ik}, hi, ks2)(e3)
            +ins2 = Shared.Bool.and_true_right(Pieces.sorted(ks2), Pieces.inside(ks2, Some{ik}, hi))(ih)
            +cb = Shared.Bool.and_true_right(
              Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
              Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
            )(c)
            %e4: {Bool.and(Pieces.sorted(_), Pieces.inside(_, lo, hi)) == True{}: Bool}
            Mst.pieces_sorted.con(
              prev,
              l,
              lo,
              hi,
              ik,
              iv,
              ks2,
              Shared.Bool.and_both(
                Pieces.after_all(Piece.Bind{ik, iv}, ks2),
                Pieces.sorted(ks2)
              )(Pieces.after_inside_bind(ik, iv, ks2, hi)(ins2))(Shared.Bool.and_true_left(Pieces.sorted(ks2), Pieces.inside(ks2, Some{ik}, hi))(ih)),
              Shared.Bool.and_both(
                Bool.and(Bound.after(lo, ik), Bound.before(ik, hi)),
                Pieces.inside(ks2, lo, hi)
              )(cb)(Pieces.inside_widen(ks2, ik, lo, hi)(ins2)(Shared.Bool.and_true_left(Bound.after(lo, ik), Bound.before(ik, hi))(cb))),
              ins2,
              Shared.Bool.and_true_right(Bound.after(lo, ik), Bound.before(ik, hi))(cb)
            )
        )(e2)
      )(ep)

# pieces, then others, may hold k when either may
def Pieces.covers_append(a: List<&2, Piece>, +b: List<&2, Piece>, +k: List<&2, U32>) -> {
  Pieces.covers(List.append(&2, Piece, a, b), k) == Bool.or(Pieces.covers(a, k), Pieces.covers(b, k)): Bool
}:
  match a:
    case Nil{}:
      {==}
    case Con{+x, +rest}:
      %Equal.sym(
        Bool,
        Pieces.covers(List.append(&2, Piece, rest, b), k),
        Bool.or(Pieces.covers(rest, k), Pieces.covers(b, k)),
        Pieces.covers_append(rest, b, k)
      ): {Bool.or(Piece.covers(x, k), _) == Bool.or(Bool.or(Piece.covers(x, k), Pieces.covers(rest, k)), Pieces.covers(b, k)): Bool}
      Shared.Bool.or_assoc(Piece.covers(x, k), Pieces.covers(rest, k), Pieces.covers(b, k))

# the value from the subtree m, between lo and hi, before the pieces rest,
# when its bounds hold k and rest give none: a read of m
def Mst.value_sub(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, rest, k) == None{}: Maybe<&2, List<&2, U32>>
} -> {
  Pieces.value(~S, ~fetch, f, s, Piece.sub(m, l, lo, hi, rest), k) == Look.value(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, m, k)): Maybe<&2, List<&2, U32>>
}:
  match m:
    case None{}:
      hin => hr =>
        %Equal.sym(Look, Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, None{}, k), Look.Absent{}, Mst.look_none(~S, ~fetch, f, s, Room{l, lo, hi}, k)): {
          Pieces.value(~S, ~fetch, f, s, rest, k) == Look.value(_): Maybe<&2, List<&2, U32>>
        }
        hr
    case Some{+h}:
      hin => hr =>
        %Equal.sym(Bool, Bool.and(Bound.after(lo, k), Bound.before(k, hi)), True{}, hin): {
          Shared.Bool.when(
            Maybe<&2, List<&2, U32>>,
            _,
            u => Piece.value(~S, ~fetch, f, s, Piece.Sub{h, l, lo, hi}, k),
            u => Pieces.value(~S, ~fetch, f, s, rest, k)
          )
            == Look.value(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, Some{h}, k)): Maybe<&2, List<&2, U32>>
        }
        {==}

# the value from the subtree m, whose bounds lo and hi do not hold k, before
# the pieces rest: the value from rest
def Mst.value_skip(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  m: Maybe<&2, Hashes.Hash>,
  +l: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +rest: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == False{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, rest, k) == Pieces.value(~S, ~fetch, f, s, Piece.sub(m, l, lo, hi, rest), k): Maybe<&2, List<&2, U32>>
}:
  match m:
    case None{}:
      hin => {==}
    case Some{+h}:
      hin =>
        %Equal.sym(Bool, Bool.and(Bound.after(lo, k), Bound.before(k, hi)), False{}, hin): {
          Pieces.value(~S, ~fetch, f, s, rest, k) == Shared.Bool.when(
            Maybe<&2, List<&2, U32>>,
            _,
            u => Piece.value(~S, ~fetch, f, s, Piece.Sub{h, l, lo, hi}, k),
            u => Pieces.value(~S, ~fetch, f, s, rest, k)
          ): Maybe<&2, List<&2, U32>>
        }
        {==}

# pieces between ik and hi give no value of a key before ik
def Mst.value_before(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +ks: List<&2, Piece>,
  +ik: List<&2, U32>,
  +hi: Maybe<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> {Pieces.inside(ks, Some{ik}, hi) == True{}: Bool} -> {Key.is_lt(ik, k) == False{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, ks, k) == None{}: Maybe<&2, List<&2, U32>>
}:
  +hin => +hk => Pieces.value_none(
    ~S,
    ~fetch,
    f,
    s,
    ks,
    k
  )(
    Bool.false_of(
      Pieces.covers(ks, k),
      cv => Shared.Bool.true_ne_false(
        Equal.trans(
          Bool,
          True{},
          Key.is_lt(ik, k),
          False{},
          Equal.sym(
            Bool,
            Key.is_lt(ik, k),
            True{},
            Shared.Bool.and_true_left(Key.is_lt(ik, k), Bound.before(k, hi))(Pieces.inside_covers(ks, Some{ik}, hi, k)(hin)(cv))
          ),
          hk
        )
      )
    )
  )

# Mst.value_pick at an item of the key ik, whose comparison with k is c
def Mst.value_pick.con(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  c: Cmp,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  +ik: List<&2, U32>,
  +iv: List<&2, U32>,
  +r: Maybe<&2, Hashes.Hash>,
  +rest: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks2: List<&2, Piece>,
  +k: List<&2, U32>,
  +ec: {Key.cmp(k, ik) == c: Cmp},
  +hin: {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool},
  ew: {Nat.is_eq(Key.level(ik), l) == True{}: Bool},
  ins2: {Pieces.inside(ks2, Some{ik}, hi) == True{}: Bool},
  ih: {Bool.and(Key.is_lt(ik, k), Bound.before(k, hi)) == True{}: Bool} -> {
    Pieces.value(~S, ~fetch, f, s, ks2, k)
      == Look.value(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))): Maybe<
      &2,
      List<&2, U32>>
  }
) -> {
  Pieces.value(~S, ~fetch, f, s, Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ks2), k)
    == Look.value(
      Mst.look.pick(
        Shared.Bool.when(
          Pick,
          Cmp.is_lt(c),
          u => Pick.Down{prev, Room.of(l, lo, Some{ik})},
          u => Shared.Bool.when(Pick, Cmp.is_eq(c), w => Pick.Hit{iv}, w => Mst.pick(rest, r, l, Some{ik}, hi, k))
        ),
        h,
        l,
        k,
        m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k)
      )
    ): Maybe<&2, List<&2, U32>>
}:
  match c:
    case LT{}:
      Mst.value_sub(
        ~S,
        ~fetch,
        f,
        s,
        prev,
        l,
        lo,
        Some{ik},
        Piece.Bind{ik, iv} <> ks2,
        k
      )(Shared.Bool.and_both(Bound.after(lo, k), Key.is_lt(k, ik))(Shared.Bool.and_true_left(Bound.after(lo, k), Bound.before(k, hi))(hin))(Key.lt_of(k, ik, LT{})(ec)))(
        %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, ik, k), False{}, Key.eq_of(k, ik, LT{})(ec)): {
          Shared.Bool.when(
            Maybe<&2, List<&2, U32>>,
            _,
            u => Piece.value(~S, ~fetch, f, s, Piece.Bind{ik, iv}, k),
            u => Pieces.value(~S, ~fetch, f, s, ks2, k)
          )
            == None{}: Maybe<&2, List<&2, U32>>
        }
        Mst.value_before(~S, ~fetch, f, s, ks2, ik, hi, k)(ins2)(Key.gt_of(k, ik, LT{})(ec))
      )
    case EQ{}:
      +ke = Key.cmp_eq(k, ik)(ec)
      %Mst.value_skip(
        ~S,
        ~fetch,
        f,
        s,
        prev,
        l,
        lo,
        Some{ik},
        Piece.Bind{ik, iv} <> ks2,
        k
      )(
        %Equal.sym(Bool, Key.is_lt(k, ik), False{}, Key.lt_of(k, ik, EQ{})(ec)): {Bool.and(Bound.after(lo, k), _) == False{}: Bool}
        Shared.Bool.and_false_right(Bound.after(lo, k))
      ): {
        _
          == Look.value(Shared.Bool.when(Look, Nat.is_eq(Key.level(k), l), u => Look.Found{iv}, u => Look.Missing{h})): Maybe<&2, List<&2, U32>>
      }
      %Equal.sym(
        Bool,
        Nat.is_eq(Key.level(k), l),
        True{},
        Equal.trans(Bool, Nat.is_eq(Key.level(k), l), Nat.is_eq(Key.level(ik), l), True{}, Equal.cong(List<&2, U32>, Bool, x => Nat.is_eq(Key.level(x), l), k, ik, ke), ew)
      ): {
        Pieces.value(~S, ~fetch, f, s, Piece.Bind{ik, iv} <> ks2, k)
          == Look.value(Shared.Bool.when(Look, _, u => Look.Found{iv}, u => Look.Missing{h})): Maybe<&2, List<&2, U32>>
      }
      %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, ik, k), True{}, Key.eq_of(k, ik, EQ{})(ec)): {
        Shared.Bool.when(
          Maybe<&2, List<&2, U32>>,
          _,
          u => Piece.value(~S, ~fetch, f, s, Piece.Bind{ik, iv}, k),
          u => Pieces.value(~S, ~fetch, f, s, ks2, k)
        )
          == Some{iv}: Maybe<&2, List<&2, U32>>
      }
      {==}
    case GT{}:
      +l2 = Key.gt_of(k, ik, GT{})(ec)
      %Mst.value_skip(
        ~S,
        ~fetch,
        f,
        s,
        prev,
        l,
        lo,
        Some{ik},
        Piece.Bind{ik, iv} <> ks2,
        k
      )(
        %Equal.sym(Bool, Key.is_lt(k, ik), False{}, Key.lt_of(k, ik, GT{})(ec)): {Bool.and(Bound.after(lo, k), _) == False{}: Bool}
        Shared.Bool.and_false_right(Bound.after(lo, k))
      ): {
        _
          == Look.value(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))): Maybe<
          &2,
          List<&2, U32>>
      }
      %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, ik, k), False{}, Key.eq_of(k, ik, GT{})(ec)): {
        Shared.Bool.when(
          Maybe<&2, List<&2, U32>>,
          _,
          u => Piece.value(~S, ~fetch, f, s, Piece.Bind{ik, iv}, k),
          u => Pieces.value(~S, ~fetch, f, s, ks2, k)
        )
          == Look.value(Mst.look.pick(Mst.pick(rest, r, l, Some{ik}, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))): Maybe<
          &2,
          List<&2, U32>>
      }
      ih(Shared.Bool.and_both(Key.is_lt(ik, k), Bound.before(k, hi))(l2)(Shared.Bool.and_true_right(Bound.after(lo, k), Bound.before(k, hi))(hin)))

# the pieces of the items xs of the node of the hash h give, for a key in
# their bounds, what a read of the key in the node finds
def Mst.value_pick(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +h: Hashes.Hash,
  xs: List<&2, Item>,
  +l: Nat,
  +prev: Maybe<&2, Hashes.Hash>,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Mst.pieces(xs, l, prev, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, ks, k)
    == Look.value(Mst.look.pick(Mst.pick(xs, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))): Maybe<&2, List<&2, U32>>
}:
  match xs:
    case Nil{}:
      ep => hin =>
        %Shared.Maybe.some_inj(List<&2, Piece>, Piece.sub(prev, l, lo, hi, []), ks, ep): {
          Pieces.value(~S, ~fetch, f, s, _, k) == Look.value(Mst.look.go(~S, ~fetch, f, s, Room{l, lo, hi}, prev, k)): Maybe<&2, List<&2, U32>>
        }
        Mst.value_sub(~S, ~fetch, f, s, prev, l, lo, hi, [], k)(hin)({==})
    case Con{Item{+ik, +iv, +r}, +rest}:
      ep => +hin => Maybe.when_cases(
        List<&2, Piece>,
        Bool.and(
          Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
          Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
        ),
        u => Maybe.map(
          &2,
          List<&2, Piece>,
          List<&2, Piece>,
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          Mst.pieces(rest, l, r, Some{ik}, hi)
        ),
        ks,
        {
          Pieces.value(~S, ~fetch, f, s, ks, k)
            == Look.value(
              Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))
            ): Maybe<&2, List<&2, U32>>
        },
        +c => e2 => Maybe.map_cases(
          List<&2, Piece>,
          List<&2, Piece>,
          Mst.pieces(rest, l, r, Some{ik}, hi),
          ps2 => Piece.sub(prev, l, lo, Some{ik}, Piece.Bind{ik, iv} <> ps2),
          ks,
          {
            Pieces.value(~S, ~fetch, f, s, ks, k)
              == Look.value(
                Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))
              ): Maybe<&2, List<&2, U32>>
          },
          +ks2 => +e3 => e4 =>
            %e4: {
              Pieces.value(~S, ~fetch, f, s, _, k)
                == Look.value(
                  Mst.look.pick(Mst.pick(Item{ik, iv, r} <> rest, prev, l, lo, hi, k), h, l, k, m2 => r2 => Mst.look.go(~S, ~fetch, f, s, r2, m2, k))
                ): Maybe<&2, List<&2, U32>>
            }
            Mst.value_pick.con(
              ~S,
              ~fetch,
              Key.cmp(k, ik),
              f,
              s,
              h,
              ik,
              iv,
              r,
              rest,
              l,
              prev,
              lo,
              hi,
              ks2,
              k,
              {==},
              hin,
              Shared.Bool.and_true_left(
                Nat.is_eq(Key.level(ik), l),
                Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))
              )(
                Shared.Bool.and_true_left(
                  Bool.and(Nat.is_eq(Key.level(ik), l), Bool.or(Maybe.is_none(&2, Hashes.Hash, prev), Bool.not(List.is_empty(&2, U32, ik)))),
                  Bool.and(Bound.after(lo, ik), Bound.before(ik, hi))
                )(c)
              ),
              Shared.Bool.and_true_right(Pieces.sorted(ks2), Pieces.inside(ks2, Some{ik}, hi))(Mst.pieces_sorted(rest, l, r, Some{ik}, hi, ks2)(e3)),
              hin2 => Mst.value_pick(~S, ~fetch, f, s, h, rest, l, r, Some{ik}, hi, ks2, k)(e3)(hin2)
            )
        )(e2)
      )(ep)

# the pieces of an opened node give, for a key in its bounds, what a read of
# its subtree finds
def Mst.value_open(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Mst.open(~S, ~fetch, s, h, up, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {Bool.and(Bound.after(lo, k), Bound.before(k, hi)) == True{}: Bool} -> {
  Pieces.value(~S, ~fetch, q, s, ks, k) == Look.value(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k)): Maybe<&2, List<&2, U32>>
}:
  e => hin => Mst.open_cases(
    ~S,
    ~fetch,
    s,
    h,
    up,
    lo,
    hi,
    ks,
    {Pieces.value(~S, ~fetch, q, s, ks, k) == Look.value(Mst.look.go(~S, ~fetch, 1n+q, s, Room{up, lo, hi}, Some{h}, k)): Maybe<&2, List<&2, U32>>},
    +l => +left => +xs => ef => eh => en => elt => ee0 => ep =>
      %Equal.sym(Maybe<&2, Node>, Mst.node.in(~S, ~fetch, s, h, Room{up, lo, hi}), Some{Node{l, left, xs}}, en): {
        Pieces.value(~S, ~fetch, q, s, ks, k)
          == Look.value(Mst.look.at(h, _, Room{up, lo, hi}, k, m2 => r2 => Mst.look.go(~S, ~fetch, q, s, r2, m2, k))): Maybe<&2, List<&2, U32>>
      }
      Mst.value_pick(~S, ~fetch, q, s, h, xs, l, left, lo, hi, ks, k)(ep)(hin)
  )(e)

# the pieces of an opened node are sorted and lie in its bounds
def Mst.open_sorted(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +up: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +ks: List<&2, Piece>
) -> {Mst.open(~S, ~fetch, s, h, up, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
  Bool.and(Pieces.sorted(ks), Pieces.inside(ks, lo, hi)) == True{}: Bool
}:
  e => Mst.open_cases(
    ~S,
    ~fetch,
    s,
    h,
    up,
    lo,
    hi,
    ks,
    {Bool.and(Pieces.sorted(ks), Pieces.inside(ks, lo, hi)) == True{}: Bool},
    +l => +left => +xs => ef => eh => en => elt => ee0 => ep => Mst.pieces_sorted(xs, l, left, lo, hi, ks)(ep)
  )(e)

# the opening of a binding, then pieces: the binding, then their opening
def Mst.open_all_bind(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +k2: List<&2, U32>,
  +v2: List<&2, U32>,
  +r: List<&2, Piece>,
  -a2: List<&2, Piece>,
  -P: Type,
  k: @r2: List<&2, Piece> -> {Mst.open.all(~S, ~fetch, s, r) == Some{r2}: Maybe<&2, List<&2, Piece>>} -> {
    Piece.Bind{k2, v2} <> r2 == a2: List<&2, Piece>
  } -> P
) -> {Mst.open.all(~S, ~fetch, s, Piece.Bind{k2, v2} <> r) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> P:
  e => Maybe.map_cases(
    List<&2, Piece>,
    List<&2, Piece>,
    Mst.open.all(~S, ~fetch, s, r),
    x => Piece.Bind{k2, v2} <> x,
    a2,
    P,
    r2 => er => ea => k(r2)(er)(ea)
  )(e)

# the opening of a subtree, then pieces: the pieces of its node, then their
# opening
def Mst.open_all_sub(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +h: Hashes.Hash,
  +u: Nat,
  +lo: Maybe<&2, List<&2, U32>>,
  +hi: Maybe<&2, List<&2, U32>>,
  +r: List<&2, Piece>,
  -a2: List<&2, Piece>,
  -P: Type,
  k: @ks: List<&2, Piece> -> @r2: List<&2, Piece> -> {Mst.open(~S, ~fetch, s, h, u, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {
    Mst.open.all(~S, ~fetch, s, r) == Some{r2}: Maybe<&2, List<&2, Piece>>
  } -> {List.append(&2, Piece, ks, r2) == a2: List<&2, Piece>} -> P
) -> {Mst.open.all(~S, ~fetch, s, Piece.Sub{h, u, lo, hi} <> r) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> P:
  e => Maybe.bind_cases(
    List<&2, Piece>,
    List<&2, Piece>,
    Mst.open(~S, ~fetch, s, h, u, lo, hi),
    a => Maybe.map(&2, List<&2, Piece>, List<&2, Piece>, b => List.append(&2, Piece, a, b), Mst.open.all(~S, ~fetch, s, r)),
    a2,
    P,
    +ks => eo => e2 => Maybe.map_cases(
      List<&2, Piece>,
      List<&2, Piece>,
      Mst.open.all(~S, ~fetch, s, r),
      b => List.append(&2, Piece, ks, b),
      a2,
      P,
      r2 => er => ea => k(ks)(r2)(eo)(er)(ea)
    )(e2)
  )(e)

# an opening may hold only keys that what it opens may hold
def Mst.open_all_covers(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  ps: List<&2, Piece>,
  -a2: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Mst.open.all(~S, ~fetch, s, ps) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> {Pieces.covers(a2, k) == True{}: Bool} -> {
  Pieces.covers(ps, k) == True{}: Bool
}:
  match ps:
    case Nil{}:
      e => hc => Empty.absurd(
        {False{} == True{}: Bool},
        Shared.Bool.false_ne_true(
          Equal.trans(
            Bool,
            False{},
            Pieces.covers(a2, k),
            True{},
            Equal.cong(List<&2, Piece>, Bool, x => Pieces.covers(x, k), [], a2, Shared.Maybe.some_inj(List<&2, Piece>, [], a2, e)),
            hc
          )
        )
      )
    case Con{Piece.Bind{+k2, +v2}, +rest}:
      e => hc => Mst.open_all_bind(
        ~S,
        ~fetch,
        s,
        k2,
        v2,
        rest,
        a2,
        {Pieces.covers(Piece.Bind{k2, v2} <> rest, k) == True{}: Bool},
        +r2 => er => ea =>
          +hc2 = Equal.trans(
            Bool,
            Pieces.covers(Piece.Bind{k2, v2} <> r2, k),
            Pieces.covers(a2, k),
            True{},
            Equal.cong(List<&2, Piece>, Bool, x => Pieces.covers(x, k), Piece.Bind{k2, v2} <> r2, a2, ea),
            hc
          )
          Bool.cases(
            Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
            {Pieces.covers(Piece.Bind{k2, v2} <> rest, k) == True{}: Bool},
            ct => Bool.or_true_left(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.covers(rest, k))(ct),
            cf => Bool.or_true_of(
              Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
              Pieces.covers(rest, k)
            )(
              Mst.open_all_covers(
                ~S,
                ~fetch,
                s,
                rest,
                r2,
                k
              )(er)(
                Equal.trans(
                  Bool,
                  Pieces.covers(r2, k),
                  Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.covers(r2, k)),
                  True{},
                  Equal.cong(
                    Bool,
                    Bool,
                    t => Bool.or(t, Pieces.covers(r2, k)),
                    False{},
                    Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
                    Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), False{}, cf)
                  ),
                  hc2
                )
              )
            )
          )
      )(e)
    case Con{Piece.Sub{+h, +u, +lo, +hi}, +rest}:
      e => hc => Mst.open_all_sub(
        ~S,
        ~fetch,
        s,
        h,
        u,
        lo,
        hi,
        rest,
        a2,
        {Pieces.covers(Piece.Sub{h, u, lo, hi} <> rest, k) == True{}: Bool},
        +ks => +r2 => eo => er => ea =>
          +hc2 = Equal.trans(
            Bool,
            Bool.or(Pieces.covers(ks, k), Pieces.covers(r2, k)),
            Pieces.covers(a2, k),
            True{},
            Equal.trans(
              Bool,
              Bool.or(Pieces.covers(ks, k), Pieces.covers(r2, k)),
              Pieces.covers(List.append(&2, Piece, ks, r2), k),
              Pieces.covers(a2, k),
              Equal.sym(Bool, Pieces.covers(List.append(&2, Piece, ks, r2), k), Bool.or(Pieces.covers(ks, k), Pieces.covers(r2, k)), Pieces.covers_append(ks, r2, k)),
              Equal.cong(List<&2, Piece>, Bool, x => Pieces.covers(x, k), List.append(&2, Piece, ks, r2), a2, ea)
            ),
            hc
          )
          Bool.cases(
            Pieces.covers(ks, k),
            {Pieces.covers(Piece.Sub{h, u, lo, hi} <> rest, k) == True{}: Bool},
            ct => Bool.or_true_left(
              Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
              Pieces.covers(rest, k)
            )(
              Pieces.inside_covers(
                ks,
                lo,
                hi,
                k
              )(Shared.Bool.and_true_right(Pieces.sorted(ks), Pieces.inside(ks, lo, hi))(Mst.open_sorted(~S, ~fetch, s, h, u, lo, hi, ks)(eo)))(ct)
            ),
            cf => Bool.or_true_of(
              Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
              Pieces.covers(rest, k)
            )(
              Mst.open_all_covers(
                ~S,
                ~fetch,
                s,
                rest,
                r2,
                k
              )(er)(
                Equal.trans(
                  Bool,
                  Pieces.covers(r2, k),
                  Bool.or(Pieces.covers(ks, k), Pieces.covers(r2, k)),
                  True{},
                  Equal.cong(Bool, Bool, t => Bool.or(t, Pieces.covers(r2, k)), False{}, Pieces.covers(ks, k), Equal.sym(Bool, Pieces.covers(ks, k), False{}, cf)),
                  hc2
                )
              )
            )
          )
      )(e)

# a piece before pieces is before their opening
def Mst.open_all_after(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  +w: Piece,
  ps: List<&2, Piece>,
  -a2: List<&2, Piece>
) -> {Mst.open.all(~S, ~fetch, s, ps) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> {Pieces.after_all(w, ps) == True{}: Bool} -> {
  Pieces.after_all(w, a2) == True{}: Bool
}:
  match ps:
    case Nil{}:
      e => h =>
        %Shared.Maybe.some_inj(List<&2, Piece>, [], a2, e): {Pieces.after_all(w, _) == True{}: Bool}
        {==}
    case Con{Piece.Bind{+k2, +v2}, +rest}:
      e => +h => Mst.open_all_bind(
        ~S,
        ~fetch,
        s,
        k2,
        v2,
        rest,
        a2,
        {Pieces.after_all(w, a2) == True{}: Bool},
        +r2 => er => ea =>
          %ea: {Pieces.after_all(w, _) == True{}: Bool}
          Shared.Bool.and_both(
            Piece.before(w, Piece.Bind{k2, v2}),
            Pieces.after_all(w, r2)
          )(Shared.Bool.and_true_left(Piece.before(w, Piece.Bind{k2, v2}), Pieces.after_all(w, rest))(h))(
            Mst.open_all_after(~S, ~fetch, s, w, rest, r2)(er)(Shared.Bool.and_true_right(Piece.before(w, Piece.Bind{k2, v2}), Pieces.after_all(w, rest))(h))
          )
      )(e)
    case Con{Piece.Sub{+h2, +u, +lo, +hi}, +rest}:
      e => +h => Mst.open_all_sub(
        ~S,
        ~fetch,
        s,
        h2,
        u,
        lo,
        hi,
        rest,
        a2,
        {Pieces.after_all(w, a2) == True{}: Bool},
        +ks => +r2 => eo => er => ea =>
          %ea: {Pieces.after_all(w, _) == True{}: Bool}
          Pieces.after_all_append(
            w,
            ks,
            r2
          )(
            Pieces.refine_right_all(
              w,
              ks,
              lo,
              hi,
              h2,
              u
            )(Shared.Bool.and_true_left(Piece.before(w, Piece.Sub{h2, u, lo, hi}), Pieces.after_all(w, rest))(h))(
              Shared.Bool.and_true_right(Pieces.sorted(ks), Pieces.inside(ks, lo, hi))(Mst.open_sorted(~S, ~fetch, s, h2, u, lo, hi, ks)(eo))
            )
          )(Mst.open_all_after(~S, ~fetch, s, w, rest, r2)(er)(Shared.Bool.and_true_right(Piece.before(w, Piece.Sub{h2, u, lo, hi}), Pieces.after_all(w, rest))(h)))
      )(e)

# pieces before others are before their opening
def Mst.before_all_open(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  ws: List<&2, Piece>,
  +ps: List<&2, Piece>,
  +a2: List<&2, Piece>
) -> {Mst.open.all(~S, ~fetch, s, ps) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> {Pieces.before_all(ws, ps) == True{}: Bool} -> {
  Pieces.before_all(ws, a2) == True{}: Bool
}:
  match ws:
    case Nil{}:
      e => h => {==}
    case Con{+w, +rest}:
      +e => +h => Shared.Bool.and_both(
        Pieces.after_all(w, a2),
        Pieces.before_all(rest, a2)
      )(Mst.open_all_after(~S, ~fetch, s, w, ps, a2)(e)(Shared.Bool.and_true_left(Pieces.after_all(w, ps), Pieces.before_all(rest, ps))(h)))(
        Mst.before_all_open(~S, ~fetch, s, rest, ps, a2)(e)(Shared.Bool.and_true_right(Pieces.after_all(w, ps), Pieces.before_all(rest, ps))(h))
      )

# the opening of sorted pieces is sorted
def Mst.open_all_sorted(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +s: S,
  ps: List<&2, Piece>,
  -a2: List<&2, Piece>
) -> {Mst.open.all(~S, ~fetch, s, ps) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> {Pieces.sorted(ps) == True{}: Bool} -> {
  Pieces.sorted(a2) == True{}: Bool
}:
  match ps:
    case Nil{}:
      e => h =>
        %Shared.Maybe.some_inj(List<&2, Piece>, [], a2, e): {Pieces.sorted(_) == True{}: Bool}
        {==}
    case Con{Piece.Bind{+k2, +v2}, +rest}:
      e => +h => Mst.open_all_bind(
        ~S,
        ~fetch,
        s,
        k2,
        v2,
        rest,
        a2,
        {Pieces.sorted(a2) == True{}: Bool},
        +r2 => +er => ea =>
          %ea: {Pieces.sorted(_) == True{}: Bool}
          Shared.Bool.and_both(
            Pieces.after_all(Piece.Bind{k2, v2}, r2),
            Pieces.sorted(r2)
          )(
            Mst.open_all_after(
              ~S,
              ~fetch,
              s,
              Piece.Bind{k2, v2},
              rest,
              r2
            )(er)(Shared.Bool.and_true_left(Pieces.after_all(Piece.Bind{k2, v2}, rest), Pieces.sorted(rest))(h))
          )(Mst.open_all_sorted(~S, ~fetch, s, rest, r2)(er)(Shared.Bool.and_true_right(Pieces.after_all(Piece.Bind{k2, v2}, rest), Pieces.sorted(rest))(h)))
      )(e)
    case Con{Piece.Sub{+h2, +u, +lo, +hi}, +rest}:
      e => +h => Mst.open_all_sub(
        ~S,
        ~fetch,
        s,
        h2,
        u,
        lo,
        hi,
        rest,
        a2,
        {Pieces.sorted(a2) == True{}: Bool},
        +ks => +r2 => eo => +er => ea =>
          +os = Mst.open_sorted(~S, ~fetch, s, h2, u, lo, hi, ks)(eo)
          %ea: {Pieces.sorted(_) == True{}: Bool}
          Pieces.sorted_append(
            ks,
            r2
          )(Shared.Bool.and_true_left(Pieces.sorted(ks), Pieces.inside(ks, lo, hi))(os))(
            Mst.open_all_sorted(~S, ~fetch, s, rest, r2)(er)(Shared.Bool.and_true_right(Pieces.after_all(Piece.Sub{h2, u, lo, hi}, rest), Pieces.sorted(rest))(h))
          )(
            Mst.before_all_open(
              ~S,
              ~fetch,
              s,
              ks,
              rest,
              r2
            )(er)(
              Pieces.refine_left_all(
                ks,
                rest,
                lo,
                hi,
                h2,
                u
              )(Shared.Bool.and_true_right(Pieces.sorted(ks), Pieces.inside(ks, lo, hi))(os))(
                Shared.Bool.and_true_left(Pieces.after_all(Piece.Sub{h2, u, lo, hi}, rest), Pieces.sorted(rest))(h)
              )
            )
          )
      )(e)

# the opening of sorted pieces gives, one level less down, the values that
# they give
def Mst.open_all_value(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +q: Nat,
  +s: S,
  ps: List<&2, Piece>,
  -a2: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Mst.open.all(~S, ~fetch, s, ps) == Some{a2}: Maybe<&2, List<&2, Piece>>} -> {Pieces.sorted(ps) == True{}: Bool} -> {
  Pieces.value(~S, ~fetch, 1n+q, s, ps, k) == Pieces.value(~S, ~fetch, q, s, a2, k): Maybe<&2, List<&2, U32>>
}:
  match ps:
    case Nil{}:
      e => h =>
        %Shared.Maybe.some_inj(List<&2, Piece>, [], a2, e): {None{} == Pieces.value(~S, ~fetch, q, s, _, k): Maybe<&2, List<&2, U32>>}
        {==}
    case Con{Piece.Bind{+k2, +v2}, +rest}:
      e => +h => Mst.open_all_bind(
        ~S,
        ~fetch,
        s,
        k2,
        v2,
        rest,
        a2,
        {Pieces.value(~S, ~fetch, 1n+q, s, Piece.Bind{k2, v2} <> rest, k) == Pieces.value(~S, ~fetch, q, s, a2, k): Maybe<&2, List<&2, U32>>},
        +r2 => er => ea =>
          %ea: {Pieces.value(~S, ~fetch, 1n+q, s, Piece.Bind{k2, v2} <> rest, k) == Pieces.value(~S, ~fetch, q, s, _, k): Maybe<&2, List<&2, U32>>}
          Equal.cong(
            Maybe<&2, List<&2, U32>>,
            Maybe<&2, List<&2, U32>>,
            z => Shared.Bool.when(Maybe<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), u => Some{v2}, u => z),
            Pieces.value(~S, ~fetch, 1n+q, s, rest, k),
            Pieces.value(~S, ~fetch, q, s, r2, k),
            Mst.open_all_value(~S, ~fetch, q, s, rest, r2, k)(er)(Shared.Bool.and_true_right(Pieces.after_all(Piece.Bind{k2, v2}, rest), Pieces.sorted(rest))(h))
          )
      )(e)
    case Con{Piece.Sub{+h2, +u, +lo, +hi}, +rest}:
      e => +h => Mst.open_all_sub(
        ~S,
        ~fetch,
        s,
        h2,
        u,
        lo,
        hi,
        rest,
        a2,
        {
          Pieces.value(~S, ~fetch, 1n+q, s, Piece.Sub{h2, u, lo, hi} <> rest, k) == Pieces.value(~S, ~fetch, q, s, a2, k): Maybe<&2, List<&2, U32>>
        },
        +ks => +r2 => +eo => +er => ea =>
          +os = Mst.open_sorted(~S, ~fetch, s, h2, u, lo, hi, ks)(eo)
          %ea: {
            Pieces.value(~S, ~fetch, 1n+q, s, Piece.Sub{h2, u, lo, hi} <> rest, k)
              == Pieces.value(~S, ~fetch, q, s, _, k): Maybe<&2, List<&2, U32>>
          }
          Bool.cases(
            Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
            {
              Pieces.value(~S, ~fetch, 1n+q, s, Piece.Sub{h2, u, lo, hi} <> rest, k)
                == Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k): Maybe<&2, List<&2, U32>>
            },
            +ct =>
              %Equal.sym(Bool, Bool.and(Bound.after(lo, k), Bound.before(k, hi)), True{}, ct): {
                Shared.Bool.when(
                  Maybe<&2, List<&2, U32>>,
                  _,
                  w => Piece.value(~S, ~fetch, 1n+q, s, Piece.Sub{h2, u, lo, hi}, k),
                  w => Pieces.value(~S, ~fetch, 1n+q, s, rest, k)
                )
                  == Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k): Maybe<&2, List<&2, U32>>
              }
              Equal.trans(
                Maybe<&2, List<&2, U32>>,
                Look.value(Mst.look.go(~S, ~fetch, 1n+q, s, Room{u, lo, hi}, Some{h2}, k)),
                Pieces.value(~S, ~fetch, q, s, ks, k),
                Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k),
                Equal.sym(
                  Maybe<&2, List<&2, U32>>,
                  Pieces.value(~S, ~fetch, q, s, ks, k),
                  Look.value(Mst.look.go(~S, ~fetch, 1n+q, s, Room{u, lo, hi}, Some{h2}, k)),
                  Mst.value_open(~S, ~fetch, q, s, h2, u, lo, hi, ks, k)(eo)(ct)
                ),
                Equal.sym(
                  Maybe<&2, List<&2, U32>>,
                  Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k),
                  Pieces.value(~S, ~fetch, q, s, ks, k),
                  Pieces.value_left(
                    ~S,
                    ~fetch,
                    q,
                    s,
                    ks,
                    r2,
                    k
                  )(
                    Bool.false_of(
                      Pieces.covers(r2, k),
                      c2 => Shared.Bool.true_ne_false(
                        Equal.trans(
                          Bool,
                          True{},
                          Pieces.covers(rest, k),
                          False{},
                          Equal.sym(Bool, Pieces.covers(rest, k), True{}, Mst.open_all_covers(~S, ~fetch, s, rest, r2, k)(er)(c2)),
                          Pieces.after_all_miss(
                            Piece.Sub{h2, u, lo, hi},
                            rest,
                            k
                          )(ct)(Shared.Bool.and_true_left(Pieces.after_all(Piece.Sub{h2, u, lo, hi}, rest), Pieces.sorted(rest))(h))
                        )
                      )
                    )
                  )
                )
              ),
            +cf =>
              %Equal.sym(Bool, Bool.and(Bound.after(lo, k), Bound.before(k, hi)), False{}, cf): {
                Shared.Bool.when(
                  Maybe<&2, List<&2, U32>>,
                  _,
                  w => Piece.value(~S, ~fetch, 1n+q, s, Piece.Sub{h2, u, lo, hi}, k),
                  w => Pieces.value(~S, ~fetch, 1n+q, s, rest, k)
                )
                  == Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k): Maybe<&2, List<&2, U32>>
              }
              Equal.trans(
                Maybe<&2, List<&2, U32>>,
                Pieces.value(~S, ~fetch, 1n+q, s, rest, k),
                Pieces.value(~S, ~fetch, q, s, r2, k),
                Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k),
                Mst.open_all_value(~S, ~fetch, q, s, rest, r2, k)(er)(Shared.Bool.and_true_right(Pieces.after_all(Piece.Sub{h2, u, lo, hi}, rest), Pieces.sorted(rest))(h)),
                Equal.sym(
                  Maybe<&2, List<&2, U32>>,
                  Pieces.value(~S, ~fetch, q, s, List.append(&2, Piece, ks, r2), k),
                  Pieces.value(~S, ~fetch, q, s, r2, k),
                  Pieces.value_right(
                    ~S,
                    ~fetch,
                    q,
                    s,
                    ks,
                    r2,
                    k
                  )(
                    Bool.false_of(
                      Pieces.covers(ks, k),
                      c2 => Shared.Bool.true_ne_false(
                        Equal.trans(
                          Bool,
                          True{},
                          Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                          False{},
                          Equal.sym(
                            Bool,
                            Bool.and(Bound.after(lo, k), Bound.before(k, hi)),
                            True{},
                            Pieces.inside_covers(ks, lo, hi, k)(Shared.Bool.and_true_right(Pieces.sorted(ks), Pieces.inside(ks, lo, hi))(os))(c2)
                          ),
                          cf
                        )
                      )
                    )
                  )
                )
              )
          )
      )(e)

# the values x and y differ
def Mst.differ(x: Maybe<&2, List<&2, U32>>, y: Maybe<&2, List<&2, U32>>) -> Bool:
  Bool.not(Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), x, y))

# a value does not differ from itself
def Mst.differ_self(x: Maybe<&2, List<&2, U32>>) -> {Mst.differ(x, x) == False{}: Bool}:
  match x:
    case None{}:
      {==}
    case Some{value}:
      %Equal.sym(Bool, Shared.List.is_eq(U32, U32.is_eq, value, value), True{}, Shared.List.is_eq_refl(~U32, ~U32.is_eq, ~Shared.U32.laws(), value)) :
        {Bool.not(_) == False{} : Bool}
      {==}

# pieces that Piece.same calls the same are equal
def Piece.same_eq(x: Piece, y: Piece) -> {Piece.same(x, y) == True{}: Bool} -> {x == y: Piece}:
  match x y:
    case Piece.Bind{+k1, +v1} Piece.Bind{+k2, +v2}:
      +h =>
        %Shared.List.is_eq_sound(
          ~U32,
          ~U32.is_eq,
          ~Shared.U32.laws(),
          k1,
          k2
        )(Shared.Bool.and_true_left(Shared.List.is_eq(~U32, ~U32.is_eq, k1, k2), Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2))(h)): {
          Piece.Bind{k1, v1} == Piece.Bind{_, v2}: Piece
        }
        %Shared.List.is_eq_sound(
          ~U32,
          ~U32.is_eq,
          ~Shared.U32.laws(),
          v1,
          v2
        )(Shared.Bool.and_true_right(Shared.List.is_eq(~U32, ~U32.is_eq, k1, k2), Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2))(h)): {
          Piece.Bind{k1, v1} == Piece.Bind{k1, _}: Piece
        }
        {==}
    case Piece.Sub{+h1, +u1, +lo1, +hi1} Piece.Sub{+h2, +u2, +lo2, +hi2}:
      +h =>
        +a = Shared.Bool.and_true_left(
          Bool.and(Hashes.Hash.is_eq(h1, h2), Nat.is_eq(u1, u2)),
          Bool.and(
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), lo1, lo2),
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), hi1, hi2)
          )
        )(h)
        +b = Shared.Bool.and_true_right(
          Bool.and(Hashes.Hash.is_eq(h1, h2), Nat.is_eq(u1, u2)),
          Bool.and(
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), lo1, lo2),
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), hi1, hi2)
          )
        )(h)
        %Hashes.Hash.is_eq_sound(h1, h2)(Shared.Bool.and_true_left(Hashes.Hash.is_eq(h1, h2), Nat.is_eq(u1, u2))(a)): {
          Piece.Sub{h1, u1, lo1, hi1} == Piece.Sub{_, u2, lo2, hi2}: Piece
        }
        %Shared.Nat.is_eq_sound(u1, u2)(Shared.Bool.and_true_right(Hashes.Hash.is_eq(h1, h2), Nat.is_eq(u1, u2))(a)): {
          Piece.Sub{h1, u1, lo1, hi1} == Piece.Sub{h1, _, lo2, hi2}: Piece
        }
        %Shared.Maybe.is_eq_sound(
          ~List<&2, U32>,
          ~Shared.List.is_eq(~U32, ~U32.is_eq),
          x2 => y2 => Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), x2, y2),
          lo1,
          lo2
        )(
          Shared.Bool.and_true_left(
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), lo1, lo2),
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), hi1, hi2)
          )(b)
        ): {Piece.Sub{h1, u1, lo1, hi1} == Piece.Sub{h1, u1, _, hi2}: Piece}
        %Shared.Maybe.is_eq_sound(
          ~List<&2, U32>,
          ~Shared.List.is_eq(~U32, ~U32.is_eq),
          x2 => y2 => Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), x2, y2),
          hi1,
          hi2
        )(
          Shared.Bool.and_true_right(
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), lo1, lo2),
            Shared.Maybe.is_eq(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), hi1, hi2)
          )(b)
        ): {Piece.Sub{h1, u1, lo1, hi1} == Piece.Sub{h1, u1, lo1, _}: Piece}
        {==}
    case Piece.Bind{k1, v1} Piece.Sub{h2, u2, lo2, hi2}:
      h => Empty.absurd({Piece.Bind{k1, v1} == Piece.Sub{h2, u2, lo2, hi2}: Piece}, Shared.Bool.false_ne_true(h))
    case Piece.Sub{h1, u1, lo1, hi1} Piece.Bind{k2, v2}:
      h => Empty.absurd({Piece.Sub{h1, u1, lo1, hi1} == Piece.Bind{k2, v2}: Piece}, Shared.Bool.false_ne_true(h))

# a reversal onto acc is the reversal, then acc
def List.rev_acc(-A: Data, xs: List<&2, A>, acc: List<&2, A>) -> {
  List.reverse.go(&2, A, xs, acc) == List.append(&2, A, List.reverse(&2, A, xs), acc): List<&2, A>
}:
  match xs:
    case Nil{}:
      {==}
    case Con{head, tail}:
      +head = head
      +tail = tail
      +acc = acc
      %Equal.sym(List<&2, A>, List.reverse.go(&2, A, tail, [head]), List.append(&2, A, List.reverse(&2, A, tail), [head]), List.rev_acc(A, tail, [head])) :
        {List.reverse.go(&2, A, tail, head <> acc) == List.append(&2, A, _, acc) : List<&2, A>}
      %Equal.sym(List<&2, A>, List.append(&2, A, List.append(&2, A, List.reverse.go(&2, A, tail, []), [head]), acc), List.append(&2, A, List.reverse.go(&2, A, tail, []), List.append(&2, A, [head], acc)), Shared.List.append_assoc(A, List.reverse.go(&2, A, tail, []), [head], acc)) :
        {List.reverse.go(&2, A, tail, head <> acc) == _ : List<&2, A>}
      List.rev_acc(A, tail, head <> acc)

# the reversal of xs, then ys, is the reversal of ys, then of xs
def List.rev_append.g2(
  -A: Data,
  +xs: List<&2, A>,
  +ys: List<&2, A>,
  +x: List<&2, A>,
  hx: {x == List.reverse.go(&2, A, ys, []) : List<&2, A>}) ->
  {List.reverse.go(&2, A, List.append(&2, A, xs, ys), []) == List.append(&2, A, x, List.reverse.go(&2, A, xs, [])) : List<&2, A>}:
  match xs:
    case Nil{}:
      %Equal.sym(List<&2, A>, List.append(&2, A, x, []), x, Shared.List.append_nil(A, x)) :
        {List.reverse.go(&2, A, ys, []) == _ : List<&2, A>}
      Equal.sym(List<&2, A>, x, List.reverse.go(&2, A, ys, []), hx)
    case Con{head, tail}:
      %Equal.sym(List<&2, A>, List.reverse.go(&2, A, List.append(&2, A, tail, ys), [head]), List.append(&2, A, List.reverse(&2, A, List.append(&2, A, tail, ys)), [head]), List.rev_acc(A, List.append(&2, A, tail, ys), [head])) :
        {_ == List.append(&2, A, x, List.reverse.go(&2, A, tail, [head])) : List<&2, A>}
      %Equal.sym(List<&2, A>, List.reverse.go(&2, A, List.append(&2, A, tail, ys), []), List.append(&2, A, x, List.reverse.go(&2, A, tail, [])), List.rev_append.g2(A, tail, ys, x, hx)) :
        {List.append(&2, A, _, [head]) == List.append(&2, A, x, List.reverse.go(&2, A, tail, [head])) : List<&2, A>}
      %Equal.sym(List<&2, A>, List.reverse.go(&2, A, tail, [head]), List.append(&2, A, List.reverse(&2, A, tail), [head]), List.rev_acc(A, tail, [head])) :
        {List.append(&2, A, List.append(&2, A, x, List.reverse.go(&2, A, tail, [])), [head]) == List.append(&2, A, x, _) : List<&2, A>}
      Shared.List.append_assoc(A, x, List.reverse.go(&2, A, tail, []), [head])

def List.rev_append(-A: Data, xs: List<&2, A>, ys: List<&2, A>) -> {
  List.reverse(&2, A, List.append(&2, A, xs, ys)) == List.append(&2, A, List.reverse(&2, A, ys), List.reverse(&2, A, xs)): List<&2, A>
}:
  +ys = ys
  List.rev_append.g2(A, xs, ys, List.reverse.go(&2, A, ys, []), {==})

# a list reversed twice is itself
def List.rev_rev(-A: Data, xs: List<&2, A>) -> {List.reverse(&2, A, List.reverse(&2, A, xs)) == xs: List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      %Equal.sym(List<&2, A>, List.reverse.go(&2, A, r, [x]), List.append(&2, A, List.reverse(&2, A, r), [x]), List.rev_acc(A, r, [x])): {
        List.reverse(&2, A, _) == x <> r: List<&2, A>
      }
      %Equal.sym(
        List<&2, A>,
        List.reverse(&2, A, List.append(&2, A, List.reverse(&2, A, r), [x])),
        List.append(&2, A, List.reverse(&2, A, [x]), List.reverse(&2, A, List.reverse(&2, A, r))),
        List.rev_append(A, List.reverse(&2, A, r), [x])
      ): {_ == x <> r: List<&2, A>}
      %Equal.sym(List<&2, A>, List.reverse(&2, A, List.reverse(&2, A, r)), r, List.rev_rev(A, r)): {x <> _ == x <> r: List<&2, A>}
      {==}

# the pieces of the first tree of a run
def Runs.side_a(r: Runs) -> List<&2, Piece>:
  match r:
    case Runs{a, b}:
      a

# the pieces of the second tree of a run
def Runs.side_b(r: Runs) -> List<&2, Piece>:
  match r:
    case Runs{a, b}:
      b

# the pieces at the fronts of as and bs that a trim drops
def Mst.trim_pre(as: List<&2, Piece>, bs: List<&2, Piece>) -> List<&2, Piece>:
  match as bs:
    case Con{+x, ra} Con{y, rb}:
      Shared.Bool.when(List<&2, Piece>, Piece.same(x, y), u => x <> Mst.trim_pre(ra, rb), u => [])
    case xs ys:
      []

# Mst.trim_a at two first pieces x and y that Piece.same calls t
def Mst.trim_a.at(
  t: Bool,
  +x: Piece,
  -y: Piece,
  +ra: List<&2, Piece>,
  -rb: List<&2, Piece>,
  ih: {List.append(&2, Piece, Mst.trim_pre(ra, rb), Runs.side_a(Mst.trim(ra, rb))) == ra: List<&2, Piece>}
) -> {
  List.append(
    &2,
    Piece,
    Shared.Bool.when(List<&2, Piece>, t, u => x <> Mst.trim_pre(ra, rb), u => []),
    Runs.side_a(Shared.Bool.when(Runs, t, u => Mst.trim(ra, rb), u => Runs{x <> ra, y <> rb}))
  )
    == x <> ra: List<&2, Piece>
}:
  match t:
    case False{}:
      {==}
    case True{}:
      %Equal.sym(List<&2, Piece>, List.append(&2, Piece, Mst.trim_pre(ra, rb), Runs.side_a(Mst.trim(ra, rb))), ra, ih) :
        {x <> _ == x <> ra : List<&2, Piece>}
      {==}

# a trim drops a front of as and keeps the rest
def Mst.trim_a(as: List<&2, Piece>, bs: List<&2, Piece>) -> {
  List.append(&2, Piece, Mst.trim_pre(as, bs), Runs.side_a(Mst.trim(as, bs))) == as: List<&2, Piece>
}:
  match as:
    case Nil{}:
      {==}
    case Con{head, tail}:
      match bs:
        case Nil{}:
          {==}
        case Con{head1, tail1}:
          +head = head
          +tail = tail
          Mst.trim_a.at(Piece.same(head, head1), head, head1, tail, tail1, Mst.trim_a(tail, tail1))

# Mst.trim_b at two first pieces x and y that Piece.same calls t
def Mst.trim_b.at(
  t: Bool,
  +x: Piece,
  +y: Piece,
  -ra: List<&2, Piece>,
  +rb: List<&2, Piece>,
  et: {Piece.same(x, y) == t: Bool},
  ih: {List.append(&2, Piece, Mst.trim_pre(ra, rb), Runs.side_b(Mst.trim(ra, rb))) == rb: List<&2, Piece>}
) -> {
  List.append(
    &2,
    Piece,
    Shared.Bool.when(List<&2, Piece>, t, u => x <> Mst.trim_pre(ra, rb), u => []),
    Runs.side_b(Shared.Bool.when(Runs, t, u => Mst.trim(ra, rb), u => Runs{x <> ra, y <> rb}))
  )
    == y <> rb: List<&2, Piece>
}:
  match t:
    case False{}:
      {==}
    case True{}:
      Shared.List.cons_eq(Piece, x, y, List.append(&2, Piece, Mst.trim_pre(ra, rb), Runs.side_b(Mst.trim(ra, rb))), rb, Piece.same_eq(x, y)(et), ih)

# a trim drops the same front of bs and keeps the rest
def Mst.trim_b(as: List<&2, Piece>, bs: List<&2, Piece>) -> {
  List.append(&2, Piece, Mst.trim_pre(as, bs), Runs.side_b(Mst.trim(as, bs))) == bs: List<&2, Piece>
}:
  match as:
    case Nil{}:
      {==}
    case Con{head, tail}:
      match bs:
        case Nil{}:
          {==}
        case Con{head1, tail1}:
          +head = head
          +head1 = head1
          +tail1 = tail1
          Mst.trim_b.at(Piece.same(head, head1), head, head1, tail, tail1, {==}, Mst.trim_b(tail, tail1))

# a run is the run of its two sides
def Runs.eta(r: Runs) -> {r == Runs{Runs.side_a(r), Runs.side_b(r)}: Runs}:
  match r:
    case Runs{a, b}:
      {==}

# the pieces at the backs of the runs a and b that a trim drops, in order
def Mst.trim_back(a: List<&2, Piece>, +b: List<&2, Piece>) -> List<&2, Piece>:
  +t = Mst.trim(a, b)
  List.reverse(&2, Piece, Mst.trim_pre(List.reverse(&2, Piece, Runs.side_a(t)), List.reverse(&2, Piece, Runs.side_b(t))))

# the first side of a trimmed run, by the trims of its front and its back
def Runs.trim_side_a(+a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  Runs.side_a(Runs.trim(Runs{a, b}))
    == List.reverse(
      &2,
      Piece,
      Runs.side_a(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
    ): List<&2, Piece>
}:
  %Equal.sym(Runs, Mst.trim(a, b), Runs{Runs.side_a(Mst.trim(a, b)), Runs.side_b(Mst.trim(a, b))}, Runs.eta(Mst.trim(a, b))): {
    Runs.side_a(Runs.reverse(Runs.trim_front(Runs.reverse(_))))
      == List.reverse(
        &2,
        Piece,
        Runs.side_a(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
      ): List<&2, Piece>
  }
  %Equal.sym(
    Runs,
    Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))),
    Runs{
      Runs.side_a(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b))))),
      Runs.side_b(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
    },
    Runs.eta(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
  ): {
    Runs.side_a(Runs.reverse(_))
      == List.reverse(
        &2,
        Piece,
        Runs.side_a(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
      ): List<&2, Piece>
  }
  {==}

# the second side of a trimmed run, by the trims of its front and its back
def Runs.trim_side_b(+a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  Runs.side_b(Runs.trim(Runs{a, b}))
    == List.reverse(
      &2,
      Piece,
      Runs.side_b(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
    ): List<&2, Piece>
}:
  %Equal.sym(Runs, Mst.trim(a, b), Runs{Runs.side_a(Mst.trim(a, b)), Runs.side_b(Mst.trim(a, b))}, Runs.eta(Mst.trim(a, b))): {
    Runs.side_b(Runs.reverse(Runs.trim_front(Runs.reverse(_))))
      == List.reverse(
        &2,
        Piece,
        Runs.side_b(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
      ): List<&2, Piece>
  }
  %Equal.sym(
    Runs,
    Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))),
    Runs{
      Runs.side_a(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b))))),
      Runs.side_b(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
    },
    Runs.eta(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
  ): {
    Runs.side_b(Runs.reverse(_))
      == List.reverse(
        &2,
        Piece,
        Runs.side_b(Mst.trim(List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b))), List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))))
      ): List<&2, Piece>
  }
  {==}

# a run is its dropped front, its trimmed first side, and its dropped back
def Runs.trim_split_a(+a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  List.append(&2, Piece, Mst.trim_pre(a, b), List.append(&2, Piece, Runs.side_a(Runs.trim(Runs{a, b})), Mst.trim_back(a, b))) == a: List<&2, Piece>
}:
  +ra = List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b)))
  +rb = List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))
  %Equal.sym(
    List<&2, Piece>,
    Runs.side_a(Runs.trim(Runs{a, b})),
    List.reverse(&2, Piece, Runs.side_a(Mst.trim(ra, rb))),
    Runs.trim_side_a(a, b)
  ): {
    List.append(&2, Piece, Mst.trim_pre(a, b), List.append(&2, Piece, _, List.reverse(&2, Piece, Mst.trim_pre(ra, rb)))) == a: List<&2, Piece>
  }
  %List.rev_append(Piece, Mst.trim_pre(ra, rb), Runs.side_a(Mst.trim(ra, rb))): {
    List.append(&2, Piece, Mst.trim_pre(a, b), _) == a: List<&2, Piece>
  }
  %Equal.sym(List<&2, Piece>, List.append(&2, Piece, Mst.trim_pre(ra, rb), Runs.side_a(Mst.trim(ra, rb))), ra, Mst.trim_a(ra, rb)): {
    List.append(&2, Piece, Mst.trim_pre(a, b), List.reverse(&2, Piece, _)) == a: List<&2, Piece>
  }
  %Equal.sym(List<&2, Piece>, List.reverse(&2, Piece, ra), Runs.side_a(Mst.trim(a, b)), List.rev_rev(Piece, Runs.side_a(Mst.trim(a, b)))): {
    List.append(&2, Piece, Mst.trim_pre(a, b), _) == a: List<&2, Piece>
  }
  Mst.trim_a(a, b)

# a run is its dropped front, its trimmed second side, and its dropped back
def Runs.trim_split_b(+a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  List.append(&2, Piece, Mst.trim_pre(a, b), List.append(&2, Piece, Runs.side_b(Runs.trim(Runs{a, b})), Mst.trim_back(a, b))) == b: List<&2, Piece>
}:
  +ra = List.reverse(&2, Piece, Runs.side_a(Mst.trim(a, b)))
  +rb = List.reverse(&2, Piece, Runs.side_b(Mst.trim(a, b)))
  %Equal.sym(
    List<&2, Piece>,
    Runs.side_b(Runs.trim(Runs{a, b})),
    List.reverse(&2, Piece, Runs.side_b(Mst.trim(ra, rb))),
    Runs.trim_side_b(a, b)
  ): {
    List.append(&2, Piece, Mst.trim_pre(a, b), List.append(&2, Piece, _, List.reverse(&2, Piece, Mst.trim_pre(ra, rb)))) == b: List<&2, Piece>
  }
  %List.rev_append(Piece, Mst.trim_pre(ra, rb), Runs.side_b(Mst.trim(ra, rb))): {
    List.append(&2, Piece, Mst.trim_pre(a, b), _) == b: List<&2, Piece>
  }
  %Equal.sym(List<&2, Piece>, List.append(&2, Piece, Mst.trim_pre(ra, rb), Runs.side_b(Mst.trim(ra, rb))), rb, Mst.trim_b(ra, rb)): {
    List.append(&2, Piece, Mst.trim_pre(a, b), List.reverse(&2, Piece, _)) == b: List<&2, Piece>
  }
  %Equal.sym(List<&2, Piece>, List.reverse(&2, Piece, rb), Runs.side_b(Mst.trim(a, b)), List.rev_rev(Piece, Runs.side_b(Mst.trim(a, b)))): {
    List.append(&2, Piece, Mst.trim_pre(a, b), _) == b: List<&2, Piece>
  }
  Mst.trim_b(a, b)

# a trim of a common front keeps the difference of the values of k
def Mst.trim_front_differ(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +c: List<&2, Piece>,
  +a2: List<&2, Piece>,
  +b2: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.sorted(List.append(&2, Piece, c, a2)) == True{}: Bool} -> {Pieces.sorted(List.append(&2, Piece, c, b2)) == True{}: Bool} -> {
  Mst.differ(Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, a2), k), Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, b2), k))
    == Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
}:
  +h1 => +h2 => Bool.cases(
    Pieces.covers(c, k),
    {
      Mst.differ(Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, a2), k), Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, b2), k))
        == Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
    },
    +ct =>
      +n1 = Pieces.before_miss(c, a2, k)(Pieces.sorted_split(c, a2)(h1))(ct)
      +n2 = Pieces.before_miss(c, b2, k)(Pieces.sorted_split(c, b2)(h2))(ct)
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, a2), k),
        Pieces.value(~S, ~fetch, f, s, c, k),
        Pieces.value_left(~S, ~fetch, f, s, c, a2, k)(n1)
      ): {
        Mst.differ(_, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, b2), k))
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
      }
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, b2), k),
        Pieces.value(~S, ~fetch, f, s, c, k),
        Pieces.value_left(~S, ~fetch, f, s, c, b2, k)(n2)
      ): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, c, k), _)
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
      }
      %Equal.sym(Maybe<&2, List<&2, U32>>, Pieces.value(~S, ~fetch, f, s, a2, k), None{}, Pieces.value_none(~S, ~fetch, f, s, a2, k)(n1)): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, c, k), Pieces.value(~S, ~fetch, f, s, c, k))
          == Mst.differ(_, Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
      }
      %Equal.sym(Maybe<&2, List<&2, U32>>, Pieces.value(~S, ~fetch, f, s, b2, k), None{}, Pieces.value_none(~S, ~fetch, f, s, b2, k)(n2)): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, c, k), Pieces.value(~S, ~fetch, f, s, c, k)) == Mst.differ(None{}, _): Bool
      }
      Mst.differ_self(Pieces.value(~S, ~fetch, f, s, c, k)),
    +cf =>
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, a2), k),
        Pieces.value(~S, ~fetch, f, s, a2, k),
        Pieces.value_right(~S, ~fetch, f, s, c, a2, k)(cf)
      ): {
        Mst.differ(_, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, b2), k))
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
      }
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, c, b2), k),
        Pieces.value(~S, ~fetch, f, s, b2, k),
        Pieces.value_right(~S, ~fetch, f, s, c, b2, k)(cf)
      ): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), _)
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, a2, k), Pieces.value(~S, ~fetch, f, s, b2, k)): Bool
      }
      {==}
  )

# a trim of a common back keeps the difference of the values of k
def Mst.trim_back_differ(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +x2: List<&2, Piece>,
  +y2: List<&2, Piece>,
  +e: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.sorted(List.append(&2, Piece, x2, e)) == True{}: Bool} -> {Pieces.sorted(List.append(&2, Piece, y2, e)) == True{}: Bool} -> {
  Mst.differ(Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, x2, e), k), Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, y2, e), k))
    == Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
}:
  +h1 => +h2 => Bool.cases(
    Pieces.covers(e, k),
    {
      Mst.differ(Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, x2, e), k), Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, y2, e), k))
        == Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
    },
    +ct =>
      +n1 = Pieces.after_miss(x2, e, k)(Pieces.sorted_split(x2, e)(h1))(ct)
      +n2 = Pieces.after_miss(y2, e, k)(Pieces.sorted_split(y2, e)(h2))(ct)
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, x2, e), k),
        Pieces.value(~S, ~fetch, f, s, e, k),
        Pieces.value_right(~S, ~fetch, f, s, x2, e, k)(n1)
      ): {
        Mst.differ(_, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, y2, e), k))
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
      }
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, y2, e), k),
        Pieces.value(~S, ~fetch, f, s, e, k),
        Pieces.value_right(~S, ~fetch, f, s, y2, e, k)(n2)
      ): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, e, k), _)
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
      }
      %Equal.sym(Maybe<&2, List<&2, U32>>, Pieces.value(~S, ~fetch, f, s, x2, k), None{}, Pieces.value_none(~S, ~fetch, f, s, x2, k)(n1)): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, e, k), Pieces.value(~S, ~fetch, f, s, e, k))
          == Mst.differ(_, Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
      }
      %Equal.sym(Maybe<&2, List<&2, U32>>, Pieces.value(~S, ~fetch, f, s, y2, k), None{}, Pieces.value_none(~S, ~fetch, f, s, y2, k)(n2)): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, e, k), Pieces.value(~S, ~fetch, f, s, e, k)) == Mst.differ(None{}, _): Bool
      }
      Mst.differ_self(Pieces.value(~S, ~fetch, f, s, e, k)),
    +cf =>
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, x2, e), k),
        Pieces.value(~S, ~fetch, f, s, x2, k),
        Pieces.value_left(~S, ~fetch, f, s, x2, e, k)(cf)
      ): {
        Mst.differ(_, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, y2, e), k))
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
      }
      %Equal.sym(
        Maybe<&2, List<&2, U32>>,
        Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, y2, e), k),
        Pieces.value(~S, ~fetch, f, s, y2, k),
        Pieces.value_left(~S, ~fetch, f, s, y2, e, k)(cf)
      ): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), _)
          == Mst.differ(Pieces.value(~S, ~fetch, f, s, x2, k), Pieces.value(~S, ~fetch, f, s, y2, k)): Bool
      }
      {==}
  )

# a binding of the pieces ps has the key k
def Pieces.has_key(ps: List<&2, Piece>, +k: List<&2, U32>) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{Piece.Bind{k2, v}, rest}:
      Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.has_key(rest, k))
    case Con{Piece.Sub{h, u, lo, hi}, rest}:
      Pieces.has_key(rest, k)

# no key of a binding of as is the key of a binding of bs
def Pieces.apart(as: List<&2, Piece>, +bs: List<&2, Piece>) -> Bool:
  match as:
    case Nil{}:
      True{}
    case Con{Piece.Bind{k, v}, rest}:
      Bool.and(Bool.not(Pieces.has_key(bs, k)), Pieces.apart(rest, bs))
    case Con{Piece.Sub{h, u, lo, hi}, rest}:
      Pieces.apart(rest, bs)

# the keys of the bindings of ps, before acc, hold k when a binding of ps or
# acc does
def Pieces.keys_has(ps: List<&2, Piece>, +acc: List<&2, List<&2, U32>>, +k: List<&2, U32>) -> {
  List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Pieces.keys(ps, acc), k)
    == Bool.or(Pieces.has_key(ps, k), List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), acc, k)): Bool
}:
  match ps:
    case Nil{}:
      {==}
    case Con{Piece.Bind{+k2, v}, +rest}:
      Equal.trans(
        Bool,
        List.any.if(
          u => List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Pieces.keys(rest, acc), k),
          Shared.List.is_eq(~U32, ~U32.is_eq, k2, k)
        ),
        Bool.or(
          Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
          List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Pieces.keys(rest, acc), k)
        ),
        Bool.or(
          Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.has_key(rest, k)),
          List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), acc, k)
        ),
        Shared.List.any.if_or(
          Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
          u => List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Pieces.keys(rest, acc), k)
        ),
        Equal.trans(
          Bool,
          Bool.or(
            Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
            List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Pieces.keys(rest, acc), k)
          ),
          Bool.or(
            Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
            Bool.or(Pieces.has_key(rest, k), List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), acc, k))
          ),
          Bool.or(
            Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.has_key(rest, k)),
            List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), acc, k)
          ),
          Equal.cong(
            Bool,
            Bool,
            z => Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), z),
            List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Pieces.keys(rest, acc), k),
            Bool.or(Pieces.has_key(rest, k), List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), acc, k)),
            Pieces.keys_has(rest, acc, k)
          ),
          Shared.Bool.or_assoc(
            Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
            Pieces.has_key(rest, k),
            List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), acc, k)
          )
        )
      )
    case Con{Piece.Sub{h, u, lo, hi}, +rest}:
      Pieces.keys_has(rest, acc, k)

# pieces, then others, have a binding of k when either has
def Pieces.has_key_append(a: List<&2, Piece>, +b: List<&2, Piece>, +k: List<&2, U32>) -> {
  Pieces.has_key(List.append(&2, Piece, a, b), k) == Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k)): Bool
}:
  match a:
    case Nil{}:
      {==}
    case Con{head, tail}:
      match head:
        case Piece.Bind{key, value}:
          +tail = tail
          %Equal.sym(Bool, Pieces.has_key(List.append(&2, Piece, tail, b), k), Bool.or(Pieces.has_key(tail, k), Pieces.has_key(b, k)), Pieces.has_key_append(tail, b, k)) :
            {Bool.or(Shared.List.is_eq(U32, U32.is_eq, key, k), _) == Bool.or(Bool.or(Shared.List.is_eq(U32, U32.is_eq, key, k), Pieces.has_key(tail, k)), Pieces.has_key(b, k)) : Bool}
          Shared.Bool.or_assoc(Shared.List.is_eq(U32, U32.is_eq, key, k), Pieces.has_key(tail, k), Pieces.has_key(b, k))
        case Piece.Sub{hash, up, lo, hi}:
          Pieces.has_key_append(tail, b, k)

# no key has bindings in two apart runs
def Pieces.apart_key(as: List<&2, Piece>, +bs: List<&2, Piece>, +k: List<&2, U32>) -> {Pieces.apart(as, bs) == True{}: Bool} -> {
  Bool.and(Pieces.has_key(as, k), Pieces.has_key(bs, k)) == False{}: Bool
}:
  match as:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{+k2, +v}, +rest}:
      +h => Bool.cases(
        Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
        {Bool.and(Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.has_key(rest, k)), Pieces.has_key(bs, k)) == False{}: Bool},
        +ct =>
          %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), True{}, ct): {
            Bool.and(Bool.or(_, Pieces.has_key(rest, k)), Pieces.has_key(bs, k)) == False{}: Bool
          }
          %Shared.List.is_eq_sound(~U32, ~U32.is_eq, ~Shared.U32.laws(), k2, k)(ct): {
            Bool.and(True{}, Pieces.has_key(bs, _)) == False{}: Bool
          }
          Shared.Bool.not_true(
            Pieces.has_key(bs, k2)
          )(Shared.Bool.and_true_left(Bool.not(Pieces.has_key(bs, k2)), Pieces.apart(rest, bs))(h)),
        +cf =>
          %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), False{}, cf): {
            Bool.and(Bool.or(_, Pieces.has_key(rest, k)), Pieces.has_key(bs, k)) == False{}: Bool
          }
          Pieces.apart_key(rest, bs, k)(Shared.Bool.and_true_right(Bool.not(Pieces.has_key(bs, k2)), Pieces.apart(rest, bs))(h))
      )
    case Con{Piece.Sub{h2, u, lo, hi}, +rest}:
      h => Pieces.apart_key(rest, bs, k)(h)

# pieces apart from bs, after others, are apart from bs
def Pieces.apart_right(a: List<&2, Piece>, +b: List<&2, Piece>, +bs: List<&2, Piece>) -> {
  Pieces.apart(List.append(&2, Piece, a, b), bs) == True{}: Bool
} -> {Pieces.apart(b, bs) == True{}: Bool}:
  match a:
    case Nil{}:
      h => h
    case Con{Piece.Bind{+k, v}, +rest}:
      h => Pieces.apart_right(
        rest,
        b,
        bs
      )(Shared.Bool.and_true_right(Bool.not(Pieces.has_key(bs, k)), Pieces.apart(List.append(&2, Piece, rest, b), bs))(h))
    case Con{Piece.Sub{h2, u, lo, hi}, +rest}:
      h => Pieces.apart_right(rest, b, bs)(h)

# pieces apart from bs, before others, are apart from bs
def Pieces.apart_left(a: List<&2, Piece>, +b: List<&2, Piece>, +bs: List<&2, Piece>) -> {
  Pieces.apart(List.append(&2, Piece, a, b), bs) == True{}: Bool
} -> {Pieces.apart(a, bs) == True{}: Bool}:
  match a:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{+k, v}, +rest}:
      +h => Shared.Bool.and_both(
        Bool.not(Pieces.has_key(bs, k)),
        Pieces.apart(rest, bs)
      )(Shared.Bool.and_true_left(Bool.not(Pieces.has_key(bs, k)), Pieces.apart(List.append(&2, Piece, rest, b), bs))(h))(
        Pieces.apart_left(rest, b, bs)(Shared.Bool.and_true_right(Bool.not(Pieces.has_key(bs, k)), Pieces.apart(List.append(&2, Piece, rest, b), bs))(h))
      )
    case Con{Piece.Sub{h2, u, lo, hi}, +rest}:
      h => Pieces.apart_left(rest, b, bs)(h)

# Pieces.apart_sub_left and right help: a not-or that holds holds for each side
def Bool.not_or_l(a: Bool, -b: Bool) -> {Bool.not(Bool.or(a, b)) == True{}: Bool} -> {Bool.not(a) == True{}: Bool}:
  match a:
    case False{}:
      x => {==}
    case True{}:
      x => x

# the second side of a not-or that holds
def Bool.not_or_r(a: Bool, -b: Bool) -> {Bool.not(Bool.or(a, b)) == True{}: Bool} -> {Bool.not(b) == True{}: Bool}:
  match a:
    case False{}:
      x => x
    case True{}:
      x => Empty.absurd({Bool.not(b) == True{} : Bool}, {(%x : {\{False: Unit; \{True: Empty; \{}}} : Bool -> Type}(_); Unit{}) : Empty})

# pieces apart from others are apart from the front of them
def Pieces.apart_sub_left(as: List<&2, Piece>, +a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  Pieces.apart(as, List.append(&2, Piece, a, b)) == True{}: Bool
} -> {Pieces.apart(as, a) == True{}: Bool}:
  match as:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{+k, v}, +rest}:
      +h =>
        +h1 = Equal.trans(
          Bool,
          Bool.not(Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k))),
          Bool.not(Pieces.has_key(List.append(&2, Piece, a, b), k)),
          True{},
          Equal.cong(
            Bool,
            Bool,
            z => Bool.not(z),
            Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k)),
            Pieces.has_key(List.append(&2, Piece, a, b), k),
            Equal.sym(Bool, Pieces.has_key(List.append(&2, Piece, a, b), k), Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k)), Pieces.has_key_append(a, b, k))
          ),
          Shared.Bool.and_true_left(Bool.not(Pieces.has_key(List.append(&2, Piece, a, b), k)), Pieces.apart(rest, List.append(&2, Piece, a, b)))(h)
        )
        Shared.Bool.and_both(
          Bool.not(Pieces.has_key(a, k)),
          Pieces.apart(rest, a)
        )(Bool.not_or_l(Pieces.has_key(a, k), Pieces.has_key(b, k))(h1))(
          Pieces.apart_sub_left(
            rest,
            a,
            b
          )(Shared.Bool.and_true_right(Bool.not(Pieces.has_key(List.append(&2, Piece, a, b), k)), Pieces.apart(rest, List.append(&2, Piece, a, b)))(h))
        )
    case Con{Piece.Sub{h2, u, lo, hi}, +rest}:
      h => Pieces.apart_sub_left(rest, a, b)(h)

# pieces apart from others are apart from the back of them
def Pieces.apart_sub_right(as: List<&2, Piece>, +a: List<&2, Piece>, +b: List<&2, Piece>) -> {
  Pieces.apart(as, List.append(&2, Piece, a, b)) == True{}: Bool
} -> {Pieces.apart(as, b) == True{}: Bool}:
  match as:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{+k, v}, +rest}:
      +h =>
        +h1 = Equal.trans(
          Bool,
          Bool.not(Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k))),
          Bool.not(Pieces.has_key(List.append(&2, Piece, a, b), k)),
          True{},
          Equal.cong(
            Bool,
            Bool,
            z => Bool.not(z),
            Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k)),
            Pieces.has_key(List.append(&2, Piece, a, b), k),
            Equal.sym(Bool, Pieces.has_key(List.append(&2, Piece, a, b), k), Bool.or(Pieces.has_key(a, k), Pieces.has_key(b, k)), Pieces.has_key_append(a, b, k))
          ),
          Shared.Bool.and_true_left(Bool.not(Pieces.has_key(List.append(&2, Piece, a, b), k)), Pieces.apart(rest, List.append(&2, Piece, a, b)))(h)
        )
        Shared.Bool.and_both(
          Bool.not(Pieces.has_key(b, k)),
          Pieces.apart(rest, b)
        )(Bool.not_or_r(Pieces.has_key(a, k), Pieces.has_key(b, k))(h1))(
          Pieces.apart_sub_right(
            rest,
            a,
            b
          )(Shared.Bool.and_true_right(Bool.not(Pieces.has_key(List.append(&2, Piece, a, b), k)), Pieces.apart(rest, List.append(&2, Piece, a, b)))(h))
        )
    case Con{Piece.Sub{h2, u, lo, hi}, +rest}:
      h => Pieces.apart_sub_right(rest, a, b)(h)

# pieces without a subtree give a value of k exactly when a binding of them
# has the key k
def Mst.value_key(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  ps: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.has_sub(ps) == False{}: Bool} -> {
  Maybe.is_some(&2, List<&2, U32>, Pieces.value(~S, ~fetch, f, s, ps, k)) == Pieces.has_key(ps, k): Bool
}:
  match ps:
    case Nil{}:
      h => {==}
    case Con{Piece.Bind{+k2, +v}, +rest}:
      +h => Bool.cases(
        Shared.List.is_eq(~U32, ~U32.is_eq, k2, k),
        {
          Maybe.is_some(&2, List<&2, U32>, Pieces.value(~S, ~fetch, f, s, Piece.Bind{k2, v} <> rest, k))
            == Bool.or(Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), Pieces.has_key(rest, k)): Bool
        },
        +ct =>
          %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), True{}, ct): {
            Maybe.is_some(
              &2,
              List<&2, U32>,
              Shared.Bool.when(Maybe<&2, List<&2, U32>>, _, u => Some{v}, u => Pieces.value(~S, ~fetch, f, s, rest, k))
            )
              == Bool.or(_, Pieces.has_key(rest, k)): Bool
          }
          {==},
        +cf =>
          %Equal.sym(Bool, Shared.List.is_eq(~U32, ~U32.is_eq, k2, k), False{}, cf): {
            Maybe.is_some(
              &2,
              List<&2, U32>,
              Shared.Bool.when(Maybe<&2, List<&2, U32>>, _, u => Some{v}, u => Pieces.value(~S, ~fetch, f, s, rest, k))
            )
              == Bool.or(_, Pieces.has_key(rest, k)): Bool
          }
          Mst.value_key(~S, ~fetch, f, s, rest, k)(h)
      )
    case Con{Piece.Sub{h2, u, lo, hi}, rest}:
      h => Empty.absurd(
        {
          Maybe.is_some(&2, List<&2, U32>, Pieces.value(~S, ~fetch, f, s, Piece.Sub{h2, u, lo, hi} <> rest, k))
            == Pieces.has_key(rest, k): Bool
        },
        Shared.Bool.true_ne_false(h)
      )

# values that are not both there differ exactly when either is there
def Mst.differ_some(x: Maybe<&2, List<&2, U32>>, y: Maybe<&2, List<&2, U32>>) -> {
  Bool.and(Maybe.is_some(&2, List<&2, U32>, x), Maybe.is_some(&2, List<&2, U32>, y)) == False{}: Bool
} -> {Mst.differ(x, y) == Bool.or(Maybe.is_some(&2, List<&2, U32>, x), Maybe.is_some(&2, List<&2, U32>, y)): Bool}:
  match x:
    case None{}:
      match y:
        case None{}:
          x => {==}
        case Some{value}:
          x => {==}
    case Some{value}:
      match y:
        case None{}:
          x => {==}
        case Some{value1}:
          x => Empty.absurd({Mst.differ(Some{value}, Some{value1}) == Bool.or(Maybe.is_some(&2, List<&2, U32>, Some{value}), Maybe.is_some(&2, List<&2, U32>, Some{value1})) : Bool}, {(%x : {\{False: Empty; \{True: Unit; \{}}} : Bool -> Type}(_); Unit{}) : Empty})

# the differences of the values of k over the runs ps, read f levels down
def Runs.differ(~S: Data, ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>, +f: Nat, +s: S, ps: List<&2, Runs>, +k: List<&2, U32>) -> Bool:
  match ps:
    case Nil{}:
      False{}
    case Con{Runs{a, b}, rest}:
      Bool.or(
        Mst.differ(Pieces.value(~S, ~fetch, f, s, a, k), Pieces.value(~S, ~fetch, f, s, b, k)),
        Runs.differ(~S, ~fetch, f, s, rest, k)
      )

# reversed pieces x then sa, then as, are reversed sa, then x then as
def List.rev_move.g9(
  -A: Data,
  +x: A,
  +sa: List<&2, A>,
  +as: List<&2, A>,
  +x1: List<&2, A>,
  hx1: {x1 == List.reverse.go(&2, A, sa, []) : List<&2, A>}) ->
  {List.append(&2, A, List.append(&2, A, List.reverse(&2, A, sa), [x]), as) == List.append(&2, A, x1, x <> as) : List<&2, A>}:
  match x1:
    case Nil{}:
      %hx1 :
        {List.append(&2, A, List.append(&2, A, _, [x]), as) == x <> as : List<&2, A>}
      {==}
    case Con{head, tail}:
      %hx1 :
        {List.append(&2, A, List.append(&2, A, _, [x]), as) == head <> List.append(&2, A, tail, x <> as) : List<&2, A>}
      %Equal.sym(List<&2, A>, List.append(&2, A, List.append(&2, A, tail, [x]), as), List.append(&2, A, tail, List.append(&2, A, [x], as)), Shared.List.append_assoc(A, tail, [x], as)) :
        {head <> _ == head <> List.append(&2, A, tail, x <> as) : List<&2, A>}
      {==}

def List.rev_move(-A: Data, +x: A, sa: List<&2, A>, +as: List<&2, A>) -> {
  List.append(&2, A, List.reverse(&2, A, x <> sa), as) == List.append(&2, A, List.reverse(&2, A, sa), x <> as): List<&2, A>
}:
  +sa = sa
  %Equal.sym(List<&2, A>, List.reverse.go(&2, A, sa, [x]), List.append(&2, A, List.reverse(&2, A, sa), [x]), List.rev_acc(A, sa, [x])) :
    {List.append(&2, A, _, as) == List.append(&2, A, List.reverse.go(&2, A, sa, []), x <> as) : List<&2, A>}
  List.rev_move.g9(A, x, sa, as, List.reverse.go(&2, A, sa, []), {==})

# the keys of a round with a run first are the keys of the round
def Round.keys_cons(p: Runs, r: Round) -> {Round.keys(Round.cons(p, r)) == Round.keys(r): List<&2, List<&2, U32>>}:
  match r:
    case Round{keys, pairs}:
      {==}

# the keys of a round with a key that may differ
def Round.keys_differs(k: List<&2, U32>, v1: List<&2, U32>, v2: List<&2, U32>, r: Round) -> {
  Round.keys(Round.differs(k, v1, v2, r))
    == Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => Round.keys(r), u => k <> Round.keys(r)): List<
    &2,
    List<&2, U32>>
}:
  match r:
    case Round{keys, pairs}:
      {==}

# keys and maybe one other key hold k as the keys do, when the other is not k
def Mst.contains_when(
  t: Bool,
  +k1: List<&2, U32>,
  +ks: List<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> {Shared.List.is_eq(~U32, ~U32.is_eq, k1, k) == False{}: Bool} -> {
  List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Shared.Bool.when(List<&2, List<&2, U32>>, t, u => ks, u => k1 <> ks), k)
    == List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k): Bool
}:
  match t:
    case False{}:
      x => (%Equal.sym(Bool, Shared.List.is_eq(U32, U32.is_eq, k1, k), False{}, x) : {List.any.if(u => List.contains(List<&2, U32>, Shared.List.is_eq(U32, U32.is_eq), ks, k), _) == List.contains(List<&2, U32>, Shared.List.is_eq(U32, U32.is_eq), ks, k) : Bool}; {==})
    case True{}:
      x => {==}

# keys that lack k, and k when t fails, hold k exactly when t fails
def Mst.contains_when_eq(
  t: Bool,
  +k1: List<&2, U32>,
  +ks: List<&2, List<&2, U32>>,
  +k: List<&2, U32>
) -> {Shared.List.is_eq(~U32, ~U32.is_eq, k1, k) == True{}: Bool} -> {
  List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k) == False{}: Bool
} -> {
  Bool.not(t)
    == List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Shared.Bool.when(List<&2, List<&2, U32>>, t, u => ks, u => k1 <> ks), k): Bool
}:
  match t:
    case False{}:
      x => x1 => (%Equal.sym(Bool, Shared.List.is_eq(U32, U32.is_eq, k1, k), True{}, x) : {True{} == List.any.if(u => List.contains(List<&2, U32>, Shared.List.is_eq(U32, U32.is_eq), ks, k), _) : Bool}; {==})
    case True{}:
      x => x1 => Equal.sym(Bool, List.contains(List<&2, U32>, Shared.List.is_eq(U32, U32.is_eq), ks, k), False{}, x1)

# an or of two False sides is False
def Bool.or_false_of(a: Bool, -b: Bool) -> {a == False{}: Bool} -> {b == False{}: Bool} -> {Bool.or(a, b) == False{}: Bool}:
  x => x1 => (%Equal.sym(Bool, a, False{}, x) : {Bool.or(_, b) == False{} : Bool}; x1)

# two values that are not there do not differ
def Mst.differ_none(x: Maybe<&2, List<&2, U32>>, y: Maybe<&2, List<&2, U32>>) -> {x == None{}: Maybe<&2, List<&2, U32>>} -> {
  y == None{}: Maybe<&2, List<&2, U32>>
} -> {Mst.differ(x, y) == False{}: Bool}:
  x1 => x2 => (%Equal.sym(Maybe<&2, List<&2, U32>>, x, None{}, x1) : {Bool.not(Shared.Maybe.is_eq(List<&2, U32>, Shared.List.is_eq(U32, U32.is_eq), _, y)) == False{} : Bool}; (%Equal.sym(Maybe<&2, List<&2, U32>>, y, None{}, x2) : {Bool.not(Shared.Maybe.is_eq(List<&2, U32>, Shared.List.is_eq(U32, U32.is_eq), None{}, _)) == False{} : Bool}; {==}))

# a key not after k1 is not held by pieces after the binding of k1
def Mst.ra_miss(+xs: List<&2, Piece>, +k1: List<&2, U32>, +v1: List<&2, U32>, +ra: List<&2, Piece>, +k: List<&2, U32>) -> {
  Pieces.sorted(List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra)) == True{}: Bool
} -> {Key.is_lt(k1, k) == False{}: Bool} -> {Pieces.covers(ra, k) == False{}: Bool}:
  hs => hk => Bool.false_of(
    Pieces.covers(ra, k),
    c => Shared.Bool.true_ne_false(
      Equal.trans(
        Bool,
        True{},
        Key.is_lt(k1, k),
        False{},
        Equal.sym(
          Bool,
          Key.is_lt(k1, k),
          True{},
          Pieces.above_all(
            k1,
            v1,
            ra,
            k
          )(
            Shared.Bool.and_true_left(
              Pieces.after_all(Piece.Bind{k1, v1}, ra),
              Pieces.sorted(ra)
            )(Pieces.sorted_right(xs, Piece.Bind{k1, v1} <> ra)(hs))
          )(c)
        ),
        hk
      )
    )
  )

# a key not before k1 is not held by pieces before the binding of k1
def Mst.xs_miss(+xs: List<&2, Piece>, +k1: List<&2, U32>, +v1: List<&2, U32>, +ra: List<&2, Piece>, +k: List<&2, U32>) -> {
  Pieces.sorted(List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra)) == True{}: Bool
} -> {Key.is_lt(k, k1) == False{}: Bool} -> {Pieces.covers(xs, k) == False{}: Bool}:
  x => x1 => Bool.false_of(Pieces.covers(xs, k), x2 => Shared.Bool.true_ne_false((%x1 : {True{} == _ : Bool}; Equal.sym(Bool, Key.is_lt(k, k1), True{}, Pieces.below_all(xs, k1, v1, ra, k)(Pieces.sorted_split(xs, Piece.Bind{k1, v1} <> ra)(x))(x2)))))

# the values of k in the run of xs, then the binding of k1, then ra, by how
# k compares to k1: before it, the values of xs
def Mst.side_left(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +xs: List<&2, Piece>,
  +k1: List<&2, U32>,
  +v1: List<&2, U32>,
  +ra: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.sorted(List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra)) == True{}: Bool} -> {Key.is_lt(k1, k) == False{}: Bool} -> {
  Shared.List.is_eq(~U32, ~U32.is_eq, k1, k) == False{}: Bool
} -> {
  Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra), k) == Pieces.value(~S, ~fetch, f, s, xs, k): Maybe<&2, List<&2, U32>>
}:
  x => x1 => x2 => Pieces.value_left(~S, ~fetch, f, s, xs, Piece.Bind{k1, v1} <> ra, k)((%Equal.sym(Bool, Shared.List.is_eq(U32, U32.is_eq, k1, k), False{}, x2) : {Bool.or(_, Pieces.covers(ra, k)) == False{} : Bool}; Mst.ra_miss(xs, k1, v1, ra, k)(x)(x1)))

# the values of k in the run of xs, then the binding of k1, then ra, from k1
# on: the values of the binding, then ra
def Mst.side_right(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +xs: List<&2, Piece>,
  +k1: List<&2, U32>,
  +v1: List<&2, U32>,
  +ra: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.sorted(List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra)) == True{}: Bool} -> {Key.is_lt(k, k1) == False{}: Bool} -> {
  Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra), k)
    == Pieces.value(~S, ~fetch, f, s, Piece.Bind{k1, v1} <> ra, k): Maybe<&2, List<&2, U32>>
}:
  x => x1 => Pieces.value_right(~S, ~fetch, f, s, xs, Piece.Bind{k1, v1} <> ra, k)(Mst.xs_miss(xs, k1, v1, ra, k)(x)(x1))

# the difference of runs cut at a key k1 that both hold as a binding: before
# k1 the runs before it, at k1 the two values, after k1 the runs after it
# (ih)
def Mst.cut_eq(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  +f: Nat,
  +s: S,
  +xs: List<&2, Piece>,
  +ys: List<&2, Piece>,
  +k1: List<&2, U32>,
  +v1: List<&2, U32>,
  +v2: List<&2, U32>,
  +ra: List<&2, Piece>,
  +rb: List<&2, Piece>,
  +ks: List<&2, List<&2, U32>>,
  +pd: Bool,
  +k: List<&2, U32>,
  +hx: {Pieces.sorted(List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra)) == True{}: Bool},
  +hy: {Pieces.sorted(List.append(&2, Piece, ys, Piece.Bind{k1, v2} <> rb)) == True{}: Bool},
  +ih: {
    Mst.differ(Pieces.value(~S, ~fetch, f, s, ra, k), Pieces.value(~S, ~fetch, f, s, rb, k))
      == Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), pd): Bool
  }
) -> {
  Mst.differ(
    Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra), k),
    Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, ys, Piece.Bind{k1, v2} <> rb), k)
  )
    == Bool.or(
      List.contains(
        ~List<&2, U32>,
        ~Shared.List.is_eq(~U32, ~U32.is_eq),
        Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => ks, u => k1 <> ks),
        k
      ),
      Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), pd)
    ): Bool
}:
  Key.cases.at(
    Key.cmp(k, k1),
    k,
    k1,
    {Mst.differ(Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra), k), Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, ys, Piece.Bind{k1, v2} <> rb), k)) == Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => ks, u => k1 <> ks), k), Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), pd)): Bool},
    {==},
    +el =>
      +gt0 = Key.gt_of(k, k1, LT{})(el)
      +eq0 = Key.eq_of(k, k1, LT{})(el)
      +i0 = Equal.trans(
        Bool,
        False{},
        Mst.differ(Pieces.value(~S, ~fetch, f, s, ra, k), Pieces.value(~S, ~fetch, f, s, rb, k)),
        Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), pd),
        Equal.sym(
          Bool,
          Mst.differ(Pieces.value(~S, ~fetch, f, s, ra, k), Pieces.value(~S, ~fetch, f, s, rb, k)),
          False{},
          Mst.differ_none(Pieces.value(~S, ~fetch, f, s, ra, k), Pieces.value(~S, ~fetch, f, s, rb, k))(Pieces.value_none(~S, ~fetch, f, s, ra, k)(Mst.ra_miss(xs, k1, v1, ra, k)(hx)(gt0)))(
            Pieces.value_none(~S, ~fetch, f, s, rb, k)(Mst.ra_miss(ys, k1, v2, rb, k)(hy)(gt0))
          )
        ),
        ih
      )
      %Equal.sym(Maybe<&2, List<&2, U32>>, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, xs, Piece.Bind{k1, v1} <> ra), k), Pieces.value(~S, ~fetch, f, s, xs, k), Mst.side_left(~S, ~fetch, f, s, xs, k1, v1, ra, k)(hx)(gt0)(eq0)): {
        Mst.differ(_, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, ys, Piece.Bind{k1, v2} <> rb), k)) == Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => ks, u => k1 <> ks), k), Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), pd)): Bool
      }
      %Equal.sym(Maybe<&2, List<&2, U32>>, Pieces.value(~S, ~fetch, f, s, List.append(&2, Piece, ys, Piece.Bind{k1, v2} <> rb), k), Pieces.value(~S, ~fetch, f, s, ys, k), Mst.side_left(~S, ~fetch, f, s, ys, k1, v2, rb, k)(hy)(gt0)(eq0)): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), _) == Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => ks, u => k1 <> ks), k), Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), pd)): Bool
      }
      %Equal.sym(Bool, List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), Shared.Bool.when(List<&2, List<&2, U32>>, Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), u => ks, u => k1 <> ks), k), List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), Mst.contains_when(Shared.List.is_eq(~U32, ~U32.is_eq, v1, v2), k1, ks, k)(eq0)): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)) == Bool.or(_, Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), pd)): Bool
      }
      %Equal.sym(Bool, List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), False{}, Bool.or_false_l(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), pd)(Equal.sym(Bool, False{}, Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), pd), i0))): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)) == Bool.or(_, Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), pd)): Bool
      }
      %Equal.sym(Bool, pd, False{}, Bool.or_false_r(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), pd)(Equal.sym(Bool, False{}, Bool.or(List.contains(~List<&2, U32>, ~Shared.List.is_eq(~U32, ~U32.is_eq), ks, k), pd), i0))): {
        Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)) == Bool.or(False{}, Bool.or(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k)), _)): Bool
      }
      Shared.Bool.or_false(Mst.differ(Pieces.value(~S, ~fetch, f, s, xs, k), Pieces.value(~S, ~fetch, f, s, ys, k))),
    +ee =>
