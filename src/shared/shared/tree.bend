# a node over a merged first subtree is an edit
def Mst.with_first_some(+l: Nat, xs: List<&2, Item>, e: Maybe<&2, Edit>) -> {Maybe.is_some(&2, Edit, e) == True{}: Bool} -> {
  Maybe.is_some(&2, Edit, Mst.with_first(l, xs, e)) == True{}: Bool
