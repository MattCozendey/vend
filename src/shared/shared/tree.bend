# a pick that goes down into a whole subtree reads k absent when the subtree
# does (ih)
def Mst.absent_pick(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  -f: Nat,
  +g: Nat,
