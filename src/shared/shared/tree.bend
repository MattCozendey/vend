  -ks: List<&2, Piece>
) -> {Mst.open(~S, ~fetch, s, h, up, lo, hi) == Some{ks}: Maybe<&2, List<&2, Piece>>} -> {Pieces.wf(~S, ~fetch, q, s, ks) == True{}: Bool} -> {
  Mst.wf(~S, ~fetch, 1n+q, s, up, Room{up, lo, hi}, Some{h}) == True{}: Bool
}:
