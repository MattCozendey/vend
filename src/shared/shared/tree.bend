# a difference of runs with sorted sides lists exactly the keys that they
# read differently
def Mst.diff_differ(
  ~S: Data,
  ~fetch: S -> Hashes.Hash -> Maybe<&2, List<&2, U32>>,
  f: Nat,
  +s: S,
  runs: List<&2, Runs>,
  -ks: List<&2, List<&2, U32>>,
  +k: List<&2, U32>
