  bs: List<&2, Piece>,
  +sa: List<&2, Piece>,
  +sb: List<&2, Piece>,
  +k: List<&2, U32>
) -> {Pieces.sorted(List.append(&2, Piece, List.reverse(&2, Piece, sa), as)) == True{}: Bool} -> {
  Pieces.sorted(List.append(&2, Piece, List.reverse(&2, Piece, sb), bs)) == True{}: Bool
